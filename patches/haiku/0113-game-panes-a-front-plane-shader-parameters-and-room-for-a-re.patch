 			status_t			SetTextFont(const BFont* font = NULL,
-									float size = 8.0f);
-			uint32				TextWidth(const char* text) const;
-			uint32				TextHeight() const;
+									float size = 8.0f, uint32 slot = 0);
+			uint32				TextWidth(const char* text,
