+void
+BGamePane::SetShaderParam(uint32 index, float value)
+{
+	if (fStatus != B_OK || index >= PRDS_SHADER_PARAMS)
+		return;
+	((float*)(fPool + fPoolOffset + fParamOffset))[index] = value;
+}
+
+
+float
