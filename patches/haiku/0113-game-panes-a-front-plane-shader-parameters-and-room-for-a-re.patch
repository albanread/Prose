 		+ PRDS_SPRITE_PALETTES * 16) * 4;
+	fParamOffset = fPaletteOffset + paletteSize;
+	paletteSize += PRDS_SHADER_PARAMS * 4;
 	fSpriteTableOffset = ALIGN_UP(fPaletteOffset + paletteSize, 64);
