+								   scanline palette, then PRDS_SPRITE_PALETTES of
+								   16, then PRDS_SHADER_PARAMS floats */
+	uint64	front_offset;		/* pool offset of the front plane, or 0 for none:
+								   `buffers` more planes of the same size and
+								   stride, composited after the sprites */
 } _PACKED;
 
 struct prds_pane_config {
@@ -282,6 +287,7 @@ struct prds_pane_alloc {
 	uint64	buffer_offset;		/* in: buffer 0, within the allocation */
 	uint64	buffer_stride;		/* in */
 	uint64	palette_offset;		/* in: within the allocation */
+	uint64	front_offset;		/* in: within the allocation, or 0 for no front plane */
 	uint64	pool_offset;		/* out: where the allocation landed */
 	uint32	pane_id;			/* out */
