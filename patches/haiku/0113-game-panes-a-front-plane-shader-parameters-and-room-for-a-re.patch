 		+ PRDS_MAX_SPRITES * sizeof(struct prds_sprite);
@@ -146,10 +150,17 @@ BGamePane::BGamePane(BRect frame, const char* title, uint32 worldWidth,
 	fShaderSize = PRDS_SHADER_MAX;
