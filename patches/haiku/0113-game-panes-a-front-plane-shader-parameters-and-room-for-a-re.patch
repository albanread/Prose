--- a/headers/os/game/GamePane.h
+++ b/headers/os/game/GamePane.h
@@ -29,7 +29,17 @@ class BBitmap;
 
 enum {
 	B_GAME_PANE_SCANLINE_PALETTE	= 1 << 0,	/* 1-15 come from the row's palette */
-	B_GAME_PANE_FULLSCREEN			= 1 << 1	/* covers the screen: the desktop is not drawn */
+	B_GAME_PANE_FULLSCREEN			= 1 << 1,	/* covers the screen: the desktop is not drawn */
+	B_GAME_PANE_FRONT_PLANE			= 1 << 2	/* a second plane, over the sprites */
+};
+
+
+/* Which plane the drawing calls write to. The world is under the sprites; the
+   front plane is over them, out of the global palette, and is where a score
+   belongs -- an alien flying across it should pass behind. */
+enum game_pane_plane {
+	B_GAME_WORLD = 0,
+	B_GAME_FRONT = 1
 };
 
 
@@ -72,6 +82,12 @@ public:
 	// buffer being drawn into, which Present() then makes the live one.
 			uint8*				World() const;
 			uint8*				RowAt(int32 y) const;
+
+	// Everything below draws into the plane this selects; the world by
+	// default, and only the world unless B_GAME_PANE_FRONT_PLANE was asked
+	// for. Set it, draw, set it back.
+			void				SetPlane(game_pane_plane plane);
+			game_pane_plane		Plane() const { return fPlane; }
 			uint32				WorldWidth() const { return fWorldWidth; }
 			uint32				WorldHeight() const { return fWorldHeight; }
