@@ -141,6 +157,13 @@ public:
 			status_t			SetOverlayShader(const char* metalSource);
 			const char*			ShaderError() const;
 
+	// Sixteen floats either shader reads as p.param(i) -- how a running game
+	// tells one anything: which of twelve skies to draw, how hard to shake,
+	// how far through a fade it is. They take effect on the next frame and
+	// cost nothing; no shader is recompiled.
+			void				SetShaderParam(uint32 index, float value);
+			float				ShaderParam(uint32 index) const;
+
 	// Sprites are transformed by the host, so they scale and rotate. Define
 	// a shape once; list the ones you want each frame, then Present().
 	//
@@ -184,14 +207,18 @@ public:
 	// as a space.
 	//
 	// A string is one colour. Draw it twice, offset by a pixel, for a shadow.
+	// Four slots, so a program can have a title size and a score size
