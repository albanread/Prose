@@ -201,7 +228,7 @@ public:
 	virtual	void				DirectConnected(direct_buffer_info* info);
 
 private:
-			enum { kMaxSprites = 64 };
+			enum { kMaxSprites = 128, kFontSlots = 4 };
 
