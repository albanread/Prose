+	uint64 end = fShaderOffset + fShaderSize * 2;
+	if ((flags & B_GAME_PANE_FRONT_PLANE) != 0) {
+		fFrontOffset = ALIGN_UP(end, 64);
+		end = fFrontOffset + fBufferStride * fBuffers;
+	}
 
 	struct prds_pane_alloc alloc;
 	memset(&alloc, 0, sizeof(alloc));
-	alloc.size = fShaderOffset + fShaderSize * 2;
+	alloc.size = end;
 	alloc.format = PRDS_PANE_INDEXED8;
 	alloc.world_width = worldWidth;
 	alloc.world_height = worldHeight;
@@ -158,6 +169,7 @@ BGamePane::BGamePane(BRect frame, const char* title, uint32 worldWidth,
 	alloc.buffer_offset = fBufferOffset;
 	alloc.buffer_stride = fBufferStride;
 	alloc.palette_offset = fPaletteOffset;
+	alloc.front_offset = fFrontOffset;
 	if (ioctl(fDevice, PRDS_PANE_ALLOC, &alloc, sizeof(alloc)) != 0) {
 		fStatus = errno != 0 ? (status_t)errno : B_ERROR;
 		return;
@@ -165,7 +177,7 @@ BGamePane::BGamePane(BRect frame, const char* title, uint32 worldWidth,
 	fPaneID = alloc.pane_id;
 	fPoolOffset = alloc.pool_offset;
 
-	memset(fPool + fPoolOffset, 0, (size_t)(fShaderOffset + fShaderSize * 2));
+	memset(fPool + fPoolOffset, 0, (size_t)end);
 	fStatus = B_OK;
 }
 
