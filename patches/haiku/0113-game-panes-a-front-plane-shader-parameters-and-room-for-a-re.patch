@@ -208,12 +222,22 @@ BGamePane::InitCheck() const
 //	#pragma mark - the world
 
 
+void
+BGamePane::SetPlane(game_pane_plane plane)
+{
+	if (plane == B_GAME_FRONT && fFrontOffset == 0)
+		return;
+	fPlane = plane;
+}
+
+
 uint8*
 BGamePane::World() const
 {
 	if (fStatus != B_OK)
 		return NULL;
-	return fPool + fPoolOffset + fBufferOffset + fBufferStride * fBufferIndex;
+	uint64 base = fPlane == B_GAME_FRONT ? fFrontOffset : fBufferOffset;
+	return fPool + fPoolOffset + base + fBufferStride * fBufferIndex;
 }
 
 
