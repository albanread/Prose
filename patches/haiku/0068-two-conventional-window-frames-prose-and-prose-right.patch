+	"long_descr"		= "One full-width title bar sized from the system font, "
+		"round close, minimize and zoom buttons at the left, the title "
+		"centred. The colours are the system's window colours, so a theme "
+		"restyles it. Stacked windows share the bar as slices.",
+	"lic_url"			= "https://opensource.org/license/mit",
+	"lic_name"			= "MIT",
+	"support_url"		= "https://github.com/albanread/Prose",
+	float "version"		= 1.0
