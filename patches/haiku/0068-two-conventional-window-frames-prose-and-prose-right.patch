diff --git a/src/add-ons/decorators/ProseDecorator/ProseRightAddOn.cpp b/src/add-ons/decorators/ProseDecorator/ProseRightAddOn.cpp
new file mode 100644
index 0000000000..9c826e23f1
--- /dev/null
+++ b/src/add-ons/decorators/ProseDecorator/ProseRightAddOn.cpp
@@ -0,0 +1,39 @@
+/*
+ * Copyright 2026, the Prose project.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	The "Prose Right" decorator: buttons on the right, title at the left. */
+
+
+#include "ProseDecorator.h"
+
+#include <new>
+
+
+class ProseRightDecorAddOn : public DecorAddOn {
+public:
+								ProseRightDecorAddOn(image_id id,
+									const char* name)
+									:
+									DecorAddOn(id, name)
+								{
+								}
+
+protected:
+	virtual	Decorator*			_AllocateDecorator(DesktopSettings& settings,
+									BRect rect, Desktop* desktop)
+								{
+									return new (std::nothrow) ProseDecorator(
+										settings, rect, desktop,
+										ProseDecorator::BUTTONS_RIGHT);
+								}
+};
+
+
+extern "C" DecorAddOn*
+instantiate_decor_addon(image_id id, const char* name)
+{
+	return new (std::nothrow) ProseRightDecorAddOn(id, name);
+}
diff --git a/src/add-ons/decorators/ProseRightDecorator/Jamfile b/src/add-ons/decorators/ProseRightDecorator/Jamfile
new file mode 100644
index 0000000000..59a927e6c0
--- /dev/null
+++ b/src/add-ons/decorators/ProseRightDecorator/Jamfile
@@ -0,0 +1,28 @@
+SubDir HAIKU_TOP src add-ons decorators ProseRightDecorator ;
+
+# The same class as ProseDecorator, with the buttons at the other end; the
+# sources live there and are compiled again here under this directory's
+# grist, so the two add-ons never share an object.
+SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src add-ons decorators ProseDecorator ] ;
+UseHeaders [ FDirName $(HAIKU_TOP) src add-ons decorators ProseDecorator ] ;
+
+UseBuildFeatureHeaders freetype ;
+UseHeaders [ FDirName $(HAIKU_TOP) src servers app ] ;
+UseHeaders [ FDirName $(HAIKU_TOP) src servers app stackandtile ] ;
+UseHeaders [ FDirName $(HAIKU_TOP) src servers app decorator ] ;
+UseHeaders [ FDirName $(HAIKU_TOP) src servers app drawing ] ;
+UseHeaders [ FDirName $(HAIKU_TOP) src servers app drawing Painter ] ;
+UseHeaders [ FDirName $(HAIKU_TOP) src servers app font ] ;
+UsePrivateHeaders app shared interface graphics ;
+UseLibraryHeaders agg ;
+
+AddResources ProseRightDecorator : ProseRightDecorator.rdef ;
+
+Includes [ FGristFiles ProseDecorator.cpp ProseRightAddOn.cpp ]
+	: [ BuildFeatureAttribute freetype : headers ] ;
+
+Addon ProseRightDecorator :
+	ProseDecorator.cpp
+	ProseRightAddOn.cpp
+	: be <nogrist>app_server [ TargetLibstdc++ ] [ TargetLibsupc++ ]
+;
