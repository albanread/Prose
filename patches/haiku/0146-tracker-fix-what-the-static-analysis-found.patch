+/*!	Measures text like BPoseView does, for the callers that have no pose
+	view and only want the value as text (SetupEditing() of the rating and
+	checkbox columns).
+*/
+class PlainFontMeasure {
+public:
+	float StringWidth(const char* string) const
+	{
+		return StringWidth(string, (int32)strlen(string));
+	}
+
+	float StringWidth(const char* string, int32 length) const
+	{
+		return BPrivate::gWidthBuffer->StringWidth(string, 0, length,
+			be_plain_font);
+	}
+
+	void GetFont(BFont* font) const
+	{
+		*font = *be_plain_font;
+	}
+};
+
+
+static const PlainFontMeasure sPlainFontMeasure;
+
+
 float
 WidgetAttributeText::TruncString(BString* outString, const char* inString,
 	int32 length, const BPoseView* view, float width, uint32 truncMode)
 {
+	if (view == NULL) {
+		return TruncStringBase(outString, inString, length,
+			&sPlainFontMeasure, width, truncMode);
+	}
+
 	return TruncStringBase(outString, inString, length, view, width, truncMode);
 }
 
