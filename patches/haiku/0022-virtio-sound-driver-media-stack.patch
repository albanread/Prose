+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * prose_tone [seconds] [hertz]: plays a sine wave through the Media Kit
+ * (BSoundPlayer -> system mixer -> hmulti_audio -> the sound device), so the
+ * audio path can be verified without a media player in the image.
+ */
+
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <Application.h>
+#include <SoundPlayer.h>
+
+
+static float sPhase = 0;
+static float sHertz = 440;
+static int64 sFramesFilled = 0;
+
+
+static void
+fill_buffer(void* cookie, void* buffer, size_t size, const media_raw_audio_format& format)
+{
+	size_t frames = size / (format.channel_count * sizeof(float));
+	float* out = (float*)buffer;
+	float step = 2 * M_PI * sHertz / format.frame_rate;
+	for (size_t i = 0; i < frames; i++) {
+		float sample = sinf(sPhase) * 0.4f;
+		for (uint32 c = 0; c < format.channel_count; c++)
+			*out++ = sample;
+		sPhase += step;
+		if (sPhase > 2 * M_PI)
+			sPhase -= 2 * M_PI;
+	}
+	sFramesFilled += frames;
+}
+
+
+int
+main(int argc, char** argv)
+{
+	int seconds = argc > 1 ? atoi(argv[1]) : 3;
+	if (argc > 2)
+		sHertz = atof(argv[2]);
+
+	BApplication app("application/x-vnd.prose-tone");
+
+	media_raw_audio_format format = media_raw_audio_format::wildcard;
+	format.frame_rate = 48000;
+	format.channel_count = 2;
+	format.format = media_raw_audio_format::B_AUDIO_FLOAT;
+	format.byte_order = B_MEDIA_HOST_ENDIAN;
+	format.buffer_size = 4096;
+
+	BSoundPlayer player(&format, "prose_tone", fill_buffer);
+	status_t status = player.InitCheck();
+	printf("prose_tone: player init: %s\n", strerror(status));
+	if (status != B_OK)
+		return 1;
+	media_raw_audio_format got = player.Format();
+	printf("prose_tone: format %g Hz, %u channels, format %#x, buffer %u bytes, latency %"
+		B_PRIdBIGTIME " us\n", got.frame_rate, (unsigned)got.channel_count, (unsigned)got.format,
+		(unsigned)got.buffer_size, player.Latency());
+
+	player.SetVolume(1.0f);
+	player.Start();
+	player.SetHasData(true);
+	snooze((bigtime_t)seconds * 1000000);
+	player.SetHasData(false);
+	player.Stop();
+	printf("prose_tone: played %d s of %g Hz: %" B_PRId64 " frames filled\n", seconds, sHertz,
+		sFramesFilled);
+	return 0;
+}
