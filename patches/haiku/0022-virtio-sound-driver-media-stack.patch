+/*!	Finds the first output stream and what it can do. */
+static status_t
+snd_query_streams(snd_info* info)
+{
+	uint32 count = min_c(info->config.streams, (uint32)MAX_STREAMS);
+	if (count == 0)
+		return B_DEVICE_NOT_FOUND;
+
+	virtio_snd_query_info request = {};
+	request.hdr.code = VIRTIO_SND_R_PCM_INFO;
+	request.start_id = 0;
+	request.count = count;
+	request.size = sizeof(virtio_snd_pcm_info);
+
+	struct {
+		virtio_snd_hdr hdr;
+		virtio_snd_pcm_info info[MAX_STREAMS];
+	} _PACKED response;
+	memset(&response, 0, sizeof(response));
+	status_t status = snd_command(info, &request, sizeof(request), &response,
+		sizeof(virtio_snd_hdr) + count * sizeof(virtio_snd_pcm_info));
+	if (status != B_OK)
+		return status;
+
+	for (uint32 i = 0; i < count; i++) {
+		const virtio_snd_pcm_info& pcm = response.info[i];
+		INFO("stream %" B_PRIu32 ": %s, %u-%u channels, formats %#" B_PRIx64 ", rates %#"
+			B_PRIx64 "\n", i, pcm.direction == VIRTIO_SND_D_OUTPUT ? "output" : "input",
+			pcm.channels_min, pcm.channels_max, pcm.formats, pcm.rates);
+		if (pcm.direction == VIRTIO_SND_D_OUTPUT && !info->playback.present
+			&& pcm.channels_min <= CHANNELS && pcm.channels_max >= CHANNELS
+			&& (pcm.formats & (1ULL << VIRTIO_SND_PCM_FMT_S16)) != 0) {
+			info->playback.present = true;
+			info->playback.id = i;
+			info->playback.formats = pcm.formats;
+			info->playback.rates = pcm.rates;
+			info->playback.channelsMin = pcm.channels_min;
+			info->playback.channelsMax = pcm.channels_max;
+		}
+	}
+	if (!info->playback.present) {
+		ERROR("no stereo S16 output stream\n");
+		return B_DEVICE_NOT_FOUND;
+	}
+	if ((info->playback.rates & (1ULL << VIRTIO_SND_PCM_RATE_48000)) != 0) {
+		info->rate = B_SR_48000;
+		info->rateHz = 48000;
+		info->virtioRate = VIRTIO_SND_PCM_RATE_48000;
+	} else if ((info->playback.rates & (1ULL << VIRTIO_SND_PCM_RATE_44100)) != 0) {
+		info->rate = B_SR_44100;
+		info->rateHz = 44100;
+		info->virtioRate = VIRTIO_SND_PCM_RATE_44100;
+	} else {
+		ERROR("output stream offers neither 48 nor 44.1 kHz\n");
+		return B_DEVICE_NOT_FOUND;
+	}
+	info->format = B_FMT_16BIT;
+	return B_OK;
+}
