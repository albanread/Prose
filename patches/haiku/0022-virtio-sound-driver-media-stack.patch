+//	#pragma mark - playback (txq)
+
+
+static void
+snd_tx_callback(void* driverCookie, void* cookie)
+{
+	snd_info* info = (snd_info*)cookie;
+	playback_stream& stream = info->playback;
+	void* tag;
+	uint32 length;
+	while (info->virtio->queue_dequeue(info->queues[VIRTIO_SND_VQ_TX], &tag, &length)) {
+		uint32 index = (uint32)(addr_t)tag - 1;
+		if (index >= stream.bufferCount)
+			continue;
+		virtio_snd_pcm_status* status = (virtio_snd_pcm_status*)(info->cmd + XFER_OFFSET
+			+ index * XFER_STRIDE + 8);
+		InterruptsSpinLocker locker(stream.lock);
+		if (status->status != VIRTIO_SND_S_OK)
+			stream.ioErrors++;
+		stream.latencyBytes = status->latency_bytes;
+		stream.framesCount += stream.frames;
+		stream.realTime = system_time();
+		uint32 slot = stream.completedHead % MAX_BUFFERS;
+		stream.completed[slot] = index;
+		stream.completedTime[slot] = stream.realTime;
+		stream.completedFrames[slot] = stream.framesCount;
+		stream.completedHead++;
+		locker.Unlock();
+		release_sem_etc(stream.readySem, 1, B_DO_NOT_RESCHEDULE);
+	}
+}
+
+
+static status_t
+snd_submit(snd_info* info, uint32 index)
+{
+	playback_stream& stream = info->playback;
+	virtio_snd_pcm_xfer* xfer = (virtio_snd_pcm_xfer*)(info->cmd + XFER_OFFSET
+		+ index * XFER_STRIDE);
+	xfer->stream_id = stream.id;
+	physical_entry entries[3] = {
+		{ info->cmdPhys + XFER_OFFSET + index * XFER_STRIDE, sizeof(virtio_snd_pcm_xfer) },
+		{ stream.phys + index * stream.bufferBytes, stream.bufferBytes },
+		{ info->cmdPhys + XFER_OFFSET + index * XFER_STRIDE + 8, sizeof(virtio_snd_pcm_status) },
+	};
+	status_t status = info->virtio->queue_request_v(info->queues[VIRTIO_SND_VQ_TX], entries, 2, 1,
+		(void*)(addr_t)(index + 1));
+	if (status != B_OK)
+		ERROR("submitting buffer %" B_PRIu32 " failed: %s\n", index, strerror(status));
+	else
+		stream.submitted++;
+	return status;
+}
+
+
+static status_t
+snd_pcm_start(snd_info* info)
+{
+	playback_stream& stream = info->playback;
+
+	virtio_snd_pcm_set_params params = {};
+	params.hdr.hdr.code = VIRTIO_SND_R_PCM_SET_PARAMS;
+	params.hdr.stream_id = stream.id;
+	params.buffer_bytes = stream.bufferCount * stream.bufferBytes;
+	params.period_bytes = stream.bufferBytes;
+	params.features = 0;
+	params.channels = CHANNELS;
+	params.format = VIRTIO_SND_PCM_FMT_S16;
+	params.rate = info->virtioRate;
+	virtio_snd_hdr response = {};
+	status_t status = snd_command(info, &params, sizeof(params), &response, sizeof(response));
+	if (status != B_OK)
+		return status;
+	status = snd_pcm_request(info, VIRTIO_SND_R_PCM_PREPARE);
+	if (status != B_OK)
+		return status;
+	stream.prepared = true;
+
+	memset(stream.buffers, 0, stream.bufferCount * stream.bufferBytes);
+	{
+		InterruptsSpinLocker locker(stream.lock);
+		stream.completedHead = stream.completedTail = 0;
+		stream.framesCount = 0;
+		stream.realTime = system_time();
+	}
+	stream.toSubmit = -1;
+	for (uint32 i = 0; i < stream.bufferCount; i++) {
+		status = snd_submit(info, i);
+		if (status != B_OK)
+			return status;
+	}
+	status = snd_pcm_request(info, VIRTIO_SND_R_PCM_START);
+	if (status != B_OK)
+		return status;
+	stream.anchorTime = system_time();
+	stream.anchorExchanges = 0;
+	stream.reanchors = 0;
+	stream.maxLag = 0;
+	stream.running = true;
+	INFO("playback started: %" B_PRIu32 " buffers of %" B_PRIu32 " frames, %" B_PRIu32 " Hz\n",
+		stream.bufferCount, stream.frames, info->rateHz);
+	return B_OK;
+}
+
+
+static void
+snd_pcm_stop(snd_info* info)
+{
+	playback_stream& stream = info->playback;
+	if (stream.running)
+		snd_pcm_request(info, VIRTIO_SND_R_PCM_STOP);
+	if (stream.prepared)
+		snd_pcm_request(info, VIRTIO_SND_R_PCM_RELEASE);
+	if (stream.running || stream.prepared) {
+		INFO("playback stopped: %" B_PRIu32 " buffers submitted, %" B_PRIu32 " exchanges, %"
+			B_PRIu32 " I/O errors, %" B_PRIu32 " xruns, %" B_PRIu32 " re-anchors, device lag up to %"
+			B_PRIdBIGTIME " us\n", stream.submitted, stream.exchanges, stream.ioErrors,
+			stream.xruns, stream.reanchors, stream.maxLag);
+	}
+	stream.running = false;
+	stream.prepared = false;
+	// the device returns whatever was still queued; those completions are stale
+	snooze(20000);
+	InterruptsSpinLocker locker(stream.lock);
+	stream.completedHead = stream.completedTail = 0;
+	stream.toSubmit = -1;
+}
+
+
+static void
+snd_free_buffers(snd_info* info)
+{
+	playback_stream& stream = info->playback;
+	if (stream.area >= 0) {
+		delete_area(stream.area);
+		stream.area = -1;
+		stream.buffers = NULL;
+	}
+	if (stream.readySem >= 0) {
+		delete_sem(stream.readySem);
+		stream.readySem = -1;
+	}
+}
+
+
+//	#pragma mark - Multi Audio API
+
+
+static status_t
+get_description(snd_info* info, multi_description* data)
+{
+	multi_description description;
+	if (user_memcpy(&description, data, sizeof(multi_description)) != B_OK)
+		return B_BAD_ADDRESS;
+
+	description.interface_version = B_CURRENT_INTERFACE_VERSION;
+	description.interface_minimum = B_CURRENT_INTERFACE_VERSION;
+	strlcpy(description.friendly_name, "Virtio Sound", sizeof(description.friendly_name));
+	strlcpy(description.vendor_info, "virtio", sizeof(description.vendor_info));
+	description.output_channel_count = 2;
+	description.input_channel_count = 0;
+	description.output_bus_channel_count = 2;
+	description.input_bus_channel_count = 0;
+	description.aux_bus_channel_count = 0;
+	description.output_rates = info->rate;
+	description.input_rates = 0;
+	description.max_cvsr_rate = 0;
+	description.min_cvsr_rate = 0;
+	description.output_formats = B_FMT_16BIT;
+	description.input_formats = 0;
+	description.lock_sources = B_MULTI_LOCK_INTERNAL;
+	description.timecode_sources = 0;
+	description.interface_flags = B_MULTI_INTERFACE_PLAYBACK;
+	description.start_latency = 30000;
+	strcpy(description.control_panel, "");
+
+	if (user_memcpy(data, &description, sizeof(multi_description)) != B_OK)
+		return B_BAD_ADDRESS;
+	if ((size_t)description.request_channel_count >= B_COUNT_OF(sChannels)) {
+		if (user_memcpy(description.channels, sChannels, sizeof(sChannels)) != B_OK)
+			return B_BAD_ADDRESS;
+	}
+	return B_OK;
+}
+
+
+static status_t
+get_enabled_channels(snd_info* info, multi_channel_enable* data)
+{
+	multi_channel_enable enable;
+	if (user_memcpy(&enable, data, sizeof(enable)) != B_OK)
+		return B_BAD_ADDRESS;
+	uint8 bits = 0x3;		// both output channels, always
+	if (user_memcpy(enable.enable_bits, &bits, sizeof(bits)) != B_OK)
+		return B_BAD_ADDRESS;
+	enable.lock_source = B_MULTI_LOCK_INTERNAL;
+	if (user_memcpy(data, &enable, sizeof(enable)) != B_OK)
+		return B_BAD_ADDRESS;
+	return B_OK;
+}
+
+
+static status_t
+get_global_format(snd_info* info, multi_format_info* data)
+{
+	multi_format_info format;
+	if (user_memcpy(&format, data, sizeof(format)) != B_OK)
+		return B_BAD_ADDRESS;
+	format.output_latency = 30000;
+	format.input_latency = 0;
+	format.timecode_kind = 0;
+	format.output.format = B_FMT_16BIT;
+	format.output.rate = info->rate;
+	format.output.cvsr = info->rateHz;
+	format.input.format = 0;
+	format.input.rate = 0;
+	format.input.cvsr = 0;
+	if (user_memcpy(data, &format, sizeof(format)) != B_OK)
+		return B_BAD_ADDRESS;
+	return B_OK;
+}
+
+
+static status_t
+set_global_format(snd_info* info, multi_format_info* data)
+{
+	multi_format_info format;
+	if (user_memcpy(&format, data, sizeof(format)) != B_OK)
+		return B_BAD_ADDRESS;
+	// only what the device does: stereo 16-bit at the rate we picked
+	if (format.output.format != 0 && format.output.format != B_FMT_16BIT)
+		return B_BAD_VALUE;
+	if (format.output.rate != 0 && format.output.rate != info->rate)
+		return B_BAD_VALUE;
+	return B_OK;
+}
+
+
+static status_t
+list_mix_controls(snd_info* info, multi_mix_control_info* data)
+{
+	multi_mix_control_info controlInfo;
+	if (user_memcpy(&controlInfo, data, sizeof(controlInfo)) != B_OK)
+		return B_BAD_ADDRESS;
+	multi_mix_control group;
+	memset(&group, 0, sizeof(group));
+	group.id = MULTI_AUDIO_BASE_ID;
+	group.parent = 0;
+	group.flags = B_MULTI_MIX_GROUP;
+	group.master = MULTI_AUDIO_MASTER_ID;
+	group.string = S_null;
+	strlcpy(group.name, "Playback", sizeof(group.name));
+	if (controlInfo.control_count >= 1
+		&& user_memcpy(controlInfo.controls, &group, sizeof(group)) != B_OK)
+		return B_BAD_ADDRESS;
+	controlInfo.control_count = 1;
+	if (user_memcpy(data, &controlInfo, sizeof(controlInfo)) != B_OK)
+		return B_BAD_ADDRESS;
+	return B_OK;
+}
+
+
+static status_t
+get_buffers(snd_info* info, multi_buffer_list* data)
+{
+	playback_stream& stream = info->playback;
+	multi_buffer_list list;
+	if (user_memcpy(&list, data, sizeof(list)) != B_OK)
+		return B_BAD_ADDRESS;
+
+	if (stream.running)
+		snd_pcm_stop(info);
+	snd_free_buffers(info);
+
+	int32 count = list.request_playback_buffers;
+	if (count < MIN_BUFFERS || count > MAX_BUFFERS)
+		count = MAX_BUFFERS;
+	uint32 frames = list.request_playback_buffer_size;
+	if (frames == 0)
+		frames = DEFAULT_FRAMES;
+	if (frames > MAX_FRAMES)
+		frames = MAX_FRAMES;
+	frames &= ~(uint32)7;
+
+	stream.bufferCount = count;
+	stream.frames = frames;
+	stream.bufferBytes = frames * CHANNELS * SAMPLE_BYTES;
+	size_t size = ROUNDUP((size_t)stream.bufferCount * stream.bufferBytes, B_PAGE_SIZE);
+	// the mixer writes straight into these, so they are user accessible
+	stream.area = create_area("virtio_sound playback", (void**)&stream.buffers,
+		B_ANY_KERNEL_ADDRESS, size, B_CONTIGUOUS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA | B_READ_AREA | B_WRITE_AREA);
+	if (stream.area < 0) {
+		ERROR("creating the playback buffers failed: %s\n", strerror(stream.area));
+		return stream.area;
+	}
+	physical_entry entry;
+	status_t status = get_memory_map(stream.buffers, size, &entry, 1);
+	if (status != B_OK) {
+		snd_free_buffers(info);
+		return status;
+	}
+	stream.phys = entry.address;
+	memset(stream.buffers, 0, size);
+	stream.readySem = create_sem(0, "virtio_sound playback");
+	if (stream.readySem < 0) {
+		status = stream.readySem;
+		snd_free_buffers(info);
+		return status;
+	}
+	stream.toSubmit = -1;
+	stream.exchanges = 0;
+	stream.submitted = 0;
+
+	list.flags = 0;
+	list.return_playback_buffers = count;
+	list.return_playback_channels = CHANNELS;
+	list.return_playback_buffer_size = frames;
+	list.return_record_buffers = 0;
+	list.return_record_channels = 0;
+	list.return_record_buffer_size = 0;
+	for (int32 b = 0; b < count; b++) {
+		buffer_desc* row;
+		if (user_memcpy(&row, list.playback_buffers + b, sizeof(row)) != B_OK)
+			return B_BAD_ADDRESS;
+		for (int32 c = 0; c < CHANNELS; c++) {
+			buffer_desc desc;
+			memset(&desc, 0, sizeof(desc));
+			desc.base = (char*)stream.buffers + b * stream.bufferBytes + c * SAMPLE_BYTES;
+			desc.stride = CHANNELS * SAMPLE_BYTES;
+			if (user_memcpy(row + c, &desc, sizeof(desc)) != B_OK)
+				return B_BAD_ADDRESS;
+		}
+	}
+	if (user_memcpy(data, &list, sizeof(list)) != B_OK)
+		return B_BAD_ADDRESS;
+	INFO("buffers: %" B_PRId32 " x %" B_PRIu32 " frames (%" B_PRIu32 " bytes each)\n", count,
+		frames, stream.bufferBytes);
+	return B_OK;
+}
+
+
+/*!	Blocks until the device has finished a buffer, then reports that buffer as
+	the one to fill: the node fills (playback_buffer_cycle - 1) % count, and we
+	send it out at the next exchange.
+*/
+static status_t
+buffer_exchange(snd_info* info, multi_buffer_info* data)
+{
+	playback_stream& stream = info->playback;
+	multi_buffer_info bufferInfo;
+	if (user_memcpy(&bufferInfo, data, sizeof(bufferInfo)) != B_OK)
+		return B_BAD_ADDRESS;
+	if (stream.area < 0)
+		return B_NO_INIT;
+
+	if (!stream.running) {
+		status_t status = snd_pcm_start(info);
+		if (status != B_OK)
+			return status;
+	} else if (stream.toSubmit >= 0) {
+		snd_submit(info, stream.toSubmit);
+		stream.toSubmit = -1;
+	}
+
+	status_t status = acquire_sem_etc(stream.readySem, 1, B_RELATIVE_TIMEOUT | B_CAN_INTERRUPT,
+		2000000);
+	if (status != B_OK) {
+		if (status != B_INTERRUPTED)
+			ERROR("no buffer completed in 2 s: %s\n", strerror(status));
+		return status;
+	}
+
+	InterruptsSpinLocker locker(stream.lock);
+	uint32 slot = stream.completedTail % MAX_BUFFERS;
+	uint32 done = stream.completed[slot];
+	bigtime_t completedAt = stream.completedTime[slot];
+	stream.completedTail++;
+	locker.Unlock();
+
+	// The host consumes our buffers in bursts of its own audio period, and the
+	// mixer's node only survives a regular cadence: hand buffers out on a steady
+	// schedule derived from the sample rate, anchored to the device's clock and
+	// re-anchored only when the device falls a whole period behind. The device's
+	// completions gate the schedule (a buffer is never handed out before the
+	// device has finished with it); they do not drive it.
+	const bigtime_t period = (bigtime_t)stream.frames * 1000000 / info->rateHz;
+	const uint32 k = stream.exchanges - stream.anchorExchanges + 1;
+	bigtime_t scheduled = stream.anchorTime + (bigtime_t)k * stream.frames * 1000000 / info->rateHz;
+	bigtime_t now = system_time();
+	if (now + 500 < scheduled) {
+		snooze_until(scheduled, B_SYSTEM_TIMEBASE);
+	} else if (now > scheduled + period) {
+		// behind by a period (the device stalled, or we did): restart the schedule here
+		stream.anchorTime = now;
+		stream.anchorExchanges = stream.exchanges + 1;
+		stream.reanchors++;
+		scheduled = now;
+	}
+	if (completedAt > scheduled && completedAt - scheduled > stream.maxLag)
+		stream.maxLag = completedAt - scheduled;
+
+	bufferInfo.playback_buffer_cycle = (done + 1) % stream.bufferCount;
+	bufferInfo.played_real_time = scheduled;
+	bufferInfo.played_frames_count = (int64)(stream.exchanges + 1) * stream.frames;
+	bufferInfo.record_buffer_cycle = 0;
+	bufferInfo.recorded_real_time = 0;
+	bufferInfo.recorded_frames_count = 0;
+	stream.toSubmit = done;
+	stream.exchanges++;
+	if (stream.exchanges % 5000 == 0) {
+		INFO("%" B_PRIu32 " exchanges, latency %" B_PRIu32 " bytes, %" B_PRIu32 " I/O errors, %"
+			B_PRIu32 " xruns, %" B_PRIu32 " re-anchors, device lag up to %" B_PRIdBIGTIME " us\n",
+			stream.exchanges, stream.latencyBytes, stream.ioErrors, stream.xruns, stream.reanchors,
+			stream.maxLag);
+	}
+
+	if (user_memcpy(data, &bufferInfo, sizeof(bufferInfo)) != B_OK)
+		return B_BAD_ADDRESS;
+	return B_OK;
+}
+
+
+static status_t
+buffer_force_stop(snd_info* info)
+{
+	// The node still writes silence into the buffers after this (its
+	// _StopOutputThread), so they stay mapped until the next GET_BUFFERS
+	// or the last close.
+	snd_pcm_stop(info);
+	return B_OK;
+}
 
+
+static status_t
+multi_audio_control(snd_info* info, uint32 op, void* arg, size_t length)
+{
+	switch (op) {
+		case B_MULTI_GET_DESCRIPTION:
+			return get_description(info, (multi_description*)arg);
+		case B_MULTI_GET_EVENT_INFO:
+		case B_MULTI_SET_EVENT_INFO:
+		case B_MULTI_GET_EVENT:
+			return B_ERROR;
+		case B_MULTI_GET_ENABLED_CHANNELS:
+			return get_enabled_channels(info, (multi_channel_enable*)arg);
+		case B_MULTI_SET_ENABLED_CHANNELS:
+			return B_OK;
+		case B_MULTI_GET_GLOBAL_FORMAT:
+			return get_global_format(info, (multi_format_info*)arg);
+		case B_MULTI_SET_GLOBAL_FORMAT:
+			return set_global_format(info, (multi_format_info*)arg);
+		case B_MULTI_GET_CHANNEL_FORMATS:
+		case B_MULTI_SET_CHANNEL_FORMATS:
+		case B_MULTI_GET_MIX:
+		case B_MULTI_SET_MIX:
+		case B_MULTI_LIST_MIX_CHANNELS:
+		case B_MULTI_LIST_MIX_CONNECTIONS:
+			return B_ERROR;
+		case B_MULTI_LIST_MIX_CONTROLS:
+			return list_mix_controls(info, (multi_mix_control_info*)arg);
+		case B_MULTI_GET_BUFFERS:
+			return get_buffers(info, (multi_buffer_list*)arg);
+		case B_MULTI_SET_BUFFERS:
+		case B_MULTI_SET_START_TIME:
+			return B_ERROR;
+		case B_MULTI_BUFFER_EXCHANGE:
+			return buffer_exchange(info, (multi_buffer_info*)arg);
+		case B_MULTI_BUFFER_FORCE_STOP:
+			return buffer_force_stop(info);
+		case B_MULTI_LIST_EXTENSIONS:
+		case B_MULTI_GET_EXTENSION:
+		case B_MULTI_SET_EXTENSION:
+		case B_MULTI_LIST_MODES:
+		case B_MULTI_GET_MODE:
+		case B_MULTI_SET_MODE:
+			return B_ERROR;
+	}
+	return B_DEV_INVALID_IOCTL;
+}
