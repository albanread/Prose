+/*!	Sends one control request and waits for its response. */
+static status_t
+snd_command(snd_info* info, const void* request, size_t requestSize, void* response,
+	size_t responseSize)
+{
+	MutexLocker locker(info->cmdLock);
+
+	memcpy(info->cmd + REQUEST_OFFSET, request, requestSize);
+	memset(info->cmd + RESPONSE_OFFSET, 0, responseSize);
+	physical_entry entries[2] = {
+		{ info->cmdPhys + REQUEST_OFFSET, requestSize },
+		{ info->cmdPhys + RESPONSE_OFFSET, responseSize },
+	};
+	uint32 code = ((const virtio_snd_hdr*)request)->code;
+	status_t status = info->virtio->queue_request_v(info->queues[VIRTIO_SND_VQ_CONTROL],
+		entries, 1, 1, NULL);
+	if (status != B_OK)
+		return status;
+	status = acquire_sem_etc(info->cmdDone, 1, B_RELATIVE_TIMEOUT, 5000000);
+	if (status != B_OK) {
+		ERROR("request %#" B_PRIx32 " timed out\n", code);
+		return status;
+	}
+	while (!info->virtio->queue_dequeue(info->queues[VIRTIO_SND_VQ_CONTROL], NULL, NULL))
+		spin(10);
+
+	memcpy(response, info->cmd + RESPONSE_OFFSET, responseSize);
+	uint32 result = ((virtio_snd_hdr*)response)->code;
+	if (result != VIRTIO_SND_S_OK) {
+		ERROR("request %#" B_PRIx32 " failed: %#" B_PRIx32 "\n", code, result);
+		return B_ERROR;
+	}
+	return B_OK;
+}
