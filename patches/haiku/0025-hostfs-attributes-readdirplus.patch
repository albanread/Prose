+++ b/src/add-ons/kernel/file_systems/hostfs/Jamfile
@@ -1,9 +1,14 @@
 SubDir HAIKU_TOP src add-ons kernel file_systems hostfs ;
 
 UsePrivateKernelHeaders ;
-UsePrivateHeaders shared storage virtio ;
+UsePrivateHeaders shared storage file_systems virtio ;
 
 KernelAddon hostfs :
+	attributes.cpp
 	kernel_interface.cpp
 	Volume.cpp
+	mime_ext_table.c
 ;
+
+SEARCH on [ FGristFiles mime_ext_table.c ]
+	+= [ FDirName $(HAIKU_TOP) src add-ons kernel file_systems shared ] ;
