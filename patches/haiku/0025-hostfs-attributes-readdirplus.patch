-/*!	Must be called with the lock held. Takes \a node out of the table if
-	nothing needs it any more -- and then its parent, if that was all that kept
-	the parent -- and prepends them to \a reclaimList for _Reclaim().
+/*!	Must be called with the lock held. The node is in use again: out of the
+	idle list.
+*/
+void
+Volume::_Busy(Node* node)
+{
+	if (node->idle) {
+		fIdleNodes.Remove(node);
+		node->idle = false;
+		fIdleCount--;
+	}
+}
+
+
+/*!	Must be called with the lock held. If nothing needs \a node any more, it
+	becomes idle: it stays in the table, with its lookups, until the idle list
+	grows past HOSTFS_MAX_IDLE_NODES. Nodes that fall off the end are prepended
+	to \a reclaimList for _Reclaim().
 */
 void
 Volume::_Collect(Node* node, Node*& reclaimList)
 {
-	while (node != NULL && node->nodeid != FUSE_ROOT_ID && !node->published
-		&& node->pending == 0 && node->children == 0) {
+	if (node == NULL || node->nodeid == FUSE_ROOT_ID || node->published
+		|| node->pending > 0 || node->children > 0 || node->idle) {
+		return;
+	}
+	fIdleNodes.Add(node);
+	node->idle = true;
+	fIdleCount++;
+	_TrimIdle(HOSTFS_MAX_IDLE_NODES, reclaimList);
+}
+
+
+/*!	Must be called with the lock held. Takes the oldest idle nodes out of the
+	table until at most \a keep are left. A directory whose last child goes
+	becomes idle itself.
+*/
+void
+Volume::_TrimIdle(int32 keep, Node*& reclaimList)
+{
+	while (fIdleCount > keep) {
+		Node* node = fIdleNodes.RemoveHead();
+		node->idle = false;
+		fIdleCount--;
 		fNodes.Remove(node);
 		Node* parent = node->parent != 0 ? fNodes.Lookup(node->parent) : NULL;
-		if (parent != NULL)
-			parent->children--;
 		node->hashLink = reclaimList;
 		reclaimList = node;
-		node = parent;
+		if (parent != NULL && --parent->children == 0 && parent->nodeid != FUSE_ROOT_ID
+			&& !parent->published && parent->pending == 0 && !parent->idle) {
+			fIdleNodes.Add(parent);
+			parent->idle = true;
+			fIdleCount++;
+		}
 	}
 }
 
diff --git a/src/add-ons/kernel/file_systems/hostfs/attributes.cpp b/src/add-ons/kernel/file_systems/hostfs/attributes.cpp
new file mode 100644
index 0000000000..35dbba8dea
--- /dev/null
+++ b/src/add-ons/kernel/file_systems/hostfs/attributes.cpp
@@ -0,0 +1,722 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * HostFS attributes. A Haiku attribute is a host extended attribute named
+ * "user.haiku.<name>" whose value is the attribute's type code (uint32,
+ * little endian) followed by its data -- the convention Haiku's own build
+ * tools use on the host (src/build/libroot/fs_attr_untyped.cpp), so
+ * attributes they wrote show up, and ours survive on the Mac. In names, '/'
+ * is written as "%\" and '%' as "%%".
+ *
+ * Files without a stored BEOS:TYPE get one from their extension, like on FAT,
+ * so Tracker shows the right icons and opens the right application without
+ * writing anything to the host.
+ */
+
+
+#include "hostfs.h"
+
+#include <ByteOrder.h>
+#include <dirent.h>
+#include <new>
+#include <stdlib.h>
+#include <string.h>
+
+#include <fs_attr.h>
+#include <kernel.h>
+#include <NodeMonitor.h>
+#include <TypeConstants.h>
+#include <util/AutoLock.h>
+#include <AutoDeleter.h>
+
+#include <file_systems/mime_ext_table.h>
+
+
+#define XATTR_PREFIX			"user.haiku."
+#define XATTR_PREFIX_LENGTH		(sizeof(XATTR_PREFIX) - 1)
+#define TYPE_HEADER_SIZE		sizeof(uint32)
+#define MAX_XATTR_NAME			255
+#define MIME_TYPE_ATTRIBUTE		"BEOS:TYPE"
+#define FALLBACK_MIME_TYPE		"application/octet-stream"
+
+// setxattr(2) flags as Linux numbers them
+#define LINUX_XATTR_CREATE		1
+
+
+struct AttrCookie {
+	char		name[B_ATTR_NAME_LENGTH];
+	uint32		type;
+	int			openMode;
+	bool		emulated;	// BEOS:TYPE from the file name
+};
+
+
+struct AttrDirCookie {
+	char*		names;		// NUL-separated attribute names
+	size_t		length;
+	size_t		position;
+};
+
+
+static inline Volume*
+get_volume(fs_volume* volume)
+{
+	return (Volume*)volume->private_volume;
+}
+
+
+static inline Node*
+get_node(fs_vnode* vnode)
+{
+	return (Node*)vnode->private_node;
+}
+
+
+static status_t
+copy_out(void* to, const void* from, size_t size)
+{
+	if (IS_USER_ADDRESS(to))
+		return user_memcpy(to, from, size);
+	memcpy(to, from, size);
+	return B_OK;
+}
+
+
+static status_t
+copy_in(void* to, const void* from, size_t size)
+{
+	if (IS_USER_ADDRESS(from))
+		return user_memcpy(to, from, size);
+	memcpy(to, from, size);
+	return B_OK;
+}
+
+
+//	#pragma mark - names
+
+
+static status_t
+xattr_name_for(const char* attribute, char* buffer, size_t bufferSize)
+{
+	size_t length = strlcpy(buffer, XATTR_PREFIX, bufferSize);
+	for (const char* c = attribute; *c != '\0'; c++) {
+		const char* insert;
+		char single[2] = { *c, '\0' };
+		switch (*c) {
+			case '/':
+				insert = "%\\";
+				break;
+			case '%':
+				insert = "%%";
+				break;
+			default:
+				insert = single;
+				break;
+		}
+		size_t insertLength = strlen(insert);
+		if (length + insertLength >= bufferSize || length + insertLength > MAX_XATTR_NAME)
+			return B_NAME_TOO_LONG;
+		memcpy(buffer + length, insert, insertLength + 1);
+		length += insertLength;
+	}
+	return B_OK;
+}
+
+
+/*!	Returns the attribute name for an xattr name, or false if the xattr is
+	not one of ours.
+*/
+static bool
+attribute_name_for(const char* xattr, char* buffer, size_t bufferSize)
+{
+	if (strncmp(xattr, XATTR_PREFIX, XATTR_PREFIX_LENGTH) != 0)
+		return false;
+	size_t length = 0;
+	for (const char* c = xattr + XATTR_PREFIX_LENGTH; *c != '\0'; c++) {
+		char out = *c;
+		if (*c == '%' && (c[1] == '\\' || c[1] == '%')) {
+			out = c[1] == '\\' ? '/' : '%';
+			c++;
+		}
+		if (length + 1 >= bufferSize)
+			return false;
+		buffer[length++] = out;
+	}
+	buffer[length] = '\0';
+	return length > 0;
+}
+
+
+/*!	The MIME type the file's name implies, or NULL if the name says nothing
+	(no extension the table knows).
+*/
+static const char*
+emulated_mime_type(Volume* volume, Node* node)
+{
+	if (!node->IsFile())
+		return NULL;
+	char name[B_FILE_NAME_LENGTH];
+	if (!volume->GetName(node, name, sizeof(name)))
+		return NULL;
+	const char* mime = NULL;
+	set_mime(&mime, name);
+	if (mime == NULL || strcmp(mime, FALLBACK_MIME_TYPE) == 0)
+		return NULL;
+	return mime;
+}
+
+
+//	#pragma mark - xattr requests
+
+
+/*!	Reads the whole value of \a xattr into a new malloc()ed buffer. */
+static status_t
+read_xattr(Volume* volume, Node* node, const char* xattr, uint8** _value,
+	size_t* _length)
+{
+	for (int attempt = 0; attempt < 3; attempt++) {
+		fuse_getxattr_in in = {};
+		fuse_getxattr_out out;
+		status_t status = volume->Request(FUSE_GETXATTR, node->nodeid, &in, sizeof(in),
+			xattr, NULL, NULL, 0, &out, sizeof(out));
+		if (status != B_OK)
+			return status;
+		if (out.size > volume->MaxData())
+			return B_BUFFER_OVERFLOW;
+
+		uint8* value = (uint8*)malloc(max_c(out.size, 1u));
+		if (value == NULL)
+			return B_NO_MEMORY;
+		size_t length = 0;
+		if (out.size > 0) {
+			in.size = out.size;
+			status = volume->Request(FUSE_GETXATTR, node->nodeid, &in, sizeof(in), xattr,
+				NULL, NULL, 0, NULL, 0, value, out.size, &length);
+			if (status == ERANGE) {
+				// it grew in between
+				free(value);
+				continue;
+			}
+			if (status != B_OK) {
+				free(value);
+				return status;
+			}
+		}
+		*_value = value;
+		*_length = length;
+		return B_OK;
+	}
+	return B_BUSY;
+}
+
+
+static status_t
+write_xattr(Volume* volume, Node* node, const char* xattr, const void* value,
+	size_t length, uint32 flags)
+{
+	if (length > volume->MaxData())
+		return B_FILE_TOO_LARGE;
+	// without FUSE_SETXATTR_EXT the arguments are the 8-byte compat form
+	fuse_setxattr_in in = {};
+	in.size = length;
+	in.flags = flags;
+	return volume->Request(FUSE_SETXATTR, node->nodeid, &in, FUSE_COMPAT_SETXATTR_IN_SIZE,
+		xattr, NULL, value, length, NULL, 0);
+}
+
+
+/*!	Reads the attribute \a name: its type and a malloc()ed copy of its data. */
+static status_t
+read_attribute(Volume* volume, Node* node, const char* name, uint32* _type,
+	uint8** _data, size_t* _length)
+{
+	char xattr[MAX_XATTR_NAME + 1];
+	status_t status = xattr_name_for(name, xattr, sizeof(xattr));
+	if (status != B_OK)
+		return status;
+
+	uint8* value;
+	size_t length;
+	status = read_xattr(volume, node, xattr, &value, &length);
+	if (status != B_OK)
+		return status;
+
+	if (length < TYPE_HEADER_SIZE) {
+		// not written by Haiku: raw data
+		*_type = B_RAW_TYPE;
+		*_data = value;
+		*_length = length;
+		return B_OK;
+	}
+	uint32 type;
+	memcpy(&type, value, TYPE_HEADER_SIZE);
+	*_type = B_LENDIAN_TO_HOST_INT32(type);
+	memmove(value, value + TYPE_HEADER_SIZE, length - TYPE_HEADER_SIZE);
+	*_data = value;
+	*_length = length - TYPE_HEADER_SIZE;
+	return B_OK;
+}
+
+
+static status_t
+write_attribute(Volume* volume, Node* node, const char* name, uint32 type,
+	const void* data, size_t length, uint32 flags)
+{
+	char xattr[MAX_XATTR_NAME + 1];
+	status_t status = xattr_name_for(name, xattr, sizeof(xattr));
+	if (status != B_OK)
+		return status;
+
+	uint8* value = (uint8*)malloc(TYPE_HEADER_SIZE + length);
+	if (value == NULL)
+		return B_NO_MEMORY;
+	MemoryDeleter valueDeleter(value);
+	uint32 typeCode = B_HOST_TO_LENDIAN_INT32(type);
+	memcpy(value, &typeCode, TYPE_HEADER_SIZE);
+	if (length > 0)
+		memcpy(value + TYPE_HEADER_SIZE, data, length);
+	return write_xattr(volume, node, xattr, value, TYPE_HEADER_SIZE + length, flags);
+}
+
+
+//	#pragma mark - attribute directories
+
+
+status_t
+hostfs_open_attr_dir(fs_volume* _volume, fs_vnode* _node, void** _cookie)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+
+	AttrDirCookie* cookie = new(std::nothrow) AttrDirCookie;
+	if (cookie == NULL)
+		return B_NO_MEMORY;
+	ObjectDeleter<AttrDirCookie> cookieDeleter(cookie);
+	cookie->names = NULL;
+	cookie->length = 0;
+	cookie->position = 0;
+
+	// the host's list: every xattr name, NUL-separated
+	char* list = NULL;
+	size_t listLength = 0;
+	if (volume->SupportsXattrs()) {
+		fuse_getxattr_in in = {};
+		fuse_getxattr_out out;
+		status_t status = volume->Request(FUSE_LISTXATTR, node->nodeid, &in, sizeof(in),
+			NULL, NULL, NULL, 0, &out, sizeof(out));
+		if (status == B_OK && out.size > 0 && out.size <= volume->MaxData()) {
+			list = (char*)malloc(out.size);
+			if (list == NULL)
+				return B_NO_MEMORY;
+			in.size = out.size;
+			status = volume->Request(FUSE_LISTXATTR, node->nodeid, &in, sizeof(in), NULL,
+				NULL, NULL, 0, NULL, 0, list, out.size, &listLength);
+			if (status != B_OK)
+				listLength = 0;
+		}
+	}
+	MemoryDeleter listDeleter(list);
+
+	// keep ours, as attribute names, plus the emulated MIME type
+	size_t capacity = listLength + B_ATTR_NAME_LENGTH + 1;
+	cookie->names = (char*)malloc(capacity);
+	if (cookie->names == NULL)
+		return B_NO_MEMORY;
+	bool haveType = false;
+	for (size_t offset = 0; offset < listLength;) {
+		const char* xattr = list + offset;
+		size_t xattrLength = strnlen(xattr, listLength - offset);
+		offset += xattrLength + 1;
+		if (offset > listLength + 1)
+			break;
+		char name[B_ATTR_NAME_LENGTH];
+		char terminated[MAX_XATTR_NAME + 1];
+		strlcpy(terminated, xattr, min_c(xattrLength + 1, sizeof(terminated)));
+		if (!attribute_name_for(terminated, name, sizeof(name)))
+			continue;
+		if (strcmp(name, MIME_TYPE_ATTRIBUTE) == 0)
+			haveType = true;
+		size_t nameLength = strlen(name) + 1;
+		if (cookie->length + nameLength > capacity)
+			break;
+		memcpy(cookie->names + cookie->length, name, nameLength);
+		cookie->length += nameLength;
+	}
+	if (!haveType && emulated_mime_type(volume, node) != NULL
+		&& cookie->length + sizeof(MIME_TYPE_ATTRIBUTE) <= capacity) {
+		memcpy(cookie->names + cookie->length, MIME_TYPE_ATTRIBUTE,
+			sizeof(MIME_TYPE_ATTRIBUTE));
+		cookie->length += sizeof(MIME_TYPE_ATTRIBUTE);
+	}
+
+	*_cookie = cookieDeleter.Detach();
+	return B_OK;
+}
+
+
+status_t
+hostfs_close_attr_dir(fs_volume* _volume, fs_vnode* _node, void* _cookie)
+{
+	return B_OK;
+}
+
+
+status_t
+hostfs_free_attr_dir_cookie(fs_volume* _volume, fs_vnode* _node, void* _cookie)
+{
+	AttrDirCookie* cookie = (AttrDirCookie*)_cookie;
+	free(cookie->names);
+	delete cookie;
+	return B_OK;
+}
+
+
+status_t
+hostfs_read_attr_dir(fs_volume* _volume, fs_vnode* _node, void* _cookie,
+	struct dirent* buffer, size_t bufferSize, uint32* _num)
+{
+	Volume* volume = get_volume(_volume);
+	AttrDirCookie* cookie = (AttrDirCookie*)_cookie;
+
+	if (cookie->position >= cookie->length) {
+		*_num = 0;
+		return B_OK;
+	}
+	const char* name = cookie->names + cookie->position;
+	size_t nameLength = strlen(name);
+	size_t recordLength = offsetof(struct dirent, d_name) + nameLength + 1;
+	if (recordLength > bufferSize)
+		return B_BUFFER_OVERFLOW;
+
+	buffer->d_dev = volume->ID();
+	buffer->d_ino = -1;
+	memcpy(buffer->d_name, name, nameLength + 1);
+	buffer->d_reclen = recordLength;
+	cookie->position += nameLength + 1;
+	*_num = 1;
+	return B_OK;
+}
+
+
+status_t
+hostfs_rewind_attr_dir(fs_volume* _volume, fs_vnode* _node, void* _cookie)
+{
+	((AttrDirCookie*)_cookie)->position = 0;
+	return B_OK;
+}
+
+
+//	#pragma mark - attributes
+
+
+status_t
+hostfs_create_attr(fs_volume* _volume, fs_vnode* _node, const char* name, uint32 type,
+	int openMode, void** _cookie)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	if (volume->IsReadOnly())
+		return B_READ_ONLY_DEVICE;
+	if (!volume->SupportsXattrs())
+		return B_NOT_SUPPORTED;
+	if (strlen(name) >= B_ATTR_NAME_LENGTH)
+		return B_NAME_TOO_LONG;
+
+	AttrCookie* cookie = new(std::nothrow) AttrCookie;
+	if (cookie == NULL)
+		return B_NO_MEMORY;
+	ObjectDeleter<AttrCookie> cookieDeleter(cookie);
+	strlcpy(cookie->name, name, sizeof(cookie->name));
+	cookie->type = type;
+	cookie->openMode = openMode;
+	cookie->emulated = false;
+
+	uint32 oldType;
+	uint8* data;
+	size_t length;
+	status_t status = read_attribute(volume, node, name, &oldType, &data, &length);
+	if (status == B_OK) {
+		free(data);
+		if ((openMode & O_EXCL) != 0)
+			return B_FILE_EXISTS;
+		if ((openMode & O_TRUNC) == 0 && oldType == type) {
+			*_cookie = cookieDeleter.Detach();
+			return B_OK;
+		}
+	} else if (status != B_ENTRY_NOT_FOUND)
+		return status;
+
+	// new, truncated, or changing type: an empty value of the new type
+	status = write_attribute(volume, node, name, type, NULL, 0,
+		(openMode & O_EXCL) != 0 ? LINUX_XATTR_CREATE : 0);
+	if (status != B_OK)
+		return status;
+
+	notify_attribute_changed(volume->ID(), volume->ParentOf(node), node->nodeid, name,
+		B_ATTR_CREATED);
+	*_cookie = cookieDeleter.Detach();
+	return B_OK;
+}
+
+
+status_t
+hostfs_open_attr(fs_volume* _volume, fs_vnode* _node, const char* name, int openMode,
+	void** _cookie)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	const bool writable = (openMode & O_RWMASK) != O_RDONLY;
+	if (writable && volume->IsReadOnly())
+		return B_READ_ONLY_DEVICE;
+
+	AttrCookie* cookie = new(std::nothrow) AttrCookie;
+	if (cookie == NULL)
+		return B_NO_MEMORY;
+	ObjectDeleter<AttrCookie> cookieDeleter(cookie);
+	strlcpy(cookie->name, name, sizeof(cookie->name));
+	cookie->openMode = openMode;
+	cookie->emulated = false;
+
+	status_t status = B_ENTRY_NOT_FOUND;
+	if (volume->SupportsXattrs()) {
+		uint8* data;
+		size_t length;
+		status = read_attribute(volume, node, name, &cookie->type, &data, &length);
+		if (status == B_OK)
+			free(data);
+	}
+	if (status == B_ENTRY_NOT_FOUND && strcmp(name, MIME_TYPE_ATTRIBUTE) == 0
+		&& emulated_mime_type(volume, node) != NULL) {
+		cookie->type = B_MIME_STRING_TYPE;
+		cookie->emulated = true;
+		status = B_OK;
+	}
+	if (status != B_OK)
+		return status;
+	if (writable && cookie->emulated && !volume->SupportsXattrs())
+		return B_NOT_ALLOWED;
+
+	if (writable && (openMode & O_TRUNC) != 0) {
+		status = write_attribute(volume, node, name, cookie->type, NULL, 0, 0);
+		if (status != B_OK)
+			return status;
+		cookie->emulated = false;
+		notify_attribute_changed(volume->ID(), volume->ParentOf(node), node->nodeid,
+			name, B_ATTR_CHANGED);
+	}
+
+	*_cookie = cookieDeleter.Detach();
+	return B_OK;
+}
+
+
+status_t
+hostfs_close_attr(fs_volume* _volume, fs_vnode* _node, void* _cookie)
+{
+	return B_OK;
+}
+
+
+status_t
+hostfs_free_attr_cookie(fs_volume* _volume, fs_vnode* _node, void* _cookie)
+{
+	delete (AttrCookie*)_cookie;
+	return B_OK;
+}
+
+
+/*!	The attribute's current data, from the host or the file name. */
+static status_t
+attribute_data(Volume* volume, Node* node, AttrCookie* cookie, uint8** _data,
+	size_t* _length)
+{
+	if (!cookie->emulated) {
+		uint32 type;
+		status_t status = read_attribute(volume, node, cookie->name, &type, _data,
+			_length);
+		if (status != B_ENTRY_NOT_FOUND || strcmp(cookie->name, MIME_TYPE_ATTRIBUTE) != 0)
+			return status;
+	}
+	const char* mime = emulated_mime_type(volume, node);
+	if (mime == NULL)
+		return B_ENTRY_NOT_FOUND;
+	size_t length = strlen(mime) + 1;
+	*_data = (uint8*)strdup(mime);
+	if (*_data == NULL)
+		return B_NO_MEMORY;
+	*_length = length;
+	return B_OK;
+}
+
+
+status_t
+hostfs_read_attr(fs_volume* _volume, fs_vnode* _node, void* _cookie, off_t pos,
+	void* buffer, size_t* _length)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	AttrCookie* cookie = (AttrCookie*)_cookie;
+	if (pos < 0)
+		return B_BAD_VALUE;
+
+	uint8* data;
+	size_t length;
+	status_t status = attribute_data(volume, node, cookie, &data, &length);
+	if (status != B_OK)
+		return status;
+	MemoryDeleter dataDeleter(data);
+
+	if ((uint64)pos >= length) {
+		*_length = 0;
+		return B_OK;
+	}
+	size_t toCopy = min_c(*_length, length - (size_t)pos);
+	status = copy_out(buffer, data + pos, toCopy);
+	if (status != B_OK)
+		return status;
+	*_length = toCopy;
+	return B_OK;
+}
+
+
+status_t
+hostfs_write_attr(fs_volume* _volume, fs_vnode* _node, void* _cookie, off_t pos,
+	const void* buffer, size_t* _length)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	AttrCookie* cookie = (AttrCookie*)_cookie;
+	if (volume->IsReadOnly())
+		return B_READ_ONLY_DEVICE;
+	if (!volume->SupportsXattrs())
+		return B_NOT_SUPPORTED;
+	if ((cookie->openMode & O_RWMASK) == O_RDONLY)
+		return B_NOT_ALLOWED;
+	if (pos < 0 || (uint64)pos + *_length > volume->MaxData() - TYPE_HEADER_SIZE)
+		return B_FILE_TOO_LARGE;
+
+	// Attributes are small: read what is there, splice, write it all back.
+	uint8* old = NULL;
+	size_t oldLength = 0;
+	if (pos > 0 || !cookie->emulated) {
+		status_t status = attribute_data(volume, node, cookie, &old, &oldLength);
+		if (status != B_OK && status != B_ENTRY_NOT_FOUND)
+			return status;
+	}
+	MemoryDeleter oldDeleter(old);
+
+	size_t end = (size_t)pos + *_length;
+	size_t newLength = max_c(end, oldLength);
+	uint8* data = (uint8*)malloc(max_c(newLength, 1u));
+	if (data == NULL)
+		return B_NO_MEMORY;
+	MemoryDeleter dataDeleter(data);
+	memset(data, 0, newLength);
+	if (old != NULL)
+		memcpy(data, old, oldLength);
+	status_t status = copy_in(data + pos, buffer, *_length);
+	if (status != B_OK)
+		return status;
+
+	status = write_attribute(volume, node, cookie->name, cookie->type, data, newLength, 0);
+	if (status != B_OK)
+		return status;
+	cookie->emulated = false;
+
+	notify_attribute_changed(volume->ID(), volume->ParentOf(node), node->nodeid,
+		cookie->name, B_ATTR_CHANGED);
+	return B_OK;
+}
+
+
+status_t
+hostfs_read_attr_stat(fs_volume* _volume, fs_vnode* _node, void* _cookie,
+	struct stat* stat)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	AttrCookie* cookie = (AttrCookie*)_cookie;
+
+	uint8* data;
+	size_t length;
+	status_t status = attribute_data(volume, node, cookie, &data, &length);
+	if (status != B_OK)
+		return status;
+	free(data);
+
+	stat->st_size = length;
+	stat->st_type = cookie->type;
+	return B_OK;
+}
+
+
+status_t
+hostfs_remove_attr(fs_volume* _volume, fs_vnode* _node, const char* name)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	if (volume->IsReadOnly())
+		return B_READ_ONLY_DEVICE;
+	if (!volume->SupportsXattrs())
+		return B_NOT_SUPPORTED;
+
+	char xattr[MAX_XATTR_NAME + 1];
+	status_t status = xattr_name_for(name, xattr, sizeof(xattr));
+	if (status != B_OK)
+		return status;
+	status = volume->Request(FUSE_REMOVEXATTR, node->nodeid, NULL, 0, xattr, NULL, NULL,
+		0, NULL, 0);
+	if (status != B_OK)
+		return status;
+
+	notify_attribute_changed(volume->ID(), volume->ParentOf(node), node->nodeid, name,
+		B_ATTR_REMOVED);
+	return B_OK;
+}
+
+
+status_t
+hostfs_rename_attr(fs_volume* _volume, fs_vnode* _fromNode, const char* fromName,
+	fs_vnode* _toNode, const char* toName)
+{
+	Volume* volume = get_volume(_volume);
+	Node* fromNode = get_node(_fromNode);
+	Node* toNode = get_node(_toNode);
+	if (volume->IsReadOnly())
+		return B_READ_ONLY_DEVICE;
+	if (!volume->SupportsXattrs())
+		return B_NOT_SUPPORTED;
+
+	uint32 type;
+	uint8* data;
+	size_t length;
+	status_t status = read_attribute(volume, fromNode, fromName, &type, &data, &length);
+	if (status != B_OK)
+		return status;
+	MemoryDeleter dataDeleter(data);
+
+	status = write_attribute(volume, toNode, toName, type, data, length, 0);
+	if (status == B_OK)
+		status = hostfs_remove_attr(_volume, _fromNode, fromName);
+	if (status == B_OK) {
+		notify_attribute_changed(volume->ID(), volume->ParentOf(toNode), toNode->nodeid,
+			toName, B_ATTR_CREATED);
+	}
+	return status;
+}
+
+
+/*!	Called at mount: does the host keep extended attributes for us? */
+bool
+hostfs_probe_xattrs(Volume* volume)
+{
+	fuse_getxattr_in in = {};
+	fuse_getxattr_out out;
+	status_t status = volume->Request(FUSE_LISTXATTR, FUSE_ROOT_ID, &in, sizeof(in), NULL,
+		NULL, NULL, 0, &out, sizeof(out));
+	INFORM("extended attributes on the host: %s (listxattr on the root: %s, %"
+		B_PRIu32 " bytes)\n", status == B_OK ? "yes" : "no", strerror(status),
+		status == B_OK ? out.size : 0);
+	return status == B_OK;
+}
