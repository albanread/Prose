+/*!	Walks the records of a READDIR or READDIRPLUS reply. \a callback gets
+	each entry and, for READDIRPLUS, its lookup (NULL for "." and "..", which
+	the host does not count), and returns false to stop.
+*/
+template<typename Callback>
+static bool
+for_each_dir_record(const uint8* buffer, size_t length, size_t& position, bool plus,
+	Callback callback)
+{
+	while (position < length) {
+		const fuse_entry_out* lookup = NULL;
+		const fuse_dirent* entry;
+		size_t recordSize;
+		if (plus) {
+			const fuse_direntplus* record = (const fuse_direntplus*)(buffer + position);
+			if (position + FUSE_NAME_OFFSET_DIRENTPLUS > length)
+				return false;
+			entry = &record->dirent;
+			recordSize = FUSE_DIRENTPLUS_SIZE(record);
+			if (record->entry_out.nodeid != 0)
+				lookup = &record->entry_out;
+		} else {
+			entry = (const fuse_dirent*)(buffer + position);
+			if (position + FUSE_NAME_OFFSET > length)
+				return false;
+			recordSize = FUSE_DIRENT_SIZE(entry);
+		}
+		if (position + recordSize > length || entry->namelen == 0
+			|| entry->namelen >= B_FILE_NAME_LENGTH) {
+			return false;
+		}
+		if (!callback(entry, lookup, recordSize))
+			return true;
+		position += recordSize;
+	}
+	return true;
+}
+
+
+static inline bool
+is_dot_or_dotdot(const fuse_dirent* entry)
+{
+	return (entry->namelen == 1 && entry->name[0] == '.')
+		|| (entry->namelen == 2 && entry->name[0] == '.' && entry->name[1] == '.');
+}
+
+
+/*!	Reads the next batch of entries from the host. With READDIRPLUS every
+	entry comes with a lookup the host counts; they all go into the node table
+	right away (as idle nodes), so none is lost if the caller stops reading.
+*/
+static status_t
+dir_fetch(Volume* volume, Node* dir, DirCookie* cookie)
+{
+	if (cookie->buffer == NULL) {
+		cookie->buffer = (uint8*)malloc(DIR_BUFFER_SIZE);
+		if (cookie->buffer == NULL)
+			return B_NO_MEMORY;
+	}
+	const bool plus = (volume->InitFlags() & FUSE_DO_READDIRPLUS) != 0;
+	fuse_read_in in = {};
+	in.fh = cookie->fh;
+	in.offset = cookie->offset;
+	in.size = DIR_BUFFER_SIZE;
+	size_t length = 0;
+	status_t status = volume->Request(plus ? FUSE_READDIRPLUS : FUSE_READDIR, dir->nodeid,
+		&in, sizeof(in), NULL, NULL, NULL, 0, NULL, 0, cookie->buffer, DIR_BUFFER_SIZE,
+		&length);
+	if (status != B_OK)
+		return status;
+
+	cookie->length = length;
+	cookie->position = 0;
+	cookie->plus = plus;
+	if (length == 0) {
+		cookie->eof = true;
+		return B_OK;
+	}
+
+	if (plus) {
+		size_t position = 0;
+		for_each_dir_record(cookie->buffer, length, position, true,
+			[&](const fuse_dirent* entry, const fuse_entry_out* lookup, size_t) {
+				if (lookup == NULL || is_dot_or_dotdot(entry))
+					return true;
+				char name[B_FILE_NAME_LENGTH];
+				memcpy(name, entry->name, entry->namelen);
+				name[entry->namelen] = '\0';
+				Node* node = volume->AcquireEntry(*lookup, dir->nodeid, name);
+				if (node != NULL) {
+					node_update(volume, node, lookup->attr);
+					volume->Unpend(node);
+				}
+				return true;
+			});
+	}
+	return B_OK;
+}
