diff --git a/build/jam/DefaultBuildProfiles b/build/jam/DefaultBuildProfiles
index 1624aa58f8..43b4a42556 100644
--- a/build/jam/DefaultBuildProfiles
+++ b/build/jam/DefaultBuildProfiles
@@ -28,6 +28,16 @@ switch $(HAIKU_BUILD_PROFILE) {
 		TARGET_DEFINES += HAIKU_MINIMUM_BUILD ;
 	}
 
+	case "prose-*" : {
+		# PROSE fork: a regular build for a virtual machine guest
+		HAIKU_BUILD_TYPE = regular ;
+		EnableBuildFeatures regular_image ;
+		PROSE_VM_GUEST = 1 ;
+
+		HAIKU_DEFINES += HAIKU_REGULAR_BUILD ;
+		TARGET_DEFINES += HAIKU_REGULAR_BUILD ;
+	}
+
 	case "*" : {
 		HAIKU_BUILD_TYPE = regular ;
 		EnableBuildFeatures regular_image ;
@@ -72,6 +82,10 @@ rule DefineDefaultBuildProfiles
 	DefineBuildProfile minimum-anyboot : anyboot-image
 		: "haiku-minimum-anyboot.iso" ;
 
+	# Prose profiles (PROSE fork): the regular image, with Prose's packages
+	DefineBuildProfile prose-raw : image : "haiku-prose.image" ;
+	DefineBuildProfile prose-mmc : haiku-mmc-image : "haiku-prose.mmc" ;
+
 	# test profiles
 	DefineBuildProfile test-raw : image : "haiku-test.image" ;
 
@@ -177,6 +191,96 @@ rule DefineDefaultBuildProfiles
 			}
 		}
 
+		case "prose-*" : {
+			Echo Building Prose ;
+			HAIKU_IMAGE_HOST_NAME ?= prose ;
+			if $(DEBUG) != 0 {
+				HAIKU_IMAGE_SIZE ?= 850 ;
+			}
+			HAIKU_IMAGE_SIZE ?= 650 ;
+
+			# The regular image's packages that exist for arm64 -- built by
+			# HaikuArmQemu's prosepkg, the package server has none of them --
+			# and Prose's applications (HaikuArchives, haikuports). Their
+			# libraries come through dependency resolution. One not built yet
+			# is reported by the build ("not available") and left out.
+			AddHaikuImageSystemPackages
+				noto
+				openssl3
+				pe
+				vision
+				xz_utils
+				zip
+				unzip
+				curl
+				gzip
+				tar
+				which
+				# applications
+				2048
+				artpaint
+				attrify
+				bdhcalc
+				bebattle
+				becheckers
+				bepdf
+				beshare
+				bespider
+				bong
+				bsnow
+				capitalbe
+				catkeyseditor
+				cdplayer
+				clipdinger
+				commandtimer
+				connect4
+				copynametoclipboard
+				deskbareyes
+				desknotes
+				filecropper
+				filer
+				fontboy
+				ftppositive
+				genesis_commander
+				haikuwebsearch
+				hexvexed
+				lightsoff
+				lingua
+				midikeyboard
+				minesweeper
+				netpulse
+				pecorename
+				peggy
+				phantomlimb
+				ponpokodiff
+				querywatcher
+				remember
+				rename
+				samedi
+				shredder
+				slayer
+				systeminfo
+				taresizer
+				taskmanager
+				textworker
+				timebomb
+				timecop
+				timetracker
+				tipster
+				tolmach
+				toner
+				trackergrep
+				transplus
+				trax
+				w6
+				wakeup
+				webwatch
+				whereismymouse
+				wordclock
+				zookeeper
+			;
+		}
+
 		case "minimum-*" : {
 			Echo Building Haiku Minimum Target ;
 			HAIKU_IMAGE_HOST_NAME ?= shredder ;
