+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * Galaxigans: the sound effects.
+ *
+ * These are NOT the original's -- it had none written as notation -- so
+ * unlike Tunes.h nothing here is generated and everything here is meant to be
+ * changed. They are ordinary ABC and the host is the synthesiser, so tuning
+ * one is editing a string and running the game again.
+ *
+ * All of them live on chip 2, so firing never takes a voice the music is
+ * using. `v=` is ONE-BASED -- v=7, 8 and 9 are chip 2's three voices -- and
+ * it has to agree with the V: the notes are on, or the registers are set on
+ * one chip while the notes play on another and you get the default pulse
+ * wave instead of whatever was asked for. That is a silent failure: the
+ * effect still makes a noise, just the wrong one.
+ *
+ * The one thing worth knowing before editing: a chip effect is a sweep
+ * stepped at frame rate, not a note. The chip's envelope runs at 50 Hz and
+ * its decay index 1 is already 24 ms, so two notes of a thirty-second at
+ * 240 bpm -- 31 ms each -- are over before the envelope has moved, and what
+ * you hear is a click. Write the sweep out instead: a tempo where one unit is
+ * about a frame (Q:1/4=750 with L:1/16 makes a unit 20 ms), no decay, a high
+ * sustain, and the release at the end doing the fade.
+ */
+#ifndef GALAXIGANS_SFX_H
+#define GALAXIGANS_SFX_H
+
+
+/* The shot: a pulse falling two octaves in six frames. No decay and a high
+   sustain, so the envelope holds the sweep up and the release ends it --
+   which is what makes it a "pew" and not a tick. */
+static const char* const kSfxShoot =
+	"X:1\n"
+	"M:4/4\n"
+	"L:1/16\n"
+	"Q:1/4=750\n"
+	"K:C\n"
+	"V:7\n"
+	"[I:chip v=7 wave=pulse pw=300 a=0 d=0 s=13 r=4 vol=12]\n"
+	"c''a'f'c'a e\n"
+	;
+
+/* An alien going up: noise, all decay, nothing held. */
+static const char* const kSfxExplode =
+	"X:1\n"
+	"M:4/4\n"
+	"L:1/8\n"
+	"Q:1/4=240\n"
+	"K:C\n"
+	"V:7\n"
+	"[I:chip v=7 wave=noise a=0 d=7 s=0 r=5 vol=15]\n"
+	"C2\n"
+	;
+
+/* Losing something: the same, lower and longer. */
+static const char* const kSfxHurt =
+	"X:1\n"
+	"M:4/4\n"
+	"L:1/8\n"
+	"Q:1/4=240\n"
+	"K:C\n"
+	"V:7\n"
+	"[I:chip v=7 wave=noise a=0 d=9 s=2 r=8 vol=15]\n"
+	"C,4\n"
+	;
+
+/* The saucer paying out: a rising ping, three frames a step. */
+static const char* const kSfxCoin =
+	"X:1\n"
+	"M:4/16\n"
+	"L:1/16\n"
+	"Q:1/4=250\n"
+	"K:C\n"
+	"V:8\n"
+	"[I:chip v=8 wave=pulse pw=520 a=0 d=0 s=14 r=5 vol=12]\n"
+	"e b e' b'\n"
+	;
+
+/* A mine going off: a short noise crack. */
+static const char* const kSfxBang =
+	"X:1\n"
+	"M:4/4\n"
+	"L:1/8\n"
+	"Q:1/4=240\n"
+	"K:C\n"
+	"V:8\n"
+	"[I:chip v=8 wave=noise a=0 d=5 s=0 r=3 vol=14]\n"
+	"c/2\n"
+	;
+
+/* The saucer's warble, looped while it crosses: a triangle with deep vibrato. */
+static const char* const kSfxSaucer =
+	"X:1\n"
+	"M:4/4\n"
+	"L:1/8\n"
+	"Q:1/4=240\n"
+	"K:C\n"
+	"V:9\n"
+	"[I:chip v=9 wave=tri a=2 d=0 s=13 r=5 vol=11 vib=40/6]\n"
+	"g4\n"
+	;
+
+/* The boss charging: a filtered saw opening up, which is what `sweep` is for. */
+static const char* const kSfxBossHum =
+	"X:1\n"
+	"M:4/4\n"
+	"L:1/8\n"
+	"Q:1/4=120\n"
+	"K:C\n"
+	"V:9\n"
+	"[I:chip v=9 wave=saw a=4 d=0 s=12 r=6 vol=11 filt=on cutoff=520 res=9 mode=lp sweep=14]\n"
+	"C,,8\n"
+	;
+
+
+#endif	/* GALAXIGANS_SFX_H */
