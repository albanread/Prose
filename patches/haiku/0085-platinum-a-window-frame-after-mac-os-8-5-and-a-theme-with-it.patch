+# Platinum
+# After Mac OS 8.5: the Platinum frame, platinum grey panels and menus, a
+# lavender highlight, and a plain periwinkle desktop with no picture.
+
+decorator = PlatinumDecorator
+wallpaper = none
+
+# the window frame: the bevels are tints of the tab colour
+window_tab = 221,221,221
+window_text = 0,0,0
+window_inactive_tab = 232,232,232
+window_inactive_text = 128,128,128
+window_border = 221,221,221
+window_inactive_border = 232,232,232
+
+# the desktop, shown with no picture, and under the icons' labels
+desktop = 102,102,153
+
+# panels, menus, documents, controls, lists
+panel_background = 221,221,221
+menu_background = 221,221,221
+navigation_base = 102,102,204
+menu_selected_background = 51,51,153
+menu_text = 0,0,0
+menu_selected_text = 255,255,255
+menu_selected_border = 51,51,153
+panel_text = 0,0,0
+document_background = 255,255,255
+document_text = 0,0,0
+control_background = 238,238,238
+control_text = 0,0,0
