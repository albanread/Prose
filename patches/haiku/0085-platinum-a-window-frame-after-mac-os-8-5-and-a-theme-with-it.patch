--- /dev/null
+++ b/src/add-ons/decorators/PlatinumDecorator/PlatinumDecorator.h
@@ -0,0 +1,127 @@
+/*
+ * Copyright 2026, the Prose project.
+ * Distributed under the terms of the MIT License.
+ *
+ * Platinum: a window frame after the Mac OS 8.5 appearance of that name. A
+ * grey bevelled frame inside a dark outline; a title bar grooved with fine
+ * horizontal lines either side of the centred title; a square close box at
+ * the left, zoom and collapse boxes at the right (collapse minimizes). A
+ * window in the background loses its grooves and its boxes, as it did there,
+ * and a click where a box was only brings the window forward.
+ *
+ * It is pixel art: every line is a whole number of units, a unit being one
+ * pixel at the 12-point system font and two or more above it, so the frame
+ * stays crisp on a dense screen. The greys come from the system's window
+ * colours (the bevels are tints of the tab colour), so a theme can tint it.
+ *
+ * The layout is ProseDecorator's -- a full-width bar over a frame, built on
+ * SATDecorator, stacked windows sharing the bar as slices -- except that the
+ * top border is drawn as the lower part of the title bar: every border is
+ * as wide as BorderWidth() says, which stack and tile and
+ * BWindow::DecoratorFrame() count on.
+ */
+#ifndef PLATINUM_DECORATOR_H
+#define PLATINUM_DECORATOR_H
+
+
+#include "DecorManager.h"
+#include "SATDecorator.h"
+
+
+class PlatinumDecorator : public SATDecorator {
+public:
+								PlatinumDecorator(DesktopSettings& settings,
+									BRect frame, Desktop* desktop);
+	virtual						~PlatinumDecorator();
+
+	virtual	Region				RegionAt(BPoint where, int32& tab) const;
+	virtual	void				ExtendDirtyRegion(Region region,
+									BRegion& dirty);
+
+	virtual	void				Draw(BRect updateRect);
+	virtual	void				Draw();
+
+protected:
+	virtual	void				_DoLayout();
+
+	virtual	void				_DrawFrame(BRect invalid);
+	virtual	void				_DrawTab(Decorator::Tab* tab, BRect invalid);
+	virtual	void				_DrawTitle(Decorator::Tab* tab, BRect rect);
+	virtual	void				_DrawButtons(Decorator::Tab* tab,
+									const BRect& invalid);
+	virtual	void				_DrawClose(Decorator::Tab* tab, bool direct,
+									BRect rect);
+	virtual	void				_DrawZoom(Decorator::Tab* tab, bool direct,
+									BRect rect);
+	virtual	void				_DrawMinimize(Decorator::Tab* tab, bool direct,
+									BRect rect);
+
+	virtual	void				_SetTitle(Decorator::Tab* tab,
+									const char* string,
+									BRegion* updateRegion = NULL);
+	virtual	void				_SetFocus(Decorator::Tab* tab);
+	virtual	bool				_SetTabLocation(Decorator::Tab* tab,
+									float location, bool isShifting,
+									BRegion* updateRegion = NULL);
+	virtual	bool				_MoveTab(int32 from, int32 to, bool isMoving,
+									BRegion* updateRegion = NULL);
+
+	virtual	void				_MoveBy(BPoint offset);
+	virtual	void				_ResizeBy(BPoint offset, BRegion* dirty);
+
+	virtual	void				_GetFootprint(BRegion* region);
+
+private:
+			enum Box {
+				BOX_CLOSE,
+				BOX_ZOOM,
+				BOX_COLLAPSE
+			};
+
+			struct Palette {
+				rgb_color		face;
+				rgb_color		light;		// the lit edge of a bevel
+				rgb_color		shadow;		// its shaded edge; the grooves
+				rgb_color		outline;
+				rgb_color		text;
+				bool			active;
+			};
+
+			void				_LayoutBar();
+			void				_LayoutBoxes(Decorator::Tab* tab,
+									bool allBoxes);
+			BRect				_BarRect(Decorator::Tab* tab) const;
+			BRect				_BarInside(Decorator::Tab* tab) const;
+			void				_TitleRoom(Decorator::Tab* tab, float* left,
+									float* right) const;
+			BRect				_TitleRect(Decorator::Tab* tab);
+
+			void				_GetPalette(Decorator::Tab* tab,
+									Palette& palette);
+			rgb_color			_SideFace(Component component, Region region,
+									const rgb_color& plain);
+
+			void				_FillRing(BRect outer, float width,
+									const rgb_color& color);
+			void				_Bevel(BRect rect, const rgb_color& topLeft,
+									const rgb_color& bottomRight);
+			void				_DrawGrooves(Decorator::Tab* tab,
+									const Palette& palette);
+			void				_DrawBox(Decorator::Tab* tab, bool direct,
+									BRect rect, Box box, bool pressed);
+			void				_DrawGrowBox(const Palette& palette);
+
+			float				fUnit;
+			bool				fSmall;			// a floating window's bar
+			bool				fInnerBevel;	// frame rings, outside in:
+			bool				fInnerLine;		// outline, bevel, face,
+												// inner bevel, inner line
+			float				fBoxSize;		// a box with its well
+			float				fBoxInset;		// from the bar's inside
+			float				fBoxGap;
+			float				fTitleGap;		// grooves stop this far away
+			int32				fGrooves;
+};
+
+
+#endif	// PLATINUM_DECORATOR_H
