+control_highlight = 204,204,255
+navigation_pulse = 0,0,0
+shine = 255,255,255
+shadow = 0,0,0
+tooltip_background = 255,255,204
+tooltip_text = 0,0,0
+control_mark = 51,51,153
+list_background = 255,255,255
+list_selected_background = 204,204,255
+list_text = 0,0,0
+list_selected_text = 0,0,0
+scroll_bar_thumb = 204,204,255
+link_text = 0,0,204
+link_hover = 51,51,204
+link_visited = 102,0,153
