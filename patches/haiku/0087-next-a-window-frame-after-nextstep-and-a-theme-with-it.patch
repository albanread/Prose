@@ -0,0 +1,116 @@
+/*
+ * Copyright 2026, the Prose project.
+ * Distributed under the terms of the MIT License.
+ *
+ * NeXT: a window frame after NeXTSTEP. A one-unit black line round the
+ * window; a title bar that is black with a white title when the window is
+ * in front and light grey with a black one behind, the title centred, a
+ * miniaturize button at its left and a close button at its right; and under
+ * a resizable window the resize bar, in three raised segments -- the corners
+ * and the middle. There is no zoom button, as there was none.
+ *
+ * Pixel art in whole units, as Platinum and Win2k are, in NeXT's four greys:
+ * the title bar is the tab colour (active or inactive) with the tab text,
+ * the buttons and the resize bar are the border colour, and the bevels are
+ * white and a half-tone of it. A theme sets them.
+ *
+ * Unlike the other Prose frames, the borders are not all one width: the
+ * sides and the top are the black line, the bottom is the resize bar.
+ * BorderWidth() is the line's; stack and tile, and BWindow::DecoratorFrame(),
+ * count the bottom as that too, and so see the frame end a little short.
+ * With the primary button only the resize bar's right segment resizes (Haiku
+ * resizes from the bottom right corner only); with the secondary, all three.
+ */
+#ifndef NEXT_DECORATOR_H
+#define NEXT_DECORATOR_H
+
+
+#include "DecorManager.h"
+#include "SATDecorator.h"
+
+
+class NextDecorator : public SATDecorator {
+public:
+								NextDecorator(DesktopSettings& settings,
+									BRect frame, Desktop* desktop);
+	virtual						~NextDecorator();
+
+	virtual	Region				RegionAt(BPoint where, int32& tab) const;
+	virtual	void				ExtendDirtyRegion(Region region,
+									BRegion& dirty);
+
+protected:
+	virtual	void				_DoLayout();
+
+	virtual	void				_DrawFrame(BRect invalid);
+	virtual	void				_DrawTab(Decorator::Tab* tab, BRect invalid);
+	virtual	void				_DrawTitle(Decorator::Tab* tab, BRect rect);
+	virtual	void				_DrawButtons(Decorator::Tab* tab,
+									const BRect& invalid);
+	virtual	void				_DrawClose(Decorator::Tab* tab, bool direct,
+									BRect rect);
+	virtual	void				_DrawZoom(Decorator::Tab* tab, bool direct,
+									BRect rect);
+	virtual	void				_DrawMinimize(Decorator::Tab* tab, bool direct,
+									BRect rect);
+
+	virtual	void				_SetTitle(Decorator::Tab* tab,
+									const char* string,
+									BRegion* updateRegion = NULL);
+	virtual	void				_SetFocus(Decorator::Tab* tab);
+	virtual	bool				_SetTabLocation(Decorator::Tab* tab,
+									float location, bool isShifting,
+									BRegion* updateRegion = NULL);
+	virtual	bool				_MoveTab(int32 from, int32 to, bool isMoving,
+									BRegion* updateRegion = NULL);
+
+	virtual	void				_MoveBy(BPoint offset);
+	virtual	void				_ResizeBy(BPoint offset, BRegion* dirty);
+
+	virtual	void				_GetFootprint(BRegion* region);
+
+private:
+			enum Button {
+				BUTTON_CLOSE,
+				BUTTON_MINIATURIZE
+			};
+
+			struct Palette {
+				rgb_color		bar;
+				rgb_color		barLight;
+				rgb_color		barDark;
+				rgb_color		text;
+				rgb_color		face;		// buttons and the resize bar
+				rgb_color		white;
+				rgb_color		dark;
+				rgb_color		black;
+				rgb_color		glyph;
+			};
+
+			void				_LayoutBar();
+			void				_LayoutButtons(Decorator::Tab* tab,
+									bool allButtons);
+			BRect				_BarInside(Decorator::Tab* tab) const;
+			BRect				_TitleRect(Decorator::Tab* tab);
+			float				_SegmentWidth() const;
+
+			void				_GetPalette(Decorator::Tab* tab,
+									Palette& palette);
+			rgb_color			_SideFace(Component component, Region region,
+									const rgb_color& plain);
+
+			void				_FillRing(BRect outer, float width,
+									const rgb_color& color);
+			void				_Edge(BRect rect, const rgb_color& topLeft,
+									const rgb_color& bottomRight);
+			void				_DrawResizeBar(const Palette& palette);
+			void				_DrawButton(Decorator::Tab* tab, bool direct,
+									BRect rect, Button button, bool pressed);
+
+			float				fUnit;
+			float				fBottom;		// the bottom border's height
+			float				fButtonSize;
+};
+
+
+#endif	// NEXT_DECORATOR_H
