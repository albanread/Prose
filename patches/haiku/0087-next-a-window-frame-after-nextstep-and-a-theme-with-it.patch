+# NeXTSTEP
+# After NeXTSTEP: the NeXT frame -- a black title bar in front, light grey
+# behind, the resize bar -- and NeXT's four greys for everything else:
+# light grey panels and menus, white where a menu item or a list line is
+# chosen, white documents, on the dark grey workspace with no picture.
+
+decorator = NextDecorator
+wallpaper = none
+
+# the window frame: the title bar is the tab colour, the buttons and the
+# resize bar the border colour
+window_tab = 0,0,0
+window_text = 255,255,255
+window_inactive_tab = 170,170,170
+window_inactive_text = 0,0,0
+window_border = 170,170,170
+window_inactive_border = 170,170,170
+
+# the desktop, shown with no picture, and under the icons' labels
+desktop = 85,85,85
+
+# panels, menus, documents, controls, lists
+panel_background = 170,170,170
+menu_background = 170,170,170
+navigation_base = 0,0,0
+menu_selected_background = 255,255,255
+menu_text = 0,0,0
+menu_selected_text = 0,0,0
+menu_selected_border = 0,0,0
+panel_text = 0,0,0
+document_background = 255,255,255
+document_text = 0,0,0
+control_background = 170,170,170
+control_text = 0,0,0
+control_border = 85,85,85
+control_highlight = 170,170,170
+navigation_pulse = 0,0,0
+shine = 255,255,255
+shadow = 0,0,0
+tooltip_background = 255,255,255
+tooltip_text = 0,0,0
+control_mark = 0,0,0
+list_background = 255,255,255
+list_selected_background = 170,170,170
+list_text = 0,0,0
+list_selected_text = 0,0,0
+scroll_bar_thumb = 170,170,170
+link_text = 0,0,0
+link_hover = 85,85,85
+link_visited = 85,85,85
+link_active = 0,0,0
+status_bar = 85,85,85
+success = 0,85,0
+failure = 170,0,0
