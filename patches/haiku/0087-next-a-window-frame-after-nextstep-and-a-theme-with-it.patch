+resource("be:decor:info") message('deco') {
+	"name"				= "NeXT",
+	"authors"			= "The Prose project",
+	"short_descr"		= "A black title bar and a resize bar, after NeXTSTEP",
+	"long_descr"		= "A thin black line round the window; a title bar, "
+		"black with a white title in front and light grey behind, a "
+		"miniaturize button at its left and a close button at its right; "
+		"and the resize bar under a resizable window, in three segments. "
+		"Drawn in whole pixels that grow with the system font, in the "
+		"system's window colours, so a theme sets them.",
+	"lic_url"			= "https://opensource.org/license/mit",
+	"lic_name"			= "MIT",
+	"support_url"		= "https://github.com/albanread/Prose",
+	float "version"		= 1.0
+};
