diff --git a/src/servers/app/ClientMemoryAllocator.cpp b/src/servers/app/ClientMemoryAllocator.cpp
index 99c1e9fea4..5754f91060 100644
--- a/src/servers/app/ClientMemoryAllocator.cpp
+++ b/src/servers/app/ClientMemoryAllocator.cpp
@@ -71,6 +71,11 @@ ClientMemoryAllocator::Allocate(size_t size, block** _address)
 	if (fApplication == NULL)
 		return NULL;
 
+	// a block without size would share its base with its neighbours, and
+	// Free() could not tell them apart
+	if (size == 0)
+		return NULL;
+
 	BAutolock locker(fLock);
 
 	// Search best matching free block from the list
@@ -152,7 +157,7 @@ ClientMemoryAllocator::Free(block* freeBlock)
 				after = block;
 		}
 
-		if (before != NULL && after != NULL) {
+		if (before != NULL && after != NULL && before != after) {
 			// merge with adjacent blocks
 			before->size += after->size + freeBlock->size;
 			fFreeBlocks.Remove(after);
diff --git a/src/servers/app/ServerBitmap.h b/src/servers/app/ServerBitmap.h
index ab04bc8c7b..3e7bf1d585 100644
--- a/src/servers/app/ServerBitmap.h
+++ b/src/servers/app/ServerBitmap.h
@@ -127,7 +127,7 @@ public:
 uint32
 ServerBitmap::BitsLength() const
 {
-	int64 length = fBytesPerRow * fHeight;
+	int64 length = (int64)fBytesPerRow * fHeight;
 	return (length > 0 && length <= UINT32_MAX) ? (uint32)length : 0;
 }
 
diff --git a/src/servers/app/ServerPicture.cpp b/src/servers/app/ServerPicture.cpp
index 09b9f2889a..0c95347d30 100644
--- a/src/servers/app/ServerPicture.cpp
+++ b/src/servers/app/ServerPicture.cpp
@@ -1078,6 +1078,17 @@ ServerPicture::ServerPicture(const ServerPicture& picture)
 		size);
 
 	PictureDataWriter::SetTo(fData.Get());
+
+	// The copied ops refer to the nested pictures by their index. Copy them
+	// as well, since the destructor disowns the pictures it nests.
+	if (picture.fPictures.IsSet()) {
+		for (int32 i = 0; i < picture.fPictures->CountItems(); i++) {
+			BReference<ServerPicture> nested(new(std::nothrow)
+				ServerPicture(*picture.fPictures->ItemAt(i)), true);
+			if (nested == NULL || NestPicture(nested) < 0)
+				break;
+		}
+	}
 }
 
 
@@ -1245,10 +1256,14 @@ ServerPicture::Play(Canvas* target)
 	if (mallocIO == NULL)
 		return;
 
-	CanvasCallbacks callbacks(target, *fPictures.Get());
+	// a picture that nests none has no list
+	PictureList noPictures;
+	PictureList& pictures = fPictures.IsSet() ? *fPictures.Get() : noPictures;
+
+	CanvasCallbacks callbacks(target, pictures);
 
 	BPrivate::PicturePlayer player(mallocIO->Buffer(),
-		mallocIO->BufferLength(), PictureList::Private(fPictures.Get()).AsBList());
+		mallocIO->BufferLength(), PictureList::Private(&pictures).AsBList());
 	player.Play(callbacks);
 }
 
