diff --git a/src/servers/prose_display/prose_display_agent.cpp b/src/servers/prose_display/prose_display_agent.cpp
new file mode 100644
index 0000000000..b1d91949e8
--- /dev/null
+++ b/src/servers/prose_display/prose_display_agent.cpp
@@ -0,0 +1,126 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * Prose Display agent: follows the host window. When the host resizes its
+ * window the Prose Display device sends a MODE_HINT; the driver wakes us
+ * (PRDS_WAIT_MODE_HINT) and we switch the screen to that size, the way
+ * guest tools do on other hypervisors. Without the device we just idle.
+ */
+
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <syslog.h>
+#include <unistd.h>
+
+#include <Application.h>
+#include <Screen.h>
+
+#include <compute_display_timing.h>
+#include <create_display_modes.h>
+#include <prose_display.h>
+
+
+static const char* kDevicePath = "/dev/graphics/prose_display/0";
+static const char* kSignature = "application/x-vnd.Haiku-prose_display_agent";
+
+
+static status_t
+switch_to(uint32 width, uint32 height)
+{
+	BScreen screen;
+	if (!screen.IsValid())
+		return B_NO_INIT;
+
+	display_mode current;
+	status_t status = screen.GetMode(&current);
+	if (status != B_OK)
+		return status;
+	if (current.virtual_width == width && current.virtual_height == height)
+		return B_OK;
+
+	display_mode mode = current;
+	compute_display_timing(width, height, 60, false, &mode.timing);
+	fill_display_mode(width, height, &mode);
+	mode.space = B_RGB32;
+
+	status = screen.SetMode(&mode);
+	syslog(status == B_OK ? LOG_INFO : LOG_ERR,
+		"prose_display_agent: %" B_PRIu32 "x%" B_PRIu32 " -> %" B_PRIu32 "x%" B_PRIu32
+		": %s\n", current.virtual_width, current.virtual_height, width, height,
+		strerror(status));
+	return status;
+}
+
+
+static int32
+hint_thread(void* data)
+{
+	int device = *(int*)data;
+	uint32 wanted = 0, wantedHeight = 0;
+	int failures = 0;
+
+	while (true) {
+		prds_mode_hint hint;
+		hint.timeout = 2000000;
+		status_t status = ioctl(device, PRDS_WAIT_MODE_HINT, &hint, sizeof(hint));
+		if (status != B_OK && status != B_TIMED_OUT && errno != B_TIMED_OUT
+			&& errno != B_INTERRUPTED) {
+			if (++failures > 10) {
+				syslog(LOG_ERR, "prose_display_agent: giving up: %s\n", strerror(errno));
+				return 1;
+			}
+			snooze(1000000);
+			continue;
+		}
+		failures = 0;
+		if (hint.width == 0 || hint.height == 0)
+			continue;
+		if (hint.width == wanted && hint.height == wantedHeight)
+			continue;
+
+		// coalesce the burst a live resize produces
+		snooze(150000);
+		prds_mode_hint latest;
+		latest.timeout = 0;
+		if (ioctl(device, PRDS_WAIT_MODE_HINT, &latest, sizeof(latest)) == B_OK
+			|| errno == B_TIMED_OUT) {
+			if (latest.width != 0 && latest.height != 0) {
+				hint.width = latest.width;
+				hint.height = latest.height;
+			}
+		}
+
+		if (switch_to(hint.width, hint.height) == B_OK) {
+			wanted = hint.width;
+			wantedHeight = hint.height;
+		}
+	}
+	return 0;
+}
+
+
+int
+main()
+{
+	int device = open(kDevicePath, O_RDWR);
+	if (device < 0) {
+		// no Prose Display: nothing to do, but stay out of launch_daemon's way
+		while (true)
+			snooze(B_INFINITE_TIMEOUT);
+	}
+
+	BApplication app(kSignature);
+	thread_id thread = spawn_thread(hint_thread, "mode hints", B_NORMAL_PRIORITY, &device);
+	if (thread < 0)
+		return 1;
+	resume_thread(thread);
+	syslog(LOG_INFO, "prose_display_agent: following the host window\n");
+	app.Run();
+	close(device);
+	return 0;
+}
