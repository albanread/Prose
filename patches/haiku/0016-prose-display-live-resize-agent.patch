 build/jam/images/definitions/minimum          |   1 +
 data/launch/system                            |   6 +
 .../graphics/prose_display/prose_display.h    |   9 ++
 .../accelerants/prose_display/accelerant.cpp  |   9 +-
 .../graphics/prose_display/prose_display.cpp  |  36 ++++-
 src/servers/Jamfile                           |   1 +
 src/servers/prose_display/Jamfile             |  12 ++
 .../prose_display/prose_display_agent.cpp     | 126 ++++++++++++++++++
 .../prose_display/prose_display_agent.rdef    |  13 ++
 9 files changed, 209 insertions(+), 4 deletions(-)
 create mode 100644 src/servers/prose_display/Jamfile
 create mode 100644 src/servers/prose_display/prose_display_agent.cpp
 create mode 100644 src/servers/prose_display/prose_display_agent.rdef

