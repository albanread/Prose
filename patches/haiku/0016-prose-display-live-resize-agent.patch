diff --git a/headers/private/graphics/prose_display/prose_display.h b/headers/private/graphics/prose_display/prose_display.h
index 8167628b4d..21acb3cb4e 100644
--- a/headers/private/graphics/prose_display/prose_display.h
+++ b/headers/private/graphics/prose_display/prose_display.h
@@ -147,6 +147,14 @@ struct prds_shared_info {
 
 	area_id			mode_list_area;		/* owned by the primary accelerant */
 	uint32			mode_count;
+
+	uint32			redraw_count;		/* bumped by REDRAW events: present everything again */
+};
+
+struct prds_mode_hint {
+	uint32			width;				/* out: the host's current preferred size */
+	uint32			height;
+	bigtime_t		timeout;			/* in: how long to wait for a new hint */
 };
 
 struct prds_commit_request {
@@ -162,6 +170,7 @@ enum {
 	PRDS_SET_MODE,										/* display_mode* */
 	PRDS_COMMIT,										/* prds_commit_request* */
 	PRDS_ENABLE_EVENTS,									/* uint32* mask */
+	PRDS_WAIT_MODE_HINT,								/* prds_mode_hint*: blocks until the next hint or timeout */
 };
 
 
diff --git a/src/add-ons/accelerants/prose_display/accelerant.cpp b/src/add-ons/accelerants/prose_display/accelerant.cpp
index b7e5c82fde..477809bfb1 100644
--- a/src/add-ons/accelerants/prose_display/accelerant.cpp
+++ b/src/add-ons/accelerants/prose_display/accelerant.cpp
@@ -71,6 +71,7 @@ commit_thread(void* data)
 	prds_commit_request request;
 
 	bool useRetrace = true;
+	uint32 lastRedraw = info->shared_info->redraw_count;
 	while (!info->quit) {
 		sem_id retrace = useRetrace ? info->shared_info->retrace_sem : -1;
 		status_t waited = B_ERROR;
@@ -97,7 +98,13 @@ commit_thread(void* data)
 			info->dirty_count = 0;
 		}
 		release_sem(info->dirty_lock);
-		if (count == 0)
+
+		// the host asked for everything again (REDRAW): a full commit
+		bool redraw = info->shared_info->redraw_count != lastRedraw;
+		if (redraw) {
+			lastRedraw = info->shared_info->redraw_count;
+			count = 0;
+		} else if (count == 0)
 			continue;
 
 		request.rect_count = count;
diff --git a/src/add-ons/kernel/drivers/graphics/prose_display/prose_display.cpp b/src/add-ons/kernel/drivers/graphics/prose_display/prose_display.cpp
index eec33f815e..0dd0f502de 100644
--- a/src/add-ons/kernel/drivers/graphics/prose_display/prose_display.cpp
+++ b/src/add-ons/kernel/drivers/graphics/prose_display/prose_display.cpp
@@ -74,6 +74,7 @@ struct prds_info {
 	area_id						shared_area;
 	struct prds_shared_info*	shared;
 	sem_id						retrace_sem;
+	sem_id						hint_sem;			// kernel-owned, waited on inside ioctl
 
 	uint32						mode_width;
 	uint32						mode_height;
@@ -159,12 +160,18 @@ prds_event_callback(void* driverCookie, void* cookie)
 				break;
 			}
 			case PRDS_EVT_MODE_HINT:
+			{
 				info->hint_count++;
 				info->shared->pref_width = event->mode_hint.width;
 				info->shared->pref_height = event->mode_hint.height;
+				int32 waiting;
+				if (get_sem_count(info->hint_sem, &waiting) == B_OK && waiting < 0)
+					release_sem_etc(info->hint_sem, -waiting, B_DO_NOT_RESCHEDULE);
 				break;
+			}
 			case PRDS_EVT_REDRAW:
 				info->redraw_count++;
+				info->shared->redraw_count = (uint32)info->redraw_count;
 				atomic_set(&info->need_redraw, 1);
 				break;
 		}
@@ -414,6 +421,8 @@ prds_teardown(prds_info* info)
 		info->virtio->free_interrupts(info->device);
 	if (info->retrace_sem >= 0)
 		delete_sem(info->retrace_sem);
+	if (info->hint_sem >= 0)
+		delete_sem(info->hint_sem);
 	if (info->command_done >= 0)
 		delete_sem(info->command_done);
 	if (info->shared_area >= 0)
@@ -437,7 +446,7 @@ prds_init_driver(device_node* node, void** _cookie)
 		return B_NO_MEMORY;
 	info->node = node;
 	info->pool_area = info->command_area = info->event_area = info->shared_area = -1;
-	info->command_done = info->retrace_sem = -1;
+	info->command_done = info->retrace_sem = info->hint_sem = -1;
 	info->test_thread = -1;
 	mutex_init(&info->command_lock, "prose display commands");
 
@@ -512,7 +521,8 @@ prds_init_driver(device_node* node, void** _cookie)
 	}
 	info->command_done = create_sem(0, "prose display command");
 	info->retrace_sem = create_sem(0, "prose display retrace");
-	if (info->command_done < 0 || info->retrace_sem < 0) {
+	info->hint_sem = create_sem(0, "prose display mode hint");
+	if (info->command_done < 0 || info->retrace_sem < 0 || info->hint_sem < 0) {
 		status = info->command_done < 0 ? info->command_done : info->retrace_sem;
 		ERROR("creating semaphores failed: %s\n", strerror(status));
 		goto error;
@@ -637,9 +647,12 @@ prds_open(void* deviceCookie, const char* path, int openMode, void** _cookie)
 		if (get_sem_info(info->retrace_sem, &semInfo) != B_OK) {
 			info->retrace_sem = create_sem(0, "prose display retrace");
 			info->shared->retrace_sem = info->retrace_sem;
+			get_sem_info(info->retrace_sem, &semInfo);
 		}
+		// the first opener (app_server) gets it; later ones (clones, the agent) leave it
 		thread_info threadInfo;
-		if (info->retrace_sem >= 0 && get_thread_info(find_thread(NULL), &threadInfo) == B_OK
+		if (info->retrace_sem >= 0 && semInfo.team == team_get_kernel_team_id()
+			&& get_thread_info(find_thread(NULL), &threadInfo) == B_OK
 			&& threadInfo.team != team_get_kernel_team_id())
 			set_sem_owner(info->retrace_sem, threadInfo.team);
 	}
@@ -750,6 +763,23 @@ prds_control(void* cookie, uint32 op, void* buffer, size_t length)
 				return B_BAD_ADDRESS;
 			return prds_enable_events(info, mask);
 		}
+
+		case PRDS_WAIT_MODE_HINT:
+		{
+			// the semaphore stays kernel-owned; the wait happens here on the caller's behalf
+			struct prds_mode_hint hint;
+			if (length < sizeof(hint) || user_memcpy(&hint, buffer, sizeof(hint)) != B_OK)
+				return B_BAD_ADDRESS;
+			status_t status = acquire_sem_etc(info->hint_sem, 1,
+				B_RELATIVE_TIMEOUT | B_CAN_INTERRUPT, hint.timeout);
+			if (status != B_OK && status != B_TIMED_OUT && status != B_WOULD_BLOCK)
+				return status;
+			hint.width = info->shared->pref_width;
+			hint.height = info->shared->pref_height;
+			if (user_memcpy(buffer, &hint, sizeof(hint)) != B_OK)
+				return B_BAD_ADDRESS;
+			return status;
+		}
 	}
 	return B_DEV_INVALID_IOCTL;
 }
