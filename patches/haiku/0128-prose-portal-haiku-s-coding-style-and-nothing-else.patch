 		status = get_memory_map(address, size, &entry, 1);
 		if (status != B_OK)
 			goto error;
-		info->buffers = (uint8*)address;
+		info->buffers = static_cast<uint8*>(address);
 		info->phys = entry.address;
 		memset(info->buffers, 0, size);
