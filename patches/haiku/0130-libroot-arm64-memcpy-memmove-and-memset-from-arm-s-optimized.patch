From 9f4f5081593154c251b0d3f146a9f162d0038476 Mon Sep 17 00:00:00 2001
From: albanread <albanread@googlemail.com>
Date: Wed, 23 Sep 2026 19:08:30 +0100
Subject: [PATCH] libroot: arm64 memcpy, memmove and memset from Arm's
 optimized-routines

The generic C they replace moved eight bytes per instruction at best, and one
byte at a time, for the whole call, whenever source and destination differed
in alignment modulo 8. app_server does all its copying through them -- the
back buffer to the front one, scrolling, unscaled bitmaps -- and hits the byte
loop on every sideways scroll by an odd number of pixels and every 32-bit
bitmap drawn at an odd x. Arm's routines move sixteen bytes per instruction
in q-register pairs, handle unaligned heads and tails without caring how the
two pointers relate, and zero large blocks with dc zva.

memcpy and memmove are one routine, which copies overlapping ranges correctly
in either direction, so musl's memmove.c is left out of libroot and of
runtime_loader on arm64. DrawingEngine::_CopyRect needs that: it calls memcpy
on overlapping rows when it moves content left.

The routines assume Normal memory; on Device memory (B_UNCACHED_MEMORY on
arm64) their unaligned accesses and dc zva would fault. Every frame buffer
userland maps is write-back (prose_display) or write-combining (framebuffer).
The kernel and the boot loader compile their own copies of the generic C and
keep them.

Imported unchanged from github.com/ARM-software/optimized-routines at
47597821aaa5, under MIT OR Apache-2.0 WITH LLVM-exception (LICENSE alongside);
memcpy.S and memset.S only give the entry points their libc names.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Prose-Patch: 0130-libroot-arm64-memcpy-memmove-and-memset-from-arm-s-optimized.patch 12bc514f94cf4ca26916eb095316b68712e691054ecaafb22473a4cd45b8e42c
---
 src/system/libroot/posix/musl/string/Jamfile  |   9 +-
 .../libroot/posix/string/arch/arm64/Jamfile   |  12 +-
 .../arch/arm64/arm-optimized-routines/LICENSE | 249 ++++++++++++++++++
 .../arm64/arm-optimized-routines/asmdefs.h    | 105 ++++++++
 .../arm-optimized-routines/memcpy-advsimd.S   | 209 +++++++++++++++
 .../arm64/arm-optimized-routines/memset.S     | 121 +++++++++
 .../libroot/posix/string/arch/arm64/memcpy.S  |  24 ++
 .../libroot/posix/string/arch/arm64/memset.S  |  14 +
 src/system/runtime_loader/Jamfile             |   9 +-
 9 files changed, 741 insertions(+), 11 deletions(-)
 create mode 100644 src/system/libroot/posix/string/arch/arm64/arm-optimized-routines/LICENSE
 create mode 100644 src/system/libroot/posix/string/arch/arm64/arm-optimized-routines/asmdefs.h
 create mode 100644 src/system/libroot/posix/string/arch/arm64/arm-optimized-routines/memcpy-advsimd.S
 create mode 100644 src/system/libroot/posix/string/arch/arm64/arm-optimized-routines/memset.S
 create mode 100644 src/system/libroot/posix/string/arch/arm64/memcpy.S
 create mode 100644 src/system/libroot/posix/string/arch/arm64/memset.S

diff --git a/src/system/libroot/posix/musl/string/Jamfile b/src/system/libroot/posix/musl/string/Jamfile
index 2bae858cd8..596b4e1f17 100644
--- a/src/system/libroot/posix/musl/string/Jamfile
+++ b/src/system/libroot/posix/musl/string/Jamfile
@@ -10,12 +10,19 @@ for architectureObject in [ MultiArchSubDirSetup ] {
 	on $(architectureObject) {
 		local architecture = $(TARGET_PACKAGING_ARCH) ;
 
+		# arm64's memcpy handles overlap and is its memmove as well
+		# (posix/string/arch/arm64)
+		local memmove = memmove.c ;
+		if $(TARGET_ARCH) = arm64 {
+			memmove = ;
+		}
+
 		MergeObject <$(architecture)>posix_musl_string.o :
 			index.c
 			memccpy.c
 			memchr.c
 			memmem.c
-			memmove.c
+			$(memmove)
 			memrchr.c
 			stpcpy.c
 			stpncpy.c
diff --git a/src/system/libroot/posix/string/arch/arm64/Jamfile b/src/system/libroot/posix/string/arch/arm64/Jamfile
index dc5b49afc7..1c84e61011 100644
--- a/src/system/libroot/posix/string/arch/arm64/Jamfile
+++ b/src/system/libroot/posix/string/arch/arm64/Jamfile
@@ -1,20 +1,14 @@
 SubDir HAIKU_TOP src system libroot posix string arch arm64 ;
 
-# Optimizations create infinite recursion otherwise.
-SubDirCcFlags -fno-builtin ;
-
 local architectureObject ;
 for architectureObject in [ MultiArchSubDirSetup arm64 ] {
 	on $(architectureObject) {
 		local architecture = $(TARGET_PACKAGING_ARCH) ;
 
-		UsePrivateSystemHeaders ;
-
-		SEARCH_SOURCE += [ FDirName $(SUBDIR) $(DOTDOT) generic ] ;
-
+		# memcpy.S is memmove as well
 		MergeObject <$(architecture)>posix_string_arch_$(TARGET_ARCH).o :
-			generic_memcpy.c
-			generic_memset.c
+			memcpy.S
+			memset.S
 			;
 	}
 }
