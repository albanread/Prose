+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+/*
+ * memset for arm64: Arm's optimized-routines, unchanged; see memcpy.S. A fill
+ * with zero of more than 128 bytes uses dc zva, which zeroes a 64-byte block
+ * without reading it, when DCZID_EL0 allows that at EL0.
+ */
+
+#define __memset_aarch64	memset
+
+#include "arm-optimized-routines/memset.S"
