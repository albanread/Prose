 	registrar
 	syslog_daemon
 ] ;
diff --git a/build/jam/packages/Haiku b/build/jam/packages/Haiku
index f449f3f95f..50bd0ca464 100644
--- a/build/jam/packages/Haiku
+++ b/build/jam/packages/Haiku
@@ -156,7 +156,6 @@ AddNewDriversToPackage display :
 	;
 AddNewDriversToPackage audio hmulti :
 	prose_midi
-	<driver>prose_portal
 	virtio_sound
 	;
 AddNewDriversToPackage hyperv :
diff --git a/build/jam/packages/ProsePortal b/build/jam/packages/ProsePortal
new file mode 100644
index 0000000000..e6ef8ec1cd
--- /dev/null
+++ b/build/jam/packages/ProsePortal
@@ -0,0 +1,18 @@
+# The Prose Portal: the device the host drives this machine through.
+#
+# A package of its own, not part of haiku.hpkg, so that updating it does not
+# mean replacing the whole system. packagefs resolves one file per path, so a
+# second package cannot supply what the base one already does -- which is why
+# the driver, the daemon and the launch job all live here and nowhere else.
+local prosePortalPackage = prose_portal.hpkg ;
+HaikuPackage $(prosePortalPackage) ;
+
+AddNewDriversToPackage audio hmulti : <driver>prose_portal ;
+AddFilesToPackage servers : prose_portal ;
+
+local portalLaunch = prose_portal ;
+portalLaunch = $(portalLaunch:G=launch) ;
+SEARCH on $(portalLaunch) = [ FDirName $(HAIKU_TOP) data launch ] ;
+AddFilesToPackage data launch : $(portalLaunch) ;
+
+BuildHaikuPackage $(prosePortalPackage) : prose_portal ;
diff --git a/data/launch/prose_portal b/data/launch/prose_portal
new file mode 100644
index 0000000000..ba2cd3f20b
--- /dev/null
+++ b/data/launch/prose_portal
@@ -0,0 +1,8 @@
+# The Prose Portal's daemon. In the prose_portal package, not the system's own
+# launch script, so the portal can be replaced on its own: a newer Prose drops
+# in a newer prose_portal.hpkg and need not bring a whole new system with it.
+service x-vnd.Haiku-prose_portal {
+	launch /system/servers/prose_portal
+	no_safemode
+	legacy
+}
diff --git a/data/launch/system b/data/launch/system
index d8983b0fd2..5945770512 100644
--- a/data/launch/system
+++ b/data/launch/system
@@ -67,12 +67,6 @@ service x-vnd.Haiku-prose_display_agent {
 	legacy
 }
 
-service x-vnd.Haiku-prose_portal {
-	launch /system/servers/prose_portal
-	no_safemode
-	legacy
-}
-
 job x-vnd.Haiku-cddb_lookup {
 	launch /system/bin/cddb_lookup
 	no_safemode
diff --git a/src/data/package_infos/generic/prose_portal b/src/data/package_infos/generic/prose_portal
new file mode 100644
index 0000000000..8057b8f39f
--- /dev/null
+++ b/src/data/package_infos/generic/prose_portal
@@ -0,0 +1,22 @@
+name			prose_portal
+version			%HAIKU_VERSION%
+architecture	HAIKU_PACKAGING_ARCH
+summary			"The portal the host drives this machine through"
+
+description		"A driver for the Prose Portal device and the daemon that \
+answers on it: the host asks this machine to do something and hears what \
+happened. Its own package so it can be replaced on its own."
+
+packager		"The Haiku build system"
+vendor			"Prose"
+
+copyrights		"2026 HaikuArmQemu (PROSE fork)"
+licenses		"MIT"
+
+provides {
+	prose_portal = %HAIKU_VERSION%
+}
+
+requires {
+	haiku >= R1~beta1
+}
