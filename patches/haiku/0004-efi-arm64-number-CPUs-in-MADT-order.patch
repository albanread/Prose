@@ -101,6 +101,17 @@ arch_handle_acpi()
 		uint64 gicr_base = 0;
 		uint8 version = 0;
 
+		// HaikuArmQemu fork: number CPUs in MADT order, with the CPU we run on
+		// as 0. The GICC "CPU interface number" only means something for
+		// GICv2; Apple's Virtualization.framework reports 0 for every CPU
+		// (valid for GICv3), so using it as the id made every CPU look like the
+		// boot CPU. None were started, and the kernel waited for them forever.
+		uint64 bootMpidr;
+		asm volatile("mrs %0, MPIDR_EL1" : "=r" (bootMpidr));
+		bootMpidr &= 0xff00ffffffULL;	// affinity fields, as in the MADT
+		platform_cpu_info* firstCpu = NULL;
+		uint32 cpuCount = 0;
+
 		acpi_apic *desc = (acpi_apic*)(madt + 1);
 		while (desc != (acpi_apic*)((char*)madt + madt->header.length)) {
 			if (desc->type == ACPI_MADT_GIC_INTERFACE) {
