 				arch_smp_register_cpu(&cpu);
 				if (cpu == NULL)
 					break;
-				cpu->id = acpi_gicc->cpu_interface_num;
+				cpu->id = cpuCount++;
 				cpu->mpidr = acpi_gicc->mpidr;
+				if (firstCpu == NULL) {
+					firstCpu = cpu;
+				} else if (cpu->mpidr == bootMpidr) {
+					// The boot CPU must be CPU 0.
+					cpu->mpidr = firstCpu->mpidr;
+					firstCpu->mpidr = bootMpidr;
+				}
 			} else if (desc->type == ACPI_MADT_GIC_DISTRIBUTOR) {
