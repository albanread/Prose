From eeb2fdbec9d674ffc001a2852a8c518bb48dd7bf Mon Sep 17 00:00:00 2001
From: albanread <albanread@googlemail.com>
Date: Sun, 20 Sep 2026 22:37:23 +0100
Subject: [PATCH] Examples in the image: six short programs to build and change

Something for the compiler to compile, in
/boot/system/data/prose-examples: a C program and how to compile one,
C++ with the standard library, a window, a view that paints itself, the
named values a file carries beside its contents, and threads with the
lock that keeps them honest. Each has a Makefile and says in its first
lines what to type without one.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Prose-Patch: 0078-examples-in-the-image-six-short-programs-to-build-and-change.patch e92b3d1155b13868c58a52ba5041c4db1ae4972731acdbc266c6bd0cb1851d9d
---
 build/jam/DefaultBuildProfiles          | 4 ++++
 build/jam/repositories/HaikuPorts/arm64 | 1 +
 2 files changed, 5 insertions(+)

diff --git a/build/jam/DefaultBuildProfiles b/build/jam/DefaultBuildProfiles
index 9026bc216c..3ebdb69470 100644
--- a/build/jam/DefaultBuildProfiles
+++ b/build/jam/DefaultBuildProfiles
@@ -356,6 +356,10 @@ rule DefineDefaultBuildProfiles
 				gcc_syslibs_devel
 				make
 				mkdepend
+				# and something to compile: six short programs in
+				# /boot/system/data/prose-examples, with a README that says
+				# to take a copy of them first
+				prose_examples
 			;
 		}
 
diff --git a/build/jam/repositories/HaikuPorts/arm64 b/build/jam/repositories/HaikuPorts/arm64
index 4bcc15992a..ea159a2300 100644
--- a/build/jam/repositories/HaikuPorts/arm64
+++ b/build/jam/repositories/HaikuPorts/arm64
@@ -7,6 +7,7 @@ RemotePackageRepository HaikuPorts
 	ca_root_certificates-2026_07_16-1
 	firacode-4-1
 	jetbrains_mono-2.304-1
+	prose_examples-1.0-1
 	timgmsoundfont-2011.12.11-1
 	noto_sans_cjk_jp-2.004-2
 	haikuporter-0_bootstrap-1
