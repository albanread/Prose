From 261eb4fc5789beeae82b2580d08c2e2962d53981 Mon Sep 17 00:00:00 2001
From: albanread <albanread@googlemail.com>
Date: Sun, 20 Sep 2026 18:16:37 +0100
Subject: [PATCH] Prose profile: ProseWriter, the word processor, in Office

The package is built by prosepkg from the Prose repository's own tree
(packages/builder/overlay/haiku-apps/prosewriter), and local-packages
copies it in at the image build; the repository list names it so the
image build can take it, and its Deskbar entry goes into Office.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Prose-Patch: 0072-prose-profile-prosewriter-the-word-processor-in-office.patch 2b8573cc2e17bf86e80e000c39206c302a3d8d18ae9baa4ede27aa2e5a37f01e
---
 build/jam/DefaultBuildProfiles          | 1 +
 build/jam/DeskbarCategories             | 1 +
 build/jam/repositories/HaikuPorts/arm64 | 1 +
 3 files changed, 3 insertions(+)

diff --git a/build/jam/DefaultBuildProfiles b/build/jam/DefaultBuildProfiles
index dd6e40f2d7..8edfe2a015 100644
--- a/build/jam/DefaultBuildProfiles
+++ b/build/jam/DefaultBuildProfiles
@@ -305,6 +305,7 @@ rule DefineDefaultBuildProfiles
 				ponpokodiff
 				ponyexpress
 				ppviewer
+				prosewriter
 				querywatcher
 				remember
 				remotecontrol
diff --git a/build/jam/DeskbarCategories b/build/jam/DeskbarCategories
index 24967d1ad7..c80b11e4e0 100644
--- a/build/jam/DeskbarCategories
+++ b/build/jam/DeskbarCategories
@@ -134,6 +134,7 @@ DESKBAR_CATEGORY_Office =
 	Lingua
 	"Mr. Peeps!"
 	People
+	ProseWriter
 	TimeTracker
 	Tolmach
 	;
diff --git a/build/jam/repositories/HaikuPorts/arm64 b/build/jam/repositories/HaikuPorts/arm64
index ca93eebaeb..b024b9bbd4 100644
--- a/build/jam/repositories/HaikuPorts/arm64
+++ b/build/jam/repositories/HaikuPorts/arm64
@@ -184,6 +184,7 @@ RemotePackageRepository HaikuPorts
 	romannumbers-1.0~git-2
 	samedi-1.2-1
 	shredder-1.0.0-3
+	prosewriter-0.1-1
 	sisong-2.16-1
 	slayer-1.0-2
 	speex-1.2.1-2
