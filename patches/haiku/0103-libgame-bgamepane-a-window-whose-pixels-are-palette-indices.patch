+++ b/headers/os/game/GamePane.h
@@ -0,0 +1,174 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * BGamePane: a window whose pixels are palette indices.
+ *
+ * The program writes one byte per pixel into a world buffer that lives in the
+ * display's surface pool, which the host's GPU can read; the host looks the
+ * indices up, scales the view into the window, composites sprites and applies
+ * a filter. Nothing is copied between the bytes written here and the screen.
+ *
+ * Index 0 is transparent -- the desktop shows through it. With
+ * B_GAME_PANE_SCANLINE_PALETTE, indices 1 to 15 come from that row's own
+ * sixteen colours and 16 to 255 from the global palette; without it, all 255
+ * are global.
+ *
+ * See HaikuArmQemu/docs/game-pane.md.
+ */
+#ifndef _GAME_PANE_H
+#define _GAME_PANE_H
+
+
+#include <DirectWindow.h>
+#include <Locker.h>
+
+
+enum {
+	B_GAME_PANE_SCANLINE_PALETTE	= 1 << 0,	/* 1-15 come from the row's palette */
+	B_GAME_PANE_FULLSCREEN			= 1 << 1	/* covers the screen: the desktop is not drawn */
+};
+
+
+enum game_pane_effect {
+	B_GAME_PANE_PLAIN		= 0,
+	B_GAME_PANE_SCANLINES	= 1,
+	B_GAME_PANE_CRT			= 2
+};
+
+
+/* What a blit does where the source and the destination meet. Keyed copy is
+   the usual one: it leaves the destination wherever the source is index 0. */
+enum game_blit_op {
+	B_GAME_COPY = 0,
+	B_GAME_COPY_KEYED,
+	B_GAME_AND,
+	B_GAME_OR,
+	B_GAME_XOR
+};
+
+
+enum {
+	B_GAME_SPRITE_FLIP_X	= 1 << 1,
+	B_GAME_SPRITE_FLIP_Y	= 1 << 2
+};
+
+
+class BGamePane : public BDirectWindow {
+public:
+								BGamePane(BRect frame, const char* title,
+									uint32 worldWidth, uint32 worldHeight,
+									uint32 buffers = 2, uint32 flags = 0,
+									size_t spriteBytes = 256 * 1024);
+	virtual						~BGamePane();
+
+			status_t			InitCheck() const;
+
+	// The world: one byte per pixel, BytesPerRow() apart. World() is the
+	// buffer being drawn into, which Present() then makes the live one.
+			uint8*				World() const;
+			uint8*				RowAt(int32 y) const;
+			uint32				WorldWidth() const { return fWorldWidth; }
+			uint32				WorldHeight() const { return fWorldHeight; }
+			uint32				BytesPerRow() const { return fStride; }
+
+	// Palettes. A scanline colour only shows with B_GAME_PANE_SCANLINE_PALETTE.
+			void				SetColor(uint8 index, rgb_color color);
+			void				SetColors(uint8 first, uint32 count,
+									const rgb_color* colors);
+			rgb_color			Color(uint8 index) const;
+			void				SetScanlineColor(uint32 row, uint8 index,
+									rgb_color color);
+			void				SetScanlineColors(uint32 row, uint8 first,
+									uint32 count, const rgb_color* colors);
+
+	// The view: how much of the world the window shows, and from where.
+			void				SetView(uint32 width, uint32 height);
+			void				SetScroll(int32 x, int32 y);
+			int32				ScrollX() const { return fScrollX; }
+			int32				ScrollY() const { return fScrollY; }
+			void				SetEffect(game_pane_effect effect);
+
+	// Drawing, in the guest, on the CPU: a byte per pixel in write-back
+	// memory is faster to bang on here than to ask anything else about.
+			void				Clear(uint8 index = 0);
+			void				FillRect(int32 x, int32 y, uint32 width,
+									uint32 height, uint8 index);
+			void				Plot(int32 x, int32 y, uint8 index);
+			void				Blit(const uint8* source, uint32 sourceStride,
+									int32 x, int32 y, uint32 width,
+									uint32 height,
+									game_blit_op op = B_GAME_COPY_KEYED);
+
+	// Sprites are transformed by the host, so they scale and rotate. Define
+	// a shape once; list the ones you want each frame, then Present().
+			int32				DefineSprite(const uint8* pixels,
+									uint32 width, uint32 height);
+			void				ClearSprites();
+			status_t			DrawSprite(int32 shape, int32 x, int32 y,
+									float scale = 1.0f, float rotation = 0.0f,
+									float alpha = 1.0f, uint8 paletteBase = 0,
+									uint32 flags = 0);
+
+	// A frame. Present() makes the buffer just drawn the live one and moves
+	// on to the next; WaitForRetrace() blocks until the host's next vsync.
+			void				Present();
+			status_t			WaitForRetrace(bigtime_t timeout = 100000);
+
+	virtual	void				DirectConnected(direct_buffer_info* info);
+
+private:
+			enum { kMaxSprites = 64 };
+
+			// Guest-side bookkeeping for a shape cut from the sprite arena.
+			struct sprite_shape {
+				uint64			offset;		// within the allocation
+				uint32			width;
+				uint32			height;
+				uint32			stride;
+			};
+
+			void				_Configure();
+			void				_Free();
+
+			status_t			fStatus;
+			int					fDevice;
+			area_id				fPoolClone;
+			uint8*				fPool;
+
+			uint32				fPaneID;
+			uint64				fPoolOffset;
+			uint32				fWorldWidth;
+			uint32				fWorldHeight;
+			uint32				fStride;
+			uint32				fBuffers;
+			uint32				fBufferIndex;
+			uint64				fBufferStride;
+			uint64				fBufferOffset;
+			uint64				fPaletteOffset;
+			uint64				fSpriteTableOffset;
+			uint64				fSpriteArenaOffset;
+			size_t				fSpriteArenaSize;
+			size_t				fSpriteArenaUsed;
+			uint32				fSpriteCount;
+			uint32				fShapeCount;
+			sprite_shape		fShapes[kMaxSprites];
+
+			uint32				fFlags;
+			uint32				fEffect;
+			uint32				fViewWidth;
+			uint32				fViewHeight;
+			int32				fScrollX;
+			int32				fScrollY;
+
+			BLocker				fLock;
+			bool				fConnected;
+			clipping_rect		fBounds;
+			uint32				fClipCount;
+			clipping_rect		fClip[32];
+
+			uint32				_reserved[8];
+};
+
+
+#endif	/* _GAME_PANE_H */
diff --git a/src/kits/game/GamePane.cpp b/src/kits/game/GamePane.cpp
new file mode 100644
index 0000000000..4c36f15c9c
--- /dev/null
+++ b/src/kits/game/GamePane.cpp
@@ -0,0 +1,565 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * BGamePane: retro mode. See headers/os/game/GamePane.h and
+ * HaikuArmQemu/docs/game-pane.md.
+ *
+ * The world buffers, the palette and the sprites all live in one allocation
+ * inside the display's surface pool, which is host memory: the bytes written
+ * here are the bytes the host's GPU reads. What this class does is lay that
+ * allocation out, keep the host told where the window is, and bang on bytes.
+ */
+
+
+#include <GamePane.h>
+
+#include <Autolock.h>
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <new>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include <prose_display.h>
+
+
+#define ALIGN_UP(x, a)	((((x) + (a) - 1) / (a)) * (a))
+
+static const char* kDeviceDir = "/dev/graphics/prose_display";
+
+
+/// Every pane in a team shares nothing but the device; one open each is fine.
+static int
+open_display_device()
+{
+	DIR* dir = opendir(kDeviceDir);
+	if (dir == NULL)
+		return -1;
+	int fd = -1;
+	while (struct dirent* entry = readdir(dir)) {
+		if (entry->d_name[0] == '.')
+			continue;
+		char path[B_PATH_NAME_LENGTH];
+		snprintf(path, sizeof(path), "%s/%s", kDeviceDir, entry->d_name);
+		fd = open(path, B_READ_WRITE);
+		if (fd >= 0)
+			break;
+	}
+	closedir(dir);
+	return fd;
+}
+
+
+static inline uint32
+to_bgrx(rgb_color color)
+{
+	return ((uint32)color.red << 16) | ((uint32)color.green << 8) | color.blue;
+}
+
+
+//	#pragma mark -
+
+
+BGamePane::BGamePane(BRect frame, const char* title, uint32 worldWidth,
+	uint32 worldHeight, uint32 buffers, uint32 flags, size_t spriteBytes)
+	:
+	BDirectWindow(frame, title, B_TITLED_WINDOW, B_NOT_ZOOMABLE),
+	fStatus(B_NO_INIT),
+	fDevice(-1),
+	fPoolClone(-1),
+	fPool(NULL),
+	fPaneID(0),
+	fPoolOffset(0),
+	fWorldWidth(worldWidth),
+	fWorldHeight(worldHeight),
+	fStride(0),
+	fBuffers(buffers < 1 ? 1 : (buffers > PRDS_PANE_BUFFERS_MAX
+		? PRDS_PANE_BUFFERS_MAX : buffers)),
+	fBufferIndex(0),
+	fSpriteArenaSize(spriteBytes),
+	fSpriteArenaUsed(0),
+	fSpriteCount(0),
+	fShapeCount(0),
+	fFlags(flags),
+	fEffect(PRDS_EFFECT_NONE),
+	fViewWidth(worldWidth),
+	fViewHeight(worldHeight),
+	fScrollX(0),
+	fScrollY(0),
+	fLock("game pane"),
+	fConnected(false),
+	fClipCount(0)
+{
+	memset(&fBounds, 0, sizeof(fBounds));
+	memset(fClip, 0, sizeof(fClip));
+	memset(fShapes, 0, sizeof(fShapes));
+
+	if (worldWidth == 0 || worldHeight == 0) {
+		fStatus = B_BAD_VALUE;
+		return;
+	}
+	if (!SupportsWindowMode()) {
+		fStatus = B_NOT_SUPPORTED;
+		return;
+	}
+
+	fDevice = open_display_device();
+	if (fDevice < 0) {
+		fStatus = B_DEVICE_NOT_FOUND;
+		return;
+	}
+
+	area_info poolInfo;
+	if (ioctl(fDevice, PRDS_CLONE_POOL, &poolInfo, sizeof(poolInfo)) != 0) {
+		fStatus = errno != 0 ? (status_t)errno : B_ERROR;
+		return;
+	}
+	fPoolClone = poolInfo.area;
+	fPool = (uint8*)poolInfo.address;
+
+	// One allocation: the buffers, then the palette, then the sprite table
+	// and the pixels the sprites are cut from.
+	fStride = ALIGN_UP(worldWidth, 16);
+	fBufferOffset = 0;
+	fBufferStride = ALIGN_UP((uint64)fStride * worldHeight, 64);
+	fPaletteOffset = fBufferOffset + fBufferStride * fBuffers;
+	uint64 paletteSize = (256 + (uint64)worldHeight * 16) * 4;
+	fSpriteTableOffset = ALIGN_UP(fPaletteOffset + paletteSize, 64);
+	fSpriteArenaOffset = fSpriteTableOffset
+		+ PRDS_MAX_SPRITES * sizeof(struct prds_sprite);
+	fSpriteArenaOffset = ALIGN_UP(fSpriteArenaOffset, 64);
+
+	struct prds_pane_alloc alloc;
+	memset(&alloc, 0, sizeof(alloc));
+	alloc.size = fSpriteArenaOffset + fSpriteArenaSize;
+	alloc.format = PRDS_PANE_INDEXED8;
+	alloc.world_width = worldWidth;
+	alloc.world_height = worldHeight;
+	alloc.stride = fStride;
+	alloc.buffers = fBuffers;
+	alloc.buffer_offset = fBufferOffset;
+	alloc.buffer_stride = fBufferStride;
+	alloc.palette_offset = fPaletteOffset;
+	if (ioctl(fDevice, PRDS_PANE_ALLOC, &alloc, sizeof(alloc)) != 0) {
+		fStatus = errno != 0 ? (status_t)errno : B_ERROR;
+		return;
+	}
+	fPaneID = alloc.pane_id;
+	fPoolOffset = alloc.pool_offset;
+
+	memset(fPool + fPoolOffset, 0, (size_t)(fSpriteArenaOffset + fSpriteArenaSize));
+	fStatus = B_OK;
+}
+
+
+BGamePane::~BGamePane()
+{
+	_Free();
+}
+
+
+void
+BGamePane::_Free()
+{
+	if (fDevice >= 0) {
+		if (fStatus == B_OK) {
+			uint32 id = fPaneID;
+			ioctl(fDevice, PRDS_PANE_FREE, &id, sizeof(id));
+		}
+		close(fDevice);
+		fDevice = -1;
+	}
+	if (fPoolClone >= 0) {
+		delete_area(fPoolClone);
+		fPoolClone = -1;
+		fPool = NULL;
+	}
+	fStatus = B_NO_INIT;
+}
+
+
+status_t
+BGamePane::InitCheck() const
+{
+	return fStatus;
+}
+
+
+//	#pragma mark - the world
+
+
+uint8*
+BGamePane::World() const
+{
+	if (fStatus != B_OK)
+		return NULL;
+	return fPool + fPoolOffset + fBufferOffset + fBufferStride * fBufferIndex;
+}
+
+
+uint8*
+BGamePane::RowAt(int32 y) const
+{
+	uint8* world = World();
+	if (world == NULL || y < 0 || (uint32)y >= fWorldHeight)
+		return NULL;
+	return world + (uint32)y * fStride;
+}
+
+
+//	#pragma mark - palettes
+
+
+void
+BGamePane::SetColor(uint8 index, rgb_color color)
+{
+	if (fStatus != B_OK)
+		return;
+	uint32* palette = (uint32*)(fPool + fPoolOffset + fPaletteOffset);
+	palette[index] = to_bgrx(color);
+}
+
+
+void
+BGamePane::SetColors(uint8 first, uint32 count, const rgb_color* colors)
+{
+	if (fStatus != B_OK || colors == NULL)
+		return;
+	uint32* palette = (uint32*)(fPool + fPoolOffset + fPaletteOffset);
+	for (uint32 i = 0; i < count && first + i < 256; i++)
+		palette[first + i] = to_bgrx(colors[i]);
+}
+
+
+rgb_color
+BGamePane::Color(uint8 index) const
+{
+	rgb_color color = { 0, 0, 0, 255 };
+	if (fStatus != B_OK)
+		return color;
+	uint32 value = ((uint32*)(fPool + fPoolOffset + fPaletteOffset))[index];
+	color.red = (value >> 16) & 0xff;
+	color.green = (value >> 8) & 0xff;
+	color.blue = value & 0xff;
+	return color;
+}
+
+
+void
+BGamePane::SetScanlineColor(uint32 row, uint8 index, rgb_color color)
+{
+	if (fStatus != B_OK || row >= fWorldHeight || index >= 16)
+		return;
+	uint32* palette = (uint32*)(fPool + fPoolOffset + fPaletteOffset);
+	palette[256 + row * 16 + index] = to_bgrx(color);
+}
+
+
+void
+BGamePane::SetScanlineColors(uint32 row, uint8 first, uint32 count,
+	const rgb_color* colors)
+{
+	for (uint32 i = 0; i < count; i++)
+		SetScanlineColor(row, first + i, colors[i]);
+}
+
+
+//	#pragma mark - the view
+
+
+void
+BGamePane::SetView(uint32 width, uint32 height)
+{
+	if (width == 0 || height == 0)
+		return;
+	BAutolock lock(fLock);
+	fViewWidth = width;
+	fViewHeight = height;
+	_Configure();
+}
+
+
+void
+BGamePane::SetScroll(int32 x, int32 y)
+{
+	BAutolock lock(fLock);
+	if (x == fScrollX && y == fScrollY)
+		return;
+	fScrollX = x;
+	fScrollY = y;
+	_Configure();
+}
+
+
+void
+BGamePane::SetEffect(game_pane_effect effect)
+{
+	BAutolock lock(fLock);
+	fEffect = (uint32)effect;
+	_Configure();
+}
+
+
+//	#pragma mark - drawing
+
+
+void
+BGamePane::Clear(uint8 index)
+{
+	uint8* world = World();
+	if (world == NULL)
+		return;
+	if (fStride == fWorldWidth)
+		memset(world, index, (size_t)fStride * fWorldHeight);
+	else {
+		for (uint32 y = 0; y < fWorldHeight; y++)
+			memset(world + (size_t)y * fStride, index, fWorldWidth);
+	}
+}
+
+
+void
+BGamePane::FillRect(int32 x, int32 y, uint32 width, uint32 height, uint8 index)
+{
+	uint8* world = World();
+	if (world == NULL)
+		return;
+	if (x < 0) { if ((uint32)-x >= width) return; width += x; x = 0; }
+	if (y < 0) { if ((uint32)-y >= height) return; height += y; y = 0; }
+	if ((uint32)x >= fWorldWidth || (uint32)y >= fWorldHeight)
+		return;
+	if (x + width > fWorldWidth)
+		width = fWorldWidth - x;
+	if (y + height > fWorldHeight)
+		height = fWorldHeight - y;
+	for (uint32 row = 0; row < height; row++)
+		memset(world + (size_t)(y + row) * fStride + x, index, width);
+}
+
+
+void
+BGamePane::Plot(int32 x, int32 y, uint8 index)
+{
+	uint8* world = World();
+	if (world == NULL || x < 0 || y < 0
+		|| (uint32)x >= fWorldWidth || (uint32)y >= fWorldHeight)
+		return;
+	world[(size_t)y * fStride + x] = index;
+}
+
+
+void
+BGamePane::Blit(const uint8* source, uint32 sourceStride, int32 x, int32 y,
+	uint32 width, uint32 height, game_blit_op op)
+{
+	uint8* world = World();
+	if (world == NULL || source == NULL)
+		return;
+	uint32 skipX = 0, skipY = 0;
+	if (x < 0) { if ((uint32)-x >= width) return; skipX = -x; width += x; x = 0; }
+	if (y < 0) { if ((uint32)-y >= height) return; skipY = -y; height += y; y = 0; }
+	if ((uint32)x >= fWorldWidth || (uint32)y >= fWorldHeight)
+		return;
+	if (x + width > fWorldWidth)
+		width = fWorldWidth - x;
+	if (y + height > fWorldHeight)
+		height = fWorldHeight - y;
+
+	for (uint32 row = 0; row < height; row++) {
+		const uint8* in = source + (size_t)(skipY + row) * sourceStride + skipX;
+		uint8* out = world + (size_t)(y + row) * fStride + x;
+		switch (op) {
+			case B_GAME_COPY:
+				memcpy(out, in, width);
+				break;
+			case B_GAME_COPY_KEYED:
+				for (uint32 i = 0; i < width; i++) {
+					if (in[i] != 0)
+						out[i] = in[i];
+				}
+				break;
+			case B_GAME_AND:
+				for (uint32 i = 0; i < width; i++)
+					out[i] &= in[i];
+				break;
+			case B_GAME_OR:
+				for (uint32 i = 0; i < width; i++)
+					out[i] |= in[i];
+				break;
+			case B_GAME_XOR:
+				for (uint32 i = 0; i < width; i++)
+					out[i] ^= in[i];
+				break;
+		}
+	}
+}
+
+
+//	#pragma mark - sprites
+
+
+int32
+BGamePane::DefineSprite(const uint8* pixels, uint32 width, uint32 height)
+{
+	if (fStatus != B_OK || pixels == NULL || width == 0 || height == 0)
+		return B_BAD_VALUE;
+
+	BAutolock lock(fLock);
+	if (fShapeCount >= kMaxSprites)
+		return B_NO_MEMORY;
+	size_t need = ALIGN_UP((size_t)width * height, 16);
+	if (fSpriteArenaUsed + need > fSpriteArenaSize)
+		return B_NO_MEMORY;
+
+	// The arena holds the pixels; where each shape sits is ours to remember.
+	uint8* arena = fPool + fPoolOffset + fSpriteArenaOffset;
+	memcpy(arena + fSpriteArenaUsed, pixels, (size_t)width * height);
+	sprite_shape& shape = fShapes[fShapeCount];
+	shape.offset = fSpriteArenaOffset + fSpriteArenaUsed;
+	shape.width = width;
+	shape.height = height;
+	shape.stride = width;
+	fSpriteArenaUsed += need;
+	return (int32)fShapeCount++;
+}
+
+
+void
+BGamePane::ClearSprites()
+{
+	BAutolock lock(fLock);
+	fSpriteCount = 0;
+}
+
+
+status_t
+BGamePane::DrawSprite(int32 shape, int32 x, int32 y, float scale,
+	float rotation, float alpha, uint8 paletteBase, uint32 flags)
+{
+	if (fStatus != B_OK)
+		return B_NO_INIT;
+	BAutolock lock(fLock);
+	if (shape < 0 || (uint32)shape >= fShapeCount)
+		return B_BAD_VALUE;
+	if (fSpriteCount >= PRDS_MAX_SPRITES)
+		return B_NO_MEMORY;
+
+	const sprite_shape* table = &fShapes[shape];
+	struct prds_sprite* sprite = (struct prds_sprite*)(fPool + fPoolOffset
+		+ fSpriteTableOffset) + fSpriteCount;
+	sprite->x = x;
+	sprite->y = y;
+	sprite->width = table->width;
+	sprite->height = table->height;
+	sprite->offset = fPoolOffset + table->offset;
+	sprite->stride = table->stride;
+	sprite->flags = flags;
+	sprite->scale = scale;
+	sprite->rotation = rotation;
+	sprite->alpha = alpha;
+	sprite->palette_base = paletteBase;
+	fSpriteCount++;
+	return B_OK;
+}
+
+
+//	#pragma mark - frames
+
+
+void
+BGamePane::Present()
+{
+	if (fStatus != B_OK)
+		return;
+	BAutolock lock(fLock);
+
+	struct prds_pane_present_request request;
+	memset(&request, 0, sizeof(request));
+	request.pane_id = fPaneID;
+	request.buffer_index = fBufferIndex;
+	request.sprite_count = fSpriteCount;
+	request.sprite_offset = fSpriteTableOffset;
+	ioctl(fDevice, PRDS_PANE_PRESENT, &request, sizeof(request));
+
+	fBufferIndex = (fBufferIndex + 1) % fBuffers;
+}
+
+
+status_t
+BGamePane::WaitForRetrace(bigtime_t timeout)
+{
+	if (fStatus != B_OK)
+		return B_NO_INIT;
+	bigtime_t value = timeout;
+	if (ioctl(fDevice, PRDS_PANE_WAIT_RETRACE, &value, sizeof(value)) != 0)
+		return errno != 0 ? (status_t)errno : B_ERROR;
+	return B_OK;
+}
+
+
+//	#pragma mark - geometry
+
+
+void
+BGamePane::DirectConnected(direct_buffer_info* info)
+{
+	// The pixels it offers are of no use to us; the geometry is the point.
+	BAutolock lock(fLock);
+	uint32 state = info->buffer_state & B_DIRECT_MODE_MASK;
+	if (state == B_DIRECT_STOP) {
+		fConnected = false;
+		fClipCount = 0;
+	} else {
+		fConnected = true;
+		fBounds = info->window_bounds;
+		fClipCount = info->clip_list_count;
+		if (fClipCount > PRDS_MAX_CLIP_RECTS)
+			fClipCount = PRDS_MAX_CLIP_RECTS;
+		for (uint32 i = 0; i < fClipCount; i++)
+			fClip[i] = info->clip_list[i];
+	}
+	_Configure();
+}
+
+
+/// Called with the lock held.
+void
+BGamePane::_Configure()
+{
+	if (fStatus != B_OK)
+		return;
+
+	struct prds_pane_config_request config;
+	memset(&config, 0, sizeof(config));
+	config.pane_id = fPaneID;
+	config.flags = fConnected ? PRDS_PANE_F_VISIBLE : 0;
+	if ((fFlags & B_GAME_PANE_SCANLINE_PALETTE) != 0)
+		config.flags |= PRDS_PANE_F_SCANLINE;
+	if ((fFlags & B_GAME_PANE_FULLSCREEN) != 0)
+		config.flags |= PRDS_PANE_F_FULLSCREEN;
+	config.dest_x = fBounds.left;
+	config.dest_y = fBounds.top;
+	config.dest_width = fBounds.right >= fBounds.left
+		? fBounds.right - fBounds.left + 1 : 0;
+	config.dest_height = fBounds.bottom >= fBounds.top
+		? fBounds.bottom - fBounds.top + 1 : 0;
+	config.view_width = fViewWidth;
+	config.view_height = fViewHeight;
+	config.scroll_x = fScrollX;
+	config.scroll_y = fScrollY;
+	config.effect = fEffect;
+	config.clip_count = fConnected ? fClipCount : 0;
+	for (uint32 i = 0; i < config.clip_count; i++) {
+		config.clip[i].x = fClip[i].left;
+		config.clip[i].y = fClip[i].top;
+		config.clip[i].width = fClip[i].right - fClip[i].left + 1;
+		config.clip[i].height = fClip[i].bottom - fClip[i].top + 1;
+	}
+	ioctl(fDevice, PRDS_PANE_CONFIGURE, &config, sizeof(config));
+}
