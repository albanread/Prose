 	fSpriteArenaOffset = ALIGN_UP(fSpriteArenaOffset, 64);
+	// two shader buffers, one for each layer: a source goes in, and the
+	// compiler's complaint comes back in its place
 	fShaderSize = PRDS_SHADER_MAX;
 	fShaderOffset = ALIGN_UP(fSpriteArenaOffset + fSpriteArenaSize, 64);
+	fFailedShader = fShaderOffset;
 
 	struct prds_pane_alloc alloc;
 	memset(&alloc, 0, sizeof(alloc));
