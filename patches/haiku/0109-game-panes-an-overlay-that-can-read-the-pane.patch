 	alloc.world_width = worldWidth;
 	alloc.world_height = worldHeight;
@@ -156,7 +159,7 @@ BGamePane::BGamePane(BRect frame, const char* title, uint32 worldWidth,
 	fPaneID = alloc.pane_id;
 	fPoolOffset = alloc.pool_offset;
 
-	memset(fPool + fPoolOffset, 0, (size_t)(fShaderOffset + fShaderSize));
+	memset(fPool + fPoolOffset, 0, (size_t)(fShaderOffset + fShaderSize * 2));
 	fStatus = B_OK;
 }
 
@@ -477,26 +480,43 @@ BGamePane::DefineSprite(const uint8* pixels, uint32 width, uint32 height, uint32
 
 
 status_t
-BGamePane::SetShader(const char* metalSource)
+BGamePane::SetBackgroundShader(const char* metalSource)
+{
