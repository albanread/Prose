+	//     float4 p.colour(float2 at)   the finished pane, nearest
+	//     float4 p.smooth(float2 at)   the same, interpolated
+	//     uint   p.index(float2 at)    the palette index there, 0 transparent
+	//     float3 p.palette(uint i)     a global palette entry
+	//
+	// `colour()` and `smooth()` are black in a background function, which runs
+	// before there is a picture. Neither function can reach anything else: not
+	// the pool at large, not another pane, not the host. A source that does not
+	// compile fails the call and leaves the compiler's complaint in
+	// ShaderError(); a NULL or empty one takes that layer away again.
+			status_t			SetBackgroundShader(const char* metalSource);
+			status_t			SetOverlayShader(const char* metalSource);
 			const char*			ShaderError() const;
 
