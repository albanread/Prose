+/// The overlay: handed the finished pane, and free to look anywhere in it.
+/// Heat rising off the ground displaces what is behind it, bright pixels
+/// bleed into their neighbours, and the light falls off at the corners --
+/// none of which the pane could do for itself, and none of which the pane
+/// has to know about.
+void
+RetroPane::_SetOverlay(bool on)
+{
+	if (!on) {
+		SetOverlayShader(NULL);
+		fOverlay = false;
+		return;
+	}
+	static const char* kOverlay =
+		"float4 overlay(float4 colour, pane p)\n"
+		"{\n"
+		"    float heat = smoothstep(0.34, 0.60, p.uv.y) * (1.0 - smoothstep(0.60, 0.78, p.uv.y));\n"
+		"    float2 uv = p.uv + float2(sin(p.uv.y * 60.0 + p.time * 4.0) * 0.007 * heat, 0.0);\n"
+		"    float4 c = p.smooth(uv);\n"
+		"    float4 glow = float4(0.0);\n"
+		"    for (int i = 0; i < 4; i++) {\n"
+		"        float a = float(i) * 1.5707963 + 0.4;\n"
+		"        glow += p.colour(uv + float2(cos(a), sin(a)) * 0.013);\n"
+		"    }\n"
+		"    glow *= 0.25;\n"
+		"    float bright = max(max(glow.r, glow.g), glow.b);\n"
+		"    c.rgb += glow.rgb * smoothstep(0.55, 1.0, bright) * 0.6;\n"
+		"    float2 d = p.uv * 2.0 - 1.0;\n"
+		"    c.rgb *= 1.0 - 0.18 * dot(d, d);\n"
+		"    return c;\n"
+		"}\n";
+	if (SetOverlayShader(kOverlay) != B_OK) {
+		fprintf(stderr, "Retro: the overlay would not compile:\n%s\n", ShaderError());
+		fOverlay = false;
+		return;
+	}
+	fOverlay = true;
+}
+
