index d0ab26a102..b2f8d1d294 100644
--- a/src/kits/tracker/VirtualDirectoryManager.cpp
+++ b/src/kits/tracker/VirtualDirectoryManager.cpp
@@ -15,6 +15,8 @@
 
 #include <Directory.h>
 #include <File.h>
+#include <Node.h>
+#include <fs_attr.h>
 #include <StringList.h>
 
 #include <AutoDeleter.h>
@@ -33,6 +35,48 @@ static const size_t kMaxVirtualDirectoryFileSize = 10 * 1024;
 static const char* const kTemporaryDefinitionFileBaseDirectoryPath
 	= "/tmp/tracker/virtual-directories";
 
+// the attributes a directory's own icon is in
+static const char* const kIconAttributes[] = {
+	"BEOS:ICON", "BEOS:M:STD_ICON", "BEOS:L:STD_ICON"
+};
+static const off_t kMaxIconAttributeSize = 64 * 1024;
+
+
+static void
+copy_directory_icon(const BStringList& rootDirectoryPaths,
+	const BString& subDirectory, BNode& definitionFile)
+{
+	// the icon of the first merged directory that has one
+	for (int32 i = 0; i < rootDirectoryPaths.CountStrings(); i++) {
+		BString path = rootDirectoryPaths.StringAt(i);
+		path << '/' << subDirectory;
+		BNode directory(path.String());
+		if (directory.InitCheck() != B_OK)
+			continue;
+
+		bool copied = false;
+		for (size_t j = 0; j < B_COUNT_OF(kIconAttributes); j++) {
+			attr_info info;
+			if (directory.GetAttrInfo(kIconAttributes[j], &info) != B_OK
+				|| info.size <= 0 || info.size > kMaxIconAttributeSize) {
+				continue;
