diff --git a/src/bin/prosetheme/prosetheme.cpp b/src/bin/prosetheme/prosetheme.cpp
new file mode 100644
index 0000000000..f6682c1467
--- /dev/null
+++ b/src/bin/prosetheme/prosetheme.cpp
@@ -0,0 +1,521 @@
+/*
+ * Copyright 2026, the Prose project. MIT licence.
+ *
+ * prosetheme: apply a theme to this machine -- a window decorator, the
+ * system's colours and the desktop's wallpaper, from one file -- so the host
+ * can offer themes in a menu and switch them through the portal.
+ *
+ *   prosetheme --list        the themes there are; "* " marks the current one
+ *   prosetheme --current     the current theme's name
+ *   prosetheme --show NAME   what a theme sets
+ *   prosetheme NAME          apply it
+ *
+ * A theme is NAME.theme in /boot/system/data/prose/themes (shipped) or in
+ * ~/config/settings/prose/themes (the user's, which win), lines of
+ * "key = value":
+ *
+ *   decorator = ProseDecorator      a decorator's name as setdecor knows it
+ *   wallpaper = /path/to/image.png  scaled to the screen; "none" clears it
+ *   window_tab = 236,236,236        a colour, r,g,b -- the keys are below
+ *
+ * A key a theme leaves out keeps its current value, so a theme may be partial.
+ * app_server keeps the colours and the decorator, Tracker keeps the wallpaper,
+ * so what was applied survives a restart; the name is kept in
+ * ~/config/settings/prose/theme for --list and --current.
+ */
+
+
+#include <ctype.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <Application.h>
+#include <Directory.h>
+#include <Entry.h>
+#include <File.h>
+#include <FindDirectory.h>
+#include <InterfaceDefs.h>
+#include <Message.h>
+#include <Messenger.h>
+#include <Node.h>
+#include <Path.h>
+#include <String.h>
+
+#include <be_apps/Tracker/Background.h>
+#include <DecorInfo.h>
+
+
+static const char* kTrackerSignature = "application/x-vnd.Be-TRAK";
+static const char* kThemesSubdirectory = "prose/themes";
+static const char* kCurrentFile = "prose/theme";
+
+
+static const struct {
+	const char*	key;
+	color_which	which;
+} kColorKeys[] = {
+	{ "panel_background", B_PANEL_BACKGROUND_COLOR },
+	{ "panel_text", B_PANEL_TEXT_COLOR },
+	{ "document_background", B_DOCUMENT_BACKGROUND_COLOR },
+	{ "document_text", B_DOCUMENT_TEXT_COLOR },
+	{ "control_background", B_CONTROL_BACKGROUND_COLOR },
+	{ "control_text", B_CONTROL_TEXT_COLOR },
+	{ "control_border", B_CONTROL_BORDER_COLOR },
+	{ "control_highlight", B_CONTROL_HIGHLIGHT_COLOR },
+	{ "control_mark", B_CONTROL_MARK_COLOR },
+	{ "navigation_base", B_NAVIGATION_BASE_COLOR },
+	{ "navigation_pulse", B_NAVIGATION_PULSE_COLOR },
+	{ "shine", B_SHINE_COLOR },
+	{ "shadow", B_SHADOW_COLOR },
+	{ "link_text", B_LINK_TEXT_COLOR },
+	{ "link_hover", B_LINK_HOVER_COLOR },
+	{ "link_visited", B_LINK_VISITED_COLOR },
+	{ "link_active", B_LINK_ACTIVE_COLOR },
+	{ "menu_background", B_MENU_BACKGROUND_COLOR },
+	{ "menu_selected_background", B_MENU_SELECTED_BACKGROUND_COLOR },
+	{ "menu_text", B_MENU_ITEM_TEXT_COLOR },
+	{ "menu_selected_text", B_MENU_SELECTED_ITEM_TEXT_COLOR },
+	{ "menu_selected_border", B_MENU_SELECTED_BORDER_COLOR },
+	{ "list_background", B_LIST_BACKGROUND_COLOR },
+	{ "list_selected_background", B_LIST_SELECTED_BACKGROUND_COLOR },
+	{ "list_text", B_LIST_ITEM_TEXT_COLOR },
+	{ "list_selected_text", B_LIST_SELECTED_ITEM_TEXT_COLOR },
+	{ "scroll_bar_thumb", B_SCROLL_BAR_THUMB_COLOR },
+	{ "tooltip_background", B_TOOL_TIP_BACKGROUND_COLOR },
+	{ "tooltip_text", B_TOOL_TIP_TEXT_COLOR },
+	{ "status_bar", B_STATUS_BAR_COLOR },
+	{ "success", B_SUCCESS_COLOR },
+	{ "failure", B_FAILURE_COLOR },
+	{ "window_tab", B_WINDOW_TAB_COLOR },
+	{ "window_text", B_WINDOW_TEXT_COLOR },
+	{ "window_inactive_tab", B_WINDOW_INACTIVE_TAB_COLOR },
+	{ "window_inactive_text", B_WINDOW_INACTIVE_TEXT_COLOR },
+	{ "window_border", B_WINDOW_BORDER_COLOR },
+	{ "window_inactive_border", B_WINDOW_INACTIVE_BORDER_COLOR },
+	{ "desktop", B_DESKTOP_COLOR },
+};
+static const size_t kColorKeyCount = sizeof(kColorKeys) / sizeof(kColorKeys[0]);
+
+
+struct Theme {
+	BString		name;
+	BString		decorator;
+	bool		hasWallpaper;
+	BString		wallpaper;			// empty with hasWallpaper: none
+	bool		hasColor[kColorKeyCount];
+	rgb_color	color[kColorKeyCount];
+
+	Theme()
+		:
+		hasWallpaper(false)
+	{
+		memset(hasColor, 0, sizeof(hasColor));
+	}
+};
+
+
+// #pragma mark - where themes are
+
+
+static bool
+themes_directory(directory_which which, BPath& path)
+{
+	if (find_directory(which, &path) != B_OK)
+		return false;
+	path.Append(kThemesSubdirectory);
+	return true;
+}
+
+
+static bool
+current_theme_path(BPath& path)
+{
+	if (find_directory(B_USER_SETTINGS_DIRECTORY, &path) != B_OK)
+		return false;
+	path.Append(kCurrentFile);
+	return true;
+}
+
+
+static BString
+current_theme()
+{
+	BPath path;
+	if (!current_theme_path(path))
+		return BString();
+	BFile file(path.Path(), B_READ_ONLY);
+	if (file.InitCheck() != B_OK)
+		return BString();
+	char buffer[256];
+	ssize_t read = file.Read(buffer, sizeof(buffer) - 1);
+	if (read <= 0)
+		return BString();
+	buffer[read] = '\0';
+	BString name(buffer);
+	name.Trim();
+	return name;
+}
+
+
+static status_t
+remember_theme(const char* name)
+{
+	BPath path;
+	if (!current_theme_path(path))
+		return B_ERROR;
+	BPath parent;
+	path.GetParent(&parent);
+	create_directory(parent.Path(), 0755);
+	BFile file(path.Path(), B_WRITE_ONLY | B_CREATE_FILE | B_ERASE_FILE);
+	if (file.InitCheck() != B_OK)
+		return file.InitCheck();
+	BString line(name);
+	line << "\n";
+	ssize_t written = file.Write(line.String(), line.Length());
+	return written == line.Length() ? B_OK : B_ERROR;
+}
+
+
+/*!	The theme's file: the user's directory first, then the shipped one. */
+static bool
+find_theme(const char* name, BPath& path)
+{
+	const directory_which places[] = {
+		B_USER_SETTINGS_DIRECTORY, B_SYSTEM_DATA_DIRECTORY
+	};
+	for (size_t i = 0; i < sizeof(places) / sizeof(places[0]); i++) {
+		if (!themes_directory(places[i], path))
+			continue;
+		BString file(name);
+		file << ".theme";
+		path.Append(file.String());
+		BEntry entry(path.Path());
+		if (entry.Exists() && entry.IsFile())
+			return true;
+	}
+	return false;
+}
+
+
+static int
+compare_names(const void* a, const void* b)
+{
+	return strcasecmp(*(const char* const*)a, *(const char* const*)b);
+}
+
+
+/*!	Every NAME.theme in the two directories, each name once, sorted. */
+static int32
+list_themes(BString* names, int32 capacity)
+{
+	int32 count = 0;
+	const directory_which places[] = {
+		B_SYSTEM_DATA_DIRECTORY, B_USER_SETTINGS_DIRECTORY
+	};
+	for (size_t i = 0; i < sizeof(places) / sizeof(places[0]); i++) {
+		BPath path;
+		if (!themes_directory(places[i], path))
+			continue;
+		BDirectory directory(path.Path());
+		if (directory.InitCheck() != B_OK)
+			continue;
+		BEntry entry;
+		while (directory.GetNextEntry(&entry) == B_OK && count < capacity) {
+			char leaf[B_FILE_NAME_LENGTH];
+			if (!entry.IsFile() || entry.GetName(leaf) != B_OK)
+				continue;
+			BString name(leaf);
+			if (!name.EndsWith(".theme"))
+				continue;
+			name.Truncate(name.Length() - 6);
+			bool seen = false;
+			for (int32 j = 0; j < count; j++) {
+				if (names[j].ICompare(name) == 0)
+					seen = true;
+			}
+			if (!seen)
+				names[count++] = name;
+		}
+	}
+	const char* raw[64];
+	for (int32 i = 0; i < count; i++)
+		raw[i] = names[i].String();
+	qsort(raw, count, sizeof(raw[0]), compare_names);
+	BString sorted[64];
+	for (int32 i = 0; i < count; i++)
+		sorted[i] = raw[i];
+	for (int32 i = 0; i < count; i++)
+		names[i] = sorted[i];
+	return count;
+}
+
+
+// #pragma mark - reading a theme
+
+
+static bool
+parse_color(const char* text, rgb_color& color)
+{
+	int r, g, b;
+	if (sscanf(text, "%d , %d , %d", &r, &g, &b) != 3)
+		return false;
+	if (r < 0 || r > 255 || g < 0 || g > 255 || b < 0 || b > 255)
+		return false;
+	color.red = r;
+	color.green = g;
+	color.blue = b;
+	color.alpha = 255;
+	return true;
+}
+
+
+static status_t
+read_theme(const char* name, Theme& theme)
+{
+	BPath path;
+	if (!find_theme(name, path))
+		return B_NAME_NOT_FOUND;
+	FILE* file = fopen(path.Path(), "r");
+	if (file == NULL)
+		return errno;
+
+	theme.name = name;
+	char line[1024];
+	int lineNumber = 0;
+	while (fgets(line, sizeof(line), file) != NULL) {
+		lineNumber++;
+		char* text = line;
+		while (isspace(*text))
+			text++;
+		if (*text == '#' || *text == '\0')
+			continue;
+		char* equals = strchr(text, '=');
+		if (equals == NULL) {
+			fprintf(stderr, "%s:%d: not \"key = value\"\n", path.Path(),
+				lineNumber);
+			continue;
+		}
+		*equals = '\0';
+		BString key(text);
+		key.Trim();
+		key.ToLower();
+		BString value(equals + 1);
+		value.Trim();
+
+		if (key == "decorator") {
+			theme.decorator = value;
+			continue;
+		}
+		if (key == "wallpaper") {
+			theme.hasWallpaper = true;
+			theme.wallpaper = value.ICompare("none") == 0 ? "" : value;
+			continue;
+		}
+		bool known = false;
+		for (size_t i = 0; i < kColorKeyCount; i++) {
+			if (key != kColorKeys[i].key)
+				continue;
+			known = true;
+			if (parse_color(value.String(), theme.color[i]))
+				theme.hasColor[i] = true;
+			else {
+				fprintf(stderr, "%s:%d: %s is not a colour (r,g,b)\n",
+					path.Path(), lineNumber, value.String());
+			}
+		}
+		if (!known) {
+			fprintf(stderr, "%s:%d: unknown key \"%s\"\n", path.Path(),
+				lineNumber, key.String());
+		}
+	}
+	fclose(file);
+	return B_OK;
+}
+
+
+// #pragma mark - applying one
+
+
+static status_t
+apply_decorator(const char* name)
+{
+	DecorInfoUtility utility;
+	DecorInfo* decorator = utility.FindDecorator(name);
+	if (decorator == NULL)
+		return B_NAME_NOT_FOUND;
+	if (utility.IsCurrentDecorator(decorator))
+		return B_OK;
+	return utility.SetDecorator(decorator);
+}
+
+
+/*!	What the Backgrounds preferences write for "scaled to fit" on every
+	workspace, and the refresh they ask Tracker for. An empty message is a
+	desktop with no image: the desktop colour shows. */
+static status_t
+apply_wallpaper(const char* imagePath)
+{
+	BPath desktop;
+	status_t status = find_directory(B_DESKTOP_DIRECTORY, &desktop);
+	if (status != B_OK)
+		return status;
+	BNode node(desktop.Path());
+	if (node.InitCheck() != B_OK)
+		return node.InitCheck();
+
+	BMessage info;
+	if (imagePath != NULL && imagePath[0] != '\0') {
+		BEntry image(imagePath);
+		if (!image.Exists())
+			return B_ENTRY_NOT_FOUND;
+		info.AddString(B_BACKGROUND_IMAGE, imagePath);
+		info.AddInt32(B_BACKGROUND_WORKSPACES, (int32)0xffffffff);
+		info.AddInt32(B_BACKGROUND_MODE, B_BACKGROUND_MODE_SCALED);
+		info.AddBool(B_BACKGROUND_ERASE_TEXT, false);
+		info.AddPoint(B_BACKGROUND_ORIGIN, BPoint(0, 0));
+	}
+	ssize_t size = info.FlattenedSize();
+	char* buffer = new char[size];
+	info.Flatten(buffer, size);
+	ssize_t written = node.WriteAttr(B_BACKGROUND_INFO, B_MESSAGE_TYPE, 0,
+		buffer, size);
+	delete[] buffer;
+	if (written < 0)
+		return written;
+	if (written != size)
+		return B_ERROR;
+
+	BMessenger tracker(kTrackerSignature);
+	if (tracker.IsValid())
+		tracker.SendMessage(B_RESTORE_BACKGROUND_IMAGE);
+	return B_OK;
+}
+
+
+static int
+apply_theme(const Theme& theme)
+{
+	int failures = 0;
+
+	int32 colors = 0;
+	for (size_t i = 0; i < kColorKeyCount; i++) {
+		if (!theme.hasColor[i])
+			continue;
+		set_ui_color(kColorKeys[i].which, theme.color[i]);
+		colors++;
+	}
+	printf("%s: %" B_PRId32 " colour%s", theme.name.String(), colors,
+		colors == 1 ? "" : "s");
+
+	if (theme.decorator.Length() > 0) {
+		status_t status = apply_decorator(theme.decorator.String());
+		if (status == B_OK)
+			printf(", decorator %s", theme.decorator.String());
+		else {
+			printf(", decorator %s: %s", theme.decorator.String(),
+				strerror(status));
+			failures++;
+		}
+	}
+
+	if (theme.hasWallpaper) {
+		status_t status = apply_wallpaper(theme.wallpaper.String());
+		const char* what = theme.wallpaper.Length() > 0
+			? theme.wallpaper.String() : "no wallpaper";
+		if (status == B_OK)
+			printf(", %s", what);
+		else {
+			printf(", %s: %s", what, strerror(status));
+			failures++;
+		}
+	}
+	printf("\n");
+
+	if (failures == 0 && remember_theme(theme.name.String()) != B_OK)
+		fprintf(stderr, "could not remember the theme's name\n");
+	return failures;
+}
+
+
+// #pragma mark - main
+
+
+static void
+usage()
+{
+	fprintf(stderr,
+		"usage: prosetheme --list | --current | --show NAME | NAME\n"
+		"  --list      the themes there are; \"* \" marks the current one\n"
+		"  --current   the current theme's name\n"
+		"  --show      what a theme sets\n"
+		"  NAME        apply that theme\n");
+}
+
+
+int
+main(int argc, char** argv)
+{
+	if (argc < 2) {
+		usage();
+		return 1;
+	}
+
+	if (strcmp(argv[1], "--list") == 0) {
+		BString names[64];
+		int32 count = list_themes(names, 64);
+		BString current = current_theme();
+		for (int32 i = 0; i < count; i++) {
+			printf("%s%s\n", names[i] == current ? "* " : "",
+				names[i].String());
+		}
+		return 0;
+	}
+
+	if (strcmp(argv[1], "--current") == 0) {
+		printf("%s\n", current_theme().String());
+		return 0;
+	}
+
+	// the name may be given in several words
+	BString name;
+	int first = strcmp(argv[1], "--show") == 0 ? 2 : 1;
+	for (int i = first; i < argc; i++) {
+		if (i > first)
+			name << " ";
+		name << argv[i];
+	}
+	if (name.Length() == 0) {
+		usage();
+		return 1;
+	}
+
+	Theme theme;
+	status_t status = read_theme(name.String(), theme);
+	if (status != B_OK) {
+		fprintf(stderr, "%s: %s\n", name.String(),
+			status == B_NAME_NOT_FOUND ? "no such theme" : strerror(status));
+		return 1;
+	}
+
+	if (first == 2) {
+		if (theme.decorator.Length() > 0)
+			printf("decorator = %s\n", theme.decorator.String());
+		if (theme.hasWallpaper) {
+			printf("wallpaper = %s\n", theme.wallpaper.Length() > 0
+				? theme.wallpaper.String() : "none");
+		}
+		for (size_t i = 0; i < kColorKeyCount; i++) {
+			if (!theme.hasColor[i])
+				continue;
+			printf("%s = %d,%d,%d\n", kColorKeys[i].key, theme.color[i].red,
+				theme.color[i].green, theme.color[i].blue);
+		}
+		return 0;
+	}
+
+	// colours and the decorator go through app_server: that takes a BApplication
+	BApplication application("application/x-vnd.prose-theme");
+	return apply_theme(theme) == 0 ? 0 : 1;
+}
