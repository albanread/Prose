diff --git a/build/jam/packages/ProsePortal b/build/jam/packages/ProsePortal
index e6ef8ec1cd..c62b7f6cb4 100644
--- a/build/jam/packages/ProsePortal
+++ b/build/jam/packages/ProsePortal
@@ -15,4 +15,14 @@ portalLaunch = $(portalLaunch:G=launch) ;
 SEARCH on $(portalLaunch) = [ FDirName $(HAIKU_TOP) data launch ] ;
 AddFilesToPackage data launch : $(portalLaunch) ;
 
+# The themes the host offers in View > Theme and the tool that applies one
+# (prosetheme): here for the same reason, so a newer Prose can bring newer
+# themes without a new system.
+AddFilesToPackage bin : prosetheme ;
+
+local proseThemes = "Prose Light.theme" "Prose Dark.theme" Classic.theme ;
+proseThemes = $(proseThemes:G=prose-themes) ;
+SEARCH on $(proseThemes) = [ FDirName $(HAIKU_TOP) data prose themes ] ;
+AddFilesToPackage data prose themes : $(proseThemes) ;
+
 BuildHaikuPackage $(prosePortalPackage) : prose_portal ;
