diff --git a/data/prose/themes/High Contrast.theme b/data/prose/themes/High Contrast.theme
new file mode 100644
index 0000000000..e91879a105
--- /dev/null
+++ b/data/prose/themes/High Contrast.theme	
@@ -0,0 +1,55 @@
+# High Contrast
+# Black on white wherever there is text, a black frame and title bar on
+# the window in front and a white one with a black outline behind, black
+# selections with white text, a blue keyboard focus, on a white desktop
+# with no picture, so the window in front is the one black shape.
+# The frame with glyph buttons at the right: its signs are the text colour,
+# so nothing depends on telling colours apart.
+
+decorator = ProseRightDecorator
+wallpaper = none
+
+# the window frame
+window_tab = 0,0,0
+window_text = 255,255,255
+window_inactive_tab = 255,255,255
+window_inactive_text = 0,0,0
+window_border = 0,0,0
+window_inactive_border = 0,0,0
+
+# the desktop, shown with no picture, and under the icons' labels
+desktop = 255,255,255
+
+# panels, menus, documents, controls, lists
+panel_background = 255,255,255
+panel_text = 0,0,0
+menu_background = 255,255,255
+menu_text = 0,0,0
+menu_selected_background = 0,0,0
+menu_selected_text = 255,255,255
+menu_selected_border = 0,0,0
+document_background = 255,255,255
+document_text = 0,0,0
+control_background = 255,255,255
+control_text = 0,0,0
+control_border = 0,0,0
+control_highlight = 0,0,0
+control_mark = 0,0,0
+navigation_base = 0,0,255
+navigation_pulse = 0,0,0
+shine = 255,255,255
+shadow = 0,0,0
+tooltip_background = 255,255,255
+tooltip_text = 0,0,0
+list_background = 255,255,255
+list_selected_background = 0,0,0
+list_text = 0,0,0
+list_selected_text = 255,255,255
+scroll_bar_thumb = 80,80,80
