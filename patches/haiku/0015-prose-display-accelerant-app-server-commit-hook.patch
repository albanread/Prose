@@ -0,0 +1,43 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef PROSE_DISPLAY_ACCELERANT_H
+#define PROSE_DISPLAY_ACCELERANT_H
+
+
+#include <Accelerant.h>
+#include <OS.h>
+
+#include <prose_display.h>
+
+
+typedef struct accelerant_info {
+	int					device;
+	bool				is_clone;
+
+	area_id				shared_info_area;
+	prds_shared_info*	shared_info;
+
+	area_id				pool_area;			// primary accelerant only
+	uint8*				pool;
+
+	area_id				mode_list_area;		// cloned list of display modes
+	display_mode*		mode_list;
+
+	// Rectangles app_server has finished drawing, waiting for the next vsync.
+	sem_id				dirty_lock;
+	uint32				dirty_count;
+	struct prds_rect	dirty[PRDS_MAX_COMMIT_RECTS];
+	thread_id			commit_thread;
+	volatile bool		quit;
+	uint32				commits;
+	uint32				commit_errors;
+} accelerant_info;
+
+extern accelerant_info* gInfo;
+
+extern status_t create_mode_list(void);
+
+
+#endif	/* PROSE_DISPLAY_ACCELERANT_H */
