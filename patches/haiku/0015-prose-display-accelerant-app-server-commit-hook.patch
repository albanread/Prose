+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "accelerant_protos.h"
+#include "accelerant.h"
+
+
+extern "C" void*
+get_accelerant_hook(uint32 feature, void* data)
+{
+	switch (feature) {
+		/* general */
+		case B_INIT_ACCELERANT:
+			return (void*)prose_display_init_accelerant;
+		case B_UNINIT_ACCELERANT:
+			return (void*)prose_display_uninit_accelerant;
+		case B_CLONE_ACCELERANT:
+			return (void*)prose_display_clone_accelerant;
+		case B_ACCELERANT_CLONE_INFO_SIZE:
+			return (void*)prose_display_accelerant_clone_info_size;
+		case B_GET_ACCELERANT_CLONE_INFO:
+			return (void*)prose_display_get_accelerant_clone_info;
+		case B_GET_ACCELERANT_DEVICE_INFO:
+			return (void*)prose_display_get_accelerant_device_info;
+		case B_ACCELERANT_RETRACE_SEMAPHORE:
+			return (void*)prose_display_accelerant_retrace_semaphore;
+
+		/* mode configuration */
+		case B_ACCELERANT_MODE_COUNT:
+			return (void*)prose_display_accelerant_mode_count;
+		case B_GET_MODE_LIST:
+			return (void*)prose_display_get_mode_list;
+		case B_GET_PREFERRED_DISPLAY_MODE:
+			return (void*)prose_display_get_preferred_mode;
+		case B_SET_DISPLAY_MODE:
+			return (void*)prose_display_set_display_mode;
+		case B_GET_DISPLAY_MODE:
+			return (void*)prose_display_get_display_mode;
+		case B_GET_FRAME_BUFFER_CONFIG:
+			return (void*)prose_display_get_frame_buffer_config;
+		case B_GET_PIXEL_CLOCK_LIMITS:
+			return (void*)prose_display_get_pixel_clock_limits;
+
+		/* presentation */
+		case B_COMMIT_RECTANGLES:
+			return (void*)prose_display_commit_rectangles;
+	}
+
+	return NULL;
+}
diff --git a/src/add-ons/accelerants/prose_display/mode.cpp b/src/add-ons/accelerants/prose_display/mode.cpp
new file mode 100644
index 0000000000..65574ce742
--- /dev/null
+++ b/src/add-ons/accelerants/prose_display/mode.cpp
@@ -0,0 +1,185 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <syslog.h>
+#include <unistd.h>
+
+#include <compute_display_timing.h>
+#include <create_display_modes.h>
+
+#include "accelerant_protos.h"
+#include "accelerant.h"
+
+
+//#define TRACE_MODE
+#ifdef TRACE_MODE
+extern "C" void _sPrintf(const char* format, ...);
+#	define TRACE(x) _sPrintf x
+#else
+#	define TRACE(x) ;
+#endif
+
+
+bool
+operator==(const display_mode& lhs, const display_mode& rhs)
+{
+	return lhs.space == rhs.space
+		&& lhs.virtual_width == rhs.virtual_width
+		&& lhs.virtual_height == rhs.virtual_height
+		&& lhs.h_display_start == rhs.h_display_start
+		&& lhs.v_display_start == rhs.v_display_start;
+}
+
+
+/*!	Any 32-bit mode that fits the host's maximum surface works: the host
+	checks stride and bounds, nothing else is fixed.
+*/
+static bool
+is_mode_supported(display_mode* mode)
+{
+	if (mode == NULL || mode->space != B_RGB32)
+		return false;
+	const prds_shared_info& shared = *gInfo->shared_info;
+	return mode->virtual_width >= 640 && mode->virtual_height >= 480
+		&& mode->virtual_width <= shared.max_width
+		&& mode->virtual_height <= shared.max_height;
+}
+
+
+static void
+make_mode(uint32 width, uint32 height, display_mode* mode)
+{
+	memset(mode, 0, sizeof(display_mode));
+	compute_display_timing(width, height, 60, false, &mode->timing);
+	fill_display_mode(width, height, mode);
+	mode->space = B_RGB32;
+}
+
+
+/*!	Creates the initial mode list of the primary accelerant: the mode the
+	driver set at boot (the host's preferred size) plus the standard modes
+	that fit.
+*/
+status_t
+create_mode_list(void)
+{
+	prds_shared_info& shared = *gInfo->shared_info;
+	const color_space spaces[] = { B_RGB32 };
+
+	display_mode initial;
+	make_mode(shared.current_mode.virtual_width, shared.current_mode.virtual_height,
+		&initial);
+	// the driver only knows the size; give app_server a complete mode
+	shared.current_mode = initial;
+
+	gInfo->mode_list_area = create_display_modes("prose display modes", NULL,
+		&initial, 1, spaces, 1, is_mode_supported, &gInfo->mode_list,
+		&shared.mode_count);
+	if (gInfo->mode_list_area < 0)
+		return gInfo->mode_list_area;
+
+	shared.mode_list_area = gInfo->mode_list_area;
+	return B_OK;
+}
+
+
+//	#pragma mark -
+
+
+uint32
+prose_display_accelerant_mode_count(void)
+{
+	TRACE(("prose_display_accelerant_mode_count() = %" B_PRIu32 "\n",
+		gInfo->shared_info->mode_count));
+	return gInfo->shared_info->mode_count;
+}
+
+
+status_t
+prose_display_get_mode_list(display_mode* list)
+{
+	TRACE(("prose_display_get_mode_list()\n"));
+	memcpy(list, gInfo->mode_list,
+		gInfo->shared_info->mode_count * sizeof(display_mode));
+	return B_OK;
+}
+
+
+/*!	The host window's current size (updated by MODE_HINT events). */
+status_t
+prose_display_get_preferred_mode(display_mode* mode)
+{
+	TRACE(("prose_display_get_preferred_mode()\n"));
+	const prds_shared_info& shared = *gInfo->shared_info;
+	make_mode(shared.pref_width, shared.pref_height, mode);
+	return B_OK;
+}
+
+
+status_t
+prose_display_set_display_mode(display_mode* mode)
+{
+	TRACE(("prose_display_set_display_mode()\n"));
+	if (mode == NULL)
+		return B_BAD_VALUE;
+	if (*mode == gInfo->shared_info->current_mode)
+		return B_OK;
+	if (!is_mode_supported(mode))
+		return B_UNSUPPORTED;
+
+	if (ioctl(gInfo->device, PRDS_SET_MODE, mode, sizeof(display_mode)) != 0) {
+		syslog(LOG_ERR, "prose_display: setting %ux%u failed: %s\n",
+			mode->virtual_width, mode->virtual_height, strerror(errno));
+		return B_ERROR;
+	}
+	// the driver updated size, stride and offset; keep the timing too
+	gInfo->shared_info->current_mode = *mode;
+	return B_OK;
+}
+
+
+status_t
+prose_display_get_display_mode(display_mode* mode)
+{
+	TRACE(("prose_display_get_display_mode()\n"));
+	*mode = gInfo->shared_info->current_mode;
+	return B_OK;
+}
+
+
+status_t
+prose_display_get_frame_buffer_config(frame_buffer_config* config)
+{
+	TRACE(("prose_display_get_frame_buffer_config()\n"));
+	if (gInfo->pool == NULL)
+		return B_NO_INIT;
+	config->frame_buffer = gInfo->pool + gInfo->shared_info->mode_offset;
+	config->frame_buffer_dma = NULL;
+	config->bytes_per_row = gInfo->shared_info->bytes_per_row;
+	return B_OK;
+}
+
+
+status_t
+prose_display_get_pixel_clock_limits(display_mode* mode, uint32* _low,
+	uint32* _high)
+{
+	TRACE(("prose_display_get_pixel_clock_limits()\n"));
+	// there is no pixel clock; accept anything from ~48 Hz up
+	uint32 totalPixel = (uint32)mode->timing.h_total
+		* (uint32)mode->timing.v_total;
+	uint32 clockLimit = 2000000;
+
+	*_low = totalPixel * 48L / 1000L;
+	if (*_low > clockLimit)
+		return B_ERROR;
+
+	*_high = clockLimit;
+	return B_OK;
+}
