+/*!	PROSE fork: hands the rectangles that just reached the front buffer to
+	the accelerant (B_COMMIT_RECTANGLES), for displays that present on demand.
+*/
+void
+AccelerantHWInterface::_CommitRects(const BRegion& region) const
+{
+	if (fAccCommitRectangles == NULL)
+		return;
+
+	fill_rect_params rects[32];
+	uint32 count = 0;
+	int32 rectCount = region.CountRects();
+	for (int32 i = 0; i < rectCount; i++) {
+		clipping_rect r = region.RectAtInt(i);
+		if (r.left < 0)
+			r.left = 0;
+		if (r.top < 0)
+			r.top = 0;
+		if (r.right < r.left || r.bottom < r.top || r.right > 65535 || r.bottom > 65535)
+			continue;
+		rects[count].left = r.left;
+		rects[count].top = r.top;
+		rects[count].right = r.right;
+		rects[count].bottom = r.bottom;
+		if (++count == 32) {
+			fAccCommitRectangles(rects, count);
+			count = 0;
+		}
+	}
+	if (count > 0)
+		fAccCommitRectangles(rects, count);
+}
