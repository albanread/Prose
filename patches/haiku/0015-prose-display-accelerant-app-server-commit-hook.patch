+ */
+#ifndef PROSE_DISPLAY_ACCELERANT_PROTOS_H
+#define PROSE_DISPLAY_ACCELERANT_PROTOS_H
+
+
+#include <Accelerant.h>
+
+
+#ifdef __cplusplus
