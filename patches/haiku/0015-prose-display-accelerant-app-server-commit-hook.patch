diff --git a/src/add-ons/accelerants/prose_display/accelerant.cpp b/src/add-ons/accelerants/prose_display/accelerant.cpp
new file mode 100644
index 0000000000..b7e5c82fde
--- /dev/null
+++ b/src/add-ons/accelerants/prose_display/accelerant.cpp
@@ -0,0 +1,331 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * Prose Display accelerant. The frame buffer app_server draws into is the
+ * device's surface pool itself (cloned from the driver), so drawing is zero
+ * copy; the only work here is telling the host which rectangles changed.
+ * app_server reports them through B_COMMIT_RECTANGLES after every
+ * back-to-front copy; they are collected and sent once per vsync.
+ */
+
+
+#include "accelerant_protos.h"
+#include "accelerant.h"
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <syslog.h>
+#include <unistd.h>
+
+#include <AutoDeleterOS.h>
+
+
+//#define TRACE_ACCELERANT
+#ifdef TRACE_ACCELERANT
+extern "C" void _sPrintf(const char* format, ...);
+#	define TRACE(x) _sPrintf x
+#else
+#	define TRACE(x) ;
+#endif
+
+// Without vsync events (host display asleep, headless) commit this often anyway.
+#define PRDS_COMMIT_TIMEOUT		20000
+
+
+accelerant_info* gInfo;
+
+
+//	#pragma mark - commits
+
+
+/*!	Everything collected so far becomes one bounding rectangle. */
+static void
+collapse_dirty(accelerant_info* info)
+{
+	uint32 left = UINT32_MAX, top = UINT32_MAX, right = 0, bottom = 0;
+	for (uint32 i = 0; i < info->dirty_count; i++) {
+		const prds_rect& r = info->dirty[i];
+		if (r.x < left)
+			left = r.x;
+		if (r.y < top)
+			top = r.y;
+		if (r.x + r.width > right)
+			right = r.x + r.width;
+		if (r.y + r.height > bottom)
+			bottom = r.y + r.height;
+	}
+	info->dirty[0].x = left;
+	info->dirty[0].y = top;
+	info->dirty[0].width = right - left;
+	info->dirty[0].height = bottom - top;
+	info->dirty_count = 1;
+}
+
+
+static status_t
+commit_thread(void* data)
+{
+	accelerant_info* info = (accelerant_info*)data;
+	prds_commit_request request;
+
+	bool useRetrace = true;
+	while (!info->quit) {
+		sem_id retrace = useRetrace ? info->shared_info->retrace_sem : -1;
+		status_t waited = B_ERROR;
+		if (retrace >= 0)
+			waited = acquire_sem_etc(retrace, 1, B_RELATIVE_TIMEOUT, PRDS_COMMIT_TIMEOUT);
+		if (waited != B_OK && waited != B_TIMED_OUT) {
+			// no usable vsync source (headless host, or a semaphore we may not
+			// acquire): pace commits ourselves
+			if (retrace >= 0) {
+				syslog(LOG_WARNING, "prose_display: retrace semaphore unusable (%s), "
+					"pacing commits by timer\n", strerror(waited));
+				useRetrace = false;
+			}
+			snooze(PRDS_COMMIT_TIMEOUT / 2);
+		}
+		if (info->quit)
+			break;
+
+		if (acquire_sem(info->dirty_lock) != B_OK)
+			break;
+		uint32 count = info->dirty_count;
+		if (count > 0) {
+			memcpy(request.rects, info->dirty, count * sizeof(prds_rect));
+			info->dirty_count = 0;
+		}
+		release_sem(info->dirty_lock);
+		if (count == 0)
+			continue;
+
+		request.rect_count = count;
+		if (ioctl(info->device, PRDS_COMMIT, &request, sizeof(request)) != 0)
+			info->commit_errors++;
+		else
+			info->commits++;
+	}
+	return B_OK;
+}
+
+
+status_t
+prose_display_commit_rectangles(const fill_rect_params* list, uint32 count)
+{
+	accelerant_info* info = gInfo;
+	if (info == NULL || info->dirty_lock < 0)
+		return B_NO_INIT;
+	if (acquire_sem(info->dirty_lock) != B_OK)
+		return B_ERROR;
+
+	for (uint32 i = 0; i < count; i++) {
+		const fill_rect_params& r = list[i];
+		if (r.right < r.left || r.bottom < r.top)
+			continue;
+		if (info->dirty_count == PRDS_MAX_COMMIT_RECTS)
+			collapse_dirty(info);
+		prds_rect& d = info->dirty[info->dirty_count++];
+		d.x = r.left;
+		d.y = r.top;
+		d.width = r.right - r.left + 1;
+		d.height = r.bottom - r.top + 1;
+	}
+
+	release_sem(info->dirty_lock);
+	return B_OK;
+}
+
+
+//	#pragma mark - init
+
+
+/*!	Common part of the primary accelerant's and every clone's initialization. */
+static status_t
+init_common(int device, bool isClone)
+{
+	gInfo = (accelerant_info*)calloc(1, sizeof(accelerant_info));
+	if (gInfo == NULL)
+		return B_NO_MEMORY;
+	MemoryDeleter infoDeleter(gInfo);
+
+	gInfo->is_clone = isClone;
+	gInfo->device = device;
+	gInfo->pool_area = -1;
+	gInfo->mode_list_area = -1;
+	gInfo->dirty_lock = -1;
+	gInfo->commit_thread = -1;
+
+	area_id sharedArea;
+	if (ioctl(device, PRDS_GET_SHARED_INFO, &sharedArea, sizeof(area_id)) != 0)
+		return B_ERROR;
+
+	AreaDeleter sharedDeleter(clone_area("prose display shared info",
+		(void**)&gInfo->shared_info, B_ANY_ADDRESS, B_READ_AREA | B_WRITE_AREA,
+		sharedArea));
+	status_t status = gInfo->shared_info_area = sharedDeleter.Get();
+	if (status < B_OK)
+		return status;
+
+	infoDeleter.Detach();
+	sharedDeleter.Detach();
+	return B_OK;
+}
+
+
+static void
+uninit_common(void)
+{
+	if (gInfo->pool_area >= 0)
+		delete_area(gInfo->pool_area);
+	delete_area(gInfo->shared_info_area);
+	gInfo->shared_info_area = -1;
+	gInfo->shared_info = NULL;
+
+	// close the file handle ONLY if we're the clone
+	if (gInfo->is_clone)
+		close(gInfo->device);
+
+	free(gInfo);
+	gInfo = NULL;
+}
+
+
+//	#pragma mark - public accelerant functions
+
+
+status_t
+prose_display_init_accelerant(int device)
+{
+	TRACE(("prose_display_init_accelerant()\n"));
+
+	status_t status = init_common(device, false);
+	if (status != B_OK)
+		return status;
+
+	status = create_mode_list();
+	if (status != B_OK) {
+		uninit_common();
+		return status;
+	}
+
+	area_info poolInfo;
+	if (ioctl(device, PRDS_CLONE_POOL, &poolInfo, sizeof(poolInfo)) != 0) {
+		syslog(LOG_ERR, "prose_display: cloning the surface pool failed: %s\n",
+			strerror(errno));
+		delete_area(gInfo->mode_list_area);
+		uninit_common();
+		return B_ERROR;
+	}
+	gInfo->pool_area = poolInfo.area;
+	gInfo->pool = (uint8*)poolInfo.address;
+
+	gInfo->dirty_lock = create_sem(1, "prose display dirty rects");
+	gInfo->commit_thread = spawn_thread(commit_thread, "prose display commits",
+		B_URGENT_DISPLAY_PRIORITY, gInfo);
+	if (gInfo->dirty_lock < 0 || gInfo->commit_thread < 0) {
+		syslog(LOG_ERR, "prose_display: no commit thread\n");
+		prose_display_uninit_accelerant();
+		return B_ERROR;
+	}
+	resume_thread(gInfo->commit_thread);
+
+	const prds_shared_info& shared = *gInfo->shared_info;
+	syslog(LOG_INFO, "prose_display: accelerant up: %ux%u (stride %u), pool %u KiB "
+		"at %p, %u modes, retrace sem %d\n", shared.current_mode.virtual_width,
+		shared.current_mode.virtual_height, shared.bytes_per_row,
+		(unsigned)(shared.pool_size >> 10), gInfo->pool, shared.mode_count,
+		(int)shared.retrace_sem);
+	return B_OK;
+}
+
+
+ssize_t
+prose_display_accelerant_clone_info_size(void)
+{
+	// clone info is the device name, so return its maximum size
+	return B_PATH_NAME_LENGTH;
+}
+
+
+void
+prose_display_get_accelerant_clone_info(void* info)
+{
+	ioctl(gInfo->device, PRDS_GET_DEVICE_NAME, info, B_PATH_NAME_LENGTH);
+}
+
+
+status_t
+prose_display_clone_accelerant(void* info)
+{
+	TRACE(("prose_display_clone_accelerant()\n"));
+
+	char path[B_PATH_NAME_LENGTH];
+	strcpy(path, "/dev/");
+	strlcat(path, (const char*)info, sizeof(path));
+
+	int fd = open(path, B_READ_WRITE);
+	if (fd < 0)
+		return errno;
+
+	status_t status = init_common(fd, true);
+	if (status != B_OK) {
+		close(fd);
+		return status;
+	}
+
+	// read-only clone of the primary accelerant's mode list
+	status = gInfo->mode_list_area = clone_area("prose display cloned modes",
+		(void**)&gInfo->mode_list, B_ANY_ADDRESS, B_READ_AREA,
+		gInfo->shared_info->mode_list_area);
+	if (status < B_OK) {
+		uninit_common();
+		return status;
+	}
+
+	return B_OK;
+}
+
+
+/*!	Called for the primary accelerant and for every clone. */
+void
+prose_display_uninit_accelerant(void)
+{
+	TRACE(("prose_display_uninit_accelerant()\n"));
+
+	if (gInfo->commit_thread >= 0) {
+		gInfo->quit = true;
+		status_t result;
+		wait_for_thread(gInfo->commit_thread, &result);
+		gInfo->commit_thread = -1;
+	}
+	if (gInfo->dirty_lock >= 0) {
+		delete_sem(gInfo->dirty_lock);
+		gInfo->dirty_lock = -1;
+	}
+
+	delete_area(gInfo->mode_list_area);
+	gInfo->mode_list = NULL;
+
+	uninit_common();
+}
+
+
+status_t
+prose_display_get_accelerant_device_info(accelerant_device_info* info)
+{
+	info->version = B_ACCELERANT_VERSION;
+	strcpy(info->name, "Prose Display");
+	strcpy(info->chipset, "PRDS shared-surface display");
+	strcpy(info->serial_no, "None");
+	info->memory = gInfo->shared_info->pool_size;
+	info->dac_speed = 0;
+	return B_OK;
+}
+
+
+sem_id
+prose_display_accelerant_retrace_semaphore(void)
+{
+	return gInfo->shared_info->retrace_sem;
+}
