+#endif
+
+// general
+status_t prose_display_init_accelerant(int fd);
+ssize_t prose_display_accelerant_clone_info_size(void);
+void prose_display_get_accelerant_clone_info(void* data);
+status_t prose_display_clone_accelerant(void* data);
