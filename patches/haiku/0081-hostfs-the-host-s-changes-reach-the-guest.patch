diff --git a/src/add-ons/kernel/file_systems/hostfs/kernel_interface.cpp b/src/add-ons/kernel/file_systems/hostfs/kernel_interface.cpp
index 696b322196..15f69db5c4 100644
--- a/src/add-ons/kernel/file_systems/hostfs/kernel_interface.cpp
+++ b/src/add-ons/kernel/file_systems/hostfs/kernel_interface.cpp
@@ -1504,6 +1504,17 @@ is_dot_or_dotdot(const fuse_dirent* entry)
 	entry comes with a lookup the host counts; they all go into the node table
 	right away (as idle nodes), so none is lost if the caller stops reading.
 */
+/*!	What the VFS has listed is the table's baseline of that directory: the
+	poller will not announce it as new.
+*/
+void
+Volume::MarkListed(Node* node)
+{
+	MutexLocker locker(fLock);
+	node->listed = true;
+}
+
+
 static status_t
 dir_fetch(Volume* volume, Node* dir, DirCookie* cookie)
 {
@@ -1533,6 +1544,8 @@ dir_fetch(Volume* volume, Node* dir, DirCookie* cookie)
 	}
 
 	if (plus) {
+		// what this listing holds was there before the reader asked for it
+		volume->MarkListed(dir);
 		size_t position = 0;
 		for_each_dir_record(cookie->buffer, length, position, true,
 			[&](const fuse_dirent* entry, const fuse_entry_out* lookup, size_t) {
@@ -1651,6 +1664,253 @@ hostfs_rewind_dir(fs_volume* _volume, fs_vnode* _node, void* _cookie)
 }
 
 
+//	#pragma mark - the host's changes
+
+
+// how many directories one pass asks, and how many entries of one listing
+// are diffed
+#define POLL_MAX_DIRECTORIES	256
+#define POLL_MAX_ENTRIES		4096
+
+
+struct poll_entry {
+	char		name[B_FILE_NAME_LENGTH];
+	uint64		nodeid;		// 0: the listing carries none (plain READDIR)
+	fuse_attr	attr;
+	bool		haveAttr;	// READDIRPLUS: the listing knows the attributes
+};
+
+
+struct known_entry {
+	Node*		node;
+	char		name[B_FILE_NAME_LENGTH];
+	uint64		nodeid;
+};
+
+
+static int
+poll_entry_compare_name(const void* _a, const void* _b)
+{
+	return strcmp(((const poll_entry*)_a)->name, ((const poll_entry*)_b)->name);
+}
+
+
+static int
+known_entry_compare_name(const void* _a, const void* _b)
+{
+	return strcmp(((const known_entry*)_a)->name, ((const known_entry*)_b)->name);
+}
+
+
+/*!	One pass: every directory the VFS holds a vnode for (the root always,
+	among them) is pinned and asked by _PollDirectory() what it contains now.
+	Directories nothing watches are not asked: nobody would be told.
+*/
+void
+Volume::_PollPass()
+{
+	Node* directories[POLL_MAX_DIRECTORIES];
+	int32 count = 0;
+	{
+		MutexLocker locker(fLock);
+		NodeTable::Iterator iterator = fNodes.GetIterator();
+		while (Node* node = iterator.Next()) {
+			if (node->published && node->IsDirectory()) {
+				_Busy(node);
+				node->pending++;
+				directories[count++] = node;
+				if (count == POLL_MAX_DIRECTORIES)
+					break;
+			}
+		}
+	}
+	for (int32 i = 0; i < count; i++) {
+		if (atomic_get(&fPollStop) != 0)
+			break;
+		_PollDirectory(directories[i]);
+		Unpend(directories[i]);
+	}
+}
+
+
+/*!	One directory: if the host says it changed since it was last seen, read
+	the whole listing again and tell the node monitors what differs from the
+	node table -- names that are new, names that are gone, and entries whose
+	size or modification time moved. Names new to this directory enter the
+	table as idle nodes (their listing lookups are kept until they go idle
+	again); the lookups of entries already known are returned at once, so the
+	host does not count one more reference per pass.
+*/
+void
+Volume::_PollDirectory(Node* dir)
+{
+	fuse_attr attr;
+	if (GetAttr(dir->nodeid, &attr) != B_OK)
+		return;
+
+	bool changed;
+	{
+		MutexLocker locker(dir->lock);
+		changed = attr.mtime != dir->attr.mtime
+			|| attr.mtimensec != dir->attr.mtimensec
+			|| attr.size != dir->attr.size;
+		// a directory is never stale-cached; this only refreshes
+		node_take_attr(dir, attr);
+	}
+	if (!changed)
+		return;
+
+	uint64 fh;
+	if (Open(dir->nodeid, true, LINUX_O_RDONLY, &fh) != B_OK)
+		return;
+
+	poll_entry* entries = (poll_entry*)malloc(sizeof(poll_entry) * POLL_MAX_ENTRIES);
+	uint8* buffer = (uint8*)malloc(DIR_BUFFER_SIZE);
+	known_entry* known = (known_entry*)malloc(sizeof(known_entry) * POLL_MAX_ENTRIES);
+	if (entries == NULL || buffer == NULL || known == NULL) {
+		free(entries);
+		free(buffer);
+		free(known);
+		Release(dir->nodeid, true, fh);
+		return;
+	}
+	MemoryDeleter entriesDeleter(entries);
+	MemoryDeleter bufferDeleter(buffer);
+	MemoryDeleter knownDeleter(known);
+
+	const bool plus = (InitFlags() & FUSE_DO_READDIRPLUS) != 0;
+	int32 entryCount = 0;
+	uint64 offset = 0;
+	while (entryCount < POLL_MAX_ENTRIES) {
+		fuse_read_in in = {};
+		in.fh = fh;
+		in.offset = offset;
+		in.size = DIR_BUFFER_SIZE;
+		size_t length = 0;
+		if (Request(plus ? FUSE_READDIRPLUS : FUSE_READDIR, dir->nodeid, &in,
+				sizeof(in), NULL, NULL, NULL, 0, NULL, 0, buffer, DIR_BUFFER_SIZE,
+				&length) != B_OK)
+			break;
+		if (length == 0)
+			break;	// the end of the listing
+
+		size_t position = 0;
+		bool wellFormed = for_each_dir_record(buffer, length, position, plus,
+			[&](const fuse_dirent* entry, const fuse_entry_out* lookup, size_t) {
+				offset = entry->off;
+				if (is_dot_or_dotdot(entry) || !is_usable_name(entry)
+					|| entryCount >= POLL_MAX_ENTRIES) {
+					return true;
+				}
+				poll_entry& record = entries[entryCount++];
+				memcpy(record.name, entry->name, entry->namelen);
+				record.name[entry->namelen] = '\0';
+				record.nodeid = plus && lookup != NULL ? lookup->nodeid : 0;
+				record.haveAttr = plus && lookup != NULL;
+				if (record.haveAttr)
+					record.attr = lookup->attr;
+				return true;
+			});
+		if (!wellFormed)
+			break;
+	}
+	Release(dir->nodeid, true, fh);
+
+	// The first listing of a directory is the baseline, not the news: what it
+	// holds was there when the volume was mounted, so it goes into the table
+	// without a word. (A directory the VFS has read took its baseline then, in
+	// dir_fetch().)
+	bool firstListing;
+	{
+		MutexLocker locker(fLock);
+		firstListing = !dir->listed;
+		dir->listed = true;
+	}
+
+	// the children the table knows, pinned so they survive the diff
+	int32 knownCount = 0;
+	{
+		MutexLocker locker(fLock);
+		NodeTable::Iterator iterator = fNodes.GetIterator();
+		while (Node* node = iterator.Next()) {
+			if (node->parent == dir->nodeid && node->name != NULL
+				&& knownCount < POLL_MAX_ENTRIES) {
+				node->pending++;
+				known[knownCount].node = node;
+				strlcpy(known[knownCount].name, node->name, B_FILE_NAME_LENGTH);
+				known[knownCount].nodeid = node->nodeid;
+				knownCount++;
+			}
+		}
+	}
+	qsort(entries, entryCount, sizeof(poll_entry), poll_entry_compare_name);
+	qsort(known, knownCount, sizeof(known_entry), known_entry_compare_name);
+
+	for (int32 i = 0; i < entryCount; i++) {
+		poll_entry& record = entries[i];
+
+		known_entry knownKey;
+		strlcpy(knownKey.name, record.name, sizeof(knownKey.name));
+		known_entry* found = (known_entry*)bsearch(&knownKey, known, knownCount,
+			sizeof(known_entry), known_entry_compare_name);
+		if (found != NULL && record.nodeid != 0 && found->nodeid != record.nodeid) {
+			// the name belongs to another node now: the old one is gone
+			notify_entry_removed(ID(), dir->nodeid, found->name, found->nodeid);
+			found = NULL;
+		}
+		if (found != NULL) {
+			Node* node = found->node;
+			// the table holds its own lookups for this one
+			if (record.nodeid != 0)
+				Forget(record.nodeid, 1);
+			if (record.haveAttr) {
+				bool attrChanged;
+				{
+					MutexLocker locker(node->lock);
+					attrChanged = record.attr.mtime != node->attr.mtime
+						|| record.attr.mtimensec != node->attr.mtimensec
+						|| record.attr.size != node->attr.size;
+				}
+				if (attrChanged) {
+					node_update(this, node, record.attr);
+					notify_stat_changed(ID(), dir->nodeid, node->nodeid,
+						B_STAT_SIZE | B_STAT_MODIFICATION_TIME | B_STAT_CHANGE_TIME);
+				}
+			}
+			continue;
+		}
+
+		// new in this directory: look it up, keep it as an idle node, say so
+		fuse_entry_out entry;
+		if (record.nodeid != 0) {
+			memset(&entry, 0, sizeof(entry));
+			entry.nodeid = record.nodeid;
+			entry.attr = record.attr;
+		} else if (Lookup(dir->nodeid, record.name, &entry) != B_OK)
+			continue;	// gone again already
+		Node* created = AcquireEntry(entry, dir->nodeid, record.name);
+		if (created != NULL) {
+			if (!firstListing)
+				notify_entry_created(ID(), dir->nodeid, record.name, created->nodeid);
+			Unpend(created);
+		}
+	}
+
+	for (int32 k = 0; k < knownCount; k++) {
+		known_entry& child = known[k];
+		poll_entry entryKey;
+		strlcpy(entryKey.name, child.name, sizeof(entryKey.name));
+		poll_entry* found = (poll_entry*)bsearch(&entryKey, entries, entryCount,
+			sizeof(poll_entry), poll_entry_compare_name);
+		if (found == NULL)
+			notify_entry_removed(ID(), dir->nodeid, child.name, child.nodeid);
+			// the node stays in the table: its next lookup fails, and it goes
+			// idle and is forgotten like any other
+		Unpend(child.node);
+	}
+}
+
+
 //	#pragma mark - module
 
 
