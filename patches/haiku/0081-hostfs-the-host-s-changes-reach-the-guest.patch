+				status_t			_PollThread();
+				void				_PollPass();
+				void				_PollDirectory(Node* dir);
 
 private:
 			fs_volume*			fFSVolume;
@@ -237,6 +253,11 @@ private:
 			size_t				fMaxWrite;
 			char				fName[B_FILE_NAME_LENGTH];
 			char				fDeviceName[B_PATH_NAME_LENGTH];
