@@ -293,6 +306,9 @@ Volume::Mount(const char* device, uint32 flags, const char* args)
 void
 Volume::Unmount()
 {
+	// nothing asks the host any more while the volume comes down
+	_StopPolling();
+
 	// the VFS has put every vnode but the one publish_vnode() gave us
 	put_vnode(fFSVolume, FUSE_ROOT_ID);
 
@@ -318,6 +334,77 @@ Volume::Unmount()
 }
 
 
+//	#pragma mark - the host's changes
+
+
+/*!	Nothing pushes the host's changes to the guest (the device grants no
+	notification queue), so a low-priority thread looks for them instead:
+	every HOSTFS_POLL_INTERVAL it asks the directories the VFS holds what
+	they contain now, and what differs from the node table is passed to the
+	node monitors -- so a file the Mac drops into the share appears in
+	Tracker, and one it takes away disappears. The pass itself is
+	Volume::_PollPass(), in kernel_interface.cpp.
+*/
+void
+Volume::_StartPolling()
+{
+	fPollSem = create_sem(0, "hostfs host changes");
+	if (fPollSem >= 0) {
+		atomic_set(&fPollStop, 0);
+		fPollThread = spawn_kernel_thread(_PollEntry, "hostfs host changes",
+			B_LOW_PRIORITY, this);
+	}
+	if (fPollSem < 0 || fPollThread < 0) {
+		INFORM("cannot watch the host for changes (%s); what changes there "
+			"is seen when a directory is opened\n",
+			strerror(fPollSem < 0 ? (status_t)fPollSem : (status_t)fPollThread));
+		if (fPollSem >= 0) {
+			delete_sem(fPollSem);
+			fPollSem = -1;
+		}
+		fPollThread = -1;
+		return;
+	}
+	resume_thread(fPollThread);
+}
+
+
+void
+Volume::_StopPolling()
+{
+	if (fPollThread < 0)
+		return;
+	atomic_set(&fPollStop, 1);
+	release_sem(fPollSem);
+	status_t result;
+	wait_for_thread(fPollThread, &result);
+	fPollThread = -1;
+	delete_sem(fPollSem);
+	fPollSem = -1;
+}
+
+
+/*static*/ status_t
+Volume::_PollEntry(void* cookie)
+{
+	return ((Volume*)cookie)->_PollThread();
+}
+
+
+status_t
+Volume::_PollThread()
+{
+	while (atomic_get(&fPollStop) == 0) {
+		acquire_sem_etc(fPollSem, 1, B_RELATIVE_TIMEOUT, HOSTFS_POLL_INTERVAL);
+		if (atomic_get(&fPollStop) != 0)
+			break;
+		_PollPass();
+	}
+	return B_OK;
+}
+
+
+
