-static void
+// HaikuArmQemu fork: per the SMC Calling Convention, x0-x3 carry results and
+// SMCCC 1.0 firmware may clobber x4-x17. The old asm declared x0-x3 as inputs
+// only, so any register the firmware changed corrupted the caller: QEMU's PSCI
+// only writes x0, Apple's Virtualization.framework evidently writes more, and
+// SMP boot hung there. Return x0 (the PSCI status) and declare the clobbers.
+#define PSCI_CALL(insn) \
+	register uint64 x0 asm("x0") = func; \
+	register uint64 x1 asm("x1") = arg0; \
+	register uint64 x2 asm("x2") = arg1; \
+	register uint64 x3 asm("x3") = arg2; \
+	asm volatile(insn \
+		: "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) \
+		: \
+		: "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", \
+		  "x14", "x15", "x16", "x17", "memory"); \
+	return (int64)x0;
+
+
+static int64
 arm64_psci_call_smc(uint64 func, uint64 arg0, uint64 arg1, uint64 arg2)
 {
-	register uint64 x0 asm("x0") = func;
-	register uint64 x1 asm("x1") = arg0;
-	register uint64 x2 asm("x2") = arg1;
-	register uint64 x3 asm("x3") = arg2;
-	asm("smc #0" :: "r" (x0), "r" (x1), "r" (x2), "r" (x3));
+	PSCI_CALL("smc #0")
 }
 
 
