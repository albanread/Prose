diff --git a/headers/private/prose/prose_portal.h b/headers/private/prose/prose_portal.h
new file mode 100644
index 0000000000..aabb4ff31a
--- /dev/null
+++ b/headers/private/prose/prose_portal.h
@@ -0,0 +1,54 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * The Prose Portal wire protocol: how the host asks the guest to do something
+ * and hears what happened. docs/automation.md.
+ *
+ * Framed so it does not care what carries it. Today that is a TCP connection
+ * on the host-only NAT bridge; a virtio device is the eventual home, and only
+ * the read and write calls at either end change.
+ *
+ * Every frame is a 16-byte header and then its payload. A request carries an
+ * id; its reply carries the same id, so a caller never has to assume replies
+ * arrive in order.
+ */
+#ifndef PROSE_PORTAL_H
+#define PROSE_PORTAL_H
+
+#include <SupportDefs.h>
+
+#define PROSE_PORTAL_MAGIC		'PRPT'
+#define PROSE_PORTAL_VERSION	1
+#define PROSE_PORTAL_PORT		7654
+#define PROSE_PORTAL_MAX		(8 * 1024 * 1024)
+
+enum {
+	// host -> guest
+	PROSE_PORTAL_PING		= 1,	// no payload
+	PROSE_PORTAL_RUN		= 2,	// the command line, UTF-8, no terminator
+	PROSE_PORTAL_INFO		= 3,	// no payload
+
+	// guest -> host
+	PROSE_PORTAL_HELLO		= 0x81,	// sent once, unasked, when the daemon starts
+	PROSE_PORTAL_PONG		= 0x82,
+	PROSE_PORTAL_RESULT		= 0x83,	// prose_portal_result, then stdout, then stderr
+	PROSE_PORTAL_INFO_REPLY	= 0x84,	// key=value lines, \n separated
+	PROSE_PORTAL_ERROR		= 0xFF	// a message, UTF-8
+};
+
+typedef struct {
+	uint32	magic;
+	uint16	version;
+	uint16	type;
+	uint32	id;
+	uint32	length;			// payload bytes following this header
+} prose_portal_header;
+
+typedef struct {
+	int32	status;			// the command's exit status, or -1 if it could not run
+	uint32	out_length;
+	uint32	error_length;
+} prose_portal_result;
+
+#endif	/* PROSE_PORTAL_H */
