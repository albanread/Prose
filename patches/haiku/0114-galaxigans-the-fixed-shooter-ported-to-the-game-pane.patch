+int
+main()
+{
+	BApplication app(kSignature);
+	Galaxigans* game = new Galaxigans();
+	if (game->InitCheck() != B_OK) {
+		fprintf(stderr, "galaxigans: no game pane here: %s\n",
+			strerror(game->InitCheck()));
+		game->Quit();
+		return 1;
+	}
+	game->Show();
+	app.Run();
+	return 0;
+}
