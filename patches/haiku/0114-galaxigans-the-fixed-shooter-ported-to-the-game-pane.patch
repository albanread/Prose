+Galaxigans::Galaxigans()
+	:
+	BGamePane(BRect(0, 0, kFieldW * 2 - 1, kFieldH * 2 - 1), "Galaxigans",
+		kFieldW, kFieldH, 2,
+		B_GAME_PANE_SCANLINE_PALETTE | B_GAME_PANE_FRONT_PLANE),
+	fThread(-1),
+	fQuit(false),
+	fKeys(NULL),
+	fRng(0x2545F4914F6CDD1DULL),
+	fState(ATTRACT),
+	fStateTimer(0),
+	fFrame(0),
+	fShipX(kFieldW / 2),
+	fLives(3),
+	fScore(0),
+	fHiScore(0),
+	fWave(1),
+	fLevel(0),
+	fScene(-1),
+	fTheme(0),
+	fRespawn(0),
+	fCooldown(0),
+	fFireWasDown(false),
+	fSwayX(0),
+	fSwayDir(1),
+	fDiveTimer(kDivePeriod),
+	fBombTimer(kBombPeriod),
+	fSparkCount(0),
+	fFlap(0),
+	fDanceT(0),
+	fHiNewRow(0),
+	fHiDone(0),
+	fBossOn(false),
+	fAbducting(0),
+	fAbducteeX(0),
+	fAbducteeY(0),
+	fBeamPhase(0),
+	fSaucerX(-60),
+	fSaucerDir(0),
+	fSaucerTimer(kSaucerPeriod),
+	fSaucerBombT(kSaucerBombGap),
+	fPilotShape(-1),
+	fShipShape(-1),
+	fSaucerShape(-1)
+{
+	fKeys = new KeyCatcher(Bounds());
+	AddChild(fKeys);
+	CenterOnScreen();
+	memset(fInitials, 0, sizeof(fInitials));
+	if (InitCheck() != B_OK)
+		return;
+
+	SetView(kFieldW, kFieldH);
+	SetEffect(B_GAME_PANE_PLAIN);		// the cosmos and the art carry it
+	_Palette();
+	_Define();
+
+	// Layer 0: the twelve backdrops, one compile, the scene in parameter 0.
+	if (SetBackgroundShader(kCosmosShader) != B_OK)
+		fprintf(stderr, "galaxigans: the cosmos would not compile:\n%s\n", ShaderError());
+
+	SetTextFont(NULL, 16.0f, F_BODY);
+	SetTextFont(NULL, 24.0f, F_MID);
+	SetTextFont(NULL, 32.0f, F_BIG);
+	SetTextFont(NULL, 40.0f, F_HUGE);
+
+	for (int32 r = 0; r < kRows; r++) {
+		for (int32 c = 0; c < kCols; c++)
+			fFleet[r * kCols + c].Init(kGridX + c * kColGap, kGridY + r * kRowGap);
+	}
+	for (int32 i = 0; i < 4; i++)
+		fBullets[i].Init();
+	for (int32 i = 0; i < 6; i++) {
+		fBombs[i].Init();
+		fMines[i].Init();
+	}
+	fBoss.SetIdle();
+
+	load_hall(fHall);
+	fHiScore = fHall.score[0];
+	_NewGame();
+
+	fThread = spawn_thread(galaxigans_thread, "galaxigans", B_DISPLAY_PRIORITY, this);
+	if (fThread >= 0)
+		resume_thread(fThread);
+}
