+/// The window's one view: it exists to hold the focus and to catch the
+/// letters the hall of fame asks for. Everything else is read from the board.
+class KeyCatcher : public BView {
+public:
+	KeyCatcher(BRect frame)
+		:
+		BView(frame, "keys", B_FOLLOW_ALL, B_WILL_DRAW),
+		fLetter(0)
+	{
+		SetViewColor(0, 0, 0);
+	}
+
+	virtual void AttachedToWindow() { MakeFocus(true); }
+
+	virtual void KeyDown(const char* bytes, int32 count)
+	{
+		if (count == 1) {
+			char c = bytes[0];
+			if (c >= 'a' && c <= 'z')
+				c = (char)(c - 'a' + 'A');
+			if (c >= 'A' && c <= 'Z')
+				fLetter = c;
+		}
+		BView::KeyDown(bytes, count);
+	}
+
+	/// The letter typed since this was last asked, and then nothing.
+	char TakeLetter() { char c = fLetter; fLetter = 0; return c; }
+
+private:
+	char	fLetter;
+};
