+
+// ── randomness: xorshift, seeded fixed, so a run is the same run ────────
+double
+Galaxigans::_Rand()
+{
+	uint64 x = fRng;
+	x ^= x >> 12;
+	x ^= x << 25;
+	x ^= x >> 27;
+	fRng = x;
+	return (double)((fRng >> 11) & 0x1FFFFFFFFFFFFFULL) / 9007199254740992.0;
+}
