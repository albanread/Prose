+// ── the loop ─────────────────────────────────────────────────────────────
+/// The game was tuned at ~30 frames a second: a fixed 30 Hz step however fast
+/// the display runs, with a cap so a stall cannot become a lurch.
+void
+Galaxigans::Loop()
+{
+	const bigtime_t kTick = 1000000 / 30;
+	const int32 kMaxSteps = 4;
+	bigtime_t last = system_time();
+	bigtime_t accumulator = 0;
+
+	while (!fQuit) {
+		bigtime_t now = system_time();
+		accumulator += now - last;
+		last = now;
+		if (accumulator > kTick * kMaxSteps)
+			accumulator = kTick * kMaxSteps;
+
+		key_info keys;
+		if (get_key_info(&keys) != B_OK)
+			memset(&keys, 0, sizeof(keys));
+		if (key_down(keys, kKeyEscape)) {
+			PostMessage(B_QUIT_REQUESTED);
+			return;
+		}
+		bool left = key_down(keys, kKeyLeft);
+		bool right = key_down(keys, kKeyRight);
+		bool fire = key_down(keys, kKeySpace) || key_down(keys, kKeyEnter);
+		char letter = fKeys != NULL ? fKeys->TakeLetter() : 0;
+
+		int32 steps = 0;
+		while (accumulator >= kTick && steps < kMaxSteps) {
+			accumulator -= kTick;
+			steps++;
+			_Step(left, right, fire, letter);
+			letter = 0;				// one letter, however many steps
+		}
+		// Present only what was drawn: presenting again without a step would
+		// flip back to the buffer of the frame before last.
+		if (steps > 0) {
+			_Draw();
+			Present();
+		}
+		if (WaitForRetrace() != B_OK)
+			snooze(16000);
+	}
+}
+
