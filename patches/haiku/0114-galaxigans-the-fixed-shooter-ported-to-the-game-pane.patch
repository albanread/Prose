+
+// ── the hall of fame ─────────────────────────────────────────────────────
+// Six rows, as the original keeps in .DATA -- ACE 30000 down to WOW 4000 --
+// with your score slotted in as YOU. A file in the settings folder, one
+// `NAME SCORE` per line, so a score survives a restart; anything wrong with
+// the file means the defaults, never a crash.
+#define HALL_ROWS 6
+
+struct Hall {
+	char	name[HALL_ROWS][8];
+	int32	score[HALL_ROWS];
+};
+
+
+static bool
+hall_path(BPath& path)
+{
+	if (find_directory(B_USER_SETTINGS_DIRECTORY, &path) != B_OK)
+		return false;
+	return path.Append("Galaxigans") == B_OK;
+}
+
+
+static void
+load_hall(Hall& hall)
+{
+	static const char* kNames[HALL_ROWS] = { "ACE", "ZAP", "BUG", "FOE", "POW", "WOW" };
+	static const int32 kScores[HALL_ROWS] = { 30000, 22000, 16000, 11000, 7000, 4000 };
+	for (int32 i = 0; i < HALL_ROWS; i++) {
+		strlcpy(hall.name[i], kNames[i], sizeof(hall.name[i]));
+		hall.score[i] = kScores[i];
+	}
+
+	BPath path;
+	if (!hall_path(path))
+		return;
+	BFile file(path.Path(), B_READ_ONLY);
+	if (file.InitCheck() != B_OK)
+		return;
+	char text[512];
+	ssize_t read = file.Read(text, sizeof(text) - 1);
+	if (read <= 0)
+		return;
+	text[read] = '\0';
+
+	char names[HALL_ROWS][8];
+	int32 scores[HALL_ROWS];
+	int32 rows = 0;
+	char* save = NULL;
+	for (char* line = strtok_r(text, "\n", &save);
+			line != NULL && rows < HALL_ROWS; line = strtok_r(NULL, "\n", &save)) {
+		char name[32];
+		long value = 0;
+		if (sscanf(line, "%31s %ld", name, &value) != 2)
+			continue;
+		strlcpy(names[rows], name, sizeof(names[rows]));
+		scores[rows] = (int32)value;
+		rows++;
+	}
+	if (rows != HALL_ROWS)
+		return;
+	for (int32 i = 0; i < HALL_ROWS; i++) {
+		strlcpy(hall.name[i], names[i], sizeof(hall.name[i]));
+		hall.score[i] = scores[i];
+	}
+}
+
+
+static void
+save_hall(const Hall& hall)
+{
+	BPath path;
+	if (!hall_path(path))
+		return;
+	BFile file(path.Path(), B_WRITE_ONLY | B_CREATE_FILE | B_ERASE_FILE);
+	if (file.InitCheck() != B_OK)
+		return;
+	char text[512];
+	int32 length = 0;
+	for (int32 i = 0; i < HALL_ROWS; i++) {
+		length += snprintf(text + length, sizeof(text) - length, "%s %ld\n",
+			hall.name[i], (long)hall.score[i]);
+	}
+	file.Write(text, length);
+}
