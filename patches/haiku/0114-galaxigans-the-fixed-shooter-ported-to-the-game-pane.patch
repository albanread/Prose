+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * Galaxigans -- a Galaxian/Galaga-style fixed shooter, ported from the Mojo
+ * GalaxigansDeluxe, which is itself the complete port of MACVM's Galaxigans,
+ * which ported the x64 assembler original. Every constant here is that
+ * original's: a 640x360 field, an 8x5 formation on a 56x34 grid from (96,56),
+ * sway +/-16 at 1px a frame, a dive every 60 frames that peels for 12 then
+ * homes, four bullets at 7px a frame on an 8-frame cooldown, six bombs at 4px
+ * every 22, a saucer every 420 frames worth 200, a 90-frame respawn beat. It
+ * was tuned at ~30 frames a second and steps at 30 Hz on a fixed clock however
+ * fast the display runs.
+ *
+ * What the Mojo pane did in four layers, the Prose game pane does in four:
+ * the twelve cosmos are layer 0, a fragment function compiled on the Mac; the
+ * indexed world carries the sparks, the shots and the tractor beam; the fleet
+ * are sprites, each species with a palette of its own; and the HUD is the
+ * front plane, over the sprites, so an alien crossing the score passes behind
+ * it. The beam's colour flows without a pixel being redrawn -- the cone is
+ * drawn once in index 1, and index 1 means something different on every
+ * scanline.
+ *
+ * Left and right steer, space fires (one shot a press), escape quits.
+ */
+
+
+#include "Art.h"
+#include "Cosmos.h"
+
+#include <Application.h>
+#include <File.h>
+#include <FindDirectory.h>
+#include <GamePane.h>
+#include <InterfaceDefs.h>
+#include <Path.h>
+#include <View.h>
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+
+static const char* kSignature = "application/x-vnd.Prose-Galaxigans";
+
+// ── the field, straight from the original's galaxigans_data.inc ──────────
+static const int32 kFieldW = 640;
+static const int32 kFieldH = 360;
+static const int32 kPlayerY = 310;
+static const int32 kCols = 8;
+static const int32 kRows = 5;
+static const int32 kColGap = 56;
+static const int32 kRowGap = 34;
+static const int32 kGridX = 96;
+static const int32 kGridY = 56;
+static const int32 kDivePeriod = 60;
+static const int32 kBombPeriod = 22;
+static const int32 kSaucerPeriod = 420;
+static const int32 kDanceCX = 320;
+static const int32 kDanceCY = 180;
+static const int32 kDanceR0 = 95;
+static const int32 kDanceR1 = 70;
+static const int32 kDanceAngleStep = 6;
+static const int32 kDanceRadStep = 10;
+static const int32 kDanceLength = 420;
+static const int32 kAttractLength = 600;
+static const int32 kHiscoreLength = 300;
+static const int32 kHiscoreLinger = 90;
+static const int32 kBossFirst = 40;
+static const int32 kBossDwell = 60;
+static const int32 kBossRespawn = 360;
+static const int32 kBossStationY = 18;
+static const int32 kBossCaptureY = 140;
+static const int32 kBossScore = 500;
+static const int32 kBeamCharge = 30;
+static const int32 kBeamHold = 90;
+static const int32 kPilotRowY = 344;
+static const int32 kPilotX0 = 14;
+static const int32 kPilotGap = 16;
+static const int32 kSaucerY = 30;
+static const int32 kSaucerBombGap = 28;
+static const int32 kMineScore = 150;
+
+// The indexed world is cleared to 0 -- transparent, the cosmos shows through --
+// and carries only what the game plots. Index 1 is the beam, whose colour is
+// per LINE; everything else is global.
+enum {
+	IX_BEAM			= 1,
+	IX_BULLET		= 20,
+	IX_BOMB			= 21,
+	IX_SPARK_GOLD	= 22,
+	IX_SPARK_RED	= 23
+};
+
+// The front plane's colours, out of the global palette.
+enum {
+	IX_WHITE	= 30,
+	IX_GOLD		= 31,
+	IX_CYAN		= 32,
+	IX_DIM		= 33,
+	IX_SHIP		= 34,
+	IX_GREEN	= 35,
+	IX_RED		= 36,
+	IX_AMBER	= 37
+};
+
+// Sprite palettes: a species each, then the rest.
+enum {
+	PAL_SPECIES	= 1,				// 1..14
+	PAL_MINE	= 15,
+	PAL_BOSS	= 16,
+	PAL_PILOT	= 17,
+	PAL_SHIP	= 18,
+	PAL_SAUCER	= 19
+};
+
+// Font slots.
+enum { F_BODY = 0, F_MID = 1, F_BIG = 2, F_HUGE = 3 };
+
+enum { ATTRACT = 0, PLAYING, CLEARED, OVER, HISCORE };
+enum { A_FORM = 0, A_DIVE, A_RETURN, A_DEAD };
+enum { BOSS_IDLE = 0, BOSS_ENTER, BOSS_STATION, BOSS_DESCEND, BOSS_CHARGE, BOSS_BEAM, BOSS_RETURN };
+enum { EV_NONE = 0, EV_WARN, EV_CHARGED, EV_GRAB, EV_DONE };
+
+static const double kTau = 6.283185307179586;
+
+
+/// A 256-step integer sine in [-256, 256] -- the original's sineLUT. The dive
+/// weave asks for one per diver per frame and the whole flight path stays in
+/// integers, so it is the same curve every run.
+static int32
+sine_at(int32 i)
+{
+	int32 k = ((i % 256) + 256) % 256;
+	return (int32)lround(sin((double)k * kTau / 256.0) * 256.0);
+}
+
+
+static int32
+sign(int32 v)
+{
+	return v > 0 ? 1 : (v < 0 ? -1 : 0);
+}
+
+
+static int32
+clamp(int32 v, int32 low, int32 high)
+{
+	return v < low ? low : (v > high ? high : v);
+}
+
+
+// ── one alien: a slot in the formation, and its own flight plan while diving ──
+struct Galaxigan {
+	int32	x, y, home_x, home_y;
+	int32	state, dt, seed, bank;
+	bool	alive;
+	int32	species;
+
+	void Init(int32 hx, int32 hy)
+	{
+		home_x = hx;
+		home_y = hy;
+		species = 0;
+		Reset();
+	}
+
+	void Reset()
+	{
+		x = home_x;
+		y = home_y;
+		state = A_FORM;
+		dt = 0;
+		seed = 0;
+		bank = 0;
+		alive = true;
+	}
+
+	bool IsDiving() const { return state == A_DIVE; }
+	void Kill() { alive = false; state = A_DEAD; }
+
+	/// The rarer species (higher up the library) are worth more, and a diver
+	/// is worth double -- the arcade's own bargain.
+	int32 Points() const
+	{
+		int32 base = 40 + (species + 1) * 10;
+		return state == A_DIVE ? base * 2 : base;
+	}
+
+	void DiveWithSeed(int32 s) { state = A_DIVE; dt = 0; seed = s; }
+
+	void FollowFormation(int32 sway) { x = home_x + sway; y = home_y; bank = 0; }
+
+	/// The glide home: drop from above the field into my own slot, tracking
+	/// the swaying column on the way in.
+	void ReturnStep(int32 sway)
+	{
+		y += 4;
+		x = home_x + sway;
+		bank = 0;
+		if (y >= home_y) {
+			y = home_y;
+			state = A_FORM;
+		}
+	}
+
+	/// One frame of the dive. True when I have left the bottom of the field
+	/// and should re-enter from the top.
+	bool DiveStep(int32 player_x)
+	{
+		dt++;
+		int32 vy = 2 + dt / 4;
+		int32 cap = (seed & 128) == 0 ? 8 : 10;
+		if (vy > cap)
+			vy = cap;
+		y += vy;
+		int32 speed = ((seed >> 3) & 7) + 3;
+		int32 phase = (seed >> 8) & 255;
+		int32 amp = (seed & 7) + 2;
+		int32 weave = sine_at(dt * speed + phase) * amp / 256;
+		// The peel: for the first 12 steps I only weave, breaking formation
+		// outward before I start hunting. After that the homing pull leans me
+		// toward the player -- gently, or hard if my seed says so.
+		if (dt >= 12) {
+			int32 pull = (seed & 64) == 0 ? 1 : 3;
+			weave = x < player_x ? weave + pull : weave - pull;
+		}
+		x += weave;
+		bank = sign(weave);
+		return y > kFieldH + 8;
+	}
+
+	void MoveTo(int32 ax, int32 ay) { x = ax; y = ay; bank = 0; }
+
+	void ReenterAt(int32 sway)
+	{
+		state = A_RETURN;
+		dt = 0;
+		x = home_x + sway;
+		y = -20;
+	}
+
+	/// My hit box, generous by half a pixel in the player's favour.
+	bool Hits(int32 px, int32 py, int32 hw) const
+	{
+		return alive && abs(x - px) < hw + 8 && abs(y - py) < 12;
+	}
+};
+
+
+// ── a shot: one player bullet, or one enemy bomb ─────────────────────────
+struct Shot {
+	int32	x, y, dy;
+	bool	live;
+
+	void Init() { x = y = dy = 0; live = false; }
+	void FireFrom(int32 ax, int32 ay, int32 ady) { x = ax; y = ay; dy = ady; live = true; }
+
+	void Step()
+	{
+		if (!live)
+			return;
+		y += dy;
+		if (y < -8 || y > kFieldH + 8)
+			live = false;
+	}
+
+	bool Hits(int32 tx, int32 ty, int32 hw, int32 hh) const
+	{
+		return live && abs(x - tx) < hw && abs(y - ty) < hh;
+	}
+};
+
+
+// ── the saucer's rare spinning mine ──────────────────────────────────────
+struct Mine {
+	int32	x, y, anim;
+	bool	live;
+
+	void Init() { x = y = anim = 0; live = false; }
+	int32 Frame() const { return (anim / 4) % 8; }
+	void DropAt(int32 ax, int32 ay) { x = ax; y = ay; anim = 0; live = true; }
+
+	/// Half a pixel a frame -- down on the odd ticks only -- so it hangs in
+	/// the field far longer than a bomb and has to be dealt with.
+	void Step()
+	{
+		if (!live)
+			return;
+		anim++;
+		if ((anim & 1) == 1)
+			y++;
+		if (y > kFieldH + 8)
+			live = false;
+	}
+
+	bool Hits(int32 tx, int32 ty, int32 hw, int32 hh) const
+	{
+		return live && abs(x - tx) < hw + 8 && abs(y - ty) < hh + 8;
+	}
+};
+
+
+// ── the capture boss ─────────────────────────────────────────────────────
+struct Boss {
+	int32	state, x, y, anim, timer, beam_t;
+
+	void SetIdle()
+	{
+		state = BOSS_IDLE;
+		x = 304;
+		y = -36;
+		anim = 0;
+		beam_t = 0;
+		timer = kBossFirst;
+	}
+
+	bool IsIdle() const { return state == BOSS_IDLE; }
+	bool IsVulnerable() const
+		{ return state == BOSS_DESCEND || state == BOSS_CHARGE || state == BOSS_BEAM; }
+	bool IsBeaming() const { return state == BOSS_CHARGE || state == BOSS_BEAM; }
+
+	/// Two idle poses alternating, then the charge and beam poses -- the
+	/// emitter eye grows, which is the tell.
+	int32 Frame() const
+	{
+		if (state == BOSS_BEAM)
+			return 3;
+		if (state == BOSS_CHARGE)
+			return 2;
+		return (anim / 16) % 2;
+	}
+
+	int32 BeamX() const { return x + 16; }
+	int32 BeamTop() const { return y + 24; }
+	int32 BeamBottom() const
+	{
+		if (state == BOSS_BEAM)
+			return 350;
+		int32 b = y + 24 + beam_t * 14;
+		return b > 350 ? 350 : b;
+	}
+
+	void Wake() { state = BOSS_ENTER; x = 304; y = -36; anim = 0; }
+	void Retreat() { state = BOSS_RETURN; }
+	void Vanish() { state = BOSS_IDLE; y = -60; timer = kBossRespawn; }
+
+	/// One frame. Answers an event the game acts on.
+	int32 Step(int32 lives, bool enabled)
+	{
+		anim++;
+		switch (state) {
+			case BOSS_IDLE:
+				if (!(enabled && lives > 1))
+					return EV_NONE;
+				if (--timer > 0)
+					return EV_NONE;
+				Wake();
+				return EV_WARN;
+			case BOSS_ENTER:
+				if (y < kBossStationY)
+					y += 2;
+				else {
+					state = BOSS_STATION;
+					timer = kBossDwell;
+				}
+				return EV_NONE;
+			case BOSS_STATION:
+				if (--timer > 0)
+					return EV_NONE;
+				if (lives <= 1) {			// down to the last pilot? go home
+					state = BOSS_RETURN;
+					return EV_NONE;
+				}
+				state = BOSS_DESCEND;
+				return EV_NONE;
+			case BOSS_DESCEND:
+				x = x < 304 ? x + 3 : x - 3;
+				if (y < kBossCaptureY) {
+					y += 3;
+					return EV_NONE;
+				}
+				state = BOSS_CHARGE;
+				beam_t = 0;
+				return EV_CHARGED;
+			case BOSS_CHARGE:
+				if (++beam_t < kBeamCharge)
+					return EV_NONE;
+				state = BOSS_BEAM;
+				beam_t = 0;
+				return EV_CHARGED;
+			case BOSS_BEAM:
+				if (++beam_t >= kBeamHold) {
+					state = BOSS_RETURN;
+					return EV_DONE;
+				}
+				return EV_GRAB;
+			case BOSS_RETURN:
+				y -= 4;
+				if (y < -40)
+					Vanish();
+				return EV_NONE;
+		}
+		return EV_NONE;
+	}
+
+	/// A bullet in my 32x32 box, while I am down.
+	bool Hits(int32 bx, int32 by) const
+	{
+		return IsVulnerable() && bx >= x && bx < x + 32 && by >= y && by < y + 32;
+	}
+};
+
+
+// ── explosion debris ─────────────────────────────────────────────────────
+struct Spark {
+	int32	x, y, vx, vy, life;
+	uint8	colour;
+
+	void Step() { x += vx; y += vy; vy++; life--; }
+};
