+
+/// Each wave dives harder -- the original ramps gDivePeriod so. Four frames
+/// a wave reaches the floor at wave 12, where the table wraps, so every wave
+/// in the cycle is faster than the one before it.
+int32
+Galaxigans::_DivePeriodNow() const
+{
+	int32 p = kDivePeriod - (fWave - 1) * 4;
+	return p < 18 ? 18 : p;
+}
+
+
+/// Bombs fall closer together as the waves go by: one frame a wave, reaching
+/// eleven at wave 12 -- half the opening cadence over the whole cycle.
+int32
+Galaxigans::_BombPeriodNow() const
+{
+	int32 p = kBombPeriod - (fWave - 1);
+	return p < 11 ? 11 : p;
+}
+
+
+/// One in N of the saucer's drops is a mine. Rarer early, common late;
+/// one in three is the floor, because near-always is not a decision.
+int32
+Galaxigans::_MineChanceNow() const
+{
+	int32 n = 8 - (fWave - 1) / 2;
+	return n < 3 ? 3 : n;
+}
+
+
+/// A wave is a reset, not a reallocation. Pick this level's cosmos and
+/// formation and re-arm the timers; the table wraps, so wave 13 is level 1's
+/// backdrop with wave 13's cadence.
+void
+Galaxigans::_StartWave()
+{
+	fLevel = (fWave - 1) % 12;
+	if (fLevel != fScene) {
+		fScene = fLevel;
+		SetShaderParam(0, (float)fScene);	// the sky, without a recompile
+	}
+	fTheme = fLevel % 6;
+	fShipX = kFieldW / 2;
+	fRespawn = 0;
+	fCooldown = 0;
+	fFireWasDown = false;
+	fSwayX = 0;
+	fSwayDir = 1;
+	fDiveTimer = _DivePeriodNow();
+	fBombTimer = _BombPeriodNow();
+	fSaucerX = -60;
+	fSaucerDir = 0;
+	fSaucerTimer = kSaucerPeriod;
+	fSaucerBombT = kSaucerBombGap;
+	for (int32 i = 0; i < kRows * kCols; i++)
+		fFleet[i].Reset();
+	_DressFleet();
+	for (int32 i = 0; i < 4; i++)
+		fBullets[i].live = false;
+	for (int32 i = 0; i < 6; i++) {
+		fBombs[i].live = false;
+		fMines[i].live = false;
+	}
+	fBossOn = (fLevel % 3) == 2;		// the boss turns up every third level
+	fBoss.SetIdle();
+	fAbducting = 0;
+	fAbducteeX = 0;
+	fAbducteeY = 0;
+	fBeamPhase = 0;
+	fSparkCount = 0;
+}
+
+
+/// Each row becomes one species: the shape and the palette already loaded.
+void
+Galaxigans::_DressFleet()
+{
+	for (int32 i = 0; i < kRows * kCols; i++)
+		fFleet[i].species = kThemes[fTheme][i / kCols];
+}
+
+
+int32
+Galaxigans::_AliveCount() const
+{
+	int32 n = 0;
+	for (int32 i = 0; i < kRows * kCols; i++) {
+		if (fFleet[i].alive)
+			n++;
+	}
+	return n;
+}
+
+
+// ── the frame ────────────────────────────────────────────────────────────
+void
+Galaxigans::_Step(bool left, bool right, bool fire, char letter)
+{
+	fFrame++;
+	switch (fState) {
+		case PLAYING:	_StepPlay(left, right, fire); break;
+		case ATTRACT:	_StepAttract(fire); break;
+		case CLEARED:	_StepCleared(); break;
+		case OVER:		_StepOver(); break;
+		case HISCORE:	_StepHiscores(fire, letter); break;
+	}
+}
+
+
+/// Tap to fire: the key must be RELEASED between shots.
+bool
+Galaxigans::_FirePressed(bool down)
+{
+	bool pressed = down && !fFireWasDown;
+	fFireWasDown = down;
+	return pressed;
+}
+
+
+/// The title, with the fleet swaying behind it. Fire starts a game; if nobody
+/// does, the title hands over to the hall of fame and the cabinet keeps
+/// cycling for as long as it is left alone.
+void
+Galaxigans::_StepAttract(bool fire)
+{
+	_SwayFleet();
+	for (int32 i = 0; i < kRows * kCols; i++) {
+		if (fFleet[i].alive)
+			fFleet[i].FollowFormation(fSwayX);
+	}
+	if (_FirePressed(fire)) {
+		fState = PLAYING;
+		_StartWave();
+		return;
+	}
+	if (--fStateTimer <= 0) {
+		fHiNewRow = 0;
+		fState = HISCORE;
+		fStateTimer = kHiscoreLength;
+	}
+}
+
+
+void
+Galaxigans::_StepCleared()
+{
+	if (--fStateTimer <= 0) {
+		fWave++;
+		fState = PLAYING;
+		_StartWave();
+	}
+}
+
+
+/// Game over: the survivors break formation and dance -- the angle steps once
+/// a frame plus each alien's own offset around the wheel, and the radius
+/// breathes at HALF that rate, so the pinwheel opens and closes as it turns.
+void
+Galaxigans::_StepOver()
+{
+	fStateTimer--;
+	fDanceT++;
+	int32 i = 0;
+	for (int32 k = 0; k < kRows * kCols; k++) {
+		if (!fFleet[k].alive)
+			continue;
+		int32 radius = kDanceR0
+			+ sine_at(fDanceT / 2 + i * kDanceRadStep) * kDanceR1 / 256;
+		int32 angle = fDanceT + i * kDanceAngleStep;
+		fFleet[k].MoveTo(kDanceCX + sine_at(angle + 64) * radius / 256,
+			kDanceCY + sine_at(angle) * radius / 256);
+		i++;
+	}
+	_StepSparks();
+	if (fStateTimer <= 0) {
+		if (fScore > fHiScore)
+			fHiScore = fScore;
+		_EnterHiscores();
+	}
+}
+
+
+/// Slot the score into the hall -- sorted, six rows, named YOU -- save it,
+/// and show the table before the attract resumes.
+void
+Galaxigans::_EnterHiscores()
+{
+	fHiNewRow = 0;
+	for (int32 i = 0; i < HALL_ROWS; i++) {
+		if (fScore <= fHall.score[i])
+			continue;
+		for (int32 k = HALL_ROWS - 1; k > i; k--) {
+			strlcpy(fHall.name[k], fHall.name[k - 1], sizeof(fHall.name[k]));
+			fHall.score[k] = fHall.score[k - 1];
+		}
+		strlcpy(fHall.name[i], "YOU", sizeof(fHall.name[i]));
+		fHall.score[i] = fScore;
+		fHiNewRow = i + 1;
+		save_hall(fHall);
+		break;
+	}
+	fState = HISCORE;
+	fStateTimer = kHiscoreLength;
+	memset(fInitials, 0, sizeof(fInitials));
+	fHiDone = 0;
+}
+
+
+/// Take three letters, then linger a few seconds and go back -- but only when
+/// the score EARNED a row. Being asked for your initials after not placing is
+/// the machine rubbing it in.
+void
+Galaxigans::_StepHiscores(bool fire, char letter)
+{
+	size_t typed = strlen(fInitials);
+	if (fHiNewRow > 0 && typed < 3) {
+		if (letter != 0) {
+			fInitials[typed] = letter;
+			fInitials[typed + 1] = '\0';
+			if (typed + 1 == 3) {
+				strlcpy(fHall.name[fHiNewRow - 1], fInitials,
+					sizeof(fHall.name[0]));
+				save_hall(fHall);
+				fHiDone = kHiscoreLinger;	// a few seconds to admire it
+			}
+		}
+		if (fHiDone == 0)
+			return;							// the clock waits for the player
+	}
+
+	// Space ends it -- through _FirePressed, so the shot the player was
+	// holding when they died does not skip the table before they have seen it.
+	if (_FirePressed(fire)) {
+		_NewGame();
+		return;
+	}
+	if (fHiDone > 0) {
+		if (--fHiDone > 0)
+			return;
+	}
+	if (--fStateTimer <= 0)
+		_NewGame();
+}
+
+
+/// The aliens have won: they leave formation and dance over the card.
+void
+Galaxigans::_BeginDance()
+{
+	fState = OVER;
+	fStateTimer = kDanceLength;
+	fDanceT = 0;
+}
+
+
+void
+Galaxigans::_StepPlay(bool left, bool right, bool fire)
+{
+	if (fRespawn > 0)
+		fRespawn--;
+	else
+		_StepShip(left, right, fire);
+	for (int32 i = 0; i < 4; i++)
+		fBullets[i].Step();
+	for (int32 i = 0; i < 6; i++)
+		fBombs[i].Step();
+	_SwayFleet();
+	_StepFleet();
+	_StepSaucer();
+	for (int32 i = 0; i < 6; i++)
+		fMines[i].Step();
+	_StepBoss();
+	_StepSparks();
+	_CheckCollisions();
+	if (fState == PLAYING && _AliveCount() == 0) {
+		fState = CLEARED;
+		fStateTimer = 120;
+	}
+}
+
+
+// ── the player ───────────────────────────────────────────────────────────
+void
+Galaxigans::_StepShip(bool left, bool right, bool fire)
+{
+	if (left)
+		fShipX -= 4;
+	if (right)
+		fShipX += 4;
+	fShipX = clamp(fShipX, 12, kFieldW - 12);
+	if (fCooldown > 0)
+		fCooldown--;
+	if (_FirePressed(fire))
+		_Fire();
+}
+
+
+void
+Galaxigans::_Fire()
+{
+	if (fCooldown > 0)
+		return;
+	for (int32 i = 0; i < 4; i++) {
+		if (!fBullets[i].live) {
+			fBullets[i].FireFrom(fShipX, kPlayerY - 12, -7);
+			fCooldown = 8;
+			return;
+		}
+	}
+}
+
+
+// ── the fleet ────────────────────────────────────────────────────────────
+void
+Galaxigans::_SwayFleet()
+{
+	fSwayX += fSwayDir;
+	if (fSwayX >= 16)
+		fSwayDir = -1;
+	if (fSwayX <= -16)
+		fSwayDir = 1;
+}
+
+
+void
+Galaxigans::_StepFleet()
+{
+	if (--fDiveTimer <= 0) {
+		fDiveTimer = _DivePeriodNow();
+		_LaunchDiver();
+	}
+	if (--fBombTimer <= 0) {
+		fBombTimer = _BombPeriodNow();
+		_DropBomb();
+	}
+	for (int32 i = 0; i < kRows * kCols; i++) {
+		if (!fFleet[i].alive)
+			continue;
+		if (fFleet[i].state == A_DIVE) {
+			if (fFleet[i].DiveStep(fShipX))
+				fFleet[i].ReenterAt(fSwayX);
+		} else if (fFleet[i].state == A_RETURN)
+			fFleet[i].ReturnStep(fSwayX);
+		else
+			fFleet[i].FollowFormation(fSwayX);
+	}
+}
+
+
+/// Pick a live alien still sitting in formation and launch it, with a random
+/// seed for its flight plan: the seed packs the weave speed, phase and
+/// amplitude and two behaviour bits, so every swoop differs.
+void
+Galaxigans::_LaunchDiver()
+{
+	int32 candidates[kRows * kCols];
+	int32 count = 0;
+	for (int32 i = 0; i < kRows * kCols; i++) {
+		if (fFleet[i].alive && fFleet[i].state == A_FORM)
+			candidates[count++] = i;
+	}
+	if (count == 0)
+		return;
+	int32 pick = candidates[(int32)(_Rand() * (double)count)];
+	fFleet[pick].DiveWithSeed((int32)(_Rand() * 65535.0));
+}
+
+
+/// The lowest diver drops the bomb -- a bomb from the back of the formation
+/// would be a free hit on nobody.
+void
+Galaxigans::_DropBomb()
+{
+	int32 lowest = -1;
+	for (int32 i = 0; i < kRows * kCols; i++) {
+		if (fFleet[i].alive && fFleet[i].IsDiving()) {
+			if (lowest < 0 || fFleet[i].y > fFleet[lowest].y)
+				lowest = i;
+		}
+	}
+	if (lowest < 0)
+		return;
+	for (int32 i = 0; i < 6; i++) {
+		if (!fBombs[i].live) {
+			fBombs[i].FireFrom(fFleet[lowest].x, fFleet[lowest].y + 10, 4);
+			return;
+		}
+	}
+}
+
+
+// ── the bonus saucer ─────────────────────────────────────────────────────
+void
+Galaxigans::_StepSaucer()
+{
+	if (fSaucerDir == 0) {
+		if (--fSaucerTimer <= 0) {
+			fSaucerTimer = kSaucerPeriod;
+			fSaucerDir = _Rand() < 0.5 ? 1 : -1;
+			fSaucerX = fSaucerDir > 0 ? -30 : kFieldW + 30;
+		}
+		return;
+	}
+	fSaucerX += fSaucerDir * 2;
+	_SaucerDrop();
+	if (fSaucerX < -40 || fSaucerX > kFieldW + 40)
+		fSaucerDir = 0;
+}
+
+
+/// Something from its belly every 28 frames while it is over the field -- and
+/// one drop in N is a MINE rather than a bomb. The original's ratio is one in
+/// eight; that is wave one's, and it tightens every second wave.
+void
+Galaxigans::_SaucerDrop()
+{
+	if (fSaucerX < 0 || fSaucerX > kFieldW - 16)
+		return;
+	if (--fSaucerBombT > 0)
+		return;
+	fSaucerBombT = kSaucerBombGap;
+	if ((int32)(_Rand() * (double)_MineChanceNow()) == 0) {
+		for (int32 i = 0; i < 6; i++) {
+			if (!fMines[i].live) {
+				fMines[i].DropAt(fSaucerX, kSaucerY + 12);
+				return;
+			}
+		}
+		return;
+	}
+	for (int32 i = 0; i < 6; i++) {
+		if (!fBombs[i].live) {
+			fBombs[i].FireFrom(fSaucerX, kSaucerY + 12, 4);
+			return;
+		}
+	}
+}
+
+
+// ── the capture boss ─────────────────────────────────────────────────────
+void
+Galaxigans::_StepBoss()
+{
+	// A freed pilot falls home from wherever the beam had got it to -- in ANY
+	// boss state, including after the boss is gone.
+	if (fAbducting == 2) {
+		fAbducteeY += 5;
+		if (fAbducteeY >= kPilotRowY)
+			fAbducting = 0;
+	}
+	int32 event = fBoss.Step(fLives, fBossOn);
+	if (event == EV_DONE)
+		_ReleasePilot();
+	else if (event == EV_GRAB)
+		_DragPilot();
+	if (fBoss.IsBeaming())
+		_CascadeBeam();
+}
+
+
+/// The abduction: a pilot leaves the row and rises up the beam. It reaching
+/// the boss costs a life -- and if that was the last one, the aliens have won.
+void
+Galaxigans::_DragPilot()
+{
+	if (fAbducting == 0) {
+		if (fLives <= 1)					// never take the last pilot
+			return;
+		fAbducting = 1;
+		fAbducteeX = fBoss.BeamX() - 6;
+		fAbducteeY = kPilotRowY;
+		return;
+	}
+	if (fAbducting != 1)
+		return;
+	fAbducteeY -= 3;
+	if (fAbducteeY > fBoss.y + 26)
+		return;
+	fLives--;
+	fAbducting = 0;
+	_BurstAt(fBoss.BeamX(), fBoss.y + 26, IX_SPARK_GOLD);
+	if (fLives <= 0) {
+		_BeginDance();
+		fBoss.Vanish();
+	} else
+		fBoss.Retreat();
+}
+
+
+/// The beam times out with nobody taken: whatever is halfway up falls home.
+void
+Galaxigans::_ReleasePilot()
+{
+	if (fAbducting == 1)
+		fAbducting = 2;
+}
+
+
+/// Shooting the boss frees any pilot in the beam (it drops home, saved) and
+/// pays 500 -- the reason to stand under a tractor beam.
+void
+Galaxigans::_CheckBossHit()
+{
+	for (int32 i = 0; i < 4; i++) {
+		if (fBullets[i].live && fBoss.Hits(fBullets[i].x, fBullets[i].y)) {
+			fBullets[i].live = false;
+			fScore += kBossScore;
+			_BurstAt(fBoss.x + 16, fBoss.y + 16, IX_SPARK_RED);
+			_ReleasePilot();
+			fBoss.Retreat();
+			return;
+		}
+	}
+}
+
+
+/// The beam's colour FLOWS without redrawing a pixel: the cone is drawn once
+/// in palette index 1, and index 1 means something different on every
+/// scanline. Stepping the ramp by (y + phase) each frame sends the bands
+/// downward -- the copper-bar trick.
+void
+Galaxigans::_CascadeBeam()
+{
+	int32 top = fBoss.BeamTop();
+	int32 bottom = fBoss.BeamBottom();
+	fBeamPhase++;
+	for (int32 y = top; y <= bottom; y++) {
+		if (y < 0 || y >= kFieldH)
+			continue;
+		int32 k = ((y - top + fBeamPhase) / 2) % 8;
+		rgb_color c;
+		c.red = kBeamRamp[k][0];
+		c.green = kBeamRamp[k][1];
+		c.blue = kBeamRamp[k][2];
+		c.alpha = 255;
+		SetScanlineColor(y, IX_BEAM, c);
+	}
+}
+
+
+// ── collisions ───────────────────────────────────────────────────────────
+void
+Galaxigans::_CheckCollisions()
+{
+	for (int32 b = 0; b < 4; b++) {
+		if (!fBullets[b].live)
+			continue;
+		if (fSaucerDir != 0 && fBullets[b].Hits(fSaucerX, kSaucerY + 4, 12, 8)) {
+			fBullets[b].live = false;
+			fScore += 200;
+			_BurstAt(fSaucerX, kSaucerY + 4, IX_SPARK_GOLD);
+			fSaucerDir = 0;
+			fSaucerX = -80;
+		}
+		if (!fBullets[b].live)
+			continue;
+		for (int32 a = 0; a < kRows * kCols; a++) {
+			if (!fFleet[a].Hits(fBullets[b].x, fBullets[b].y, 4))
+				continue;
+			fBullets[b].live = false;
+			fScore += fFleet[a].Points();
+			_BurstAt(fFleet[a].x, fFleet[a].y, IX_SPARK_RED);
+			fFleet[a].Kill();
+			break;
+		}
+	}
+
+	_CheckBossHit();
+
+	// Shooting a mine is the treat: 150, the best points on the screen.
+	for (int32 b = 0; b < 4; b++) {
+		if (!fBullets[b].live)
+			continue;
+		for (int32 m = 0; m < 6; m++) {
+			if (!fMines[m].Hits(fBullets[b].x, fBullets[b].y, 4, 4))
+				continue;
+			fBullets[b].live = false;
+			fMines[m].live = false;
+			fScore += kMineScore;
+			_BurstAt(fMines[m].x, fMines[m].y, IX_SPARK_GOLD);
+			break;
+		}
+	}
+
+	if (fRespawn > 0)
+		return;
+	// And touching one is the threat.
+	for (int32 m = 0; m < 6; m++) {
+		if (fMines[m].Hits(fShipX, kPlayerY, 6, 6)) {
+			fMines[m].live = false;
+			_LoseLife();
+		}
+	}
+	for (int32 b = 0; b < 6; b++) {
+		if (fBombs[b].Hits(fShipX, kPlayerY, 8, 10)) {
+			fBombs[b].live = false;
+			_LoseLife();
+		}
+	}
+	for (int32 a = 0; a < kRows * kCols; a++) {
+		if (fFleet[a].IsDiving() && fFleet[a].Hits(fShipX, kPlayerY, 6)) {
+			_BurstAt(fFleet[a].x, fFleet[a].y, IX_SPARK_RED);
+			fFleet[a].Kill();
+			_LoseLife();
+		}
+	}
+}
+
+
+void
+Galaxigans::_LoseLife()
+{
+	if (fState != PLAYING)
+		return;
+	_BurstAt(fShipX, kPlayerY, IX_SPARK_GOLD);
+	fLives--;
+	fRespawn = 90;
+	fShipX = kFieldW / 2;
+	if (fLives <= 0)
+		_BeginDance();
+}
+
+
+// ── explosions ───────────────────────────────────────────────────────────
+void
+Galaxigans::_BurstAt(int32 bx, int32 by, uint8 colour)
+{
+	const int32 n = 14;
+	for (int32 i = 1; i <= n; i++) {
+		if (fSparkCount >= (int32)(sizeof(fSparks) / sizeof(fSparks[0])))
+			break;
+		int32 ang = i * 256 / n;
+		Spark& s = fSparks[fSparkCount++];
+		s.x = bx;
+		s.y = by;
+		s.vx = sine_at(ang) * 5 / 256;
+		s.vy = sine_at(ang + 64) * 5 / 256 - 2;
+		s.life = 18;
+		s.colour = colour;
+	}
+}
+
+
+void
+Galaxigans::_StepSparks()
+{
+	int32 keep = 0;
+	for (int32 i = 0; i < fSparkCount; i++) {
+		fSparks[i].Step();
+		if (fSparks[i].life > 0)
+			fSparks[keep++] = fSparks[i];
+	}
+	fSparkCount = keep;
+}
+
+
+// ── drawing ──────────────────────────────────────────────────────────────
+/// The world is cleared to 0 so the cosmos shows through, then the sparks,
+/// the shots and the beam cone. Then the sprites, then the HUD on the front
+/// plane -- which is over them, so an alien crossing the score passes behind.
+void
+Galaxigans::_Draw()
+{
+	SetPlane(B_GAME_WORLD);
+	Clear(0);
+	for (int32 i = 0; i < fSparkCount; i++)
+		FillRect(fSparks[i].x, fSparks[i].y, 2, 2, fSparks[i].colour);
+	for (int32 i = 0; i < 4; i++) {
+		if (fBullets[i].live)
+			FillRect(fBullets[i].x - 1, fBullets[i].y, 3, 8, IX_BULLET);
+	}
+	for (int32 i = 0; i < 6; i++) {
+		if (fBombs[i].live)
+			FillRect(fBombs[i].x - 2, fBombs[i].y, 4, 6, IX_BOMB);
+	}
+	// The tractor beam: a cone from the boss's mouth to the floor, drawn ONCE
+	// in index 1 -- whose colour the cascade has already made different on
+	// every scanline. Half-width 4 -> 20 down its length.
+	if (fBoss.IsBeaming()) {
+		int32 top = fBoss.BeamTop();
+		int32 bottom = fBoss.BeamBottom();
+		int32 span = bottom - top > 1 ? bottom - top : 1;
+		int32 bx = fBoss.BeamX();
+		for (int32 y = top; y <= bottom; y++) {
+			int32 hw = 4 + (y - top) * 16 / span;
+			FillRect(bx - hw, y, hw * 2, 1, IX_BEAM);
+		}
+	}
+
+	_PlaceSprites();
+
+	SetPlane(B_GAME_FRONT);
+	Clear(0);
+	_DrawHud();
+	SetPlane(B_GAME_WORLD);
+}
+
+
+/// The fleet flaps: every eighth frame the whole formation switches to its
+/// species' second frame. The high-score scene stands alone.
+void
+Galaxigans::_PlaceSprites()
+{
+	ClearSprites();
+	if (fState == HISCORE)
+		return;
+
+	fFlap = (fFrame / 8) % 2;
+	for (int32 i = 0; i < kRows * kCols; i++) {
+		if (!fFleet[i].alive)
+			continue;
+		DrawSprite(fSpeciesShape[fFleet[i].species][fFlap],
+			fFleet[i].x - 8, fFleet[i].y - 8, 1.0f, 0.0f, 1.0f,
+			(uint8)(PAL_SPECIES + fFleet[i].species));
+	}
+	for (int32 i = 0; i < 6; i++) {
+		if (fMines[i].live) {
+			DrawSprite(fMineShape[fMines[i].Frame()], fMines[i].x - 8,
+				fMines[i].y - 8, 1.0f, 0.0f, 1.0f, PAL_MINE);
+		}
+	}
+	if (!fBoss.IsIdle())
+		DrawSprite(fBossShape[fBoss.Frame()], fBoss.x, fBoss.y, 1.0f, 0.0f, 1.0f, PAL_BOSS);
+
+	// The pilots along the bottom, one per life. A pilot in the beam has LEFT
+	// the row: drawn wherever the beam has dragged it to.
+	int32 inRow = fAbducting > 0 ? fLives - 1 : fLives;
+	for (int32 i = 0; i < 4; i++) {
+		if (i < inRow) {
+			DrawSprite(fPilotShape, kPilotX0 + i * kPilotGap, kPilotRowY,
+				1.0f, 0.0f, 1.0f, PAL_PILOT);
+		}
+	}
+	if (fAbducting > 0) {
+		DrawSprite(fPilotShape, fAbducteeX, fAbducteeY, 1.0f, 0.0f, 1.0f,
+			PAL_PILOT);
+	}
+	if (fSaucerDir != 0) {
+		DrawSprite(fSaucerShape, fSaucerX - 10, kSaucerY, 1.0f, 0.0f, 1.0f,
+			PAL_SAUCER);
+	}
+	bool blink = fRespawn > 0 && (fRespawn / 4) % 2 == 0;
+	if ((fState == PLAYING && fRespawn == 0) || blink) {
+		DrawSprite(fShipShape, fShipX - 8, kPlayerY - 7, 1.0f, 0.0f, 1.0f,
+			PAL_SHIP);
+	}
+}
+
+
+void
+Galaxigans::_DrawHud()
+{
+	char line[96];
+	if (fState == HISCORE) {
+		_DrawHiscores();
+		return;
+	}
+	int32 best = fHiScore > fScore ? fHiScore : fScore;
+	snprintf(line, sizeof(line), "SCORE %ld", (long)fScore);
+	DrawText(10, 8, line, IX_WHITE, F_BODY);
+	snprintf(line, sizeof(line), "HI %ld", (long)best);
+	DrawText(250, 8, line, IX_GOLD, F_BODY);
+	snprintf(line, sizeof(line), "WAVE %ld", (long)fWave);
+	DrawText(440, 8, line, IX_CYAN, F_BODY);
+	DrawText(440, 336, kSceneName[fScene % 12], IX_DIM, F_BODY);
+	snprintf(line, sizeof(line), "SHIPS %ld", (long)fLives);
+	DrawText(10, 336, line, IX_SHIP, F_BODY);
+
+	if (fState == ATTRACT) {
+		DrawText(176, 140, "GALAXIGANS", IX_GOLD, F_HUGE);
+		DrawText(152, 200, "SPACE TO START   ARROWS TO STEER", IX_WHITE, F_BODY);
+	} else if (fState == CLEARED) {
+		DrawText(200, 150, "WAVE CLEARED", IX_GREEN, F_BIG);
+		snprintf(line, sizeof(line), "NEXT: %s", kSceneName[fWave % 12]);
+		DrawText(200, 200, line, IX_WHITE, F_BODY);
+	} else if (fState == OVER) {
+		DrawText(220, 160, "GAME OVER", IX_RED, F_BIG);
+		snprintf(line, sizeof(line), "SCORE %ld", (long)fScore);
+		DrawText(236, 210, line, IX_AMBER, F_BODY);
+	}
+}
+
+
+void
+Galaxigans::_DrawHiscores()
+{
+	char line[96], digits[16];
+	DrawText(130, 46, "H I G H   S C O R E S", IX_GOLD, F_MID);
+
+	// The player's own score, flashing, above the table. It is the thing they
+	// came to see, and reading it out of a six-row list is not the same as
+	// being shown it.
+	score6(digits, sizeof(digits), fScore);
+	snprintf(line, sizeof(line), "YOUR SCORE  %s", digits);
+	DrawText(196, 86, line, (fFrame / 10) % 2 == 0 ? IX_WHITE : IX_AMBER, F_BODY);
+
+	int32 y = 110;
+	for (int32 i = 0; i < HALL_ROWS; i++) {
+		score6(digits, sizeof(digits), fHall.score[i]);
+		snprintf(line, sizeof(line), "%ld  %s  %s", (long)(i + 1),
+			fHall.name[i], digits);
+		DrawText(190, y, line, i + 1 == fHiNewRow ? IX_GOLD : IX_SHIP, F_BODY);
+		y += 26;
+	}
+
+	size_t typed = strlen(fInitials);
+	if (fHiNewRow > 0 && typed < 3) {
+		// Three boxes, the one being typed blinking. An arcade asks for
+		// initials by showing you the space they go in.
+		DrawText(150, 300, "ENTER YOUR INITIALS", IX_GREEN, F_BODY);
+		char slot[8];
+		int32 at = 0;
+		for (size_t i = 0; i < 3; i++) {
+			if (i < typed)
+				slot[at++] = fInitials[i];
+			else if (i == typed && (fFrame / 8) % 2 == 0)
+				slot[at++] = '_';
+			else
+				slot[at++] = '.';
+			slot[at++] = ' ';
+		}
+		slot[at] = '\0';
+		DrawText(268, 330, slot, IX_AMBER, F_MID);
+	} else if (fHiNewRow > 0)
+		DrawText(208, 300, "A PLACE IN THE HALL", IX_GREEN, F_BODY);
+	if (typed == 3 || fHiNewRow == 0)
+		DrawText(232, 356, "SPACE TO CONTINUE", IX_DIM, F_BODY);
+}
