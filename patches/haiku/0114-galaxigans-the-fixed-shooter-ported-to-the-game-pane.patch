+// ── the keyboard ─────────────────────────────────────────────────────────
+// A game reads the keys, it does not wait to be told about them: get_key_info
+// gives the whole board at whatever moment the frame asks, which is what a
+// held arrow needs and what a message queue cannot honestly give.
+static const uint8 kKeyEscape = 0x01;
+static const uint8 kKeySpace = 0x5e;
+static const uint8 kKeyLeft = 0x61;
+static const uint8 kKeyRight = 0x63;
+static const uint8 kKeyEnter = 0x47;
+
+
+static bool
+key_down(const key_info& keys, uint8 code)
+{
+	return (keys.key_states[code >> 3] & (1 << (7 - (code & 7)))) != 0;
+}
