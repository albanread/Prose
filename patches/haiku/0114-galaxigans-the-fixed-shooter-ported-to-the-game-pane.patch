+ *
+ * Galaxigans: the creature library. Art.cpp is generated from the Mojo
+ * original's art.mojo; this is the handle on it.
+ *
+ * Every definition carries its own sixteen colours, so a sprite palette
+ * belongs to a creature and the world keeps all 255 of its own.
+ */
+#ifndef GALAXIGANS_ART_H
