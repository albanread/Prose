+{
+	return k >= 0 && k < SPECIES_COUNT ? kSpeciesName[k] : "?";
+}
+
+
+/// One row-string art definition into one byte a pixel, which is what the kit
+/// takes: '.' is 0 and a hex digit is itself.
+void
+decode_art(const char* const* rows, uint32 width, uint32 height, uint8* out)
+{
+	memset(out, 0, (size_t)width * height);
+	for (uint32 y = 0; y < height; y++) {
+		const char* row = rows[y];
+		for (uint32 x = 0; x < width && row[x] != '\0'; x++) {
+			char c = row[x];
+			uint8 value = 0;
+			if (c >= '0' && c <= '9')
+				value = (uint8)(c - '0');
+			else if (c >= 'A' && c <= 'F')
+				value = (uint8)(c - 'A' + 10);
+			else if (c >= 'a' && c <= 'f')
+				value = (uint8)(c - 'a' + 10);
+			out[y * width + x] = value;
+		}
+	}
+}
+
+
+static int32
+define(BGamePane* pane, const char* const* rows, uint32 width, uint32 height,
+	const uint8* palette, uint32 colours, uint8 slot)
+{
+	uint8 pixels[48 * 48];
+	if (width * height > sizeof(pixels))
+		return B_BAD_VALUE;
+	decode_art(rows, width, height, pixels);
+	for (uint32 i = 0; i < colours; i++) {
+		rgb_color c;
+		c.red = palette[i * 3];
+		c.green = palette[i * 3 + 1];
+		c.blue = palette[i * 3 + 2];
+		c.alpha = 255;
+		pane->SetSpriteColor(slot, (uint8)(i + 1), c);
+	}
+	return pane->DefineSprite(pixels, width, height, 4);
+}
+
+
+int32
+define_species(BGamePane* pane, int32 k, int32 flap, uint8 slot)
+{
+	return define(pane, kSpecies[k][flap], 16, 16, kSpeciesPal[k], 10, slot);
+}
