+int32		define_boss(BGamePane* pane, int32 frame, uint8 slot);
+int32		define_pilot(BGamePane* pane, uint8 slot);
+int32		define_ship(BGamePane* pane, uint8 slot);
+int32		define_saucer(BGamePane* pane, uint8 slot);
+
+
+#endif	/* GALAXIGANS_ART_H */
