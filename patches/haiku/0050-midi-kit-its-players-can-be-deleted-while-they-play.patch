 using namespace BPrivate;
 
 
+// Run threads whose object was deleted while they were still in Run(): by
+// a song hook that deletes its own player, or after they did not stop in
+// time (see _StopRunThread()). They must not touch the object again. Plain
+// data, so that it outlives the static destructors at exit.
+static pthread_mutex_t sOrphanLock = PTHREAD_MUTEX_INITIALIZER;
+static BList* sOrphans = NULL;
+
+
+static void
+orphan_run_thread(thread_id thread)
+{
+	pthread_mutex_lock(&sOrphanLock);
+	if (sOrphans == NULL)
+		sOrphans = new BList;
+	if (!sOrphans->HasItem((void*)(addr_t)thread))
+		sOrphans->AddItem((void*)(addr_t)thread);
+	pthread_mutex_unlock(&sOrphanLock);
+}
+
+
 status_t 
 _run_thread(void* data)
 {
 	BMidi* midi = (BMidi*)data;
 	midi->Run();
-	midi->fIsRunning = false;
+
+	pthread_mutex_lock(&sOrphanLock);
+	if (sOrphans == NULL
+		|| !sOrphans->RemoveItem((void*)(addr_t)find_thread(NULL))) {
+		midi->fIsRunning = false;
+	}
+	pthread_mutex_unlock(&sOrphanLock);
 	return 0;
 }
 
