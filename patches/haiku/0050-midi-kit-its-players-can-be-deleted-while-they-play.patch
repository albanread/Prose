 }
 
 
+// Stops the run thread and waits until it has left Run(): destructors do
+// this before they free what Run() uses. Stop() only asks the thread to
+// stop -- it clears fThreadId, which KeepRunning() looks at -- and returns;
+// the thread goes on until its current message is taken, so waiting for
+// fThreadId after Stop() (as ~BMidi did) waited for nothing, and the
+// thread ran on in a freed object. It is remembered in fRunThread instead.
+// Two threads are not waited for: the run thread itself (a song hook that
+// deletes its player), and one that has not stopped after kMidiStopTimeout
+// (one in a song hook waiting for a lock the caller holds) -- rather than
+// deadlock on it. Both become orphans: _run_thread() leaves the object
+// alone after Run().
+bool
+BMidi::_StopRunThread()
+{
+	thread_id thread = fRunThread;
+	Stop();
+	if (thread < 0)
+		return true;
+	if (thread == find_thread(NULL)) {
+		orphan_run_thread(thread);
+		return false;
+	}
+
+	status_t result;
+	status_t status;
+	do {
+		status = wait_for_thread_etc(thread, B_RELATIVE_TIMEOUT,
+			kMidiStopTimeout, &result);
+	} while (status == B_INTERRUPTED);
+
+	if (status == B_TIMED_OUT) {
+		fprintf(stderr, "BMidi: the run thread %" B_PRId32 " did not stop "
+			"within %" B_PRIdBIGTIME " s\n", thread,
+			kMidiStopTimeout / 1000000);
+		orphan_run_thread(thread);
+		return false;
+	}
+	fRunThread = -1;
+	return true;
+}
+
+
+// Stops the input -- the glue that other BMidi objects spray to, which
+// calls the hooks from its own thread -- delivering to this object: waits
+// for a delivery in progress, and drops the ones after. Destructors do this
+// before they take down what the hooks use (be_synth, for a BMidiSynth).
+bool
+BMidi::_DetachConsumer()
+{
+	if (static_cast<BMidiGlue*>(fConsumer)->Detach(kMidiStopTimeout))
+		return true;
+
+	fprintf(stderr, "BMidi: a delivery to %p did not end within %"
+		B_PRIdBIGTIME " s\n", this, kMidiStopTimeout / 1000000);
+	return false;
+}
+
+
 void BMidi::_ReservedMidi1() {}
 void BMidi::_ReservedMidi2() {}
 void BMidi::_ReservedMidi3() {}
