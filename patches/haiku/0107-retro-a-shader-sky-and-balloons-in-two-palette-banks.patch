@@ -40,7 +41,9 @@ enum {
 	kHillLit	= 18,
 	kStar		= 19,
 	kLogo		= 20,
-	kShipFirst	= 24		// the ship's eight
+	kShipFirst	= 24,		// the ship's eight
+	kBankA		= 32,		// two banks of sixteen for the four-bit sprites
+	kBankB		= 48
 };
 
 static const uint32 kStars = 120;
@@ -59,7 +62,9 @@ public:
 private:
 			void				_MakePalette();
 			void				_MakeShip();
+			void				_MakeBalloon();
