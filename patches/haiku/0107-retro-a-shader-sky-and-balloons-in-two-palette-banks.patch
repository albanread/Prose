+			void				_SetShader(bool on);
 			void				_DrawSky(double t);
 			void				_DrawLand();
 			void				_DrawStars(int32 frame);
@@ -67,7 +72,9 @@ private:
 			thread_id			fThread;
 			bool				fQuit;
 			bool				fScrolling;
+			bool				fShaderSky;
 			int32				fShip;
+			int32				fBalloon;
 			uint8				fLogo[32 * 32];
 			int32				fStarX[kStars];
 			int32				fStarY[kStars];
@@ -112,7 +119,9 @@ RetroPane::RetroPane()
 	fThread(-1),
 	fQuit(false),
 	fScrolling(true),
-	fShip(-1)
+	fShaderSky(true),
+	fShip(-1),
+	fBalloon(-1)
 {
 	AddChild(new KeyView(Bounds()));
 	CenterOnScreen();
@@ -124,7 +133,9 @@ RetroPane::RetroPane()
 	SetEffect(B_GAME_PANE_CRT);
 	_MakePalette();
 	_MakeShip();
+	_MakeBalloon();
 	_MakeLogo();
