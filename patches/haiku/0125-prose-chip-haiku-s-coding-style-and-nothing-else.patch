@@ -474,7 +477,7 @@ struct driver_module_info sPrchDriver = {
 
 
 module_info* modules[] = {
-	(module_info*)&sPrchDriver,
-	(module_info*)&sPrchDevice,
+	reinterpret_cast<module_info*>(&sPrchDriver),
+	reinterpret_cast<module_info*>(&sPrchDevice),
 	NULL
 };
