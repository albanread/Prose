-#include <prose_chip.h>
 
 
 #define PRCH_DRIVER_MODULE_NAME		"drivers/audio/hmulti/prose_chip/driver_v1"
@@ -38,9 +39,9 @@
 #define INFO(x...)	dprintf("prose_chip: " x)
 #define ERROR(x...)	dprintf("prose_chip: " x)
 
-/* The command page: a request of at most a header plus one tune, then the
-   answer. Both live in one contiguous allocation, so a request is two
-   physical entries into the same page and never a scatter list. */
+// The command page: a request of at most a header plus one tune, then the
+// answer. Both live in one contiguous allocation, so a request is two physical
+// entries into the same page and never a scatter list.
 #define PRCH_REQUEST_MAX	(sizeof(struct prose_chip_play) + PROSE_CHIP_TEXT_MAX)
 #define PRCH_RESPONSE_AT	ROUNDUP(PRCH_REQUEST_MAX, 64)
 #define PRCH_RESPONSE_MAX	64
@@ -76,7 +77,7 @@ static device_manager_info* sDeviceManager;
 static void
 prch_callback(void* driverCookie, void* cookie)
 {
-	prch_info* info = (prch_info*)cookie;
+	prch_info* info = static_cast<prch_info*>(cookie);
 	release_sem_etc(info->done, 1, B_DO_NOT_RESCHEDULE);
 }
 
@@ -84,7 +85,8 @@ prch_callback(void* driverCookie, void* cookie)
 /*!	One command, there and back. The queue carries a request buffer the host
 	reads and a response buffer it writes; the caller waits for the answer,
 	because every one of these is a thing the player asked for and wants the
-	result of. */
+	result of.
+*/
 static status_t
 prch_command(prch_info* info, const void* request, size_t requestSize,
 	struct prose_chip_resp* response)
@@ -94,7 +96,7 @@ prch_command(prch_info* info, const void* request, size_t requestSize,
 
 	MutexLocker locker(info->lock);
 	memcpy(info->buffer, request, requestSize);
-	((struct prose_chip_hdr*)info->buffer)->seq = ++info->seq;
+	reinterpret_cast<struct prose_chip_hdr*>(info->buffer)->seq = ++info->seq;
 	memset(info->buffer + PRCH_RESPONSE_AT, 0, PRCH_RESPONSE_MAX);
 
 	physical_entry entries[2] = {
@@ -114,8 +116,8 @@ prch_command(prch_info* info, const void* request, size_t requestSize,
 	while (!info->virtio->queue_dequeue(info->queue, NULL, NULL))
 		spin(10);
 
-	struct prose_chip_resp* answer =
-		(struct prose_chip_resp*)(info->buffer + PRCH_RESPONSE_AT);
+	struct prose_chip_resp* answer
+		= reinterpret_cast<struct prose_chip_resp*>(info->buffer + PRCH_RESPONSE_AT);
 	if (response != NULL)
 		memcpy(response, answer, sizeof(*response));
 	if (answer->hdr.seq != info->seq)
@@ -172,7 +174,7 @@ prch_teardown(prch_info* info)
 static status_t
 prch_init_driver(device_node* node, void** _cookie)
 {
-	prch_info* info = (prch_info*)calloc(1, sizeof(prch_info));
+	prch_info* info = static_cast<prch_info*>(calloc(1, sizeof(prch_info)));
 	if (info == NULL)
 		return B_NO_MEMORY;
 	info->node = node;
@@ -181,8 +183,8 @@ prch_init_driver(device_node* node, void** _cookie)
 	mutex_init(&info->lock, "prose_chip command");
 
 	device_node* parent = sDeviceManager->get_parent_node(node);
-	sDeviceManager->get_driver(parent, (driver_module_info**)&info->virtio,
-		(void**)&info->device);
+	sDeviceManager->get_driver(parent, reinterpret_cast<driver_module_info**>(&info->virtio),
+		reinterpret_cast<void**>(&info->device));
 	sDeviceManager->put_node(parent);
 
 	status_t status = info->virtio->negotiate_features(info->device, 0, &info->features, NULL);
@@ -214,7 +216,7 @@ prch_init_driver(device_node* node, void** _cookie)
 		status = get_memory_map(address, PRCH_BUFFER_SIZE, &entry, 1);
 		if (status != B_OK)
 			goto error;
-		info->buffer = (uint8*)address;
+		info->buffer = static_cast<uint8*>(address);
 		info->phys = entry.address;
 		memset(info->buffer, 0, PRCH_BUFFER_SIZE);
 	}
@@ -257,14 +259,14 @@ error:
 static void
 prch_uninit_driver(void* cookie)
 {
-	prch_teardown((prch_info*)cookie);
+	prch_teardown(static_cast<prch_info*>(cookie));
 }
 
 
 static status_t
 prch_register_child_devices(void* cookie)
 {
-	prch_info* info = (prch_info*)cookie;
+	prch_info* info = static_cast<prch_info*>(cookie);
 	int32 id = sDeviceManager->create_id(PRCH_DEVICE_ID_GENERATOR);
 	if (id < 0)
 		return id;
@@ -292,11 +294,12 @@ prch_uninit_device(void* cookie)
 
 
 /*!	Many openers, unlike the portal: a tune and a sound effect are different
-	programs as often as not, and the tracks are what keeps them apart. */
+	programs as often as not, and the tracks are what keeps them apart.
+*/
 static status_t
 prch_open(void* deviceCookie, const char* path, int openMode, void** _cookie)
