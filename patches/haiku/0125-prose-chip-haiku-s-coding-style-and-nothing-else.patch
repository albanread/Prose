-	prch_info* info = (prch_info*)deviceCookie;
+	prch_info* info = static_cast<prch_info*>(deviceCookie);
 	atomic_add(&info->openCount, 1);
 	*_cookie = info;
 	return B_OK;
@@ -313,7 +316,7 @@ prch_close(void* cookie)
 static status_t
 prch_free(void* cookie)
 {
-	prch_info* info = (prch_info*)cookie;
+	prch_info* info = static_cast<prch_info*>(cookie);
 	atomic_add(&info->openCount, -1);
 	return B_OK;
 }
@@ -322,15 +325,15 @@ prch_free(void* cookie)
