+//	#pragma mark - text
+
+
+/// Glyphs are rendered once, by the system's own font engine, into shapes of
+/// our own: any size, any family, and no font data in the program.
+status_t
+BGamePane::SetTextFont(const BFont* font, float size)
+{
+	if (fStatus != B_OK)
+		return B_NO_INIT;
+	if (size < 4.0f || size > 64.0f)
+		return B_BAD_VALUE;
+
+	BFont chosen;
+	if (font != NULL)
+		chosen = *font;
+	else {
+		// A grid of characters wants a fixed width, and be_fixed_font is not
+		// reliably one here; take the first fixed family there is.
+		static const char* kPreferred[] = { "JetBrains Mono", "Fira Code",
+			"Noto Sans Mono", "Noto Mono", "DejaVu Sans Mono", NULL };
+		chosen = *be_plain_font;
+		for (int32 i = 0; kPreferred[i] != NULL; i++) {
+			BFont candidate;
+			if (candidate.SetFamilyAndStyle(kPreferred[i], NULL) == B_OK) {
+				chosen = candidate;
+				break;
+			}
+		}
+	}
+	chosen.SetSize(size);
+
+	font_height metrics;
+	chosen.GetHeight(&metrics);
+	uint32 cellHeight = (uint32)ceilf(metrics.ascent + metrics.descent);
+	uint32 cellWidth = 1;
+	for (char c = 32; c < 127; c++) {
+		char text[2] = { c, 0 };
+		uint32 width = (uint32)ceilf(chosen.StringWidth(text));
+		if (width > cellWidth)
+			cellWidth = width;
+	}
+	if (cellWidth == 0 || cellHeight == 0)
+		return B_ERROR;
+
+	BRect bounds(0, 0, (float)(cellWidth * 95) - 1, (float)cellHeight - 1);
+	BBitmap sheet(bounds, B_RGBA32, true);
+	if (sheet.InitCheck() != B_OK)
+		return sheet.InitCheck();
+	BView view(bounds, "glyphs", B_FOLLOW_NONE, B_WILL_DRAW);
+	sheet.AddChild(&view);
+	if (!sheet.Lock()) {
+		sheet.RemoveChild(&view);
+		return B_ERROR;
+	}
+	view.SetHighColor(0, 0, 0, 0);
+	view.FillRect(bounds);
+	view.SetFont(&chosen);
+	view.SetHighColor(255, 255, 255, 255);
+	view.SetDrawingMode(B_OP_ALPHA);
+	for (uint32 i = 0; i < 95; i++) {
+		char text[2] = { (char)(32 + i), 0 };
+		view.DrawString(text, BPoint((float)(i * cellWidth), metrics.ascent));
+	}
+	view.Sync();
+	sheet.Unlock();
+	sheet.RemoveChild(&view);
+
+	uint8* glyphs = (uint8*)malloc((size_t)cellWidth * cellHeight * 95);
+	if (glyphs == NULL)
+		return B_NO_MEMORY;
+	const uint8* bits = (const uint8*)sheet.Bits();
+	int32 stride = sheet.BytesPerRow();
+	for (uint32 i = 0; i < 95; i++) {
+		for (uint32 y = 0; y < cellHeight; y++) {
+			for (uint32 x = 0; x < cellWidth; x++) {
+				const uint8* pixel = bits + (size_t)y * stride
+					+ (size_t)(i * cellWidth + x) * 4;
+				glyphs[(i * cellHeight + y) * cellWidth + x] = pixel[3] >= 128 ? 1 : 0;
+			}
+		}
+	}
+
+	BAutolock lock(fLock);
+	free(fGlyphs);
+	fGlyphs = glyphs;
+	fGlyphWidth = cellWidth;
+	fGlyphHeight = cellHeight;
+	return B_OK;
+}
+
+
+uint32
+BGamePane::TextWidth(const char* text) const
+{
+	if (fGlyphs == NULL || text == NULL)
+		return 0;
+	return (uint32)strlen(text) * fGlyphWidth;
+}
+
+
+uint32
+BGamePane::TextHeight() const
+{
+	return fGlyphHeight;
+}
+
+
+void
+BGamePane::DrawText(int32 x, int32 y, const char* text, uint8 index)
+{
+	if (fGlyphs == NULL || text == NULL || index == 0)
+		return;
+	uint8* world = World();
+	if (world == NULL)
+		return;
+
+	for (const char* c = text; *c != '\0'; c++, x += (int32)fGlyphWidth) {
+		uint8 code = (uint8)*c;
+		if (code < 32 || code > 126)
+			continue;					// a space: nothing to draw
+		const uint8* glyph = fGlyphs + (size_t)(code - 32) * fGlyphWidth * fGlyphHeight;
+		for (uint32 row = 0; row < fGlyphHeight; row++) {
+			int32 at = y + (int32)row;
+			if (at < 0 || (uint32)at >= fWorldHeight)
+				continue;
+			uint8* out = world + (size_t)at * fStride;
+			for (uint32 column = 0; column < fGlyphWidth; column++) {
+				int32 across = x + (int32)column;
+				if (across < 0 || (uint32)across >= fWorldWidth)
+					continue;
+				if (glyph[row * fGlyphWidth + column] != 0)
+					out[across] = index;
+			}
+		}
+	}
+}
+
+
+void
+BGamePane::DrawTextInView(int32 x, int32 y, const char* text, uint8 index)
+{
+	DrawText(x + fScrollX, y + fScrollY, text, index);
+}
