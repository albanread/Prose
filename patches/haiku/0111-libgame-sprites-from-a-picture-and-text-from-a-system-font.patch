+/// The nearest of the first `count` colours of the palette this sprite will
+/// use. Squared distance in RGB: not perceptual, but for flat retro art the
+/// difference never shows, and it costs one pass.
+uint8
+BGamePane::_Match(rgb_color colour, uint8 count) const
+{
+	uint8 best = 1;
+	int32 bestDistance = 0x7fffffff;
+	for (uint8 i = 1; i <= count; i++) {
+		rgb_color c = fMatchPalette[i];
+		int32 dr = (int32)c.red - colour.red;
+		int32 dg = (int32)c.green - colour.green;
+		int32 db = (int32)c.blue - colour.blue;
+		int32 distance = dr * dr + dg * dg + db * db;
+		if (distance < bestDistance) {
+			bestDistance = distance;
+			best = i;
+		}
+	}
+	return best;
+}
+
+
+/// Index a picture against a palette, building that palette as it goes when
+/// there is room and it is ours to build.
+int32
+BGamePane::_DefineFromBits(const uint8* bits, uint32 width, uint32 height,
+	uint32 bytesPerRow, bool hasAlpha, uint32 depth, uint8 palette)
+{
+	if (fStatus != B_OK || bits == NULL || width == 0 || height == 0)
+		return B_BAD_VALUE;
+	if (depth != 4 && depth != 8)
+		return B_BAD_VALUE;
+	if (depth == 4 && (palette == 0 || palette >= PRDS_SPRITE_PALETTES))
+		return B_BAD_VALUE;
+
+	const uint8 budget = depth == 4 ? 15 : 255;
+	uint8 count = 0;
+	bool building = depth == 4;
+
+	// At eight bits we match what the world already has; at four we take the
+	// picture's own colours, in the order they first appear.
+	if (!building) {
+		for (uint32 i = 1; i <= budget; i++)
+			fMatchPalette[i] = Color((uint8)i);
+		count = budget;
+	}
+
+	uint8* indices = (uint8*)malloc((size_t)width * height);
+	if (indices == NULL)
+		return B_NO_MEMORY;
+
+	for (uint32 y = 0; y < height; y++) {
+		const uint8* in = bits + (size_t)y * bytesPerRow;
+		for (uint32 x = 0; x < width; x++) {
+			const uint8* pixel = in + (size_t)x * 4;		// B_RGBA32: b, g, r, a
+			if (hasAlpha && pixel[3] < 128) {
+				indices[y * width + x] = 0;
+				continue;
+			}
+			rgb_color colour;
+			colour.blue = pixel[0];
+			colour.green = pixel[1];
+			colour.red = pixel[2];
+			colour.alpha = 255;
+
+			uint8 index = 0;
+			for (uint8 i = 1; i <= count && index == 0; i++) {
+				if (fMatchPalette[i].red == colour.red
+					&& fMatchPalette[i].green == colour.green
+					&& fMatchPalette[i].blue == colour.blue)
+					index = i;
+			}
+			if (index == 0) {
+				if (building && count < budget) {
+					fMatchPalette[++count] = colour;
+					index = count;
+				} else
+					index = _Match(colour, count);
+			}
+			indices[y * width + x] = index;
+		}
+	}
+
+	if (building) {
+		for (uint8 i = 1; i <= count; i++)
+			SetSpriteColor(palette, i, fMatchPalette[i]);
+	}
+	int32 shape = DefineSprite(indices, width, height, depth);
+	free(indices);
+	return shape;
+}
+
+
+int32
+BGamePane::DefineSprite(const BBitmap* bitmap, uint32 depth, uint8 palette)
+{
+	if (bitmap == NULL || !bitmap->IsValid())
+		return B_BAD_VALUE;
+
+	color_space space = bitmap->ColorSpace();
+	if (space == B_RGBA32 || space == B_RGB32) {
+		BRect bounds = bitmap->Bounds();
+		return _DefineFromBits((const uint8*)bitmap->Bits(),
+			(uint32)bounds.IntegerWidth() + 1, (uint32)bounds.IntegerHeight() + 1,
+			bitmap->BytesPerRow(), space == B_RGBA32, depth, palette);
+	}
+
+	// anything else goes through app_server once, which knows every format
+	BBitmap converted(bitmap->Bounds(), B_RGBA32, true);
+	if (converted.InitCheck() != B_OK)
+		return converted.InitCheck();
+	BView view(bitmap->Bounds(), "convert", B_FOLLOW_NONE, 0);
+	converted.AddChild(&view);
+	if (!converted.Lock())
+		return B_ERROR;
+	view.SetDrawingMode(B_OP_COPY);
+	view.DrawBitmap(bitmap, BPoint(0, 0));
+	view.Sync();
+	converted.Unlock();
+	converted.RemoveChild(&view);
+	return DefineSprite(&converted, depth, palette);
+}
+
+
+int32
+BGamePane::DefineSprite(const char* imagePath, uint32 depth, uint8 palette)
+{
+	if (imagePath == NULL)
+		return B_BAD_VALUE;
+	BBitmap* bitmap = BTranslationUtils::GetBitmapFile(imagePath);
+	if (bitmap == NULL)
+		return B_ENTRY_NOT_FOUND;
+	int32 shape = DefineSprite(bitmap, depth, palette);
+	delete bitmap;
+	return shape;
+}
