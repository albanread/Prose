+	} else if (has_modern_capabilities(pci, device)) {
+		// HaikuArmQemu fork: a transitional device (QEMU's default virtio-*-pci)
+		// offers both interfaces. Prefer the modern one, as Linux does: the
+		// legacy interface needs I/O ports, and on arm64 Haiku's PCI layer
+		// reports host address 0 for every I/O BAR, so all legacy devices
+		// aliased the one at PCI I/O address 0 (the net driver's init reset
+		// the disk).
+		virtioVersion = 1;
+		TRACE_ALWAYS("transitional device %04x: using the modern interface\n",
+			pciDeviceId);
