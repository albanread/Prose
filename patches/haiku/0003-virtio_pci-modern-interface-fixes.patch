+// HaikuArmQemu fork: does this (transitional) device also expose the modern
+// (virtio 1.0) capability structures?
+static bool
+has_modern_capabilities(pci_device_module_info* pci, pci_device* device)
+{
+	uint8 offset;
+	if (pci->find_pci_capability(device, PCI_cap_id_vendspec, &offset) != B_OK)
+		return false;
+	// Walk the whole list from there: it can contain non-vendor capabilities too.
+	for (int guard = 0; offset != 0 && guard < 48; guard++) {
+		uint32 head = pci->read_pci_config(device, offset, 4);
+		if ((head & 0xff) == PCI_cap_id_vendspec
+			&& ((head >> 24) & 0xff) == VIRTIO_PCI_CAP_COMMON_CFG) {
+			return true;
+		}
+		offset = (head >> 8) & 0xff;
+	}
+	return false;
+}
