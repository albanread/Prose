+enum { TRACK_MOTIF = 0, TRACK_CUE = 1, TRACK_SFX = 2, TRACK_HUM = 3 };
+
+// The floor between two species motifs: thirty seconds, in frames at 30 Hz.
+// A motif is a bar long, so this is not a fade rule -- it is twenty-eight
+// seconds of no music at all between them, which is what makes the one you
+// do hear mean something.
