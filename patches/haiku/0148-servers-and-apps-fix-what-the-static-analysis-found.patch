diff --git a/src/servers/net/Services.cpp b/src/servers/net/Services.cpp
index 12220a7c0e..37651a52ae 100644
--- a/src/servers/net/Services.cpp
+++ b/src/servers/net/Services.cpp
@@ -147,10 +147,13 @@ Services::Services(const BMessage& services)
 {
 	// setup pipe to communicate with the listener thread - as the listener
 	// blocks on select(), we need a mechanism to interrupt it
-	if (pipe(&fReadPipe) < 0) {
+	int pipeFDs[2];
+	if (pipe(pipeFDs) < 0) {
 		fReadPipe = -1;
 		return;
 	}
+	fReadPipe = pipeFDs[0];
+	fWritePipe = pipeFDs[1];
 
 	fcntl(fReadPipe, F_SETFD, FD_CLOEXEC);
 	fcntl(fWritePipe, F_SETFD, FD_CLOEXEC);
