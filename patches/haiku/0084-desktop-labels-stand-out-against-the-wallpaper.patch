From 8eb778e2607341462e9e5835548ba9dca9e1233a Mon Sep 17 00:00:00 2001
From: albanread <albanread@googlemail.com>
Date: Mon, 21 Sep 2026 15:46:44 +0100
Subject: [PATCH] Desktop labels stand out against the wallpaper

Tracker chose the desktop labels' colour by comparing the workspace's
colour (BScreen::DesktopColor) with B_DESKTOP_COLOR -- two settings that
need not agree, and a theme sets them apart: prosetheme changed only the
second. So Prose Light drew white labels on the paper wallpaper and
Prose Dark, switched to at run time, black labels on the ink one; both
unreadable, measured in a guest before this change.

The desktop now picks black or white against what the labels stand on:
the wallpaper's average colour (a 64 x 64 grid of samples, taken when
Tracker shows the picture) when there is one, the workspace's colour
when there is not.

prosetheme writes the wallpaper with the label outline on (the
Backgrounds preferences' "Icon label outline"), as does the default a
new machine gets, and its "desktop" key now sets the workspaces' own
colour too -- B_DESKTOP_COLOR alone changes nothing on the screen.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Prose-Patch: 0084-desktop-labels-stand-out-against-the-wallpaper.patch c36609166d0aca5bdc87f8a14864b53bffa7188815505d1294ca02a18abab1e1
---
 src/bin/prosetheme/prosetheme.cpp        | 20 ++++++-
 src/kits/tracker/BackgroundImage.cpp     | 16 ++++++
 src/kits/tracker/DesktopPoseView.cpp     | 72 +++++++++++++++++++++++-
 src/kits/tracker/DesktopPoseView.h       |  7 +++
 src/kits/tracker/TrackerInitialState.cpp |  4 +-
 5 files changed, 114 insertions(+), 5 deletions(-)

diff --git a/src/bin/prosetheme/prosetheme.cpp b/src/bin/prosetheme/prosetheme.cpp
index f6682c1467..a9f59f1dfa 100644
--- a/src/bin/prosetheme/prosetheme.cpp
+++ b/src/bin/prosetheme/prosetheme.cpp
@@ -41,6 +41,7 @@
 #include <Messenger.h>
 #include <Node.h>
 #include <Path.h>
+#include <Screen.h>
 #include <String.h>
 
 #include <be_apps/Tracker/Background.h>
@@ -373,7 +374,8 @@ apply_wallpaper(const char* imagePath)
 		info.AddString(B_BACKGROUND_IMAGE, imagePath);
 		info.AddInt32(B_BACKGROUND_WORKSPACES, (int32)0xffffffff);
 		info.AddInt32(B_BACKGROUND_MODE, B_BACKGROUND_MODE_SCALED);
-		info.AddBool(B_BACKGROUND_ERASE_TEXT, false);
+		// the icons' labels outlined, so they read on any picture
+		info.AddBool(B_BACKGROUND_ERASE_TEXT, true);
 		info.AddPoint(B_BACKGROUND_ORIGIN, BPoint(0, 0));
 	}
 	ssize_t size = info.FlattenedSize();
@@ -400,11 +402,22 @@ apply_theme(const Theme& theme)
 	int failures = 0;
 
 	int32 colors = 0;
+	bool desktopColor = false;
 	for (size_t i = 0; i < kColorKeyCount; i++) {
 		if (!theme.hasColor[i])
 			continue;
 		set_ui_color(kColorKeys[i].which, theme.color[i]);
 		colors++;
+
+		if (kColorKeys[i].which == B_DESKTOP_COLOR) {
+			// What the desktop shows is each workspace's own colour, which
+			// the Backgrounds preferences set; B_DESKTOP_COLOR alone
+			// changes nothing on the screen.
+			BScreen screen;
+			for (int32 j = 0; j < count_workspaces(); j++)
+				screen.SetDesktopColor(theme.color[i], j, true);
+			desktopColor = true;
+		}
 	}
 	printf("%s: %" B_PRId32 " colour%s", theme.name.String(), colors,
 		colors == 1 ? "" : "s");
@@ -430,6 +443,11 @@ apply_theme(const Theme& theme)
 			printf(", %s: %s", what, strerror(status));
 			failures++;
 		}
+	} else if (desktopColor) {
+		// Tracker picks its labels' colour when the desktop is refreshed
+		BMessenger tracker(kTrackerSignature);
+		if (tracker.IsValid())
+			tracker.SendMessage(B_RESTORE_BACKGROUND_IMAGE);
 	}
 	printf("\n");
 
