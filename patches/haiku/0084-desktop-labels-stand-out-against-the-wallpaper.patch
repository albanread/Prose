@@ -295,6 +301,11 @@ BackgroundImage::Remove()
 		// their background
 		if (poseView != NULL)
 			poseView->SetWidgetTextOutline(true);
+
+		// PROSE fork: no picture behind the desktop's labels any more
+		DesktopPoseView* desktopView = dynamic_cast<DesktopPoseView*>(fView);
+		if (desktopView != NULL)
+			desktopView->WallpaperChanged(NULL);
 	}
 
 	fShowingBitmap = NULL;
@@ -350,6 +361,11 @@ BackgroundImage::WorkspaceActivated(BView* view, int32 workspace, bool state)
 			if (poseView != NULL)
 				poseView->SetWidgetTextOutline(true);
 
+			// PROSE fork: this workspace shows no picture
+			DesktopPoseView* desktopView = dynamic_cast<DesktopPoseView*>(view);
+			if (desktopView != NULL)
+				desktopView->WallpaperChanged(NULL);
+
 			view->ClearViewBitmap();
 			view->Invalidate();
 		}
diff --git a/src/kits/tracker/DesktopPoseView.cpp b/src/kits/tracker/DesktopPoseView.cpp
index 525c3eee0e..a74fa924e6 100644
--- a/src/kits/tracker/DesktopPoseView.cpp
+++ b/src/kits/tracker/DesktopPoseView.cpp
@@ -40,6 +40,9 @@ All rights reserved.
 
 #include "DesktopPoseView.h"
 
+#include <new>
+
+#include <Bitmap.h>
 #include <NodeMonitor.h>
 #include <Path.h>
 #include <Screen.h>
@@ -61,7 +64,9 @@ All rights reserved.
 
 DesktopPoseView::DesktopPoseView(Model* model, uint32 viewMode)
 	:
-	BPoseView(model, viewMode)
+	BPoseView(model, viewMode),
+	fHasWallpaper(false),
+	fWallpaperColor(kBlack)
 {
 	SetFlags(Flags() | B_DRAW_ON_CHILDREN);
 }
@@ -310,6 +315,67 @@ DesktopPoseView::AdaptToBackgroundColorChange()
 	// settings, it's expected that text will be black on white in Tracker
 	// folders, but white on blue on the desktop).
 
-	int32 desktopBrightness = ui_color(B_DESKTOP_COLOR).Brightness();
-	SetHighColor(LowColor().Brightness() <= desktopBrightness ? kWhite : kBlack);
+	// PROSE fork: black or white, whichever stands out against what the
+	// labels stand on -- the wallpaper when there is one, the desktop's
+	// colour when there is not. This compared the workspace's colour with
+	// B_DESKTOP_COLOR, two settings that need not agree (a theme sets them
+	// apart), and so drew white labels on a light wallpaper and black ones
+	// on a dark one.
+	rgb_color background = fHasWallpaper ? fWallpaperColor : LowColor();
+	SetHighColor(background.IsLight() ? kBlack : kWhite);
+}
+
+
+/*!	PROSE fork: the average colour of a picture, from a grid of samples. */
+static bool
+average_color(const BBitmap* bitmap, rgb_color& average)
+{
+	if (bitmap == NULL || !bitmap->IsValid())
+		return false;
+
+	// the translators give B_RGB32 or B_RGBA32; anything else is converted
+	BBitmap* converted = NULL;
+	if (bitmap->ColorSpace() != B_RGB32 && bitmap->ColorSpace() != B_RGBA32) {
+		converted = new(std::nothrow) BBitmap(bitmap->Bounds(), B_RGB32);
+		if (converted == NULL || converted->InitCheck() != B_OK
+			|| converted->ImportBits(bitmap) != B_OK) {
+			delete converted;
+			return false;
+		}
+		bitmap = converted;
+	}
+
+	const int32 kSamples = 64;
+	const uint8* bits = (const uint8*)bitmap->Bits();
+	int32 bytesPerRow = bitmap->BytesPerRow();
+	int32 width = bitmap->Bounds().IntegerWidth() + 1;
+	int32 height = bitmap->Bounds().IntegerHeight() + 1;
+	uint64 red = 0;
+	uint64 green = 0;
+	uint64 blue = 0;
+	for (int32 y = 0; y < kSamples; y++) {
+		const uint8* row = bits
+			+ (int64)((2 * y + 1) * height / (2 * kSamples)) * bytesPerRow;
+		for (int32 x = 0; x < kSamples; x++) {
+			// B_RGB32 and B_RGBA32 are blue, green, red, alpha in memory
+			const uint8* pixel = row + ((2 * x + 1) * width / (2 * kSamples)) * 4;
+			blue += pixel[0];
+			green += pixel[1];
+			red += pixel[2];
+		}
+	}
+	delete converted;
+
+	const uint64 count = kSamples * kSamples;
+	average = make_color(red / count, green / count, blue / count);
+	return true;
+}
+
+
+void
+DesktopPoseView::WallpaperChanged(const BBitmap* wallpaper)
+{
+	fHasWallpaper = average_color(wallpaper, fWallpaperColor);
+	AdaptToBackgroundColorChange();
+	Invalidate();
 }
diff --git a/src/kits/tracker/DesktopPoseView.h b/src/kits/tracker/DesktopPoseView.h
index 415c4fce47..c8ccc416b1 100644
--- a/src/kits/tracker/DesktopPoseView.h
+++ b/src/kits/tracker/DesktopPoseView.h
@@ -60,6 +60,10 @@ public:
 	void StartSettingsWatch();
 	void StopSettingsWatch();
 
+	void WallpaperChanged(const BBitmap* wallpaper);
+		// PROSE fork: the labels are drawn to stand out against it; NULL
+		// when the desktop shows no picture
+
 protected:
 	virtual EntryListBase* InitDirentIterator(const entry_ref*);
 
@@ -76,6 +80,9 @@ protected:
 	void AdaptToBackgroundColorChange();
 
 private:
+	bool fHasWallpaper;
+	rgb_color fWallpaperColor;
+		// PROSE fork: the wallpaper's average colour
 
 	typedef BPoseView _inherited;
 };
