 headers/private/kernel/acpi.h                 |  38 ++
 src/add-ons/kernel/drivers/power/Jamfile      |   1 +
 .../drivers/power/acpi_gpio_events/Jamfile    |   9 +
 .../acpi_gpio_events/acpi_gpio_events.cpp     | 361 ++++++++++++++++++
 5 files changed, 415 insertions(+), 1 deletion(-)
 create mode 100644 src/add-ons/kernel/drivers/power/acpi_gpio_events/Jamfile
