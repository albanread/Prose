From 0ab375765bec99456d7b789b6e9e7b2f91493630 Mon Sep 17 00:00:00 2001
From: albanread <albanread@googlemail.com>
Date: Tue, 22 Sep 2026 19:41:28 +0100
Subject: [PATCH] prose_display: a game-pane arena and the pane commands
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The pool already held app_server's two buffers; what is left of it after
them is now an arena a program can ask for a piece of. A pane is one
allocation — its world buffers, its palette and its sprites — and every
offset the client sends is relative to it, so nothing above the kit
thinks in pool offsets.

Four commands forward to the host (create, configure, present, destroy)
and four ioctls carry them, plus a retrace semaphore of its own so a
game waiting for vsync does not eat app_server's. Panes are bounds
checked against the pool, only their owning team may move or present
them, and one whose team has died is reclaimed — a game that crashes
must not leave a picture composited over the desktop.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Prose-Patch: 0102-prose-display-a-game-pane-arena-and-the-pane-commands.patch b1b746a9d73809626ace44d04b1d0678eb56a0cbf209270c95f695961a2ddc01
---
 .../graphics/prose_display/prose_display.h    | 135 +++++++++
 .../graphics/prose_display/prose_display.cpp  | 283 ++++++++++++++++++
 2 files changed, 418 insertions(+)

diff --git a/headers/private/graphics/prose_display/prose_display.h b/headers/private/graphics/prose_display/prose_display.h
index caa62751e8..7c0597fb7f 100644
--- a/headers/private/graphics/prose_display/prose_display.h
+++ b/headers/private/graphics/prose_display/prose_display.h
@@ -28,12 +28,39 @@
 #define PRDS_MAX_COMMIT_RECTS		64
 #define PRDS_EVENT_SIZE				32
 
+/* Game panes: an 8-bit indexed surface in the pool, composited by the host's
+   GPU over the desktop. See HaikuArmQemu/docs/game-pane.md. */
+#define PRDS_MAX_PANES				8
+#define PRDS_MAX_CLIP_RECTS			32
+#define PRDS_MAX_SPRITES			64
+#define PRDS_PANE_BUFFERS_MAX		3
+
+#define PRDS_PANE_INDEXED8			1	/* one byte per pixel, 0 transparent */
+#define PRDS_PANE_B8G8R8X8			2	/* four bytes per pixel, opaque */
+
+#define PRDS_PANE_F_VISIBLE			(1 << 0)
+#define PRDS_PANE_F_SCANLINE		(1 << 1)	/* indices 1-15 from the per-row palette */
+#define PRDS_PANE_F_FULLSCREEN		(1 << 2)	/* covers the screen: skip the desktop pass */
+
+#define PRDS_EFFECT_NONE			0
+#define PRDS_EFFECT_SCANLINES		1
+#define PRDS_EFFECT_CRT				2
+
+#define PRDS_SPRITE_F_SCREEN		(1 << 0)	/* placed in view space, unaffected by scroll */
+#define PRDS_SPRITE_F_FLIP_X		(1 << 1)
+#define PRDS_SPRITE_F_FLIP_Y		(1 << 2)
+
 enum {
 	PRDS_CMD_SET_MODE			= 0x0100,
 	PRDS_CMD_COMMIT				= 0x0101,
 	PRDS_CMD_ENABLE_EVENTS		= 0x0102,
 	PRDS_CMD_GET_INFO			= 0x0103,
 
+	PRDS_CMD_PANE_CREATE		= 0x0200,
+	PRDS_CMD_PANE_CONFIG		= 0x0201,
+	PRDS_CMD_PANE_PRESENT		= 0x0202,
+	PRDS_CMD_PANE_DESTROY		= 0x0203,
+
 	PRDS_RESP_OK				= 0x1000,
 	PRDS_RESP_ERR_INVALID		= 0x1100,
 	PRDS_RESP_ERR_UNSUPPORTED	= 0x1101,
@@ -107,6 +134,66 @@ struct prds_enable_events {
 	uint32	reserved;
 } _PACKED;
 
+struct prds_pane_create {
+	struct prds_hdr	hdr;
+	uint32	pane_id;
+	uint32	format;
+	uint32	world_width;
+	uint32	world_height;
+	uint32	stride;				/* bytes per row of one world buffer */
+	uint32	buffers;			/* 1..PRDS_PANE_BUFFERS_MAX */
+	uint64	offset;				/* pool offset of buffer 0 */
+	uint64	buffer_stride;		/* bytes between buffer n and n+1 */
+	uint64	palette_offset;		/* pool offset of 256 + world_height * 16 BGRA entries */
+} _PACKED;
+
+struct prds_pane_config {
+	struct prds_hdr	hdr;
+	uint32	pane_id;
+	uint32	flags;
+	int32	dest_x;				/* top left on the guest's screen, in guest pixels */
+	int32	dest_y;
+	uint32	dest_width;			/* size on screen; the view is scaled to fill it */
+	uint32	dest_height;
+	uint32	view_width;			/* how much of the world is shown */
+	uint32	view_height;
+	int32	scroll_x;			/* top left of the view within the world */
+	int32	scroll_y;
+	uint32	effect;
+	uint32	clip_count;			/* 0: nothing is visible */
+	struct prds_rect	clip[PRDS_MAX_CLIP_RECTS];	/* screen pixels */
+} _PACKED;
+
+struct prds_pane_present {
+	struct prds_hdr	hdr;
+	uint32	pane_id;
+	uint32	buffer_index;
+	uint32	sprite_count;
+	uint32	reserved;
+	uint64	sprite_offset;		/* pool offset of sprite_count prds_sprite */
+} _PACKED;
+
+struct prds_pane_destroy {
+	struct prds_hdr	hdr;
+	uint32	pane_id;
+	uint32	reserved;
+} _PACKED;
+
+/* A sprite lives in the pool, so a present carries no pixels. */
+struct prds_sprite {
+	int32	x;					/* world pixels, or view pixels with F_SCREEN */
+	int32	y;
+	uint32	width;
+	uint32	height;
+	uint64	offset;				/* pool offset of the sprite's 8-bit pixels */
+	uint32	stride;
+	uint32	flags;
+	float	scale;				/* 1.0 = one world pixel per sprite pixel */
+	float	rotation;			/* radians, about the sprite's centre */
+	float	alpha;				/* 0..1 */
+	uint32	palette_base;		/* added to each non-zero index */
+} _PACKED;
+
 struct prds_resp {
 	struct prds_hdr	hdr;
 } _PACKED;
@@ -159,6 +246,49 @@ struct prds_mode_hint {
 	bigtime_t		timeout;			/* in: how long to wait for a new hint */
 };
 
+/* One allocation holds a pane's buffers, palette and sprites; every offset the
+   client gives is relative to it, so nothing outside the kit thinks in pool
+   offsets. The pool itself arrives through PRDS_CLONE_POOL. */
+struct prds_pane_alloc {
+	uint64	size;				/* in: bytes of arena wanted */
+	uint32	format;				/* in */
+	uint32	world_width;		/* in */
+	uint32	world_height;		/* in */
+	uint32	stride;				/* in */
+	uint32	buffers;			/* in */
+	uint32	reserved;
+	uint64	buffer_offset;		/* in: buffer 0, within the allocation */
+	uint64	buffer_stride;		/* in */
+	uint64	palette_offset;		/* in: within the allocation */
+	uint64	pool_offset;		/* out: where the allocation landed */
+	uint32	pane_id;			/* out */
+	uint32	reserved2;
+};
+
+struct prds_pane_config_request {
+	uint32	pane_id;
+	uint32	flags;
+	int32	dest_x;
+	int32	dest_y;
+	uint32	dest_width;
+	uint32	dest_height;
+	uint32	view_width;
+	uint32	view_height;
+	int32	scroll_x;
+	int32	scroll_y;
+	uint32	effect;
+	uint32	clip_count;
+	struct prds_rect	clip[PRDS_MAX_CLIP_RECTS];
+};
+
+struct prds_pane_present_request {
+	uint32	pane_id;
+	uint32	buffer_index;
+	uint32	sprite_count;
+	uint32	reserved;
+	uint64	sprite_offset;		/* within the allocation */
+};
+
 struct prds_commit_request {
 	uint32				rect_count;		/* 0: the whole surface */
 	struct prds_rect	rects[PRDS_MAX_COMMIT_RECTS];
@@ -173,6 +303,11 @@ enum {
 	PRDS_COMMIT,										/* prds_commit_request* */
 	PRDS_ENABLE_EVENTS,									/* uint32* mask */
 	PRDS_WAIT_MODE_HINT,								/* prds_mode_hint*: blocks until the next hint or timeout */
+	PRDS_PANE_ALLOC,									/* prds_pane_alloc* */
+	PRDS_PANE_CONFIGURE,								/* prds_pane_config_request* */
+	PRDS_PANE_PRESENT,									/* prds_pane_present_request* */
+	PRDS_PANE_FREE,										/* uint32* pane_id */
+	PRDS_PANE_WAIT_RETRACE,								/* bigtime_t*: blocks until vsync or timeout */
 };
 
 
