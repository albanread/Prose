+		delete_sem(info->pane_retrace_sem);
 	if (info->command_done >= 0)
 		delete_sem(info->command_done);
 	if (info->shared_area >= 0)
@@ -434,6 +655,7 @@ prds_teardown(prds_info* info)
 	if (info->pool_area >= 0)
 		delete_area(info->pool_area);
 	mutex_destroy(&info->command_lock);
+	mutex_destroy(&info->pane_lock);
 	free(info);
 }
 
@@ -447,8 +669,10 @@ prds_init_driver(device_node* node, void** _cookie)
 	info->node = node;
 	info->pool_area = info->command_area = info->event_area = info->shared_area = -1;
 	info->command_done = info->retrace_sem = info->hint_sem = -1;
+	info->pane_retrace_sem = -1;
 	info->test_thread = -1;
 	mutex_init(&info->command_lock, "prose display commands");
+	mutex_init(&info->pane_lock, "prose display panes");
 
 	device_node* parent = sDeviceManager->get_parent_node(node);
 	sDeviceManager->get_driver(parent, (driver_module_info**)&info->virtio,
@@ -522,6 +746,7 @@ prds_init_driver(device_node* node, void** _cookie)
 	info->command_done = create_sem(0, "prose display command");
 	info->retrace_sem = create_sem(0, "prose display retrace");
 	info->hint_sem = create_sem(0, "prose display mode hint");
+	info->pane_retrace_sem = create_sem(0, "prose display pane retrace");
 	if (info->command_done < 0 || info->retrace_sem < 0 || info->hint_sem < 0) {
 		status = info->command_done < 0 ? info->command_done : info->retrace_sem;
 		ERROR("creating semaphores failed: %s\n", strerror(status));
@@ -562,6 +787,11 @@ prds_init_driver(device_node* node, void** _cookie)
 			info->shared->bb_size = frontMax;
 			INFO("back buffer region at pool offset %#" B_PRIx64 ", %" B_PRIu64 " KiB\n",
 				frontMax, frontMax >> 10);
+			// whatever is left is the game-pane arena (docs/game-pane.md)
+			info->arena_offset = frontMax * 2;
+			info->arena_size = info->pool_size - info->arena_offset;
+			INFO("game-pane arena at pool offset %#" B_PRIx64 ", %" B_PRIu64 " KiB\n",
+				info->arena_offset, info->arena_size >> 10);
 		} else
 			INFO("pool too small for a back buffer region (%" B_PRIu64 " KiB)\n", info->pool_size >> 10);
 	}
@@ -777,6 +1007,59 @@ prds_control(void* cookie, uint32 op, void* buffer, size_t length)
 			return prds_enable_events(info, mask);
 		}
 
+		case PRDS_PANE_ALLOC:
+		{
+			struct prds_pane_alloc alloc;
+			if (length < sizeof(alloc) || user_memcpy(&alloc, buffer, sizeof(alloc)) != B_OK)
+				return B_BAD_ADDRESS;
+			status_t status = prds_pane_alloc(info, &alloc);
+			if (status != B_OK)
+				return status;
+			if (user_memcpy(buffer, &alloc, sizeof(alloc)) != B_OK) {
+				prds_pane_free(info, alloc.pane_id);
+				return B_BAD_ADDRESS;
+			}
+			return B_OK;
+		}
+
+		case PRDS_PANE_CONFIGURE:
+		{
+			struct prds_pane_config_request config;
+			if (length < sizeof(config) || user_memcpy(&config, buffer, sizeof(config)) != B_OK)
+				return B_BAD_ADDRESS;
+			return prds_pane_configure(info, &config);
+		}
+
+		case PRDS_PANE_PRESENT:
