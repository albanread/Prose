index c6b3410062..6e4129ae83 100644
--- a/src/add-ons/kernel/drivers/graphics/prose_display/prose_display.cpp
+++ b/src/add-ons/kernel/drivers/graphics/prose_display/prose_display.cpp
@@ -43,6 +43,15 @@
 #define ALIGN_UP(x, a) ((((x) + (a) - 1) / (a)) * (a))
 
 
+// A game pane's arena allocation, and who owns it. See docs/game-pane.md.
+struct prds_pane {
+	bool						used;
+	team_id						team;
+	uint64						offset;			// in the pool
+	uint64						size;
+};
+
+
 struct prds_info {
 	device_node*				node;
 	int32						id;
@@ -75,6 +84,7 @@ struct prds_info {
 	struct prds_shared_info*	shared;
 	sem_id						retrace_sem;
 	sem_id						hint_sem;			// kernel-owned, waited on inside ioctl
+	sem_id						pane_retrace_sem;	// kernel-owned: game panes wait here
 
 	uint32						mode_width;
 	uint32						mode_height;
@@ -86,6 +96,11 @@ struct prds_info {
 	int64						redraw_count;
 	int32						need_redraw;
 
+	uint64						arena_offset;		// the game-pane arena: pool after app_server
+	uint64						arena_size;
+	mutex						pane_lock;
+	struct prds_pane			panes[PRDS_MAX_PANES];
+
 	thread_id					test_thread;
 	bool						quit;
 };
@@ -157,6 +172,8 @@ prds_event_callback(void* driverCookie, void* cookie)
 				int32 waiting;
 				if (get_sem_count(info->retrace_sem, &waiting) == B_OK && waiting < 0)
 					release_sem_etc(info->retrace_sem, -waiting, B_DO_NOT_RESCHEDULE);
+				if (get_sem_count(info->pane_retrace_sem, &waiting) == B_OK && waiting < 0)
+					release_sem_etc(info->pane_retrace_sem, -waiting, B_DO_NOT_RESCHEDULE);
 				break;
 			}
 			case PRDS_EVT_MODE_HINT:
@@ -277,6 +294,208 @@ prds_enable_events(prds_info* info, uint32 mask)
 }
 
 
+//	#pragma mark - game panes
+
+
+/// Panes whose team has gone take their pixels with them: a game that crashes
+/// must not leave a picture composited over the desktop for ever.
+static void
+prds_pane_reap(prds_info* info)
+{
+	for (uint32 i = 0; i < PRDS_MAX_PANES; i++) {
+		team_info teamInfo;
+		if (!info->panes[i].used || get_team_info(info->panes[i].team, &teamInfo) == B_OK)
+			continue;
+		struct prds_pane_destroy request = {};
+		struct prds_resp response = {};
+		request.hdr.type = PRDS_CMD_PANE_DESTROY;
+		request.pane_id = i;
+		prds_command(info, &request, sizeof(request), &response, sizeof(response));
+		INFO("pane %" B_PRIu32 ": owner gone, reclaimed\n", i);
+		info->panes[i].used = false;
+	}
+}
+
+
+/// First fit over the arena. Eight panes at most, so a linear scan of the
+/// in-use ranges is the whole allocator.
+static status_t
+prds_pane_alloc(prds_info* info, struct prds_pane_alloc* alloc)
+{
+	if (info->arena_size == 0)
+		return B_DEVICE_NOT_FOUND;
+	if (alloc->size == 0 || alloc->size > info->arena_size)
+		return B_BAD_VALUE;
+	if (alloc->buffers < 1 || alloc->buffers > PRDS_PANE_BUFFERS_MAX)
+		return B_BAD_VALUE;
+	if (alloc->world_width == 0 || alloc->world_height == 0)
+		return B_BAD_VALUE;
+	if (alloc->format != PRDS_PANE_INDEXED8 && alloc->format != PRDS_PANE_B8G8R8X8)
+		return B_BAD_VALUE;
+
+	MutexLocker locker(info->pane_lock);
+	prds_pane_reap(info);
+
+	uint64 size = ALIGN_UP(alloc->size, PRDS_SHM_ALIGNMENT);
+	int32 slot = -1;
+	for (uint32 i = 0; i < PRDS_MAX_PANES && slot < 0; i++) {
+		if (!info->panes[i].used)
+			slot = i;
+	}
+	if (slot < 0)
+		return B_BUSY;
+
+	// walk the arena from the bottom, stepping over every in-use range
+	uint64 at = info->arena_offset;
+	bool moved = true;
+	while (moved) {
+		moved = false;
+		for (uint32 i = 0; i < PRDS_MAX_PANES; i++) {
+			if (!info->panes[i].used)
+				continue;
+			uint64 end = info->panes[i].offset + info->panes[i].size;
+			if (at < end && at + size > info->panes[i].offset) {
+				at = end;
+				moved = true;
+			}
+		}
+	}
+	if (at + size > info->arena_offset + info->arena_size)
+		return B_NO_MEMORY;
+
+	// the layout the client asked for has to stay inside its allocation
+	if (alloc->buffer_offset >= size || alloc->palette_offset >= size
+		|| alloc->stride < (alloc->format == PRDS_PANE_B8G8R8X8
+			? alloc->world_width * 4 : alloc->world_width)
+		|| alloc->buffer_stride < (uint64)alloc->stride * alloc->world_height
+		|| alloc->buffer_offset + alloc->buffer_stride * alloc->buffers > size)
+		return B_BAD_VALUE;
+
+	struct prds_pane_create request = {};
+	struct prds_resp response = {};
+	request.hdr.type = PRDS_CMD_PANE_CREATE;
+	request.pane_id = slot;
+	request.format = alloc->format;
+	request.world_width = alloc->world_width;
+	request.world_height = alloc->world_height;
+	request.stride = alloc->stride;
+	request.buffers = alloc->buffers;
+	request.offset = at + alloc->buffer_offset;
+	request.buffer_stride = alloc->buffer_stride;
+	request.palette_offset = at + alloc->palette_offset;
+	status_t status = prds_command(info, &request, sizeof(request), &response, sizeof(response));
+	if (status != B_OK)
+		return status;
+
+	thread_info threadInfo;
+	get_thread_info(find_thread(NULL), &threadInfo);
+	info->panes[slot].used = true;
+	info->panes[slot].team = threadInfo.team;
+	info->panes[slot].offset = at;
+	info->panes[slot].size = size;
+	alloc->pool_offset = at;
+	alloc->pane_id = slot;
+	INFO("pane %" B_PRId32 ": %" B_PRIu32 "x%" B_PRIu32 ", %" B_PRIu64 " KiB at pool offset %#"
+		B_PRIx64 "\n", slot, alloc->world_width, alloc->world_height, size >> 10, at);
+	return B_OK;
+}
+
+
+static status_t
+prds_pane_free(prds_info* info, uint32 id)
+{
+	if (id >= PRDS_MAX_PANES)
+		return B_BAD_VALUE;
+	MutexLocker locker(info->pane_lock);
+	if (!info->panes[id].used)
+		return B_BAD_VALUE;
+	thread_info threadInfo;
+	if (get_thread_info(find_thread(NULL), &threadInfo) != B_OK
+		|| threadInfo.team != info->panes[id].team)
+		return B_PERMISSION_DENIED;
+	struct prds_pane_destroy request = {};
+	struct prds_resp response = {};
+	request.hdr.type = PRDS_CMD_PANE_DESTROY;
+	request.pane_id = id;
+	status_t status = prds_command(info, &request, sizeof(request), &response, sizeof(response));
+	info->panes[id].used = false;
+	return status;
+}
+
+
+/// The owner of a pane is the only team that may move or present it.
+static status_t
+prds_pane_check(prds_info* info, uint32 id)
+{
+	if (id >= PRDS_MAX_PANES || !info->panes[id].used)
+		return B_BAD_VALUE;
+	thread_info threadInfo;
+	if (get_thread_info(find_thread(NULL), &threadInfo) != B_OK
+		|| threadInfo.team != info->panes[id].team)
+		return B_PERMISSION_DENIED;
+	return B_OK;
+}
+
+
+static status_t
+prds_pane_configure(prds_info* info, struct prds_pane_config_request* config)
+{
+	MutexLocker locker(info->pane_lock);
+	status_t status = prds_pane_check(info, config->pane_id);
+	if (status != B_OK)
+		return status;
+	if (config->clip_count > PRDS_MAX_CLIP_RECTS)
+		return B_BAD_VALUE;
+
+	struct prds_pane_config request = {};
+	struct prds_resp response = {};
+	request.hdr.type = PRDS_CMD_PANE_CONFIG;
+	request.pane_id = config->pane_id;
+	request.flags = config->flags;
+	request.dest_x = config->dest_x;
+	request.dest_y = config->dest_y;
+	request.dest_width = config->dest_width;
+	request.dest_height = config->dest_height;
+	request.view_width = config->view_width;
+	request.view_height = config->view_height;
+	request.scroll_x = config->scroll_x;
+	request.scroll_y = config->scroll_y;
+	request.effect = config->effect;
+	request.clip_count = config->clip_count;
+	memcpy(request.clip, config->clip, config->clip_count * sizeof(struct prds_rect));
+	return prds_command(info, &request,
+		offsetof(struct prds_pane_config, clip) + config->clip_count * sizeof(struct prds_rect),
+		&response, sizeof(response));
+}
+
+
+static status_t
+prds_pane_present(prds_info* info, struct prds_pane_present_request* present)
+{
+	MutexLocker locker(info->pane_lock);
+	status_t status = prds_pane_check(info, present->pane_id);
+	if (status != B_OK)
+		return status;
+	if (present->sprite_count > PRDS_MAX_SPRITES)
+		return B_BAD_VALUE;
+	uint64 base = info->panes[present->pane_id].offset;
+	uint64 size = info->panes[present->pane_id].size;
+	if (present->sprite_count > 0
+		&& (present->sprite_offset >= size
+			|| present->sprite_offset + present->sprite_count * sizeof(struct prds_sprite) > size))
+		return B_BAD_VALUE;
+
+	struct prds_pane_present request = {};
+	struct prds_resp response = {};
+	request.hdr.type = PRDS_CMD_PANE_PRESENT;
+	request.pane_id = present->pane_id;
+	request.buffer_index = present->buffer_index;
+	request.sprite_count = present->sprite_count;
+	request.sprite_offset = base + present->sprite_offset;
+	return prds_command(info, &request, sizeof(request), &response, sizeof(response));
+}
+
+
 //	#pragma mark - milestone A test pattern
 
 
@@ -423,6 +642,8 @@ prds_teardown(prds_info* info)
 		delete_sem(info->retrace_sem);
 	if (info->hint_sem >= 0)
