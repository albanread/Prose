diff --git a/headers/os/game/ChipPlayer.h b/headers/os/game/ChipPlayer.h
new file mode 100644
index 0000000000..1dd5779b0a
--- /dev/null
+++ b/headers/os/game/ChipPlayer.h
@@ -0,0 +1,76 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * BChipPlayer: music and sound, written as notation.
+ *
+ * A program hands over ABC source -- a few hundred bytes -- and the host
+ * parses it, schedules it against the Mac's own sample clock and makes the
+ * sound. Nothing here synthesises anything, buffers anything or keeps time:
+ * a second of stereo is four hundred kilobytes and a tune is four hundred
+ * bytes, and the clock that drives the speaker is not this machine's.
+ *
+ * Where a tune goes is the notation's own business:
+ *
+ *     [I:chip v=0 wave=pulse pw=500 a=0 d=4 s=6 r=3 vol=12]
+ *
+ * is for the three-chip synthesiser -- three voices each, nine in all, with
+ * their own filters, pans and the 50 Hz performance macros that are where a
+ * chip tune actually lives (arp, vib, slide, pwm, sweep, trem). Whereas
+ *
+ *     %%MIDI program 80
+ *
+ * says the tune was written for a synthesiser, and it is played on the Mac's
+ * General MIDI one instead. Neither the program nor this class chooses.
+ *
+ * Four tracks share the nine voices, so a tune and a sound effect need not be
+ * the same schedule. Which voices each uses is the tune's business: the
+ * grammar says `v=` explicitly.
+ */
+#ifndef _CHIP_PLAYER_H
+#define _CHIP_PLAYER_H
+
+
+#include <SupportDefs.h>
+
+
+class BChipPlayer {
+public:
+								BChipPlayer();
+								~BChipPlayer();
+
+			status_t			InitCheck() const;
+
+	// Play some ABC on a track, replacing whatever that track held. The
+	// source is copied, so it need not outlive the call.
+			status_t			Play(const char* abc, uint32 track = 0,
+									bool loop = false);
+			status_t			Stop(uint32 track = 0);
+			status_t			StopAll();
+
+	// Which tracks are sounding, as a bitmask: bit n is track n.
+			uint32				Playing() const;
+			bool				IsPlaying(uint32 track = 0) const;
+
+	// 0 to 1. The chip's own master volume is a register a tune may set; this
+	// is over the top of it, for the person rather than the composer.
+			status_t			SetVolume(float volume);
+
+			uint32				CountChips() const;
+			uint32				CountVoices() const;
+			uint32				CountTracks() const;
+
+private:
+			BChipPlayer(const BChipPlayer&);
+			BChipPlayer&		operator=(const BChipPlayer&);
+
+			status_t			fStatus;
+			int					fDevice;
+			uint32				fChips;
+			uint32				fVoices;
+			uint32				fTracks;
+			uint32				_reserved[8];
+};
+
+
+#endif	/* _CHIP_PLAYER_H */
diff --git a/headers/private/prose/prose_chip.h b/headers/private/prose/prose_chip.h
new file mode 100644
index 0000000000..6b589ce521
--- /dev/null
+++ b/headers/private/prose/prose_chip.h
@@ -0,0 +1,121 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * The Prose Chip: three chips, nine voices, and the guest sends notation.
+ *
+ * The transport is a custom virtio device, ID 60, with one control queue.
+ * The guest writes ABC source and nothing else -- no samples, no note events,
+ * no timing -- and the host parses it, schedules it against its own sample
+ * clock and makes the sound. A motif is four hundred bytes where a second of
+ * stereo is four hundred kilobytes, and the clock that matters is the Mac's,
+ * not a guest timer woken late by whatever the scheduler is busy with.
+ *
+ * Where a tune goes is the notation's own business. `[I:chip ...]` is for the
+ * three-chip synthesiser; `%%MIDI program n` was written for a synthesiser
+ * and goes to the Mac's General MIDI one. Nothing here has to choose.
+ *
+ * Four tracks share the nine voices, so a motif and a sound effect are not
+ * the same schedule. Which voices a tune uses is the tune's business: the
+ * grammar says `v=` explicitly.
+ */
+#ifndef PROSE_CHIP_H
+#define PROSE_CHIP_H
+
+#include <SupportDefs.h>
+#include <Drivers.h>
+
+#define PROSE_CHIP_MAGIC			0x48435250	/* "PRCH", little-endian: the wire
+											   carries the bytes, and a character
+											   constant is the other order */
+#define PROSE_CHIP_VERSION			1
+#define PROSE_CHIP_VIRTIO_ID		60		/* 61 portal, 62 MIDI, 63 display */
+#define PROSE_CHIP_DEVICE			"/dev/misc/prose/chip/0"
+
+#define PROSE_CHIP_TEXT_MAX			16384	/* one tune's source */
+#define PROSE_CHIP_TRACKS			4
+
+/* Commands on the control queue. */
+enum {
+	PROSE_CHIP_CMD_GET_INFO		= 0x0100,
+	PROSE_CHIP_CMD_PLAY			= 0x0101,	/* the source follows the header */
+	PROSE_CHIP_CMD_STOP			= 0x0102,
+	PROSE_CHIP_CMD_STOP_ALL		= 0x0103,
+	PROSE_CHIP_CMD_VOLUME		= 0x0104,
+	PROSE_CHIP_CMD_STATE		= 0x0105,	/* answers a bitmask of playing tracks */
+
+	PROSE_CHIP_RESP_OK			= 0x1000,
+	PROSE_CHIP_ERR_INVALID		= 0x1100,
+	PROSE_CHIP_ERR_UNSUPPORTED	= 0x1101,
+	PROSE_CHIP_ERR_STATE		= 0x1102
+};
+
+#define PROSE_CHIP_FLAG_LOOP		1
+
+struct prose_chip_hdr {
+	uint32	type;
+	uint32	flags;
+	uint64	seq;
+} _PACKED;
+
+struct prose_chip_play {
+	struct prose_chip_hdr	hdr;
+	uint32	track;
+	uint32	length;				/* bytes of source, which follow this header */
+	uint32	flags;				/* PROSE_CHIP_FLAG_LOOP */
+	uint32	reserved;
+} _PACKED;
+
+struct prose_chip_track {
+	struct prose_chip_hdr	hdr;
+	uint32	track;
+	uint32	reserved;
+} _PACKED;
+
+struct prose_chip_value {
+	struct prose_chip_hdr	hdr;
+	uint32	value;
+	uint32	reserved;
+} _PACKED;
+
+struct prose_chip_resp {
+	struct prose_chip_hdr	hdr;
+	uint32	value;
+	uint32	reserved;
+} _PACKED;
+
+/* The device's configuration space. */
+struct prose_chip_config {
+	uint32	magic;
+	uint16	version;
+	uint16	flags;
+	uint32	chips;
+	uint32	voices;
+	uint32	tracks;
+	uint32	sample_rate;
+	uint32	max_text;
+	uint8	reserved[8];
+} _PACKED;
+
+/* What a caller hands the driver. The source is copied in, not referenced:
+   a tune is small and the caller should not have to keep it alive. */
+struct prose_chip_play_request {
+	uint32	track;
+	uint32	flags;
+	uint32	length;
+	uint32	reserved;
+	char	source[PROSE_CHIP_TEXT_MAX];
+};
+
+/* ioctls (device_control) */
+enum {
+	PROSE_CHIP_PLAY = B_DEVICE_OP_CODES_END + 1,	/* prose_chip_play_request* */
+	PROSE_CHIP_STOP,								/* uint32* track */
+	PROSE_CHIP_STOP_ALL,							/* NULL */
+	PROSE_CHIP_SET_VOLUME,							/* uint32*, 0..255 */
+	PROSE_CHIP_GET_STATE,							/* uint32*: a bitmask of tracks */
+	PROSE_CHIP_GET_CONFIG							/* prose_chip_config* */
+};
+
+
+#endif	/* PROSE_CHIP_H */
