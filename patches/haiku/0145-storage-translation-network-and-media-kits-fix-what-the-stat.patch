diff --git a/src/kits/network/libnetapi/NetEndpoint.cpp b/src/kits/network/libnetapi/NetEndpoint.cpp
index fa8a529b4a..4e93476fbb 100644
--- a/src/kits/network/libnetapi/NetEndpoint.cpp
+++ b/src/kits/network/libnetapi/NetEndpoint.cpp
@@ -477,6 +477,13 @@ BNetEndpoint::IsDataPending(bigtime_t timeout)
 	struct timeval tv;
 	fd_set fds;
 
+	// a closed endpoint has no socket, and FD_SET(-1) writes far outside
+	// the set
+	if (fSocket < 0 || fSocket >= FD_SETSIZE) {
+		fStatus = B_NO_INIT;
+		return false;
+	}
+
 	FD_ZERO(&fds);
 	FD_SET(fSocket, &fds);
 
diff --git a/src/kits/network/libnetapi/NetworkAddress.cpp b/src/kits/network/libnetapi/NetworkAddress.cpp
index e2d98067da..6b159bdf3b 100644
--- a/src/kits/network/libnetapi/NetworkAddress.cpp
+++ b/src/kits/network/libnetapi/NetworkAddress.cpp
@@ -871,8 +871,9 @@ BNetworkAddress::PrefixLength() const
 			// TODO : see if we can use the optimized addr_bitcount for this
 			ssize_t result = 0;
 			for (uint8 i = 0; i < sizeof(in6_addr); i++) {
+				// the mask's bits run from each byte's top bit down
 				for (uint8 j = 0; j < 8; j++) {
-					if (!(mask.sin6_addr.s6_addr[i] & (1 << j)))
+					if (!(mask.sin6_addr.s6_addr[i] & (0x80 >> j)))
 						return result;
 					result++;
 				}
diff --git a/src/kits/storage/Query.cpp b/src/kits/storage/Query.cpp
index 906e83eff5..f0f6f287a6 100644
--- a/src/kits/storage/Query.cpp
+++ b/src/kits/storage/Query.cpp
@@ -538,15 +538,22 @@ BQuery::_ParseDates(BString& parsedPredicate)
 
 	while (pos[0]) {
 		if (pos[0] == '\\') {
+			// skip the escaped character, too; an escaped quote does not
+			// end a string
 			pos++;
+			if (pos[0] != '\0')
+				pos++;
 			continue;
 		}
 		if (pos[0] == '"')
 			quotes = !quotes;
 		else if (!quotes && pos[0] == '%') {
 			const char* end = strchr(pos + 1, '%');
-			if (end == NULL)
+			if (end == NULL) {
+				// no date, just a '%'
+				pos++;
 				continue;
+			}
 
 			parsedPredicate.Append(start, pos - start);
 			start = end + 1;
