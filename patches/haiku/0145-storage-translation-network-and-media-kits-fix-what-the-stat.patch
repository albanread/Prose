 	if (fileFormat == NULL) {
 		fErr = B_BAD_VALUE;
 		return;
@@ -556,6 +564,7 @@ BMediaFile::_InitWriter(BDataIO* target, const BUrl* url,
 
 	if (target == NULL) {
 		_InitStreamer(*url, &target);
