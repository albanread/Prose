 		while (ISSPC(*tp))
@@ -277,7 +277,7 @@ file_ascmagic(DatabaseLocation* databaseLocation, const unsigned char *buf,
 		/*
 		 * find the next whitespace
 		 */
-		for (end = i + 1; end < nbytes; end++)
+		for (end = i + 1; end < ulen; end++)
 			if (ISSPC(ubuf[end]))
 				break;
 
