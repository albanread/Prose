diff --git a/src/kits/media/experimental/AdapterIO.cpp b/src/kits/media/experimental/AdapterIO.cpp
index 0bc8107386..7e0730938f 100644
--- a/src/kits/media/experimental/AdapterIO.cpp
+++ b/src/kits/media/experimental/AdapterIO.cpp
@@ -6,8 +6,11 @@
 
 #include "AdapterIO.h"
 
+#include <AutoDeleter.h>
+
 #include <MediaIO.h>
 
+#include <new>
 #include <string.h>
 
 #include "MediaDebug.h"
@@ -49,6 +52,9 @@ public:
 	status_t FlushBefore(off_t position, BPositionIO* buffer, const void* oldBuffer,
 		size_t oldLength)
 	{
+		// the new buffer is ours; it replaces the old one on success
+		ObjectDeleter<BPositionIO> bufferDeleter(buffer);
+
 		AutoWriteLocker _(fLock);
 		off_t relative = _PositionToRelative(position);
 		if (relative < 0)
@@ -64,7 +70,7 @@ public:
 			return status;
 		fBackPosition -= relative;
 		fStartOffset += relative;
-		SetBuffer(buffer);
+		SetBuffer(bufferDeleter.Detach());
 		return B_OK;
 	}
 
@@ -412,10 +418,13 @@ BAdapterIO::SetBuffer(BPositionIO* buffer)
 status_t
 BAdapterIO::FlushBefore(off_t position)
 {
-	BMallocIO* buffer = new BMallocIO();
+	BMallocIO* buffer = new(std::nothrow) BMallocIO();
+	if (buffer == NULL)
+		return B_NO_MEMORY;
+
 	BMallocIO* oldBuffer = (BMallocIO*)fBuffer->Buffer();
-	fBuffer->FlushBefore(position, buffer, oldBuffer->Buffer(), oldBuffer->BufferLength());
-	return B_OK;
+	return fBuffer->FlushBefore(position, buffer, oldBuffer->Buffer(),
+		oldBuffer->BufferLength());
 }
 
 
diff --git a/src/kits/media/experimental/MediaClientNode.cpp b/src/kits/media/experimental/MediaClientNode.cpp
index 2da6981e28..5313f25231 100644
--- a/src/kits/media/experimental/MediaClientNode.cpp
+++ b/src/kits/media/experimental/MediaClientNode.cpp
@@ -612,9 +612,14 @@ BMediaClientNode::_HandleBuffer(BBuffer* buffer)
 	media_destination dest;
 	dest.id = buffer->Header()->destination;
 	BMediaInput* conn = fOwner->_FindInput(dest);
+	if (conn == NULL) {
+		// for an input that is gone (a buffer still in flight after a
+		// disconnect)
