diff --git a/src/kits/media/MediaEncoder.cpp b/src/kits/media/MediaEncoder.cpp
index 4030efb93e..44281f58ac 100644
--- a/src/kits/media/MediaEncoder.cpp
+++ b/src/kits/media/MediaEncoder.cpp
@@ -120,8 +120,14 @@ BMediaEncoder::SetFormat(media_format* inputFormat,
 	if (!fEncoder)
 		return B_NO_INIT;
 
-	if (outputFormat != NULL)
-		SetTo(outputFormat);
+	if (outputFormat != NULL) {
+		// SetTo() releases the current encoder first
+		status_t status = SetTo(outputFormat);
+		if (status != B_OK)
+			return status;
+		if (fEncoder == NULL)
+			return B_NO_INIT;
+	}
 
 	//TODO: How we support mfi?
 	return fEncoder->SetUp(inputFormat);
