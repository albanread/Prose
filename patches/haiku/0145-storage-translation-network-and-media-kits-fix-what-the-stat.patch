+	if ((ubuf = (my_unichar*)calloc(nbytes + 1, sizeof(ubuf[0]))) == NULL)
 		goto done;
 
 	/*
@@ -235,7 +235,7 @@ file_ascmagic(DatabaseLocation* databaseLocation, const unsigned char *buf,
 	 * I believe Plan 9 troff allows non-ASCII characters in the names
