From 412c2658a52808cd63b79fa92f3b9b689087e944 Mon Sep 17 00:00:00 2001
From: albanread <albanread@googlemail.com>
Date: Fri, 18 Sep 2026 15:42:57 +0100
Subject: [PATCH] Prose Display (S2): synchronous, tear-free commits
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Only app_server knows when the front buffer is ready, and the host must
not present anything else. The accelerant's B_COMMIT_RECTANGLES hook now
sends PRDS_COMMIT itself and returns when the host has copied the
rectangles into its display buffer, so app_server cannot overwrite a
rectangle the host is still reading. The vsync-paced commit thread (and
its 16 ms window, where tearing came from) is gone; REDRAW is answered
with a full commit from the hook.

app_server: _DrawCursor() commits only the cursor's own frame instead of
the whole invalidated area (halves the commit count).

Accelerant init measures pool bandwidth from the guest: 4 MiB read/write
in 133 us, the same as the heap, after a 1.3 ms first touch — so a back
buffer can live in the pool too.

Measured on VZ: 50 us average commit round trip, rare 19 ms outliers,
0 errors, ~70 commits/s on an idle desktop (the Deskbar CPU meter).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../accelerants/prose_display/accelerant.cpp  | 208 ++++++++----------
 .../accelerants/prose_display/accelerant.h    |  14 +-
 .../interface/local/AccelerantHWInterface.cpp |  10 +-
 3 files changed, 104 insertions(+), 128 deletions(-)

diff --git a/src/add-ons/accelerants/prose_display/accelerant.cpp b/src/add-ons/accelerants/prose_display/accelerant.cpp
index 477809bfb1..a9b5a4fe18 100644
--- a/src/add-ons/accelerants/prose_display/accelerant.cpp
+++ b/src/add-ons/accelerants/prose_display/accelerant.cpp
@@ -4,9 +4,13 @@
  *
  * Prose Display accelerant. The frame buffer app_server draws into is the
  * device's surface pool itself (cloned from the driver), so drawing is zero
- * copy; the only work here is telling the host which rectangles changed.
- * app_server reports them through B_COMMIT_RECTANGLES after every
- * back-to-front copy; they are collected and sent once per vsync.
+ * copy; the only work here is telling the host which rectangles are ready.
+ *
+ * app_server reports them through B_COMMIT_RECTANGLES right after every
+ * back-to-front copy, and the commit is synchronous: the host copies the
+ * rectangles into its display buffer before the ioctl returns, so app_server
+ * cannot overwrite them while the host reads, and the host never shows a
+ * half-written rectangle. That is what makes the display tear-free.
  */
 
 
@@ -30,8 +34,7 @@ extern "C" void _sPrintf(const char* format, ...);
 #	define TRACE(x) ;
 #endif
 
-// Without vsync events (host display asleep, headless) commit this often anyway.
-#define PRDS_COMMIT_TIMEOUT		20000
+#define PRDS_STATS_EVERY	2000
 
 
 accelerant_info* gInfo;
@@ -40,106 +43,52 @@ accelerant_info* gInfo;
 //	#pragma mark - commits
 
 
-/*!	Everything collected so far becomes one bounding rectangle. */
-static void
-collapse_dirty(accelerant_info* info)
-{
-	uint32 left = UINT32_MAX, top = UINT32_MAX, right = 0, bottom = 0;
-	for (uint32 i = 0; i < info->dirty_count; i++) {
-		const prds_rect& r = info->dirty[i];
-		if (r.x < left)
-			left = r.x;
-		if (r.y < top)
-			top = r.y;
-		if (r.x + r.width > right)
-			right = r.x + r.width;
-		if (r.y + r.height > bottom)
-			bottom = r.y + r.height;
-	}
-	info->dirty[0].x = left;
-	info->dirty[0].y = top;
-	info->dirty[0].width = right - left;
-	info->dirty[0].height = bottom - top;
-	info->dirty_count = 1;
-}
-
-
-static status_t
-commit_thread(void* data)
-{
-	accelerant_info* info = (accelerant_info*)data;
-	prds_commit_request request;
-
-	bool useRetrace = true;
-	uint32 lastRedraw = info->shared_info->redraw_count;
-	while (!info->quit) {
-		sem_id retrace = useRetrace ? info->shared_info->retrace_sem : -1;
-		status_t waited = B_ERROR;
-		if (retrace >= 0)
-			waited = acquire_sem_etc(retrace, 1, B_RELATIVE_TIMEOUT, PRDS_COMMIT_TIMEOUT);
-		if (waited != B_OK && waited != B_TIMED_OUT) {
-			// no usable vsync source (headless host, or a semaphore we may not
-			// acquire): pace commits ourselves
-			if (retrace >= 0) {
-				syslog(LOG_WARNING, "prose_display: retrace semaphore unusable (%s), "
-					"pacing commits by timer\n", strerror(waited));
-				useRetrace = false;
-			}
-			snooze(PRDS_COMMIT_TIMEOUT / 2);
-		}
-		if (info->quit)
-			break;
-
-		if (acquire_sem(info->dirty_lock) != B_OK)
-			break;
-		uint32 count = info->dirty_count;
-		if (count > 0) {
-			memcpy(request.rects, info->dirty, count * sizeof(prds_rect));
-			info->dirty_count = 0;
-		}
-		release_sem(info->dirty_lock);
-
-		// the host asked for everything again (REDRAW): a full commit
-		bool redraw = info->shared_info->redraw_count != lastRedraw;
-		if (redraw) {
-			lastRedraw = info->shared_info->redraw_count;
-			count = 0;
-		} else if (count == 0)
-			continue;
-
-		request.rect_count = count;
-		if (ioctl(info->device, PRDS_COMMIT, &request, sizeof(request)) != 0)
-			info->commit_errors++;
-		else
-			info->commits++;
-	}
-	return B_OK;
-}
-
-
 status_t
 prose_display_commit_rectangles(const fill_rect_params* list, uint32 count)
 {
 	accelerant_info* info = gInfo;
-	if (info == NULL || info->dirty_lock < 0)
+	if (info == NULL)
 		return B_NO_INIT;
-	if (acquire_sem(info->dirty_lock) != B_OK)
-		return B_ERROR;
 
-	for (uint32 i = 0; i < count; i++) {
+	prds_commit_request request;
+	uint32 n = 0;
+	for (uint32 i = 0; i < count && n < PRDS_MAX_COMMIT_RECTS; i++) {
 		const fill_rect_params& r = list[i];
 		if (r.right < r.left || r.bottom < r.top)
 			continue;
-		if (info->dirty_count == PRDS_MAX_COMMIT_RECTS)
-			collapse_dirty(info);
-		prds_rect& d = info->dirty[info->dirty_count++];
-		d.x = r.left;
-		d.y = r.top;
-		d.width = r.right - r.left + 1;
-		d.height = r.bottom - r.top + 1;
+		request.rects[n].x = r.left;
+		request.rects[n].y = r.top;
+		request.rects[n].width = r.right - r.left + 1;
+		request.rects[n].height = r.bottom - r.top + 1;
+		n++;
 	}
 
-	release_sem(info->dirty_lock);
+	// the host asked for everything again (REDRAW): make this a full commit
+	uint32 redraw = info->shared_info->redraw_count;
+	if (redraw != info->last_redraw) {
+		info->last_redraw = redraw;
+		n = 0;
+	} else if (n == 0)
+		return B_OK;
+
+	request.rect_count = n;
+	bigtime_t start = system_time();
+	int result = ioctl(info->device, PRDS_COMMIT, &request, sizeof(request));
+	bigtime_t elapsed = system_time() - start;
+
+	int32 commits = atomic_add(&info->commits, 1) + 1;
+	atomic_add64(&info->commit_time_total, elapsed);
+	if (elapsed > info->commit_time_max)
+		info->commit_time_max = elapsed;
+	if (commits % PRDS_STATS_EVERY == 0) {
+		syslog(LOG_INFO, "prose_display: %" B_PRId32 " commits, round trip avg %" B_PRId64
+			" us, max %" B_PRId64 " us, %" B_PRId32 " errors\n", commits,
+			info->commit_time_total / commits, info->commit_time_max, info->commit_errors);
+	}
+	if (result != 0) {
+		atomic_add(&info->commit_errors, 1);
+		return B_ERROR;
+	}
 	return B_OK;
 }
 
@@ -160,8 +109,6 @@ init_common(int device, bool isClone)
 	gInfo->device = device;
 	gInfo->pool_area = -1;
 	gInfo->mode_list_area = -1;
-	gInfo->dirty_lock = -1;
-	gInfo->commit_thread = -1;
 
 	area_id sharedArea;
 	if (ioctl(device, PRDS_GET_SHARED_INFO, &sharedArea, sizeof(area_id)) != 0)
@@ -198,6 +145,52 @@ uninit_common(void)
 }
 
 
+/*!	The pool is host memory behind a PCI BAR: check that the guest reads and
+	writes it at RAM speed (it must, for a back buffer to live there too).
+*/
+static void
+measure_pool_bandwidth(void)
+{
+	const size_t size = 4 << 20;
+	if (gInfo->shared_info->pool_size < size)
+		return;
+	uint32* heap = (uint32*)malloc(size);
+	if (heap == NULL)
+		return;
+	uint32* pool = (uint32*)(gInfo->pool + gInfo->shared_info->pool_size - size);
+	memset(heap, 0x5a, size);
+
+	bigtime_t t0 = system_time();
+	memset(pool, 0x5a, size);
+	bigtime_t poolFirstTouch = system_time() - t0;
+	t0 = system_time();
+	memset(pool, 0x5a, size);
+	bigtime_t poolWrite = system_time() - t0;
+
+	t0 = system_time();
+	uint32 sum = 0;
+	for (size_t i = 0; i < size / 4; i++)
+		sum += pool[i];
+	bigtime_t poolRead = system_time() - t0;
+
+	t0 = system_time();
+	uint32 sumHeap = 0;
+	for (size_t i = 0; i < size / 4; i++)
+		sumHeap += heap[i];
+	bigtime_t heapRead = system_time() - t0;
+
+	t0 = system_time();
+	memset(heap, 0xa5, size);
+	bigtime_t heapWrite = system_time() - t0;
+
+	syslog(LOG_INFO, "prose_display: 4 MiB pool read %" B_PRId64 " us, write %" B_PRId64
+		" us (first touch %" B_PRId64 " us); heap read %" B_PRId64 " us, write %" B_PRId64
+		" us (%" B_PRIx32 "/%" B_PRIx32 ")\n", poolRead, poolWrite, poolFirstTouch, heapRead,
+		heapWrite, sum, sumHeap);
+	free(heap);
+}
+
+
 //	#pragma mark - public accelerant functions
 
 
@@ -226,16 +219,7 @@ prose_display_init_accelerant(int device)
 	}
 	gInfo->pool_area = poolInfo.area;
 	gInfo->pool = (uint8*)poolInfo.address;
-
-	gInfo->dirty_lock = create_sem(1, "prose display dirty rects");
-	gInfo->commit_thread = spawn_thread(commit_thread, "prose display commits",
-		B_URGENT_DISPLAY_PRIORITY, gInfo);
-	if (gInfo->dirty_lock < 0 || gInfo->commit_thread < 0) {
-		syslog(LOG_ERR, "prose_display: no commit thread\n");
-		prose_display_uninit_accelerant();
-		return B_ERROR;
-	}
-	resume_thread(gInfo->commit_thread);
+	gInfo->last_redraw = gInfo->shared_info->redraw_count;
 
 	const prds_shared_info& shared = *gInfo->shared_info;
 	syslog(LOG_INFO, "prose_display: accelerant up: %ux%u (stride %u), pool %u KiB "
@@ -243,6 +227,7 @@ prose_display_init_accelerant(int device)
 		shared.current_mode.virtual_height, shared.bytes_per_row,
 		(unsigned)(shared.pool_size >> 10), gInfo->pool, shared.mode_count,
 		(int)shared.retrace_sem);
+	measure_pool_bandwidth();
 	return B_OK;
 }
 
@@ -300,17 +285,6 @@ prose_display_uninit_accelerant(void)
 {
 	TRACE(("prose_display_uninit_accelerant()\n"));
 
-	if (gInfo->commit_thread >= 0) {
-		gInfo->quit = true;
-		status_t result;
-		wait_for_thread(gInfo->commit_thread, &result);
-		gInfo->commit_thread = -1;
-	}
-	if (gInfo->dirty_lock >= 0) {
-		delete_sem(gInfo->dirty_lock);
-		gInfo->dirty_lock = -1;
-	}
-
 	delete_area(gInfo->mode_list_area);
 	gInfo->mode_list = NULL;
 
diff --git a/src/add-ons/accelerants/prose_display/accelerant.h b/src/add-ons/accelerants/prose_display/accelerant.h
index 5749268761..b6beb12ae3 100644
--- a/src/add-ons/accelerants/prose_display/accelerant.h
+++ b/src/add-ons/accelerants/prose_display/accelerant.h
@@ -25,14 +25,12 @@ typedef struct accelerant_info {
 	area_id				mode_list_area;		// cloned list of display modes
 	display_mode*		mode_list;
 
-	// Rectangles app_server has finished drawing, waiting for the next vsync.
-	sem_id				dirty_lock;
-	uint32				dirty_count;
-	struct prds_rect	dirty[PRDS_MAX_COMMIT_RECTS];
-	thread_id			commit_thread;
-	volatile bool		quit;
-	uint32				commits;
-	uint32				commit_errors;
+	// commit statistics (the commit itself is synchronous, see accelerant.cpp)
+	uint32				last_redraw;
+	int32				commits;
+	int32				commit_errors;
+	int64				commit_time_total;
+	bigtime_t			commit_time_max;
 } accelerant_info;
 
 extern accelerant_info* gInfo;
diff --git a/src/servers/app/drawing/interface/local/AccelerantHWInterface.cpp b/src/servers/app/drawing/interface/local/AccelerantHWInterface.cpp
index 211d7c8e58..56c863808d 100644
--- a/src/servers/app/drawing/interface/local/AccelerantHWInterface.cpp
+++ b/src/servers/app/drawing/interface/local/AccelerantHWInterface.cpp
@@ -1436,9 +1436,13 @@ AccelerantHWInterface::_DrawCursor(IntRect area) const
 {
 	if (!fHardwareCursorEnabled) {
 		HWInterface::_DrawCursor(area);
-		// the software cursor bypasses the back buffer: present it too
-		_CommitRect(area & IntRect(0, 0, fFrontBuffer->Width() - 1,
-			fFrontBuffer->Height() - 1));
+		// the software cursor bypasses the back buffer: present the part of it
+		// that was just drawn (nothing else in the area changed here)
+		IntRect touched = area & _CursorFrame();
+		if (touched.IsValid()) {
+			_CommitRect(touched & IntRect(0, 0, fFrontBuffer->Width() - 1,
+				fFrontBuffer->Height() - 1));
+		}
 	}
 }
 
