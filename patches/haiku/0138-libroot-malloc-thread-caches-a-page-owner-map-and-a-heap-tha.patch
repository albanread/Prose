diff --git a/src/system/libroot/posix/malloc/openbsd/thread_cache.c b/src/system/libroot/posix/malloc/openbsd/thread_cache.c
new file mode 100644
index 0000000000..b93abe060b
--- /dev/null
+++ b/src/system/libroot/posix/malloc/openbsd/thread_cache.c
@@ -0,0 +1,429 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+/*!	Thread caches. Each thread keeps the small blocks it frees, by size class,
+	and hands them out again first, so that most malloc() and free() calls take
+	no lock at all. A miss refills half a class from the thread's pool under
+	one lock; a class that is full gives half of itself back to the pools that
+	own the blocks, locking each pool once for a run of its blocks. This is
+	glibc's tcache over OpenBSD's allocator; the page owner map (wrapper.c) is
+	what lets free() find a block's size and owner without a lock.
+
+	Included by malloc.c, after the allocator's own definitions.
+*/
+
+
+/* size classes: the buckets bin_of() rounds to, up to MALLOC_MAXCHUNK */
+#define THREAD_CACHE_CLASSES	32
+
+/* a class holds at most this many bytes' worth of blocks ... */
+#define THREAD_CACHE_CLASS_BYTES	32768
+/* ... and between this many ... */
+#define THREAD_CACHE_MIN_BLOCKS	4
+/* ... and this many blocks */
+#define THREAD_CACHE_MAX_BLOCKS	64
+
+#define THREAD_CACHE_NO_CLASS	0xff
+
+struct thread_cache {
+	void*					heads[THREAD_CACHE_CLASSES];
+	uint16					counts[THREAD_CACHE_CLASSES];
+	int32					id;
+		// the thread's malloc id, which picks its pool; it stays with the
+		// cache when the cache is reused by another thread
+	struct thread_cache*	next_free;
+};
+
+
+/* the thread's slot, after its cache was flushed at its exit */
+#define THREAD_CACHE_EXITED		((struct thread_cache*)1)
+
+static uint8 sClassOfBucket[BUCKETS + 1];
+static uint16 sBucketOfClass[THREAD_CACHE_CLASSES];
+static uint16 sClassLimit[THREAD_CACHE_CLASSES];
+
+/* A cached block holds this in its second word, so that freeing a block that
+ * is already in the cache can be noticed. It is odd: no pointer. */
+static uintptr_t sThreadCacheKey;
+
+static mutex sThreadCacheLock = MUTEX_INITIALIZER("heap thread caches");
+static struct thread_cache* sFreeThreadCaches;
+static struct thread_cache* sThreadCacheSlab;
+static size_t sThreadCacheSlabLeft;
+static int32 sNextMallocThreadID;
+
+
+static void
+thread_cache_init(void)
+{
+	u_int bucket;
+	u_int cls = 0;
+
+#ifdef B_HAIKU_64_BIT
+	sThreadCacheKey = ((uintptr_t)malloc_arc4random() << 32)
+		| malloc_arc4random() | 1;
+#else
+	sThreadCacheKey = malloc_arc4random() | 1;
+#endif
+
+	memset(sClassOfBucket, THREAD_CACHE_NO_CLASS, sizeof(sClassOfBucket));
+	for (bucket = 1; bucket <= BUCKETS; bucket++) {
+		const size_t size = B2SIZE(bucket);
+		size_t limit;
+
+		// only the buckets find_bucket() rounds to
+		if (find_bucket(size) != bucket)
+			continue;
+		if (cls == THREAD_CACHE_CLASSES)
+			debugger("malloc: more size classes than the thread caches have");
+
+		limit = THREAD_CACHE_CLASS_BYTES / size;
+		if (limit > THREAD_CACHE_MAX_BLOCKS)
+			limit = THREAD_CACHE_MAX_BLOCKS;
+		else if (limit < THREAD_CACHE_MIN_BLOCKS)
+			limit = THREAD_CACHE_MIN_BLOCKS;
+
+		sClassOfBucket[bucket] = cls;
+		sBucketOfClass[cls] = bucket;
+		sClassLimit[cls] = limit;
+		cls++;
+	}
+}
+
+
+static struct thread_cache*
+thread_cache_create(void)
+{
+	struct thread_cache* cache;
+
+	mutex_lock(&sThreadCacheLock);
+	cache = sFreeThreadCaches;
+	if (cache != NULL)
+		sFreeThreadCaches = cache->next_free;
+	else {
+		if (sThreadCacheSlabLeft == 0) {
+			void* slab = NULL;
+			uint8 cleared;
+			if (__allocate_pages(&slab, MALLOC_PAGESIZE, 0, &cleared)
+					!= B_OK) {
+				mutex_unlock(&sThreadCacheLock);
+				return NULL;
+			}
+			sThreadCacheSlab = (struct thread_cache*)slab;
+			sThreadCacheSlabLeft = MALLOC_PAGESIZE
+				/ sizeof(struct thread_cache);
+		}
+		cache = sThreadCacheSlab++;
+		sThreadCacheSlabLeft--;
+		cache->id = sNextMallocThreadID++;
+	}
+	mutex_unlock(&sThreadCacheLock);
+
+	memset(cache->heads, 0, sizeof(cache->heads));
+	memset(cache->counts, 0, sizeof(cache->counts));
+	cache->next_free = NULL;
+	malloc_tls_set(cache);
+	return cache;
+}
+
+
+/*!	The thread's cache, made on its first use; NULL once the thread has
+	exited, or if there is no memory for one. */
+static inline struct thread_cache*
+thread_cache_get(void)
+{
+	struct thread_cache* cache = (struct thread_cache*)malloc_tls_get();
+	if ((uintptr_t)cache > (uintptr_t)THREAD_CACHE_EXITED)
+		return cache;
+	if (cache == THREAD_CACHE_EXITED)
+		return NULL;
+	return thread_cache_create();
+}
+
+
+static int32
+get_thread_malloc_id(void)
+{
+	struct thread_cache* cache = thread_cache_get();
+	return cache != NULL ? cache->id : 0;
+}
+
+
+/*!	The pool that owns a page, from its owner map entry. */
+static inline struct dir_info*
+owner_pool(uint16 owner, void* block)
+{
+	const u_int pool = owner >> OWNER_POOL_SHIFT;
+	if (pool == 0 || pool > mopts.malloc_mutexes)
+		wrterror(NULL, "bogus pointer (double free?) %p", block);
+	return mopts.malloc_pool[pool - 1];
+}
+
+
+/*!	Takes up to \a count free blocks of a class from pool \a d, in the order
+	of their pages' bitmaps, onto the cache's list. The pool must be locked.
+	Returns how many it took. */
+static u_int
+malloc_bytes_batch(struct dir_info* d, struct thread_cache* cache, u_int cls,
+	u_int count)
+{
+	const u_int bucket = sBucketOfClass[cls];
+	u_int taken = 0;
+
+	while (taken < count) {
+		struct chunk_info* bp = NULL;
+		u_int list;
+		u_int i;
+
+		for (list = 0; list < MALLOC_CHUNK_LISTS && bp == NULL; list++)
+			bp = LIST_FIRST(&d->chunk_dir[bucket][list]);
+		if (bp == NULL) {
+			bp = omalloc_make_chunks(d, bucket, 0);
+			if (bp == NULL)
+				break;
+		}
+		if (bp->canary != (u_short)d->canary1 || bp->bucket != bucket)
+			wrterror(d, "chunk info corrupted");
+
+		for (i = 0; i < bp->offset && taken < count; i++) {
+			u_short bits = bp->bits[i];
+			while (bits != 0 && taken < count) {
+				const u_int k = ffs(bits) - 1;
+				void* block = (char*)bp->page
+					+ (i * MALLOC_BITS + k) * B2ALLOC(bucket);
+
+				bits &= bits - 1;
+				*(void**)block = cache->heads[cls];
+				((uintptr_t*)block)[1] = sThreadCacheKey;
+				cache->heads[cls] = block;
+				cache->counts[cls]++;
+				bp->free--;
+				taken++;
+			}
+			bp->bits[i] = bits;
+		}
+
+		if (bp->free == 0)
+			LIST_REMOVE(bp, entries);
+	}
+
+	return taken;
+}
+
+
+static void*
+thread_cache_refill(struct thread_cache* cache, u_int cls)
+{
+	struct dir_info* d = getpool();
+
+	_MALLOC_LOCK(d->mutex);
+	d->active++;
+	d->func = "malloc";
+	malloc_bytes_batch(d, cache, cls, (sClassLimit[cls] + 1) / 2);
+	d->active--;
+	_MALLOC_UNLOCK(d->mutex);
+
+	return cache->heads[cls];
+}
+
+
+/*!	Gives a class's blocks back to their pools until \a keep are left. */
+static void
+thread_cache_flush(struct thread_cache* cache, u_int cls, u_int keep)
+{
+	struct dir_info* locked = NULL;
+
+	while (cache->counts[cls] > keep) {
+		void* block = cache->heads[cls];
+		struct dir_info* pool = owner_pool(owner_map_get(block), block);
+		struct region_info* r;
+
+		cache->heads[cls] = *(void**)block;
+		cache->counts[cls]--;
+
+		if (pool != locked) {
+			if (locked != NULL) {
+				locked->active--;
+				_MALLOC_UNLOCK(locked->mutex);
+			}
+			_MALLOC_LOCK(pool->mutex);
+			pool->active++;
+			pool->func = "free";
+			locked = pool;
+		}
+
+		r = find(pool, block);
+		if (r == NULL)
+			wrterror(pool, "bogus pointer (double free?) %p", block);
+		free_bytes(pool, r, block);
+	}
+
+	if (locked != NULL) {
+		locked->active--;
+		_MALLOC_UNLOCK(locked->mutex);
+	}
+}
+
+
+static void
+thread_cache_check_double_free(struct thread_cache* cache, u_int cls,
+	void* block)
+{
+	void* cached;
+	for (cached = cache->heads[cls]; cached != NULL; cached = *(void**)cached) {
+		if (cached == block)
+			wrterror(NULL, "double free %p", block);
+	}
+}
+
+
+/*!	A small block from the thread's cache, or NULL if the size is not a small
+	one or there is no cache: then the caller takes the locked path. */
+static inline void*
+thread_cache_malloc(size_t size)
+{
+	struct thread_cache* cache;
+	void* block;
+	u_int cls;
+
+	// 0 (for malloc(0)'s own pages) and sizes above the small blocks
+	if (size - 1 >= MALLOC_MAXCHUNK)
+		return NULL;
+
+	cls = sClassOfBucket[find_bucket(size)];
+	if (cls == THREAD_CACHE_NO_CLASS)
+		return NULL;
+	cache = thread_cache_get();
+	if (cache == NULL)
+		return NULL;
+
+	block = cache->heads[cls];
+	if (block == NULL) {
+		block = thread_cache_refill(cache, cls);
+		if (block == NULL)
+			return NULL;
+	}
+	cache->heads[cls] = *(void**)block;
+	cache->counts[cls]--;
+	((uintptr_t*)block)[1] = 0;
+	return block;
+}
+
+
+/*!	Frees a small block into the thread's cache. Returns false if \a block is
+	not a small block (or there is no cache), for the locked path. */
+static inline bool
+thread_cache_free(void* block)
+{
+	const u_int bucketPlusOne = owner_map_get(block) & OWNER_BUCKET_MASK;
+	struct thread_cache* cache;
+	u_int cls;
+
+	// unknown, a region, or one of malloc(0)'s
+	if (bucketPlusOne <= 1)
+		return false;
+	cls = sClassOfBucket[bucketPlusOne - 1];
+	if (cls == THREAD_CACHE_NO_CLASS)
+		return false;
+	if (((uintptr_t)block & (MALLOC_MINSIZE - 1)) != 0)
+		wrterror(NULL, "modified chunk-pointer %p", block);
+
+	cache = thread_cache_get();
+	if (cache == NULL)
+		return false;
+
+	if (((uintptr_t*)block)[1] == sThreadCacheKey)
+		thread_cache_check_double_free(cache, cls, block);
+	if (cache->counts[cls] >= sClassLimit[cls])
+		thread_cache_flush(cache, cls, sClassLimit[cls] / 2);
+
+	*(void**)block = cache->heads[cls];
+	((uintptr_t*)block)[1] = sThreadCacheKey;
+	cache->heads[cls] = block;
+	cache->counts[cls]++;
+	return true;
+}
+
+
+/*!	realloc() of a small block: stays in place if the new size rounds to the
+	same class, and moves through malloc() and free() otherwise, without the
+	pool's lock. Returns false if \a block is not a small block. */
+static bool
+thread_cache_realloc(void* block, size_t size, void** _result)
+{
+	const u_int bucketPlusOne = owner_map_get(block) & OWNER_BUCKET_MASK;
+	size_t oldSize;
+	void* moved;
+
+	if (bucketPlusOne <= 1)
+		return false;
+
+	oldSize = B2SIZE(bucketPlusOne - 1);
+	if (size != 0 && size <= MALLOC_MAXCHUNK
+		&& find_bucket(size) == bucketPlusOne - 1) {
+		*_result = block;
+		return true;
+	}
+
+	moved = malloc(size);
+	if (moved != NULL) {
+		memcpy(moved, block, oldSize < size ? oldSize : size);
+		free(block);
+	}
+	*_result = moved;
+	return true;
+}
+
+
+/*!	The size of a small block, from the owner map. Returns false if \a block
+	is not one of the small blocks. */
+static inline bool
+thread_cache_usable_size(void* block, size_t* _size)
+{
+	const u_int bucketPlusOne = owner_map_get(block) & OWNER_BUCKET_MASK;
+	if (bucketPlusOne == 0)
+		return false;
+	*_size = B2SIZE(bucketPlusOne - 1);
+	return true;
+}
+
+
+/*!	At a thread's exit: its blocks go back to their pools, and its cache to
+	the next thread. */
+static void
+thread_cache_exit(void)
+{
+	struct thread_cache* cache = (struct thread_cache*)malloc_tls_get();
+	u_int cls;
+
+	malloc_tls_set(THREAD_CACHE_EXITED);
+	if ((uintptr_t)cache <= (uintptr_t)THREAD_CACHE_EXITED)
+		return;
+
+	for (cls = 0; cls < THREAD_CACHE_CLASSES; cls++)
+		thread_cache_flush(cache, cls, 0);
+
+	mutex_lock(&sThreadCacheLock);
+	cache->next_free = sFreeThreadCaches;
+	sFreeThreadCaches = cache;
+	mutex_unlock(&sThreadCacheLock);
+}
+
+
+static void
+thread_cache_before_fork(void)
+{
+	mutex_lock(&sThreadCacheLock);
+}
+
+
+static void
+thread_cache_after_fork(int parent)
+{
+	if (parent)
+		mutex_unlock(&sThreadCacheLock);
+	else
+		mutex_init(&sThreadCacheLock, "heap thread caches");
+}
