+			area_id area = create_area("heap owner map", &tableAddress,
+				B_ANY_ADDRESS, OWNER_MAP_ENTRIES * sizeof(uint16), B_NO_LOCK,
+				B_READ_AREA | B_WRITE_AREA | B_OVERCOMMITTING_AREA);
+			if (area >= 0) {
+				table = (uint16*)tableAddress;
+				__atomic_store_n(slot, table, __ATOMIC_RELEASE);
+			}
+		}
+		mutex_unlock(&sOwnerMapLock);
+
+		// Without a table, free() finds this page's owner by searching.
+		if (table == NULL)
+			return;
+	}
+	__atomic_store_n(&table[(address >> _MAX_PAGE_SHIFT)
+		& (OWNER_MAP_ENTRIES - 1)], owner, __ATOMIC_RELAXED);
+}
