+/* The page owner map: for every allocator page the heap hands out, the pool
+ * that owns it and, if the page holds small blocks, their bucket. free()
+ * finds a block's owner and size here, without a lock and without searching
+ * the pools. One table covers 64 GB of address space (OWNER_MAP_SLOT_SHIFT);
+ * tables are made as address space is used, and they overcommit, so only the
+ * parts describing used heap take memory. Entries are written by the owning
+ * pool, under its lock. */
+
+#ifdef B_HAIKU_64_BIT
+#	define OWNER_MAP_ADDRESS_BITS	48
+#	define OWNER_MAP_SLOT_SHIFT		36
+#else
+#	define OWNER_MAP_ADDRESS_BITS	32
+#	define OWNER_MAP_SLOT_SHIFT		28
+#endif
+#define OWNER_MAP_SLOTS \
+	((size_t)1 << (OWNER_MAP_ADDRESS_BITS - OWNER_MAP_SLOT_SHIFT))
+#define OWNER_MAP_ENTRIES \
+	((size_t)1 << (OWNER_MAP_SLOT_SHIFT - _MAX_PAGE_SHIFT))
+
+/* an entry: (pool + 1) << OWNER_POOL_SHIFT | (bucket + 1, or 0 for a region);
+ * 0 means unknown */
+#define OWNER_POOL_SHIFT			10
+#define OWNER_BUCKET_MASK			((1 << OWNER_POOL_SHIFT) - 1)
+#define OWNER(pool, bucketPlusOne) \
+	((uint16)((((pool) + 1) << OWNER_POOL_SHIFT) | (bucketPlusOne)))
+
