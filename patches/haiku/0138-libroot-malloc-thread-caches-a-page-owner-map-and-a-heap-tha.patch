+{
+	const uintptr_t address = (uintptr_t)pointer;
+	uint16* table;
+
+	if ((address >> OWNER_MAP_ADDRESS_BITS) != 0)
+		return 0;
+	table = __atomic_load_n(&sOwnerMap[address >> OWNER_MAP_SLOT_SHIFT],
+		__ATOMIC_ACQUIRE);
+	if (table == NULL)
+		return 0;
+	return __atomic_load_n(&table[(address >> _MAX_PAGE_SHIFT)
+		& (OWNER_MAP_ENTRIES - 1)], __ATOMIC_RELAXED);
+}
+
+
+static void
+owner_map_set(const void* page, uint16 owner)
+{
+	const uintptr_t address = (uintptr_t)page;
+	uint16** slot;
+	uint16* table;
+
+	if ((address >> OWNER_MAP_ADDRESS_BITS) != 0)
+		return;
+	slot = &sOwnerMap[address >> OWNER_MAP_SLOT_SHIFT];
+	table = __atomic_load_n(slot, __ATOMIC_ACQUIRE);
+	if (table == NULL) {
+		if (owner == 0)
+			return;
+
+		mutex_lock(&sOwnerMapLock);
+		table = *slot;
+		if (table == NULL) {
