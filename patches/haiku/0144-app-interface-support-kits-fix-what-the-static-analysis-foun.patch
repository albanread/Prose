diff --git a/src/kits/support/String.cpp b/src/kits/support/String.cpp
index d2af36c300..d51d29e8cf 100644
--- a/src/kits/support/String.cpp
+++ b/src/kits/support/String.cpp
@@ -2575,6 +2575,15 @@ BString&
 BString::_DoCharacterEscape(const char* string, const char* setOfCharsToEscape,
 	char escapeChar)
 {
+	// _MakeWritable() may move or free this string's buffer, which the
+	// source can be in (the overloads working in place pass it): copy it first
+	BString source;
+	if (fPrivateData != NULL && string >= fPrivateData
+		&& string <= fPrivateData + Length()) {
+		source.SetTo(string);
+		string = source.String();
+	}
+
 	if (_MakeWritable(string_length(string), false) != B_OK)
 		return *this;
 
@@ -2629,6 +2638,15 @@ BString::_DoCharacterEscape(const char* string, const char* setOfCharsToEscape,
 BString&
 BString::_DoCharacterDeescape(const char* string, char escapeChar)
 {
+	// _MakeWritable() may move or free this string's buffer, which the
+	// source can be in (the overload working in place passes it): copy it
+	BString source;
+	if (fPrivateData != NULL && string >= fPrivateData
+		&& string <= fPrivateData + Length()) {
+		source.SetTo(string);
+		string = source.String();
+	}
+
 	if (_MakeWritable(string_length(string), false) != B_OK)
 		return *this;
 
