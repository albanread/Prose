diff --git a/src/kits/interface/layouter/SimpleLayouter.cpp b/src/kits/interface/layouter/SimpleLayouter.cpp
index 2bf049fa49..517893164e 100644
--- a/src/kits/interface/layouter/SimpleLayouter.cpp
+++ b/src/kits/interface/layouter/SimpleLayouter.cpp
@@ -257,7 +257,15 @@ SimpleLayouter::DistributeSize(int32 size, float weights[], int32 sizes[],
 	for (int32 i = 0; i < count; i++) {
 		ElementInfo* info = new ElementInfo(i);
 		info->weight = weights[i];
-		elementInfos.AddItem(info);
+		if (!elementInfos.AddItem(info)) {
