+		// AddMenu() does
 		delete item;
-		item = NULL;
+		throw std::bad_alloc();
 	}
 
 	return MenuItem<ParentBuilder>(this->fParent, fMenu, item);
@@ -1761,8 +1763,10 @@ Menu<ParentBuilder>::AddItem(const char* label, uint32 messageWhat,
 	}
 
 	if (!fMenu->AddItem(item)) {
+		// the builder's calls would go through a NULL item: fail as
