diff --git a/src/kits/interface/ColumnListView.cpp b/src/kits/interface/ColumnListView.cpp
index fc323c123c..cd417826a4 100644
--- a/src/kits/interface/ColumnListView.cpp
+++ b/src/kits/interface/ColumnListView.cpp
@@ -2501,8 +2501,11 @@ TitleView::FindColumn(BPoint position, float* _leftEdge)
 		if (!column->IsVisible())
 			continue;
 
-		if (leftEdge > position.x)
-			break;
+		if (leftEdge > position.x) {
+			// left of this column, or in the gap before it
+			*_leftEdge = leftEdge;
+			return index;
+		}
 
 		if (position.x >= leftEdge
 			&& position.x <= leftEdge + column->Width()) {
@@ -2513,7 +2516,9 @@ TitleView::FindColumn(BPoint position, float* _leftEdge)
