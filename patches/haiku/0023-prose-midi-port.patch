diff --git a/src/bin/prose_midi_test.cpp b/src/bin/prose_midi_test.cpp
new file mode 100644
index 0000000000..d2f79a8b3d
--- /dev/null
+++ b/src/bin/prose_midi_test.cpp
@@ -0,0 +1,101 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * prose_midi_test [--direct]: plays a scale on the Prose MIDI port. By default
+ * through the Midi Kit (BMidiRoster -> midi_server -> /dev/midi/prose/0), with
+ * --direct straight into the device file.
+ */
+
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <Application.h>
+#include <MidiConsumer.h>
+#include <MidiProducer.h>
+#include <MidiRoster.h>
+
+
+static const uint8 kScale[] = { 60, 62, 64, 65, 67, 69, 71, 72 };
+
+
+static int
+play_direct()
+{
+	int fd = open("/dev/midi/prose/0", O_WRONLY);
+	if (fd < 0) {
+		printf("prose_midi_test: cannot open /dev/midi/prose/0: %s\n", strerror(errno));
+		return 1;
+	}
+	uint8 program[] = { 0xC0, 0 };
+	write(fd, program, sizeof(program));
+	for (size_t i = 0; i < sizeof(kScale); i++) {
+		uint8 on[] = { 0x90, kScale[i], 100 };
+		uint8 off[] = { 0x80, kScale[i], 0 };
+		write(fd, on, sizeof(on));
+		snooze(250000);
+		write(fd, off, sizeof(off));
+	}
+	close(fd);
+	printf("prose_midi_test: direct: played %" B_PRIuSIZE " notes\n", sizeof(kScale));
+	return 0;
+}
+
+
+int
+main(int argc, char** argv)
+{
+	BApplication app("application/x-vnd.prose-midi-test");
+	if (argc > 1 && strcmp(argv[1], "--direct") == 0)
+		return play_direct();
+
+	BMidiRoster* roster = BMidiRoster::MidiRoster();
+	if (roster == NULL) {
+		printf("prose_midi_test: no MIDI roster (midi_server not running?)\n");
+		return 1;
+	}
+	// give midi_server a moment to publish the ports it found under /dev/midi
+	BMidiConsumer* target = NULL;
+	for (int attempt = 0; attempt < 20 && target == NULL; attempt++) {
+		int32 id = 0;
+		BMidiConsumer* consumer;
+		while ((consumer = roster->NextConsumer(&id)) != NULL) {
+			printf("prose_midi_test: consumer %" B_PRId32 ": %s\n", consumer->ID(), consumer->Name());
+			if (target == NULL && strstr(consumer->Name(), "prose") != NULL)
+				target = consumer;
+			else
+				consumer->Release();
+		}
+		if (target == NULL)
+			snooze(500000);
+	}
+	if (target == NULL) {
+		printf("prose_midi_test: no Prose MIDI consumer found\n");
+		return 1;
+	}
+
+	BMidiLocalProducer* producer = new BMidiLocalProducer("prose_midi_test");
+	producer->Register();
+	status_t status = producer->Connect(target);
+	printf("prose_midi_test: connected to \"%s\": %s\n", target->Name(), strerror(status));
+	if (status != B_OK)
+		return 1;
+	producer->SprayProgramChange(0, 0);
+	for (size_t i = 0; i < sizeof(kScale); i++) {
+		producer->SprayNoteOn(0, kScale[i], 100);
+		snooze(250000);
+		producer->SprayNoteOff(0, kScale[i], 0);
+	}
+	snooze(300000);
+	producer->Disconnect(target);
+	producer->Unregister();
+	producer->Release();
+	target->Release();
+	printf("prose_midi_test: played %" B_PRIuSIZE " notes through the Midi Kit\n", sizeof(kScale));
+	return 0;
+}
