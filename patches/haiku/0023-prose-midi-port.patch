new file mode 100644
index 0000000000..48d9e5ba90
--- /dev/null
+++ b/src/add-ons/kernel/drivers/midi/prose_midi/prose_midi.cpp
@@ -0,0 +1,477 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * Prose MIDI: a MIDI port whose other end is the host (hvgpu plays it through
+ * the Mac's General MIDI synth and CoreMIDI). A custom virtio device, ID 62:
+ * queue 0 carries MIDI bytes to the host, queue 1 brings bytes from it. The
+ * device file /dev/midi/prose/0 is a plain MIDI byte stream, which is what
+ * midi_server expects from any port under /dev/midi.
+ */
+
+
+#include <KernelExport.h>
+#include <device_manager.h>
+#include <kernel.h>
+#include <lock.h>
+#include <util/AutoLock.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <virtio.h>
+
+
+// The module lives under drivers/audio: the device manager searches a virtio
+// child's driver only when its node is registered, in the context of the
+// /dev/<class> scan that triggered it, and for a multimedia-class device that
+// is media_server's /dev/audio scan at boot. Where the device file is published
+// (/dev/midi/prose/0) does not depend on it.
+#define PRMD_DRIVER_MODULE_NAME		"drivers/audio/hmulti/prose_midi/driver_v1"
+#define PRMD_DEVICE_MODULE_NAME		"drivers/audio/hmulti/prose_midi/device_v1"
+#define PRMD_DEVICE_ID_GENERATOR	"prose_midi/device_id"
+#define PRMD_VIRTIO_DEVICE_ID		62	// 63 is the Prose Display; >= 64 would leave virtio-pci's modern ID range
+
+#define INFO(x...)	dprintf("prose_midi: " x)
+#define ERROR(x...)	dprintf("prose_midi: " x)
+
+#define BUFFER_COUNT		8
+#define BUFFER_SIZE			256		// per transfer, both directions
+#define RX_RING_SIZE		4096
+
+
+struct prmd_info {
+	device_node*				node;
+	int32						id;
+	char						name[64];
+	virtio_device				device;
+	virtio_device_interface*	virtio;
+	uint64						features;
+	virtio_queue				txQueue;
+	virtio_queue				rxQueue;
+
+	area_id						area;			// tx buffers then rx buffers, contiguous
+	uint8*						buffers;
+	phys_addr_t					phys;
+
+	// to the host
+	sem_id						txFree;			// one count per free tx buffer
+	spinlock					lock;
+	uint32						txFreeList[BUFFER_COUNT];
+	uint32						txFreeHead;
+	uint32						txFreeTail;
+	mutex						txLock;
+
+	// from the host
+	sem_id						rxAvailable;
+	uint8						rxRing[RX_RING_SIZE];
+	uint32						rxHead;
+	uint32						rxTail;
+	uint32						rxDropped;
+
+	int32						openCount;
+	uint32						bytesOut;
+	uint32						bytesIn;
+};
+
+
+static device_manager_info* sDeviceManager;
+
+
+//	#pragma mark - queues
+
+
+static uint8*
+prmd_tx_buffer(prmd_info* info, uint32 index)
+{
+	return info->buffers + index * BUFFER_SIZE;
+}
+
+
+static uint8*
+prmd_rx_buffer(prmd_info* info, uint32 index)
+{
+	return info->buffers + (BUFFER_COUNT + index) * BUFFER_SIZE;
+}
+
+
+static status_t
+prmd_post_rx(prmd_info* info, uint32 index)
+{
+	physical_entry entry = { info->phys + (BUFFER_COUNT + index) * BUFFER_SIZE, BUFFER_SIZE };
+	return info->virtio->queue_request_v(info->rxQueue, &entry, 0, 1, (void*)(addr_t)(index + 1));
+}
+
+
+static void
+prmd_tx_callback(void* driverCookie, void* cookie)
+{
+	prmd_info* info = (prmd_info*)cookie;
+	void* tag;
+	while (info->virtio->queue_dequeue(info->txQueue, &tag, NULL)) {
+		uint32 index = (uint32)(addr_t)tag - 1;
+		if (index >= BUFFER_COUNT)
+			continue;
+		InterruptsSpinLocker locker(info->lock);
+		info->txFreeList[info->txFreeHead % BUFFER_COUNT] = index;
+		info->txFreeHead++;
+		locker.Unlock();
+		release_sem_etc(info->txFree, 1, B_DO_NOT_RESCHEDULE);
+	}
+}
+
+
+static void
+prmd_rx_callback(void* driverCookie, void* cookie)
+{
+	prmd_info* info = (prmd_info*)cookie;
+	void* tag;
+	uint32 length;
+	while (info->virtio->queue_dequeue(info->rxQueue, &tag, &length)) {
+		uint32 index = (uint32)(addr_t)tag - 1;
+		if (index >= BUFFER_COUNT)
+			continue;
+		if (length > BUFFER_SIZE)
+			length = BUFFER_SIZE;
+		const uint8* data = prmd_rx_buffer(info, index);
+		bool added = false;
+		{
+			InterruptsSpinLocker locker(info->lock);
+			for (uint32 i = 0; i < length; i++) {
+				if (info->rxHead - info->rxTail >= RX_RING_SIZE) {
+					info->rxDropped++;
+					break;
+				}
+				info->rxRing[info->rxHead % RX_RING_SIZE] = data[i];
+				info->rxHead++;
+				added = true;
+			}
+		}
+		info->bytesIn += length;
+		prmd_post_rx(info, index);
+		if (added)
+			release_sem_etc(info->rxAvailable, 1, B_DO_NOT_RESCHEDULE);
+	}
+}
+
+
+//	#pragma mark - driver
+
+
+static float
+prmd_supports_device(device_node* parent)
+{
+	const char* bus;
+	uint16 deviceType;
+	if (sDeviceManager->get_attr_string(parent, B_DEVICE_BUS, &bus, false) != B_OK
+		|| strcmp(bus, "virtio") != 0)
+		return 0.0f;
+	if (sDeviceManager->get_attr_uint16(parent, VIRTIO_DEVICE_TYPE_ITEM, &deviceType, true)
+			!= B_OK || deviceType != PRMD_VIRTIO_DEVICE_ID)
+		return 0.0f;
+	return 1.0f;
+}
+
+
+static status_t
+prmd_register_device(device_node* node)
+{
+	device_attr attrs[] = {
+		{ B_DEVICE_PRETTY_NAME, B_STRING_TYPE, { .string = "Prose MIDI" }},
+		{ NULL }
+	};
+	return sDeviceManager->register_node(node, PRMD_DRIVER_MODULE_NAME, attrs, NULL, NULL);
+}
+
+
+static void
+prmd_teardown(prmd_info* info)
+{
+	if (info->virtio != NULL && info->txQueue != NULL)
+		info->virtio->free_interrupts(info->device);
+	if (info->txFree >= 0)
+		delete_sem(info->txFree);
+	if (info->rxAvailable >= 0)
+		delete_sem(info->rxAvailable);
+	if (info->area >= 0)
+		delete_area(info->area);
+	mutex_destroy(&info->txLock);
+	free(info);
+}
+
+
+static status_t
+prmd_init_driver(device_node* node, void** _cookie)
+{
+	prmd_info* info = (prmd_info*)calloc(1, sizeof(prmd_info));
+	if (info == NULL)
+		return B_NO_MEMORY;
+	info->node = node;
+	info->area = -1;
+	info->txFree = -1;
+	info->rxAvailable = -1;
+	B_INITIALIZE_SPINLOCK(&info->lock);
+	mutex_init(&info->txLock, "prose_midi tx");
+
+	device_node* parent = sDeviceManager->get_parent_node(node);
+	sDeviceManager->get_driver(parent, (driver_module_info**)&info->virtio, (void**)&info->device);
+	sDeviceManager->put_node(parent);
+
+	status_t status = info->virtio->negotiate_features(info->device, 0, &info->features, NULL);
+	if (status != B_OK) {
+		ERROR("feature negotiation failed: %s\n", strerror(status));
+		goto error;
+	}
+
+	{
+		void* address;
+		size_t size = ROUNDUP(2 * BUFFER_COUNT * BUFFER_SIZE, B_PAGE_SIZE);
+		info->area = create_area("prose_midi buffers", &address, B_ANY_KERNEL_ADDRESS, size,
+			B_CONTIGUOUS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA);
+		if (info->area < 0) {
+			status = info->area;
+			goto error;
+		}
+		physical_entry entry;
+		status = get_memory_map(address, size, &entry, 1);
+		if (status != B_OK)
+			goto error;
+		info->buffers = (uint8*)address;
+		info->phys = entry.address;
+		memset(info->buffers, 0, size);
+	}
+	info->txFree = create_sem(BUFFER_COUNT, "prose_midi tx free");
+	info->rxAvailable = create_sem(0, "prose_midi rx");
+	if (info->txFree < 0 || info->rxAvailable < 0) {
+		status = B_NO_MEMORY;
+		goto error;
+	}
+	for (uint32 i = 0; i < BUFFER_COUNT; i++)
+		info->txFreeList[i] = i;
+	info->txFreeHead = BUFFER_COUNT;
+	info->txFreeTail = 0;
+
+	{
+		virtio_queue queues[2];
+		status = info->virtio->alloc_queues(info->device, 2, queues, NULL);
+		if (status != B_OK) {
+			ERROR("queue allocation failed: %s\n", strerror(status));
+			goto error;
+		}
+		info->txQueue = queues[0];
+		info->rxQueue = queues[1];
+	}
+	status = info->virtio->setup_interrupt(info->device, NULL, info);
+	if (status == B_OK)
+		status = info->virtio->queue_setup_interrupt(info->txQueue, prmd_tx_callback, info);
+	if (status == B_OK)
+		status = info->virtio->queue_setup_interrupt(info->rxQueue, prmd_rx_callback, info);
+	if (status != B_OK) {
+		ERROR("interrupt setup failed: %s\n", strerror(status));
+		goto error;
+	}
+	for (uint32 i = 0; i < BUFFER_COUNT; i++)
+		prmd_post_rx(info, i);
+
+	INFO("ready\n");
+	*_cookie = info;
+	return B_OK;
+
+error:
+	prmd_teardown(info);
+	return status;
+}
+
+
+static void
+prmd_uninit_driver(void* cookie)
+{
+	prmd_teardown((prmd_info*)cookie);
+}
+
+
+static status_t
+prmd_register_child_devices(void* cookie)
+{
+	prmd_info* info = (prmd_info*)cookie;
+	int32 id = sDeviceManager->create_id(PRMD_DEVICE_ID_GENERATOR);
+	if (id < 0)
+		return id;
+	info->id = id;
+	snprintf(info->name, sizeof(info->name), "midi/prose/%" B_PRId32, id);
+	return sDeviceManager->publish_device(info->node, info->name, PRMD_DEVICE_MODULE_NAME);
+}
+
+
+//	#pragma mark - device
+
+
+static status_t
+prmd_init_device(void* driverCookie, void** _cookie)
+{
+	*_cookie = driverCookie;
+	return B_OK;
+}
+
+
+static void
+prmd_uninit_device(void* cookie)
+{
+}
+
+
+static status_t
+prmd_open(void* deviceCookie, const char* path, int openMode, void** _cookie)
+{
+	prmd_info* info = (prmd_info*)deviceCookie;
+	atomic_add(&info->openCount, 1);
+	*_cookie = info;
+	return B_OK;
+}
+
+
+static status_t
+prmd_close(void* cookie)
+{
+	return B_OK;
+}
+
+
+static status_t
+prmd_free(void* cookie)
+{
+	prmd_info* info = (prmd_info*)cookie;
+	atomic_add(&info->openCount, -1);
+	return B_OK;
+}
+
+
+/*!	MIDI bytes from the host; blocks until there are some. */
+static status_t
+prmd_read(void* cookie, off_t position, void* buffer, size_t* _length)
+{
+	prmd_info* info = (prmd_info*)cookie;
+	size_t wanted = *_length;
+	while (true) {
+		uint8 chunk[64];
+		size_t count = 0;
+		{
+			InterruptsSpinLocker locker(info->lock);
+			while (count < wanted && count < sizeof(chunk) && info->rxTail != info->rxHead) {
+				chunk[count++] = info->rxRing[info->rxTail % RX_RING_SIZE];
+				info->rxTail++;
+			}
+		}
+		if (count > 0) {
+			if (user_memcpy(buffer, chunk, count) != B_OK)
+				return B_BAD_ADDRESS;
+			*_length = count;
+			return B_OK;
+		}
+		status_t status = acquire_sem_etc(info->rxAvailable, 1, B_CAN_INTERRUPT, 0);
+		if (status != B_OK) {
+			*_length = 0;
+			return status;
+		}
+	}
+}
+
+
+/*!	MIDI bytes to the host, in transfers of up to BUFFER_SIZE. */
+static status_t
+prmd_write(void* cookie, off_t position, const void* buffer, size_t* _length)
+{
+	prmd_info* info = (prmd_info*)cookie;
+	MutexLocker locker(info->txLock);
+	size_t done = 0;
+	while (done < *_length) {
+		status_t status = acquire_sem_etc(info->txFree, 1, B_CAN_INTERRUPT, 0);
+		if (status != B_OK) {
+			*_length = done;
+			return done > 0 ? B_OK : status;
+		}
+		uint32 index;
+		{
+			InterruptsSpinLocker spin(info->lock);
+			index = info->txFreeList[info->txFreeTail % BUFFER_COUNT];
+			info->txFreeTail++;
+		}
+		size_t count = min_c(*_length - done, (size_t)BUFFER_SIZE);
+		if (user_memcpy(prmd_tx_buffer(info, index), (const uint8*)buffer + done, count) != B_OK) {
+			*_length = done;
+			return B_BAD_ADDRESS;
+		}
+		physical_entry entry = { info->phys + index * BUFFER_SIZE, count };
+		status = info->virtio->queue_request_v(info->txQueue, &entry, 1, 0,
+			(void*)(addr_t)(index + 1));
+		if (status != B_OK) {
+			ERROR("queueing %" B_PRIuSIZE " bytes failed: %s\n", count, strerror(status));
+			*_length = done;
+			return status;
+		}
+		done += count;
+		info->bytesOut += count;
+	}
+	return B_OK;
+}
+
+
+static status_t
+prmd_control(void* cookie, uint32 op, void* buffer, size_t length)
+{
+	return B_DEV_INVALID_IOCTL;
+}
+
+
+module_dependency module_dependencies[] = {
+	{ B_DEVICE_MANAGER_MODULE_NAME, (module_info**)&sDeviceManager },
+	{}
+};
+
+
+struct device_module_info sPrmdDevice = {
+	{
+		PRMD_DEVICE_MODULE_NAME,
+		0,
+		NULL
+	},
+
+	prmd_init_device,
+	prmd_uninit_device,
+	NULL,	// remove
+
+	prmd_open,
+	prmd_close,
+	prmd_free,
+	prmd_read,
+	prmd_write,
+	NULL,	// io
+	prmd_control,
+
+	NULL,	// select
+	NULL,	// deselect
+};
+
+
+struct driver_module_info sPrmdDriver = {
+	{
+		PRMD_DRIVER_MODULE_NAME,
+		0,
+		NULL
+	},
+
+	prmd_supports_device,
+	prmd_register_device,
+	prmd_init_driver,
+	prmd_uninit_driver,
+	prmd_register_child_devices,
+	NULL,	// rescan
+	NULL,	// removed
+};
+
+
+module_info* modules[] = {
+	(module_info*)&sPrmdDriver,
+	(module_info*)&sPrmdDevice,
+	NULL
+};
