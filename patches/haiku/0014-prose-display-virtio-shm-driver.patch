diff --git a/src/add-ons/kernel/drivers/graphics/prose_display/prose_display.cpp b/src/add-ons/kernel/drivers/graphics/prose_display/prose_display.cpp
new file mode 100644
index 0000000000..fa8f8c9e58
--- /dev/null
+++ b/src/add-ons/kernel/drivers/graphics/prose_display/prose_display.cpp
@@ -0,0 +1,736 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * Prose Display (PRDS): kernel driver for the shared-surface display device
+ * (HaikuArmQemu/docs/s2-display-device.md). The host maps a surface pool into
+ * the guest as virtio shared memory region 0; we set a mode inside it, draw
+ * into it directly, and tell the host which rectangles to present.
+ *
+ * Milestone A: the driver alone brings the display up and draws a test
+ * pattern, so the whole pipe can be verified before an accelerant exists.
+ */
+
+
+#include <KernelExport.h>
+#include <device_manager.h>
+#include <lock.h>
+#include <util/AutoLock.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <virtio.h>
+#include <prose_display.h>
+
+
+#define PRDS_DRIVER_MODULE_NAME "drivers/graphics/prose_display/driver_v1"
+#define PRDS_DEVICE_MODULE_NAME "drivers/graphics/prose_display/device_v1"
+#define PRDS_DEVICE_ID_GENERATOR "prose_display/device_id"
+
+#define INFO(x...) dprintf("prose_display: " x)
+#define ERROR(x...) dprintf("prose_display: " x)
+
+#define PRDS_EVENT_BUFFERS		8
+#define PRDS_RESPONSE_OFFSET	2048	// in the command page
+#define PRDS_TEST_PATTERN		1		// milestone A: draw and animate ourselves
+
+#define ALIGN_UP(x, a) ((((x) + (a) - 1) / (a)) * (a))
+
+
+struct prds_info {
+	device_node*				node;
+	int32						id;
+	virtio_device_interface*	virtio;
+	virtio_device				device;
+	uint64						features;
+	struct prds_config			config;
+
+	phys_addr_t					pool_phys;
+	uint64						pool_size;
+	area_id						pool_area;
+	uint8*						pool;
+
+	virtio_queue				control_queue;
+	virtio_queue				event_queue;
+
+	area_id						command_area;
+	uint8*						command;
+	phys_addr_t					command_phys;
+	mutex						command_lock;
+	sem_id						command_done;
+	uint64						seq;
+
+	area_id						event_area;
+	uint8*						events;
+	phys_addr_t					events_phys;
+
+	area_id						shared_area;
+	struct prds_shared_info*	shared;
+	sem_id						retrace_sem;
+
+	uint32						mode_width;
+	uint32						mode_height;
+	uint32						mode_stride;
+	uint64						mode_offset;
+
+	int64						vsync_count;
+	int64						hint_count;
+	int64						redraw_count;
+	int32						need_redraw;
+
+	thread_id					test_thread;
+	bool						quit;
+};
+
+
+static device_manager_info* sDeviceManager;
+
+
+static const char*
+prds_feature_name(uint64 feature)
+{
+	switch (feature) {
+		case PRDS_F_VSYNC:
+			return "vsync";
+		case PRDS_F_RESIZE:
+			return "resize";
+		case PRDS_F_BLIT:
+			return "blit";
+	}
+	return NULL;
+}
+
+
+//	#pragma mark - queues
+
+
+static void
+prds_config_callback(void* cookie)
+{
+	prds_info* info = (prds_info*)cookie;
+	INFO("configuration changed\n");
+	atomic_set(&info->need_redraw, 1);
+}
+
+
+static void
+prds_control_callback(void* driverCookie, void* cookie)
+{
+	prds_info* info = (prds_info*)cookie;
+	release_sem_etc(info->command_done, 1, B_DO_NOT_RESCHEDULE);
+}
+
+
+static status_t
+prds_post_event_buffer(prds_info* info, uint32 index)
+{
+	physical_entry entry = { info->events_phys + index * PRDS_EVENT_SIZE, PRDS_EVENT_SIZE };
+	return info->virtio->queue_request_v(info->event_queue, &entry, 0, 1,
+		(void*)(addr_t)(index + 1));
+}
+
+
+static void
+prds_event_callback(void* driverCookie, void* cookie)
+{
+	prds_info* info = (prds_info*)cookie;
+	void* tag;
+	uint32 length;
+	while (info->virtio->queue_dequeue(info->event_queue, &tag, &length)) {
+		uint32 index = (uint32)(addr_t)tag - 1;
+		if (index >= PRDS_EVENT_BUFFERS)
+			continue;
+		struct prds_event* event = (struct prds_event*)(info->events + index * PRDS_EVENT_SIZE);
+		switch (event->hdr.type) {
+			case PRDS_EVT_VSYNC:
+				info->vsync_count++;
+				release_sem_etc(info->retrace_sem, 1, B_DO_NOT_RESCHEDULE);
+				break;
+			case PRDS_EVT_MODE_HINT:
+				info->hint_count++;
+				info->shared->pref_width = event->mode_hint.width;
+				info->shared->pref_height = event->mode_hint.height;
+				break;
+			case PRDS_EVT_REDRAW:
+				info->redraw_count++;
+				atomic_set(&info->need_redraw, 1);
+				break;
+		}
+		prds_post_event_buffer(info, index);
+	}
+}
+
+
+/*! Sends one request and waits for its response (synchronous, serialized). */
+static status_t
+prds_command(prds_info* info, void* request, size_t requestSize, void* response,
+	size_t responseSize)
+{
+	MutexLocker locker(info->command_lock);
+
+	struct prds_hdr* hdr = (struct prds_hdr*)request;
+	hdr->seq = ++info->seq;
+	memcpy(info->command, request, requestSize);
+	memset(info->command + PRDS_RESPONSE_OFFSET, 0, responseSize);
+
+	physical_entry entries[2] = {
+		{ info->command_phys, requestSize },
+		{ info->command_phys + PRDS_RESPONSE_OFFSET, responseSize },
+	};
+	status_t status = info->virtio->queue_request_v(info->control_queue, entries, 1, 1, NULL);
+	if (status != B_OK) {
+		ERROR("queueing command %#" B_PRIx32 " failed: %s\n", hdr->type, strerror(status));
+		return status;
+	}
+
+	status = acquire_sem_etc(info->command_done, 1, B_RELATIVE_TIMEOUT, 5000000);
+	if (status != B_OK) {
+		ERROR("command %#" B_PRIx32 " timed out\n", hdr->type);
+		return status;
+	}
+	while (!info->virtio->queue_dequeue(info->control_queue, NULL, NULL))
+		spin(10);
+
+	memcpy(response, info->command + PRDS_RESPONSE_OFFSET, responseSize);
+	struct prds_hdr* respHdr = (struct prds_hdr*)response;
+	if (respHdr->seq != hdr->seq)
+		ERROR("response sequence %" B_PRIu64 " != %" B_PRIu64 "\n", respHdr->seq, hdr->seq);
+	if (respHdr->type != PRDS_RESP_OK) {
+		ERROR("command %#" B_PRIx32 " failed: %#" B_PRIx32 "\n", hdr->type, respHdr->type);
+		return B_ERROR;
+	}
+	return B_OK;
+}
+
+
+static status_t
+prds_set_mode(prds_info* info, uint32 width, uint32 height)
+{
+	struct prds_set_mode request = {};
+	struct prds_resp response = {};
+	request.hdr.type = PRDS_CMD_SET_MODE;
+	request.width = width;
+	request.height = height;
+	request.stride = ALIGN_UP(width * 4, info->config.stride_align);
+	request.format = PRDS_FORMAT_B8G8R8X8;
+	request.offset = 0;
+	status_t status = prds_command(info, &request, sizeof(request), &response, sizeof(response));
+	if (status != B_OK)
+		return status;
+	info->mode_width = width;
+	info->mode_height = height;
+	info->mode_stride = request.stride;
+	info->mode_offset = 0;
+	info->shared->mode_width = width;
+	info->shared->mode_height = height;
+	info->shared->mode_stride = request.stride;
+	info->shared->mode_offset = 0;
+	INFO("mode %" B_PRIu32 "x%" B_PRIu32 ", stride %" B_PRIu32 "\n", width, height, request.stride);
+	return B_OK;
+}
+
+
+static status_t
+prds_commit(prds_info* info, const struct prds_rect* rects, uint32 count)
+{
+	struct prds_commit request = {};
+	struct prds_resp response = {};
+	if (count > PRDS_MAX_COMMIT_RECTS)
+		count = 0;		// everything
+	request.hdr.type = PRDS_CMD_COMMIT;
+	request.rect_count = count;
+	if (count > 0)
+		memcpy(request.rects, rects, count * sizeof(struct prds_rect));
+	return prds_command(info, &request, sizeof(request.hdr) + 8 + count * sizeof(struct prds_rect),
+		&response, sizeof(response));
+}
+
+
+static status_t
+prds_enable_events(prds_info* info, uint32 mask)
+{
+	struct prds_enable_events request = {};
+	struct prds_resp response = {};
+	request.hdr.type = PRDS_CMD_ENABLE_EVENTS;
+	request.mask = mask;
+	return prds_command(info, &request, sizeof(request), &response, sizeof(response));
+}
+
+
+//	#pragma mark - milestone A test pattern
+
+
+#if PRDS_TEST_PATTERN
+
+static void
+prds_fill(prds_info* info, uint32 x, uint32 y, uint32 width, uint32 height, uint32 color)
+{
+	if (x >= info->mode_width || y >= info->mode_height)
+		return;
+	if (x + width > info->mode_width)
+		width = info->mode_width - x;
+	if (y + height > info->mode_height)
+		height = info->mode_height - y;
+	for (uint32 row = y; row < y + height; row++) {
+		uint32* line = (uint32*)(info->pool + info->mode_offset + row * info->mode_stride) + x;
+		for (uint32 i = 0; i < width; i++)
+			line[i] = color;
+	}
+}
+
+
+static void
+prds_draw_pattern(prds_info* info)
+{
+	static const uint32 kBars[8] = { 0xffffff, 0xffff00, 0x00ffff, 0x00ff00, 0xff00ff,
+		0xff0000, 0x0000ff, 0x202020 };
+	uint32 barWidth = info->mode_width / 8;
+	for (uint32 i = 0; i < 8; i++)
+		prds_fill(info, i * barWidth, 0, barWidth, info->mode_height, kBars[i]);
+	// a diagonal, to make stride mistakes visible
+	for (uint32 i = 0; i < info->mode_height && i < info->mode_width; i++)
+		prds_fill(info, i, i, 2, 2, 0x000000);
+}
+
+
+static status_t
+prds_test_thread(void* data)
+{
+	prds_info* info = (prds_info*)data;
+	const uint32 box = 64;
+	uint32 x = 0, y = info->mode_height / 2, step = 12;
+	int32 iteration = 0;
+	while (!info->quit) {
+		snooze(100000);
+		if (info->quit)
+			break;
+		if (atomic_and(&info->need_redraw, 0) != 0) {
+			prds_draw_pattern(info);
+			prds_commit(info, NULL, 0);
+			continue;
+		}
+		struct prds_rect rects[2] = { { x, y, box, box }, { 0, 0, 0, 0 } };
+		// restore what the box covered, then draw it further along
+		uint32 barWidth = info->mode_width / 8;
+		for (uint32 col = x; col < x + box; col++) {
+			static const uint32 kBars[8] = { 0xffffff, 0xffff00, 0x00ffff, 0x00ff00, 0xff00ff,
+				0xff0000, 0x0000ff, 0x202020 };
+			uint32 bar = barWidth > 0 ? col / barWidth : 0;
+			prds_fill(info, col, y, 1, box, kBars[bar > 7 ? 7 : bar]);
+		}
+		x = (x + step + box > info->mode_width) ? 0 : x + step;
+		prds_fill(info, x, y, box, box, 0x00ff8000);
+		rects[1].x = x;
+		rects[1].y = y;
+		rects[1].width = box;
+		rects[1].height = box;
+		prds_commit(info, rects, 2);
+		if (++iteration % 100 == 0) {
+			INFO("stats: %" B_PRId32 " commits, %" B_PRId64 " vsyncs, %" B_PRId64 " mode hints, %"
+				B_PRId64 " redraws\n", iteration + 1, info->vsync_count, info->hint_count,
+				info->redraw_count);
+		}
+	}
+	return B_OK;
+}
+
+#endif	// PRDS_TEST_PATTERN
+
+
+//	#pragma mark - driver module
+
+
+static float
+prds_supports_device(device_node* parent)
+{
+	const char* bus;
+	uint16 deviceType;
+	if (sDeviceManager->get_attr_string(parent, B_DEVICE_BUS, &bus, false) != B_OK
+		|| strcmp(bus, "virtio") != 0)
+		return 0.0;
+	if (sDeviceManager->get_attr_uint16(parent, VIRTIO_DEVICE_TYPE_ITEM, &deviceType, true)
+			!= B_OK || deviceType != PRDS_VIRTIO_DEVICE_ID)
+		return 0.0;
+	return 0.8;
+}
+
+
+static status_t
+prds_register_device(device_node* node)
+{
+	device_attr attrs[] = {
+		{ B_DEVICE_PRETTY_NAME, B_STRING_TYPE, { .string = "Prose Display" }},
+		{ NULL }
+	};
+	return sDeviceManager->register_node(node, PRDS_DRIVER_MODULE_NAME, attrs, NULL, NULL);
+}
+
+
+static area_id
+prds_alloc_page(const char* name, uint8** _virtual, phys_addr_t* _physical)
+{
+	void* address;
+	area_id area = create_area(name, &address, B_ANY_KERNEL_ADDRESS, B_PAGE_SIZE,
+		B_CONTIGUOUS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA);
+	if (area < 0) {
+		ERROR("creating %s failed: %s\n", name, strerror(area));
+		return area;
+	}
+	physical_entry entry;
+	status_t status = get_memory_map(address, B_PAGE_SIZE, &entry, 1);
+	if (status != B_OK) {
+		ERROR("get_memory_map(%s) failed: %s\n", name, strerror(status));
+		delete_area(area);
+		return status;
+	}
+	memset(address, 0, B_PAGE_SIZE);
+	*_virtual = (uint8*)address;
+	*_physical = entry.address;
+	return area;
+}
+
+
+static void
+prds_teardown(prds_info* info)
+{
+	if (info->test_thread >= 0) {
+		info->quit = true;
+		wait_for_thread(info->test_thread, NULL);
+	}
+	if (info->virtio != NULL && info->control_queue != NULL)
+		info->virtio->free_interrupts(info->device);
+	if (info->retrace_sem >= 0)
+		delete_sem(info->retrace_sem);
+	if (info->command_done >= 0)
+		delete_sem(info->command_done);
+	if (info->shared_area >= 0)
+		delete_area(info->shared_area);
+	if (info->event_area >= 0)
+		delete_area(info->event_area);
+	if (info->command_area >= 0)
+		delete_area(info->command_area);
+	if (info->pool_area >= 0)
+		delete_area(info->pool_area);
+	mutex_destroy(&info->command_lock);
+	free(info);
+}
+
+
+static status_t
+prds_init_driver(device_node* node, void** _cookie)
+{
+	prds_info* info = (prds_info*)calloc(1, sizeof(prds_info));
+	if (info == NULL)
+		return B_NO_MEMORY;
+	info->node = node;
+	info->pool_area = info->command_area = info->event_area = info->shared_area = -1;
+	info->command_done = info->retrace_sem = -1;
+	info->test_thread = -1;
+	mutex_init(&info->command_lock, "prose display commands");
+
+	device_node* parent = sDeviceManager->get_parent_node(node);
+	sDeviceManager->get_driver(parent, (driver_module_info**)&info->virtio,
+		(void**)&info->device);
+	sDeviceManager->put_node(parent);
+
+	status_t status = info->virtio->negotiate_features(info->device,
+		PRDS_F_VSYNC | PRDS_F_RESIZE, &info->features, &prds_feature_name);
+	if (status != B_OK) {
+		ERROR("feature negotiation failed: %s\n", strerror(status));
+		goto error;
+	}
+
+	status = info->virtio->read_device_config(info->device, 0, &info->config,
+		sizeof(info->config));
+	if (status != B_OK)
+		goto error;
+	if (info->config.magic != PRDS_MAGIC || info->config.version != PRDS_VERSION) {
+		ERROR("unexpected device: magic %#" B_PRIx32 ", version %u\n", info->config.magic,
+			info->config.version);
+		status = B_DEVICE_NOT_FOUND;
+		goto error;
+	}
+	INFO("max %" B_PRIu32 "x%" B_PRIu32 ", preferred %" B_PRIu32 "x%" B_PRIu32 ", %" B_PRIu32
+		" mHz, stride align %" B_PRIu32 ", pool %" B_PRIu64 " KiB\n", info->config.max_width,
+		info->config.max_height, info->config.pref_width, info->config.pref_height,
+		info->config.refresh_mhz, info->config.stride_align, info->config.shm_size >> 10);
+
+	if (info->virtio->get_shared_memory == NULL) {
+		ERROR("this virtio bus manager has no shared memory support\n");
+		status = B_NOT_SUPPORTED;
+		goto error;
+	}
+	status = info->virtio->get_shared_memory(info->device, info->config.shm_region_id,
+		&info->pool_phys, &info->pool_size);
+	if (status != B_OK) {
+		ERROR("no shared memory region %u: %s\n", info->config.shm_region_id, strerror(status));
+		goto error;
+	}
+	info->pool_area = map_physical_memory("prose display pool", info->pool_phys,
+		info->pool_size, B_ANY_KERNEL_ADDRESS | B_WRITE_BACK_MEMORY,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA | B_READ_AREA | B_WRITE_AREA,
+		(void**)&info->pool);
+	if (info->pool_area < 0) {
+		ERROR("mapping the pool at %#" B_PRIxPHYSADDR " (%" B_PRIu64 " bytes) failed: %s\n",
+			info->pool_phys, info->pool_size, strerror(info->pool_area));
+		status = info->pool_area;
+		goto error;
+	}
+	INFO("pool at %#" B_PRIxPHYSADDR ", %" B_PRIu64 " KiB, mapped write-back at %p\n",
+		info->pool_phys, info->pool_size >> 10, info->pool);
+
+	{
+		virtio_queue queues[2];
+		status = info->virtio->alloc_queues(info->device, 2, queues, NULL);
+		if (status != B_OK) {
+			ERROR("queue allocation failed: %s\n", strerror(status));
+			goto error;
+		}
+		info->control_queue = queues[0];
+		info->event_queue = queues[1];
+	}
+
+	info->command_area = prds_alloc_page("prose display commands", &info->command,
+		&info->command_phys);
+	info->event_area = prds_alloc_page("prose display events", &info->events, &info->events_phys);
+	if (info->command_area < 0 || info->event_area < 0) {
+		status = info->command_area < 0 ? info->command_area : info->event_area;
+		goto error;
+	}
+	info->command_done = create_sem(0, "prose display command");
+	info->retrace_sem = create_sem(0, "prose display retrace");
+	if (info->command_done < 0 || info->retrace_sem < 0) {
+		status = info->command_done < 0 ? info->command_done : info->retrace_sem;
+		ERROR("creating semaphores failed: %s\n", strerror(status));
+		goto error;
+	}
+
+	{
+		size_t size = (sizeof(struct prds_shared_info) + B_PAGE_SIZE - 1) & ~(B_PAGE_SIZE - 1);
+		// Kernel-only here; the accelerant clones it read-only. (arm64 cannot express
+		// kernel-RW/user-RO in one mapping, so no user bits on the original.)
+		info->shared_area = create_area("prose display shared info", (void**)&info->shared,
+			B_ANY_KERNEL_ADDRESS, size, B_FULL_LOCK,
+			B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA | B_CLONEABLE_AREA);
+		if (info->shared_area < 0) {
+			status = info->shared_area;
+			ERROR("creating the shared info area failed: %s\n", strerror(status));
+			goto error;
+		}
+		memset(info->shared, 0, sizeof(*info->shared));
+		info->shared->pool_area = info->pool_area;
+		info->shared->pool_size = info->pool_size;
+		info->shared->max_width = info->config.max_width;
+		info->shared->max_height = info->config.max_height;
+		info->shared->pref_width = info->config.pref_width;
+		info->shared->pref_height = info->config.pref_height;
+		info->shared->refresh_mhz = info->config.refresh_mhz;
+		info->shared->stride_align = info->config.stride_align;
+		info->shared->retrace_sem = info->retrace_sem;
+	}
+
+	// This sets DRIVER_OK: from here on the device is live.
+	status = info->virtio->setup_interrupt(info->device, prds_config_callback, info);
+	if (status == B_OK)
+		status = info->virtio->queue_setup_interrupt(info->control_queue, prds_control_callback, info);
+	if (status == B_OK)
+		status = info->virtio->queue_setup_interrupt(info->event_queue, prds_event_callback, info);
+	if (status != B_OK) {
+		ERROR("interrupt setup failed: %s\n", strerror(status));
+		goto error;
+	}
+	for (uint32 i = 0; i < PRDS_EVENT_BUFFERS; i++)
+		prds_post_event_buffer(info, i);
+
+	status = prds_enable_events(info, PRDS_EVENT_MASK_VSYNC | PRDS_EVENT_MASK_MODE_HINT
+		| PRDS_EVENT_MASK_REDRAW);
+	if (status == B_OK)
+		status = prds_set_mode(info, info->config.pref_width, info->config.pref_height);
+	if (status != B_OK) {
+		ERROR("initial commands failed: %s\n", strerror(status));
+		goto error;
+	}
+
+#if PRDS_TEST_PATTERN
+	prds_draw_pattern(info);
+	status = prds_commit(info, NULL, 0);
+	if (status != B_OK)
+		goto error;
+	INFO("test pattern committed\n");
+	info->test_thread = spawn_kernel_thread(prds_test_thread, "prose display test",
+		B_NORMAL_PRIORITY, info);
+	if (info->test_thread >= 0)
+		resume_thread(info->test_thread);
+#endif
+
+	*_cookie = info;
+	return B_OK;
+
+error:
+	prds_teardown(info);
+	return status;
+}
+
+
+static void
+prds_uninit_driver(void* cookie)
+{
+	prds_teardown((prds_info*)cookie);
+}
