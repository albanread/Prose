diff --git a/src/add-ons/kernel/busses/virtio/virtio_pci/virtio_pci.cpp b/src/add-ons/kernel/busses/virtio/virtio_pci/virtio_pci.cpp
index 39d41e7429..111396858c 100644
--- a/src/add-ons/kernel/busses/virtio/virtio_pci/virtio_pci.cpp
+++ b/src/add-ons/kernel/busses/virtio/virtio_pci/virtio_pci.cpp
@@ -30,6 +30,7 @@
 #define CALLED(x...)		TRACE("CALLED %s\n", __PRETTY_FUNCTION__)
 
 
+#define VIRTIO_PCI_MAX_SHM 8
 #define VIRTIO_PCI_DEVICE_MODULE_NAME "busses/virtio/virtio_pci/driver_v1"
 #define VIRTIO_PCI_SIM_MODULE_NAME "busses/virtio/virtio_pci/device/v1"
 
@@ -68,6 +69,9 @@ typedef struct {
 	virtio_sim sim;
 	uint16 queue_count;
 	addr_t* notifyOffsets;
+	// HaikuArmQemu fork: shared memory regions by id; size 0 = none
+	phys_addr_t shmBase[VIRTIO_PCI_MAX_SHM];
+	uint64 shmSize[VIRTIO_PCI_MAX_SHM];
 
 	device_node* node;
 	pci_info info;
@@ -655,6 +659,18 @@ notify_queue(void* cookie, uint16 queue)
 }
 
 
+static status_t
+get_shared_memory(void* cookie, uint8 id, phys_addr_t* _base, uint64* _size)
+{
+	virtio_pci_sim_info* bus = (virtio_pci_sim_info*)cookie;
+	if (id >= VIRTIO_PCI_MAX_SHM || bus->shmSize[id] == 0)
+		return B_ENTRY_NOT_FOUND;
+	*_base = bus->shmBase[id];
+	*_size = bus->shmSize[id];
+	return B_OK;
+}
+
+
 //	#pragma mark -
 
 
@@ -764,6 +780,38 @@ init_bus(device_node* node, void** bus_cookie)
 		if (deviceCfgFound)
 			bus->base_addr = registers[deviceCap.bar] + deviceCap.offset;
 
+		// HaikuArmQemu fork: shared memory regions (capability type 8, 64-bit
+		// offset and length; the region id sits where legacy caps had padding).
+		uint8 capOffset;
+		if (pci->find_pci_capability(device, PCI_cap_id_vendspec, &capOffset) == B_OK) {
+			for (int guard = 0; capOffset != 0 && guard < 48; guard++) {
+				uint32 head = pci->read_pci_config(device, capOffset, 4);
+				uint8 next = (head >> 8) & 0xff;
+				if ((head & 0xff) == PCI_cap_id_vendspec
+					&& ((head >> 24) & 0xff) == VIRTIO_PCI_CAP_SHARED_MEMORY_CFG) {
+					uint32 word1 = pci->read_pci_config(device, capOffset + 4, 4);
+					uint8 bar = word1 & 0xff;
+					uint8 id = (word1 >> 8) & 0xff;
+					uint64 offset = pci->read_pci_config(device, capOffset + 8, 4)
+						| ((uint64)pci->read_pci_config(device, capOffset + 16, 4) << 32);
+					uint64 length = pci->read_pci_config(device, capOffset + 12, 4)
+						| ((uint64)pci->read_pci_config(device, capOffset + 20, 4) << 32);
+					if (bar < 6 && id < VIRTIO_PCI_MAX_SHM && length != 0) {
+						phys_addr_t barAddr = pciInfo->u.h0.base_registers[bar];
+						if ((pciInfo->u.h0.base_register_flags[bar] & PCI_address_type)
+								== PCI_address_type_64 && bar < 5) {
+							barAddr |= (uint64)pciInfo->u.h0.base_registers[bar + 1] << 32;
+						}
+						bus->shmBase[id] = barAddr + offset;
+						bus->shmSize[id] = length;
+						TRACE_ALWAYS("shared memory region %u: %#" B_PRIxPHYSADDR ", %" B_PRIu64
+							" bytes (bar %u)\n", id, bus->shmBase[id], length, bar);
+					}
+				}
+				capOffset = next;
+			}
+		}
+
 		// enable bus master and memory
 		uint16 pcicmd = pci->read_pci_config(device, PCI_command, 2);
 		pcicmd &= ~(PCI_command_int_disable | PCI_command_io);
@@ -1033,7 +1081,8 @@ static virtio_sim_interface gVirtioPCIDeviceModule = {
 	setup_queue,
 	setup_interrupt,
 	free_interrupt,
-	notify_queue
+	notify_queue,
+	get_shared_memory
 };
 
 
