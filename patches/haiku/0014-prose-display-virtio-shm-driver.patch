diff --git a/headers/private/graphics/prose_display/prose_display.h b/headers/private/graphics/prose_display/prose_display.h
new file mode 100644
index 0000000000..30bd14af57
--- /dev/null
+++ b/headers/private/graphics/prose_display/prose_display.h
@@ -0,0 +1,156 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * Prose Display (PRDS): the shared-surface display device. The wire protocol
+ * is specified in HaikuArmQemu/docs/s2-display-device.md; this header is the
+ * C view of it, shared by the kernel driver and the accelerant.
+ */
+#ifndef _PROSE_DISPLAY_H
+#define _PROSE_DISPLAY_H
+
+
+#include <SupportDefs.h>
+#include <Drivers.h>
+
+
+#define PRDS_VIRTIO_DEVICE_ID		63
+#define PRDS_MAGIC					0x53445250	/* "PRDS", little-endian */
+#define PRDS_VERSION				1
+
+#define PRDS_F_VSYNC				(1ULL << 0)
+#define PRDS_F_RESIZE				(1ULL << 1)
+#define PRDS_F_BLIT					(1ULL << 2)
+
+#define PRDS_FORMAT_B8G8R8X8		1
+#define PRDS_SHM_ALIGNMENT			16384
+#define PRDS_MAX_COMMIT_RECTS		64
+#define PRDS_EVENT_SIZE				32
+
+enum {
+	PRDS_CMD_SET_MODE			= 0x0100,
+	PRDS_CMD_COMMIT				= 0x0101,
+	PRDS_CMD_ENABLE_EVENTS		= 0x0102,
+	PRDS_CMD_GET_INFO			= 0x0103,
+
+	PRDS_RESP_OK				= 0x1000,
+	PRDS_RESP_ERR_INVALID		= 0x1100,
+	PRDS_RESP_ERR_UNSUPPORTED	= 0x1101,
+	PRDS_RESP_ERR_STATE			= 0x1102,
+	PRDS_RESP_ERR_BOUNDS		= 0x1103,
+
+	PRDS_EVT_VSYNC				= 0x2000,
+	PRDS_EVT_MODE_HINT			= 0x2001,
+	PRDS_EVT_REDRAW				= 0x2002,
+};
+
+enum {
+	PRDS_EVENT_MASK_VSYNC		= 1,
+	PRDS_EVENT_MASK_MODE_HINT	= 2,
+	PRDS_EVENT_MASK_REDRAW		= 4,
+};
+
+
+struct prds_config {
+	uint32	magic;
+	uint16	version;
+	uint16	flags;
+	uint32	max_width;
+	uint32	max_height;
+	uint32	pref_width;
+	uint32	pref_height;
+	uint32	refresh_mhz;
+	uint32	stride_align;
+	uint32	formats;
+	uint32	max_surfaces;
+	uint8	shm_region_id;
+	uint8	reserved0[3];
+	uint64	shm_size;
+	uint8	reserved1[12];
+} _PACKED;
+
+struct prds_hdr {
+	uint32	type;
+	uint32	flags;
+	uint64	seq;
+} _PACKED;
+
+struct prds_rect {
+	uint32	x;
+	uint32	y;
+	uint32	width;
+	uint32	height;
+} _PACKED;
+
+struct prds_set_mode {
+	struct prds_hdr	hdr;
+	uint32	surface_id;
+	uint32	width;
+	uint32	height;
+	uint32	stride;
+	uint32	format;
+	uint32	padding;
+	uint64	offset;
+} _PACKED;
+
+struct prds_commit {
+	struct prds_hdr	hdr;
+	uint32	surface_id;
+	uint32	rect_count;
+	struct prds_rect	rects[PRDS_MAX_COMMIT_RECTS];
+} _PACKED;
+
+struct prds_enable_events {
+	struct prds_hdr	hdr;
+	uint32	mask;
+	uint32	reserved;
+} _PACKED;
+
+struct prds_resp {
+	struct prds_hdr	hdr;
+} _PACKED;
+
+struct prds_event {
+	struct prds_hdr	hdr;
+	union {
+		struct {
+			uint64	timestamp_ns;
+			uint64	reserved;
+		} vsync;
+		struct {
+			uint32	width;
+			uint32	height;
+			uint64	reserved;
+		} mode_hint;
+		uint64	raw[2];
+	};
+} _PACKED;
+
+
+/* Shared with the accelerant (cloned area). */
+struct prds_shared_info {
+	area_id		pool_area;
+	uint64		pool_size;
+	uint32		max_width;
+	uint32		max_height;
+	uint32		pref_width;
+	uint32		pref_height;
+	uint32		refresh_mhz;
+	uint32		stride_align;
+	sem_id		retrace_sem;
+	uint32		mode_width;
+	uint32		mode_height;
+	uint32		mode_stride;
+	uint64		mode_offset;
+};
+
+/* ioctls (device_control), driver <-> accelerant */
+enum {
+	PRDS_GET_SHARED_INFO = B_DEVICE_OP_CODES_END + 1,	/* area_id* */
+	PRDS_SET_MODE,										/* prds_set_mode* (hdr ignored) */
+	PRDS_COMMIT,										/* prds_commit* (hdr ignored) */
+	PRDS_ENABLE_EVENTS,									/* uint32* mask */
+};
+
+
+#endif	/* _PROSE_DISPLAY_H */
diff --git a/headers/private/virtio/virtio.h b/headers/private/virtio/virtio.h
index 29a13a0af5..8a185d2abd 100644
--- a/headers/private/virtio/virtio.h
+++ b/headers/private/virtio/virtio.h
@@ -99,6 +99,10 @@ typedef struct {
 	status_t (*setup_interrupt)(void* cookie, uint16 queueCount);
 	status_t (*free_interrupt)(void* cookie);
 	void	(*notify_queue)(void* cookie, uint16 queue);
+	// HaikuArmQemu fork: virtio shared memory regions (virtio 1.2; PCI
+	// capability type 8). Returns B_ENTRY_NOT_FOUND if the device has none.
+	status_t (*get_shared_memory)(void* cookie, uint8 id, phys_addr_t* _base,
+		uint64* _size);
 } virtio_sim_interface;
 
 
@@ -147,6 +151,9 @@ typedef struct {
 	bool (*queue_dequeue)(virtio_queue queue, void** _cookie,
 		uint32* _usedLength);
 
+	// HaikuArmQemu fork: shared memory region <id> of the device, if any.
+	status_t (*get_shared_memory)(virtio_device cookie, uint8 id,
+		phys_addr_t* _base, uint64* _size);
 } virtio_device_interface;
 
 
diff --git a/src/add-ons/kernel/bus_managers/virtio/VirtioDevice.cpp b/src/add-ons/kernel/bus_managers/virtio/VirtioDevice.cpp
index 7cc9a2cd23..975614859c 100644
--- a/src/add-ons/kernel/bus_managers/virtio/VirtioDevice.cpp
+++ b/src/add-ons/kernel/bus_managers/virtio/VirtioDevice.cpp
@@ -338,3 +338,12 @@ VirtioDevice::_DumpFeatures(const char* title, uint64 features,
 	// HaikuArmQemu fork: always log, with the raw bits.
 	dprintf("virtio: %s: %#" B_PRIx64 " %s\n", title, features, features_string);
 }
+
+
+status_t
+VirtioDevice::GetSharedMemory(uint8 id, phys_addr_t* _base, uint64* _size)
+{
+	if (fController->get_shared_memory == NULL)
+		return B_NOT_SUPPORTED;
+	return fController->get_shared_memory(fCookie, id, _base, _size);
+}
diff --git a/src/add-ons/kernel/bus_managers/virtio/VirtioModule.cpp b/src/add-ons/kernel/bus_managers/virtio/VirtioModule.cpp
index 310e85ea71..d88e97b03f 100644
