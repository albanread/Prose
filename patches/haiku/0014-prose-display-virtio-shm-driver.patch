@@ -74,6 +74,16 @@ virtio_clear_feature(void* _device, uint64 feature)
 }
 
 
+status_t
+virtio_get_shared_memory(void* _device, uint8 id, phys_addr_t* _base, uint64* _size)
+{
+	CALLED();
+	VirtioDevice *device = (VirtioDevice *)_device;
+
+	return device->GetSharedMemory(id, _base, _size);
+}
+
+
 status_t
 virtio_read_device_config(void* _device, uint8 offset, void* buffer,
 		size_t bufferSize)
@@ -300,7 +310,8 @@ virtio_device_interface virtio_device_module = {
 	virtio_queue_is_full,
 	virtio_queue_is_empty,
 	virtio_queue_size,
-	virtio_queue_dequeue
+	virtio_queue_dequeue,
+	virtio_get_shared_memory
 };
 
 virtio_for_controller_interface virtio_for_controller_module = {
