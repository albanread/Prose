+static status_t
+prds_register_child_devices(void* cookie)
+{
+	prds_info* info = (prds_info*)cookie;
+	int32 id = sDeviceManager->create_id(PRDS_DEVICE_ID_GENERATOR);
+	if (id < 0)
+		return id;
+	info->id = id;
+	char name[64];
+	snprintf(name, sizeof(name), "graphics/prose_display/%" B_PRId32, id);
+	return sDeviceManager->publish_device(info->node, name, PRDS_DEVICE_MODULE_NAME);
+}
