+static status_t
+prds_control(void* cookie, uint32 op, void* buffer, size_t length)
+{
+	prds_info* info = (prds_info*)cookie;
+	switch (op) {
+		case PRDS_GET_SHARED_INFO:
+			return user_memcpy(buffer, &info->shared_area, sizeof(area_id));
+		case PRDS_ENABLE_EVENTS:
+		{
+			uint32 mask;
+			if (user_memcpy(&mask, buffer, sizeof(mask)) != B_OK)
+				return B_BAD_ADDRESS;
+			return prds_enable_events(info, mask);
+		}
+		case PRDS_SET_MODE:
+		{
+			struct prds_set_mode mode;
+			if (user_memcpy(&mode, buffer, sizeof(mode)) != B_OK)
+				return B_BAD_ADDRESS;
+			return prds_set_mode(info, mode.width, mode.height);
+		}
+		case PRDS_COMMIT:
+		{
+			struct prds_commit commit;
+			if (user_memcpy(&commit, buffer, sizeof(commit)) != B_OK)
+				return B_BAD_ADDRESS;
+			return prds_commit(info, commit.rects, commit.rect_count);
+		}
+	}
+	return B_DEV_INVALID_IOCTL;
+}
