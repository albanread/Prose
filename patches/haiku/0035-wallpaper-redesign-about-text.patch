diff --git a/src/apps/aboutsystem/AboutSystem.cpp b/src/apps/aboutsystem/AboutSystem.cpp
index 2b59c4e150..da4ff912a8 100644
--- a/src/apps/aboutsystem/AboutSystem.cpp
+++ b/src/apps/aboutsystem/AboutSystem.cpp
@@ -1546,6 +1546,25 @@ AboutView::_CreateCreditsView()
 		fCreditsView, B_WILL_DRAW | B_FRAME_EVENTS, false, true,
 		B_PLAIN_BORDER);
 
+	// PROSE fork: say plainly what this build is, and whose work it stands on,
+	// before any of Haiku's own credits.
+	BFont proseFont(be_bold_font);
+	proseFont.SetSize(proseFont.Size() + 4);
+
+	fCreditsView->SetFontAndColor(&proseFont, B_FONT_ALL, &fHaikuOrangeColor);
+	fCreditsView->Insert("PROSE\n");
+	fCreditsView->SetFontAndColor(be_plain_font, B_FONT_ALL, &fTextColor);
+	fCreditsView->Insert(B_TRANSLATE(
+		"An unofficial, experimental port of Haiku to Apple Silicon (arm64), "
+		"running under Apple's Virtualization.framework and QEMU. It is not "
+		"affiliated with, endorsed by, or supported by the Haiku project, and "
+		"nothing in this build should be reported to them as a Haiku bug.\n\n"
+		"Everything that makes this an operating system is Haiku's work. The "
+		"arm64 port, the kernel, the servers, the kits and the applications "
+		"are the work of the Haiku developers named below, who have carried "
+		"this system for decades. This fork only adds host integration for one "
+		"class of machine. Our gratitude and full credit go to them.\n\n"));
+
 	// Haiku copyright
 	BFont font(be_bold_font);
 	font.SetSize(font.Size() + 4);
