+/*!	Drops the cached pages of a file that changed on the host. Only call it
+	from a hook on the node's own vnode: its file cache must stay alive.
+	Only while no one here has the file open for writing: local writers own
+	the file until they close it. Pages that are mapped cannot be dropped (a
+	running program from the host, rebuilt there); the node then stays stale
+	and a later call tries again.
+*/
 static void
-invalidate_cache(Volume* volume, Node* node, off_t size)
+node_refresh_cache(Volume* volume, Node* node)
 {
-	TRACE("node %" B_PRIu64 " changed on the host, dropping its cache (size %" B_PRIdOFF
-		")\n", node->nodeid, size);
+	{
+		MutexLocker locker(node->lock);
+		if (!node->stale || node->writers > 0)
+			return;
+	}
+
+	// No space is reserved and nothing truncated while the pages go: a writer
+	// that opens meanwhile waits in write() until this is done.
+	MutexLocker refreshLocker(node->refreshLock);
+	{
+		MutexLocker locker(node->lock);
+		if (!node->stale || node->writers > 0)
+			return;
+	}
+
 	if (node->fileCache != NULL) {
-		file_cache_disable(node->fileCache);
-		file_cache_set_size(node->fileCache, size);
-		file_cache_enable(node->fileCache);
+		// writes back what is dirty (page I/O takes only the size lock,
+		// shared), then evicts every page
+		status_t status = file_cache_disable(node->fileCache);
+		if (status != B_OK) {
+			TRACE("node %" B_PRIu64 " changed on the host but its pages are in use (%s)\n",
+				node->nodeid, strerror(status));
+			return;
+		}
+	}
+
+	// the host's size now, after that write-back
+	fuse_attr attr;
+	status_t status = volume->GetAttr(node->nodeid, &attr);
+
+	off_t size;
+	{
+		WriteLocker sizeLocker(node->sizeLock);
+		{
+			MutexLocker locker(node->lock);
+			if (status == B_OK)
