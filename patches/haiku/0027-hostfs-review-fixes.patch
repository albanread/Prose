+			size = node->attr.size;
+			node->size = size;
+		}
+		if (node->fileCache != NULL)
+			file_cache_set_size(node->fileCache, size);
 	}
+	if (node->fileCache != NULL)
+		file_cache_enable(node->fileCache);
+
+	TRACE("node %" B_PRIu64 " changed on the host, cache dropped (size %" B_PRIdOFF ")\n",
+		node->nodeid, size);
 	notify_stat_changed(volume->ID(), volume->ParentOf(node), node->nodeid,
 		B_STAT_SIZE | B_STAT_MODIFICATION_TIME);
 }
