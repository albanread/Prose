 .../kernel/file_systems/hostfs/hostfs.h       |  14 +-
 .../file_systems/hostfs/kernel_interface.cpp  | 262 ++++++++++++------
 5 files changed, 222 insertions(+), 98 deletions(-)

diff --git a/src/add-ons/kernel/drivers/disk/virtual/virtio_fs/virtio_fs.cpp b/src/add-ons/kernel/drivers/disk/virtual/virtio_fs/virtio_fs.cpp
index b8f4b3b6e7..ff3162e3b0 100644
--- a/src/add-ons/kernel/drivers/disk/virtual/virtio_fs/virtio_fs.cpp
+++ b/src/add-ons/kernel/drivers/disk/virtual/virtio_fs/virtio_fs.cpp
@@ -147,12 +147,16 @@ virtio_fs_request_callback(void* driverCookie, void* cookie)
 }
 
 
+/*!	Copies between kernel buffers and the caller's: anything that is not a
+	kernel address (user memory, or garbage such as NULL from an ioctl) goes
+	through user_memcpy(), which fails cleanly instead of faulting.
+*/
 static status_t
 copy_between(void* to, const void* from, size_t size)
 {
 	if (size == 0)
 		return B_OK;
-	if (IS_USER_ADDRESS(to) || IS_USER_ADDRESS(from))
+	if (!IS_KERNEL_ADDRESS(to) || !IS_KERNEL_ADDRESS(from))
 		return user_memcpy(to, from, size);
 	memcpy(to, from, size);
 	return B_OK;
@@ -201,7 +205,7 @@ virtio_fs_do_request(void* cookie, virtio_fs_request* request)
 	const bool hiprio = request->out == NULL;
 
 	// headers live in the kernel; only the payloads may be in the calling team
-	if (IS_USER_ADDRESS(request->in) || (!hiprio && IS_USER_ADDRESS(request->out)))
+	if (!IS_KERNEL_ADDRESS(request->in) || (!hiprio && !IS_KERNEL_ADDRESS(request->out)))
 		return B_BAD_ADDRESS;
 	if (request->in_size < sizeof(fuse_in_prefix) || request->in_size > SLOT_IN_SIZE
 		|| request->in_data_size > SLOT_DATA_SIZE
@@ -261,14 +265,23 @@ virtio_fs_do_request(void* cookie, virtio_fs_request* request)
 
 	// The device owns the slot's buffers until it completes the request, so
 	// the wait is not interruptible. A slow host is reported, not abandoned.
-	bigtime_t start = system_time();
-	while (entry.Wait(B_RELATIVE_TIMEOUT, 10000000) == B_TIMED_OUT
+	// The bus manager re-enables the queue's interrupt without looking at the
+	// ring again, so a completion can arrive without one: a wait that takes
+	// long drains the queue itself.
+	const bigtime_t start = system_time();
+	bigtime_t nextReport = start + 10000000;
+	virtio_queue queue = hiprio ? info->hiprioQueue : info->requestQueue;
+	while (entry.Wait(B_RELATIVE_TIMEOUT, 20000) == B_TIMED_OUT
 		&& atomic_get(&slot->completed) == 0) {
-		ERROR("opcode %" B_PRIu32 " unique %" B_PRIu64 " still waiting after %" B_PRId64
-			" s\n", opcode, unique, (system_time() - start) / 1000000);
 		slot->completion.Add(&entry);
+		virtio_fs_queue_callback(info, queue);
 		if (atomic_get(&slot->completed) != 0)
 			break;
+		if (system_time() >= nextReport) {
+			ERROR("opcode %" B_PRIu32 " unique %" B_PRIu64 " still waiting after %" B_PRId64
+				" s\n", opcode, unique, (system_time() - start) / 1000000);
+			nextReport += 10000000;
+		}
 	}
 	atomic_add(&info->requests, 1);
 
@@ -621,7 +634,7 @@ virtio_fs_control(void* cookie, uint32 op, void* buffer, size_t length)
 			return B_OK;
 
 		case B_GET_ICON_NAME:
-			if (IS_USER_ADDRESS(buffer))
+			if (!IS_KERNEL_ADDRESS(buffer))
 				return user_strlcpy((char*)buffer, "devices/drive-harddisk", B_FILE_NAME_LENGTH);
 			strlcpy((char*)buffer, "devices/drive-harddisk", B_FILE_NAME_LENGTH);
 			return B_OK;
