+// MIDI devices' endpoints are named after their device files; the Prose MIDI
+// device plays on the Mac
+static BString
+EndpointLabel(const char* name)
+{
+	BString label(name);
+	if (label.FindFirst("midi/prose/") >= 0)
+		return BString(B_TRANSLATE("Mac (Prose MIDI)"));
+	if (label.StartsWith("/dev/midi/"))
+		label.Remove(0, 10);
+	return label;
+}
+
+
+static BString
+TimeString(bigtime_t time)
+{
+	int32 seconds = (int32)(time / 1000000);
+	BString string;
+	string.SetToFormat("%" B_PRId32 ":%02" B_PRId32, seconds / 60,
+		seconds % 60);
+	return string;
+}
