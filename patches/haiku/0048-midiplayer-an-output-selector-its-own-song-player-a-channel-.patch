diff --git a/src/apps/midiplayer/Song.cpp b/src/apps/midiplayer/Song.cpp
new file mode 100644
index 0000000000..4e2ed1833f
--- /dev/null
+++ b/src/apps/midiplayer/Song.cpp
@@ -0,0 +1,408 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "Song.h"
+
+#include <File.h>
+
+#include <algorithm>
+#include <string.h>
+
+
+// A MIDI file bigger than this is not a MIDI file
+static const off_t kMaxFileSize = 64 * 1024 * 1024;
+
+
+struct Song::RawEvent {
+	uint32		tick;
+	uint32		order;		// reading order: ties keep the file's order
+	uint32		tempo;		// != 0: a tempo change (microseconds per quarter
+							// note), which is not sent
+	SongEvent	event;
+};
+
+
+namespace {
+
+
+class Reader {
+public:
+	Reader(const uint8* data, size_t size)
+		:
+		fData(data),
+		fSize(size),
+		fPosition(0)
+	{
+	}
+
+	bool AtEnd() const { return fPosition >= fSize; }
+	size_t Remaining() const { return fSize - fPosition; }
+	const uint8* Here() const { return fData + fPosition; }
+
+	bool Byte(uint8& value)
+	{
+		if (fPosition >= fSize)
+			return false;
+		value = fData[fPosition++];
+		return true;
+	}
+
+	bool VariableLength(uint32& value)
+	{
+		value = 0;
+		for (int i = 0; i < 4; i++) {
+			uint8 byte;
+			if (!Byte(byte))
+				return false;
+			value = (value << 7) | (byte & 0x7f);
+			if ((byte & 0x80) == 0)
+				return true;
+		}
+		return false;
+	}
+
+	bool Skip(size_t count)
+	{
+		if (count > Remaining())
+			return false;
+		fPosition += count;
+		return true;
+	}
+
+private:
+	const uint8*	fData;
+	size_t			fSize;
+	size_t			fPosition;
+};
+
+
+uint32
+Big32(const uint8* p)
+{
+	return (uint32)p[0] << 24 | (uint32)p[1] << 16 | (uint32)p[2] << 8 | p[3];
+}
+
+
+uint16
+Big16(const uint8* p)
+{
+	return (uint16)(p[0] << 8 | p[1]);
+}
+
+
+bool
+IsUTF8(const uint8* text, size_t length)
+{
+	for (size_t i = 0; i < length;) {
+		uint8 c = text[i];
+		size_t more = c < 0x80 ? 0 : (c & 0xe0) == 0xc0 ? 1
+			: (c & 0xf0) == 0xe0 ? 2 : (c & 0xf8) == 0xf0 ? 3 : 4;
+		if (more == 4 || i + more >= length)
+			return false;
+		for (size_t j = 1; j <= more; j++) {
+			if ((text[i + j] & 0xc0) != 0x80)
+				return false;
+		}
+		i += more + 1;
+	}
+	return true;
+}
+
+
+// Text in MIDI files is ASCII, UTF-8 or (older files) Latin-1; BString
+// wants UTF-8
+BString
+TextFromMidi(const uint8* text, size_t length)
+{
+	size_t end = 0;
+	while (end < length && text[end] != 0)
+		end++;
+
+	BString result;
+	if (IsUTF8(text, end)) {
+		result.SetTo((const char*)text, end);
+	} else {
+		for (size_t i = 0; i < end; i++) {
+			uint8 c = text[i];
+			if (c < 0x80) {
+				result << (char)c;
+			} else {
+				char utf8[3] = { (char)(0xc0 | c >> 6),
+					(char)(0x80 | (c & 0x3f)), 0 };
+				result << utf8;
+			}
+		}
+	}
+	result.Trim();
+	return result;
+}
+
+
+}	// namespace
+
+
+Song::Song()
+	:
+	fDuration(0),
+	fUsedChannels(0)
+{
+	for (int32 i = 0; i < 16; i++)
+		fFirstProgram[i] = -1;
+}
+
+
+status_t
+Song::SetTo(const entry_ref& ref)
+{
+	BFile file(&ref, B_READ_ONLY);
+	status_t status = file.InitCheck();
+	if (status != B_OK)
+		return status;
+
+	off_t size;
+	status = file.GetSize(&size);
+	if (status != B_OK)
+		return status;
+	if (size <= 0 || size > kMaxFileSize)
+		return B_BAD_DATA;
+
+	std::vector<uint8> buffer(size);
+	ssize_t bytesRead = file.Read(&buffer[0], size);
+	if (bytesRead < 0)
+		return bytesRead;
+	if (bytesRead != size)
+		return B_IO_ERROR;
+
+	return SetTo(&buffer[0], size);
+}
+
+
+status_t
+Song::SetTo(const uint8* data, size_t size)
+{
+	fEvents.clear();
+	fData.clear();
+	fTitle = "";
+	fDuration = 0;
+	fUsedChannels = 0;
+	for (int32 i = 0; i < 16; i++)
+		fFirstProgram[i] = -1;
+
+	// RIFF MIDI ("RMID"): the Standard MIDI File is its "data" chunk
+	if (size >= 12 && memcmp(data, "RIFF", 4) == 0
+		&& memcmp(data + 8, "RMID", 4) == 0) {
+		size_t position = 12;
+		bool found = false;
+		while (position + 8 <= size) {
+			const uint8* chunk = data + position;
+			uint32 chunkSize = chunk[4] | chunk[5] << 8 | chunk[6] << 16
+				| (uint32)chunk[7] << 24;
+			if (memcmp(chunk, "data", 4) == 0) {
+				data = chunk + 8;
+				size = std::min((size_t)chunkSize, size - position - 8);
+				found = true;
+				break;
+			}
+			position += 8 + (size_t)chunkSize + (chunkSize & 1);
+		}
+		if (!found)
+			return B_BAD_DATA;
+	}
+
+	if (size < 14 || memcmp(data, "MThd", 4) != 0)
+		return B_BAD_DATA;
+	uint32 headerSize = Big32(data + 4);
+	if (headerSize < 6 || 8 + (size_t)headerSize > size)
+		return B_BAD_DATA;
+	uint16 format = Big16(data + 8);
+	uint16 trackCount = Big16(data + 10);
+	uint16 division = Big16(data + 12);
+	if (format > 2 || division == 0)
+		return B_BAD_DATA;
+
+	// all tracks, as they are in the file
+	std::vector<RawEvent> raw;
+	uint32 order = 0;
+	uint32 endTick = 0;
+	size_t position = 8 + headerSize;
+	uint16 track = 0;
+	while (track < trackCount && position + 8 <= size) {
+		const uint8* chunk = data + position;
+		size_t chunkSize = Big32(chunk + 4);
+		size_t available = size - position - 8;
+		// a chunk that claims more than the file has: read what there is
+		if (chunkSize > available)
+			chunkSize = available;
+		position += 8 + chunkSize;
+		if (memcmp(chunk, "MTrk", 4) != 0)
+			continue;
+			// unknown chunks are skipped, as the specification says
+		_ReadTrack(chunk + 8, chunkSize, track, raw, order, endTick);
+		track++;
+	}
+
+	// one list, in time order; at the same tick the file's order counts
+	std::stable_sort(raw.begin(), raw.end(),
+		[](const RawEvent& a, const RawEvent& b) {
+			return a.tick < b.tick
+				|| (a.tick == b.tick && a.order < b.order);
+		});
+
+	// ticks to microseconds, through the tempo changes
+	bool smpte = (division & 0x8000) != 0;
+	double smpteTickLength = 0;
+	if (smpte) {
+		int framesPerSecond = -(int8)(division >> 8);
+		int ticksPerFrame = division & 0xff;
+		if (framesPerSecond <= 0 || ticksPerFrame == 0)
+			return B_BAD_DATA;
+		smpteTickLength = 1000000.0 / ((framesPerSecond == 29
+			? 29.97 : framesPerSecond) * ticksPerFrame);
+	}
+
+	double time = 0;
+	uint32 lastTick = 0;
+	uint32 tempo = 500000;
+		// 120 beats per minute until the file says otherwise
+	fEvents.reserve(raw.size());
+	for (size_t i = 0; i < raw.size(); i++) {
+		RawEvent& event = raw[i];
+		time += (event.tick - lastTick)
+			* (smpte ? smpteTickLength : (double)tempo / division);
+		lastTick = event.tick;
+		if (event.tempo != 0) {
+			tempo = event.tempo;
+			continue;
+		}
+		event.event.time = (bigtime_t)time;
+		fEvents.push_back(event.event);
+
+		uint8 status = event.event.status;
+		if (status >= 0x80 && status < 0xF0) {
+			int32 channel = status & 0x0F;
+			if ((status & 0xF0) == 0x90 && event.event.data2 > 0)
+				fUsedChannels |= 1 << channel;
+			else if ((status & 0xF0) == 0xC0 && fFirstProgram[channel] < 0)
+				fFirstProgram[channel] = event.event.data1;
+		}
+	}
+	if (endTick > lastTick) {
+		time += (endTick - lastTick)
+			* (smpte ? smpteTickLength : (double)tempo / division);
+	}
+	fDuration = (bigtime_t)time;
+
+	return fEvents.empty() ? B_BAD_DATA : B_OK;
+}
+
+
+int32
+Song::IndexAt(bigtime_t time) const
+{
+	std::vector<SongEvent>::const_iterator found = std::lower_bound(
+		fEvents.begin(), fEvents.end(), time,
+		[](const SongEvent& event, bigtime_t value) {
+			return event.time < value;
+		});
+	return (int32)(found - fEvents.begin());
+}
+
+
+bool
+Song::_ReadTrack(const uint8* data, size_t size, uint16 track,
+	std::vector<RawEvent>& events, uint32& order, uint32& endTick)
+{
+	Reader reader(data, size);
+	uint32 tick = 0;
+	uint8 runningStatus = 0;
+
+	while (!reader.AtEnd()) {
+		uint32 delta;
+		uint8 status;
+		if (!reader.VariableLength(delta) || !reader.Byte(status))
+			break;
+		tick += delta;
+
+		RawEvent event = {};
+		event.tick = tick;
+
+		uint8 first = 0;
+		bool haveFirst = false;
+		if (status < 0x80) {
+			// running status: that was the first data byte
+			if (runningStatus == 0)
+				break;
+			first = status;
+			haveFirst = true;
+			status = runningStatus;
+		}
+
+		if (status < 0xF0) {
+			runningStatus = status;
+			uint8 data1 = first;
+			uint8 data2 = 0;
+			if (!haveFirst && !reader.Byte(data1))
+				break;
+			uint8 type = status & 0xF0;
+			if (type != 0xC0 && type != 0xD0 && !reader.Byte(data2))
+				break;
+			event.event.status = status;
+			event.event.data1 = data1 & 0x7f;
+			event.event.data2 = data2 & 0x7f;
+		} else if (status == 0xF0 || status == 0xF7) {
+			runningStatus = 0;
+			uint32 length;
+			if (!reader.VariableLength(length) || length > reader.Remaining())
+				break;
+			const uint8* body = reader.Here();
+			reader.Skip(length);
+			// "F0 <body> F7": SpraySystemExclusive() adds F0 and F7 itself;
+			// "F7 <bytes>" (an escape) is sent as it is
+			uint32 bodyLength = length;
+			if (status == 0xF0 && bodyLength > 0
+				&& body[bodyLength - 1] == 0xF7) {
+				bodyLength--;
+			}
+			event.event.status = status;
+			event.event.offset = (uint32)fData.size();
+			event.event.length = bodyLength;
+			fData.insert(fData.end(), body, body + bodyLength);
+		} else if (status == 0xFF) {
+			runningStatus = 0;
+			uint8 type;
+			uint32 length;
+			if (!reader.Byte(type) || !reader.VariableLength(length)
+				|| length > reader.Remaining()) {
+				break;
+			}
+			const uint8* body = reader.Here();
+			reader.Skip(length);
+			if (type == 0x2F)
+				break;
+					// end of track
+			if (type == 0x51 && length == 3) {
+				event.tempo = (uint32)body[0] << 16 | body[1] << 8 | body[2];
+				if (event.tempo == 0)
+					continue;
+			} else {
+				// the first track's name is the song's title
+				if (type == 0x03 && track == 0 && fTitle.IsEmpty())
+					fTitle = TextFromMidi(body, length);
+				continue;
+			}
+		} else {
+			// system common and real-time messages have no place in a file
+			break;
+		}
+
+		event.order = order++;
+		events.push_back(event);
+	}
+
+	if (tick > endTick)
+		endTick = tick;
+	return true;
+}
diff --git a/src/apps/midiplayer/Song.h b/src/apps/midiplayer/Song.h
new file mode 100644
index 0000000000..4c1ba2a69f
--- /dev/null
+++ b/src/apps/midiplayer/Song.h
@@ -0,0 +1,78 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * Song: a Standard MIDI File (format 0, 1 or 2, also in a RIFF "RMID"
+ * wrapper) read into one list of messages, each with its time from the start
+ * of the song in microseconds, following the file's tempo changes.
+ */
+#ifndef _SONG_H
+#define _SONG_H
+
+
+#include <String.h>
+#include <SupportDefs.h>
+
+#include <vector>
+
+
+struct entry_ref;
+
+
+struct SongEvent {
+	bigtime_t	time;
+	uint8		status;		// 0x80-0xEF: a channel message (data1, data2);
+							// 0xF0: a system exclusive, 0xF7: raw bytes,
+							// both with their body in Song::Data()
+	uint8		data1;
+	uint8		data2;
+	uint32		offset;
+	uint32		length;
+};
+
+
+class Song {
+public:
+								Song();
+
+			status_t			SetTo(const entry_ref& ref);
+			status_t			SetTo(const uint8* data, size_t size);
+
+			const BString&		Title() const { return fTitle; }
+			bigtime_t			Duration() const { return fDuration; }
+
+			int32				CountEvents() const
+									{ return (int32)fEvents.size(); }
+			const SongEvent&	EventAt(int32 index) const
+									{ return fEvents[index]; }
+			const uint8*		Data(const SongEvent& event) const
+									{ return &fData[event.offset]; }
+
+			// the first event at or after this time
+			int32				IndexAt(bigtime_t time) const;
+
+			// what the song plays on a channel: whether it has notes there,
+			// and its first program (-1 if it sets none)
+			bool				UsesChannel(int32 channel) const
+									{ return fUsedChannels & (1 << channel); }
+			int32				FirstProgram(int32 channel) const
+									{ return fFirstProgram[channel]; }
+
+private:
+			struct RawEvent;
+
+			bool				_ReadTrack(const uint8* data, size_t size,
+									uint16 track,
+									std::vector<RawEvent>& events,
+									uint32& order, uint32& endTick);
+
+			std::vector<SongEvent>	fEvents;
+			std::vector<uint8>		fData;
+			BString					fTitle;
+			bigtime_t				fDuration;
+			uint16					fUsedChannels;
+			int32					fFirstProgram[16];
+};
+
+
+#endif	// _SONG_H
diff --git a/src/apps/midiplayer/SongPlayer.cpp b/src/apps/midiplayer/SongPlayer.cpp
new file mode 100644
index 0000000000..4f33e36b86
--- /dev/null
+++ b/src/apps/midiplayer/SongPlayer.cpp
@@ -0,0 +1,599 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "SongPlayer.h"
+
+#include <Autolock.h>
+#include <MidiConsumer.h>
+#include <MidiProducer.h>
+
+#include <new>
+#include <string.h>
+
+#include "Song.h"
+
+
+// Messages due this close are sent now rather than slept for
+static const bigtime_t kEarly = 500;
+
+
+SongPlayer::SongPlayer(const BMessenger& target)
+	:
+	fLock("song player"),
+	fTarget(target),
+	fOutput(NULL),
+	fSong(NULL),
+	fQuit(false),
+	fPlaying(false),
+	fLoop(false),
+	fTempo(1.0f),
+	fVolume(1.0f),
+	fPosition(0),
+	fAnchorSongTime(0),
+	fAnchorRealTime(0),
+	fNext(0),
+	fUsedChannels(0)
+{
+	for (int32 i = 0; i < 16; i++) {
+		fSongVolume[i] = 100;
+		fProgram[i] = -1;
+		fNoteCount[i] = 0;
+		fVelocity[i] = 0;
+		fHeld[i] = 0;
+	}
+
+	fProducer = new BMidiLocalProducer("MidiPlayer");
+	fWakeSemaphore = create_sem(0, "song player wake");
+	fThread = spawn_thread(_ThreadEntry, "song player", B_URGENT_PRIORITY,
+		this);
+	if (fThread >= 0)
+		resume_thread(fThread);
+}
+
+
+SongPlayer::~SongPlayer()
+{
+	fLock.Lock();
+	fQuit = true;
+	if (fPlaying) {
+		fPlaying = false;
+		_SilenceLocked();
+	}
+	fLock.Unlock();
+		// (the owner disconnects an output that must not get this first)
+
+	_Wake();
+	if (fThread >= 0) {
+		status_t result;
+		wait_for_thread(fThread, &result);
+	}
+	delete_sem(fWakeSemaphore);
+
+	SetOutput(NULL);
+	fProducer->Release();
+	delete fSong;
+}
+
+
+void
+SongPlayer::SetSong(Song* song)
+{
+	BAutolock _(fLock);
+
+	if (fPlaying) {
+		fPlaying = false;
+		_SilenceLocked();
+	}
+	delete fSong;
+	fSong = song;
+	fPosition = 0;
+	fNext = 0;
+	_ReleaseHeld();
+
+	fUsedChannels = 0;
+	for (int32 i = 0; i < 16; i++) {
+		fNoteCount[i] = 0;
+		fVelocity[i] = 0;
+		fProgram[i] = song != NULL ? song->FirstProgram(i) : -1;
+		if (song != NULL && song->UsesChannel(i))
+			fUsedChannels |= 1 << i;
+	}
+	_Wake();
+}
+
+
+int32
+SongPlayer::Program(int32 channel) const
+{
+	return atomic_get((int32*)&fProgram[channel]);
+}
+
+
+int32
+SongPlayer::NoteCount(int32 channel) const
+{
+	return atomic_get((int32*)&fNoteCount[channel]);
+}
+
+
+int32
+SongPlayer::Velocity(int32 channel) const
+{
+	return atomic_get((int32*)&fVelocity[channel]);
+}
+
+
+int32
+SongPlayer::HeldNotes(int32 channel) const
+{
+	return atomic_get((int32*)&fHeld[channel]);
+}
+
+
+bool
+SongPlayer::UsesChannel(int32 channel) const
+{
+	return (atomic_get((int32*)&fUsedChannels) & (1 << channel)) != 0;
+}
+
+
+bool
+SongPlayer::HasSong()
+{
+	BAutolock _(fLock);
+	return fSong != NULL;
+}
+
+
+void
+SongPlayer::SetOutput(BMidiConsumer* consumer, bool silence)
+{
+	BAutolock _(fLock);
+
+	if (consumer == fOutput)
+		return;
+
+	if (fOutput != NULL) {
+		// the old output stops sounding
+		if (silence)
+			_SilenceLocked();
+		fProducer->Disconnect(fOutput);
+		fOutput->Release();
+	}
+
+	fOutput = consumer;
+	if (fOutput == NULL)
+		return;
+
+	fOutput->Acquire();
+	fProducer->Connect(fOutput);
+
+	// the new one gets the channels as the song has set them up so far
+	if (fSong != NULL && (fPlaying || fPosition > 0)) {
+		_ResetChannelsLocked();
+		_ChaseLocked(fPlaying ? fNext : fSong->IndexAt(fPosition));
+	}
+}
+
+
+void
+SongPlayer::Play()
+{
+	BAutolock _(fLock);
+
+	if (fPlaying || fSong == NULL)
+		return;
+	if (fPosition >= fSong->Duration())
+		fPosition = 0;
+
+	fPlaying = true;
+	_StartLocked();
+	_Wake();
+}
+
+
+void
+SongPlayer::Pause()
+{
+	BAutolock _(fLock);
+
+	if (!fPlaying)
+		return;
+	fPosition = _PositionLocked();
+	fPlaying = false;
+	_SilenceLocked();
+	_Wake();
+}
+
+
+void
+SongPlayer::Stop()
+{
+	BAutolock _(fLock);
+
+	if (fPlaying)
+		_SilenceLocked();
+	fPlaying = false;
+	fPosition = 0;
+	fNext = 0;
+	_Wake();
+}
+
+
+void
+SongPlayer::Seek(bigtime_t position)
+{
+	BAutolock _(fLock);
+
+	if (fSong == NULL)
+		return;
+	if (position < 0)
+		position = 0;
+	if (position > fSong->Duration())
+		position = fSong->Duration();
+
+	fPosition = position;
+	if (fPlaying) {
+		_SilenceLocked();
+		_StartLocked();
+		_Wake();
+	}
+}
+
+
+bool
+SongPlayer::IsPlaying()
+{
+	BAutolock _(fLock);
+	return fPlaying;
+}
+
+
+bigtime_t
+SongPlayer::Position()
+{
+	BAutolock _(fLock);
+	return _PositionLocked();
+}
+
+
+bigtime_t
+SongPlayer::Duration()
+{
+	BAutolock _(fLock);
+	return fSong != NULL ? fSong->Duration() : 0;
+}
+
+
+void
+SongPlayer::SetTempo(float factor)
+{
+	BAutolock _(fLock);
+
+	if (factor < 0.1f)
+		factor = 0.1f;
+	if (fPlaying) {
+		fAnchorSongTime = _PositionLocked();
+		fAnchorRealTime = system_time();
+	}
+	fTempo = factor;
+	_Wake();
+}
+
+
+void
+SongPlayer::SetLoop(bool loop)
+{
+	BAutolock _(fLock);
+	fLoop = loop;
+}
+
+
+void
+SongPlayer::SetVolume(float volume)
+{
+	BAutolock _(fLock);
+
+	if (volume < 0)
+		volume = 0;
+	if (volume > 1)
+		volume = 1;
+	fVolume = volume;
+
+	if (fOutput != NULL && fSong != NULL) {
+		bigtime_t now = system_time();
+		for (int32 channel = 0; channel < 16; channel++) {
+			fProducer->SprayControlChange(channel, 7,
+				_ScaledVolume(fSongVolume[channel]), now);
+		}
+	}
+}
+
+
+// #pragma mark - private
+
+
+status_t
+SongPlayer::_ThreadEntry(void* data)
+{
+	((SongPlayer*)data)->_Thread();
+	return B_OK;
+}
+
+
+void
+SongPlayer::_Thread()
+{
+	while (true) {
+		bigtime_t wakeAt = B_INFINITE_TIMEOUT;
+		bool ended = false;
+
+		fLock.Lock();
+		if (fQuit) {
+			fLock.Unlock();
+			break;
+		}
+
+		if (fPlaying && fSong != NULL) {
+			if (fNext >= fSong->CountEvents()) {
+				// the song ends at its length, which can be after its last
+				// message (a rest at the end)
+				bigtime_t end = fAnchorRealTime + (bigtime_t)(
+					(fSong->Duration() - fAnchorSongTime) / fTempo);
+				if (end > system_time() + kEarly) {
+					wakeAt = end;
+				} else if (fLoop) {
+					fPosition = 0;
+					_StartLocked();
+					fLock.Unlock();
+					continue;
+				} else {
+					fPlaying = false;
+					fPosition = fSong->Duration();
+					_SilenceLocked();
+					ended = true;
+				}
+			} else {
+				const SongEvent& event = fSong->EventAt(fNext);
+				bigtime_t due = fAnchorRealTime + (bigtime_t)(
+					(event.time - fAnchorSongTime) / fTempo);
+				if (due <= system_time() + kEarly) {
+					_SendLocked(event, due);
+					fNext++;
+					fLock.Unlock();
+					continue;
+				}
+				wakeAt = due;
+			}
+		}
+		fLock.Unlock();
+
+		// not while holding the lock: the window may be waiting for it
+		if (ended)
+			fTarget.SendMessage(MSG_SONG_ENDED);
+
+		acquire_sem_etc(fWakeSemaphore, 1, B_ABSOLUTE_TIMEOUT, wakeAt);
+	}
+}
+
+
+bigtime_t
+SongPlayer::_PositionLocked() const
+{
+	if (fSong == NULL)
+		return 0;
+	if (!fPlaying)
+		return fPosition;
+
+	bigtime_t position = fAnchorSongTime
+		+ (bigtime_t)((system_time() - fAnchorRealTime) * fTempo);
+	if (position < 0)
+		return 0;
+	if (position > fSong->Duration())
+		return fSong->Duration();
+	return position;
+}
+
+
+// Starts playing from fPosition: the channels are set up as the song had
+// them there (instruments, controllers), then the thread takes over
+void
+SongPlayer::_StartLocked()
+{
+	fAnchorSongTime = fPosition;
+	fAnchorRealTime = system_time();
+	fNext = fSong->IndexAt(fPosition);
+
+	_ResetChannelsLocked();
+	_ChaseLocked(fNext);
+}
+
+
+void
+SongPlayer::_ReleaseHeld()
+{
+	for (int32 channel = 0; channel < 16; channel++)
+		atomic_set(&fHeld[channel], 0);
+}
+
+
+void
+SongPlayer::_SilenceLocked()
+{
+	_ReleaseHeld();
+	if (fOutput == NULL)
+		return;
+
+	bigtime_t now = system_time();
+	for (int32 channel = 0; channel < 16; channel++) {
+		fProducer->SprayControlChange(channel, 64, 0, now);
+			// sustain off
+		fProducer->SprayControlChange(channel, 120, 0, now);
+			// all sound off
+		fProducer->SprayControlChange(channel, 123, 0, now);
+			// all notes off
+	}
+}
+
+
+// General MIDI defaults, so that a song that starts in the middle, or on an
+// output another song played through, does not inherit what came before
+void
+SongPlayer::_ResetChannelsLocked()
+{
+	_ReleaseHeld();
+	bigtime_t now = system_time();
+	for (int32 channel = 0; channel < 16; channel++) {
+		fSongVolume[channel] = 100;
+		fProgram[channel] = fSong != NULL ? fSong->FirstProgram(channel) : -1;
+		if (fOutput == NULL)
+			continue;
+		fProducer->SprayControlChange(channel, 121, 0, now);
+			// reset all controllers
+		fProducer->SprayControlChange(channel, 0, 0, now);
+		fProducer->SprayControlChange(channel, 32, 0, now);
+			// bank 0
+		fProducer->SprayProgramChange(channel, 0, now);
+		fProducer->SprayControlChange(channel, 7, _ScaledVolume(100), now);
+		fProducer->SprayControlChange(channel, 10, 64, now);
+			// pan: center
+	}
+}
+
+
+// What the song has set up by event upTo -- programs, controllers, pitch
+// bends, system exclusives -- sent without the notes. Of the programs,
+// controllers, pitch bends and channel pressures only the last of each
+// counts; the controllers that select and set RPN/NRPN parameters only work
+// in sequence, so they are all sent.
+void
+SongPlayer::_ChaseLocked(int32 upTo)
+{
+	if (fSong == NULL || fOutput == NULL || upTo <= 0)
+		return;
+
+	static const int32 kKeys = 16 * 128 + 3 * 16;
+	bool seen[kKeys];
+	memset(seen, 0, sizeof(seen));
+	bool* keep = new(std::nothrow) bool[upTo];
+	if (keep == NULL)
+		return;
+
+	for (int32 i = upTo - 1; i >= 0; i--) {
+		const SongEvent& event = fSong->EventAt(i);
+		keep[i] = false;
+		if (event.status >= 0xF0) {
+			keep[i] = true;
+			continue;
+		}
+
+		int32 channel = event.status & 0x0F;
+		int32 key;
+		switch (event.status & 0xF0) {
+			case 0xB0:
+				if (event.data1 == 6 || event.data1 == 38
+					|| (event.data1 >= 96 && event.data1 <= 101)) {
+					keep[i] = true;
+					continue;
+				}
+				if (event.data1 >= 120)
+					continue;
+						// channel mode messages
+				key = channel * 128 + event.data1;
+				break;
+			case 0xC0:
+				key = 16 * 128 + channel;
+				break;
+			case 0xD0:
+				key = 16 * 128 + 16 + channel;
+				break;
+			case 0xE0:
+				key = 16 * 128 + 32 + channel;
+				break;
+			default:
+				continue;
+					// notes and key pressure
+		}
+		if (!seen[key]) {
+			seen[key] = true;
+			keep[i] = true;
+		}
+	}
+
+	bigtime_t now = system_time();
+	for (int32 i = 0; i < upTo; i++) {
+		if (keep[i])
+			_SendLocked(fSong->EventAt(i), now);
+	}
+	delete[] keep;
+}
+
+
+void
+SongPlayer::_SendLocked(const SongEvent& event, bigtime_t when)
+{
+	uint8 status = event.status;
+	if (status == 0xF0) {
+		fProducer->SpraySystemExclusive((void*)fSong->Data(event),
+			event.length, when);
+		return;
+	}
+	if (status == 0xF7) {
+		fProducer->SprayData((void*)fSong->Data(event), event.length, false,
+			when);
+		return;
+	}
+
+	int32 channel = status & 0x0F;
+	uint8 data[3] = { status, event.data1, event.data2 };
+	size_t length = 3;
+
+	switch (status & 0xF0) {
+		case 0x90:
+			if (event.data2 > 0) {
+				fVelocity[channel] = event.data2;
+				atomic_add(&fNoteCount[channel], 1);
+				atomic_add(&fHeld[channel], 1);
+				break;
+			}
+			// a note-on with velocity 0 is a note-off
+		case 0x80:
+			if (atomic_add(&fHeld[channel], -1) <= 0)
+				atomic_set(&fHeld[channel], 0);
+			break;
+		case 0xB0:
+			if (event.data1 == 7) {
+				// channel volume: the song's, scaled by ours
+				fSongVolume[channel] = event.data2;
+				data[2] = _ScaledVolume(event.data2);
+			}
+			break;
+		case 0xC0:
+			fProgram[channel] = event.data1;
+			length = 2;
+			break;
+		case 0xD0:
+			length = 2;
+			break;
+	}
+
+	fProducer->SprayData(data, length, true, when);
+}
+
+
+uint8
+SongPlayer::_ScaledVolume(uint8 value) const
+{
+	int32 scaled = (int32)(value * fVolume + 0.5f);
+	return (uint8)(scaled > 127 ? 127 : scaled);
+}
+
+
+void
+SongPlayer::_Wake()
+{
+	release_sem(fWakeSemaphore);
+}
diff --git a/src/apps/midiplayer/SongPlayer.h b/src/apps/midiplayer/SongPlayer.h
new file mode 100644
index 0000000000..6fdd62a01c
--- /dev/null
+++ b/src/apps/midiplayer/SongPlayer.h
@@ -0,0 +1,113 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * SongPlayer: plays a Song through a Midi Kit 2 producer, so that any
+ * consumer can be the output -- the built-in synthesizer (SynthBridge), the
+ * Mac (the Prose MIDI device), a MIDI device, another application. One
+ * thread sends each message at its time; every command wakes it, so pause,
+ * stop, seek and the destructor take effect at once.
+ */
+#ifndef _SONG_PLAYER_H
+#define _SONG_PLAYER_H
+
+
+#include <Locker.h>
+#include <Messenger.h>
+#include <OS.h>
+
+
+class BMidiConsumer;
+class BMidiLocalProducer;
+class Song;
+struct SongEvent;
+
+
+enum {
+	MSG_SONG_ENDED = 'sEnd'
+};
+
+
+class SongPlayer {
+public:
+								SongPlayer(const BMessenger& target);
+								~SongPlayer();
+
+			// takes ownership; stops what was playing
+			void				SetSong(Song* song);
+			bool				HasSong();
+
+			// NULL: no output. The old output gets "all notes off" unless
+			// silence is false (the built-in synthesizer, when the
+			// application quits: it is about to go away)
+			void				SetOutput(BMidiConsumer* consumer,
+									bool silence = true);
+
+			void				Play();
+			void				Pause();
+			void				Stop();
+			void				Seek(bigtime_t position);
+
+			bool				IsPlaying();
+			bigtime_t			Position();
+			bigtime_t			Duration();
+
+			void				SetTempo(float factor);
+			void				SetLoop(bool loop);
+			void				SetVolume(float volume);
+
+			// for the channel view: read without locking
+			int32				Program(int32 channel) const;
+			int32				NoteCount(int32 channel) const;
