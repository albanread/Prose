+ * Distributed under the terms of the MIT License.
+ *
+ * ChannelView: the song's 16 MIDI channels, each with its instrument and a
+ * bar that lights up with the notes it plays. It shows what the player
+ * sends, so it works whatever the output is.
+ */
+#ifndef _CHANNEL_VIEW_H
+#define _CHANNEL_VIEW_H
+
+
+#include <String.h>
+#include <View.h>
+
+
+class SongPlayer;
+
+
+class ChannelView : public BView {
+public:
+								ChannelView(SongPlayer* player);
+
+	virtual	void				AttachedToWindow();
+	virtual	void				Draw(BRect updateRect);
+	virtual	void				Pulse();
+
+	virtual	BSize				MinSize();
+	virtual	BSize				MaxSize();
+	virtual	BSize				PreferredSize();
+
+			void				SetHasSong(bool hasSong);
+			void				SetEmptyText(const char* text);
+
+private:
+			BRect				_CellFrame(int32 channel) const;
+			void				_DrawCell(int32 channel);
+			void				_Measure();
+			BString				_Instrument(int32 channel) const;
+
+			SongPlayer*			fPlayer;
+			bool				fHasSong;
+			BString				fEmptyText;
+
+			float				fLevel[16];
+			int32				fSeenNotes[16];
+			int32				fShownProgram[16];
+			bool				fShownUsed[16];
+
+			float				fRowHeight;
+			float				fCellWidth;
+			float				fNumberWidth;
+			float				fTextBaseline;
+};
+
+
+#endif	// _CHANNEL_VIEW_H
