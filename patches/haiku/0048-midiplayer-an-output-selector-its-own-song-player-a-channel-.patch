+#define B_TRANSLATION_CONTEXT "Channel View"
+
+
+static const int32 kRows = 8;
+static const float kSpacing = 6;
+static const float kDecay = 0.80f;
+	// per pulse (25 a second), once a channel's notes have ended
+static const float kHeldDecay = 0.97f;
+static const float kHeldFloor = 0.55f;
+	// while notes sound: a slow fade, down to this part of their velocity
+
+static const rgb_color kBackground = { 30, 32, 36, 255 };
+static const rgb_color kTrack = { 48, 52, 60, 255 };
+static const rgb_color kText = { 228, 232, 238, 255 };
+static const rgb_color kDimText = { 112, 118, 128, 255 };
+
+
+// General MIDI level 1 instruments
+static const char* kInstruments[128] = {
+	"Acoustic Grand Piano", "Bright Acoustic Piano", "Electric Grand Piano",
+	"Honky-tonk Piano", "Electric Piano 1", "Electric Piano 2", "Harpsichord",
+	"Clavinet", "Celesta", "Glockenspiel", "Music Box", "Vibraphone",
+	"Marimba", "Xylophone", "Tubular Bells", "Dulcimer", "Drawbar Organ",
+	"Percussive Organ", "Rock Organ", "Church Organ", "Reed Organ",
+	"Accordion", "Harmonica", "Tango Accordion", "Nylon Guitar",
+	"Steel Guitar", "Jazz Guitar", "Clean Guitar", "Muted Guitar",
+	"Overdriven Guitar", "Distortion Guitar", "Guitar Harmonics",
+	"Acoustic Bass", "Fingered Bass", "Picked Bass", "Fretless Bass",
+	"Slap Bass 1", "Slap Bass 2", "Synth Bass 1", "Synth Bass 2", "Violin",
+	"Viola", "Cello", "Contrabass", "Tremolo Strings", "Pizzicato Strings",
+	"Orchestral Harp", "Timpani", "String Ensemble 1", "String Ensemble 2",
+	"Synth Strings 1", "Synth Strings 2", "Choir Aahs", "Voice Oohs",
+	"Synth Voice", "Orchestra Hit", "Trumpet", "Trombone", "Tuba",
+	"Muted Trumpet", "French Horn", "Brass Section", "Synth Brass 1",
+	"Synth Brass 2", "Soprano Sax", "Alto Sax", "Tenor Sax", "Baritone Sax",
+	"Oboe", "English Horn", "Bassoon", "Clarinet", "Piccolo", "Flute",
+	"Recorder", "Pan Flute", "Blown Bottle", "Shakuhachi", "Whistle",
+	"Ocarina", "Square Lead", "Sawtooth Lead", "Calliope Lead", "Chiff Lead",
+	"Charang Lead", "Voice Lead", "Fifths Lead", "Bass + Lead", "New Age Pad",
+	"Warm Pad", "Polysynth Pad", "Choir Pad", "Bowed Pad", "Metallic Pad",
+	"Halo Pad", "Sweep Pad", "Rain", "Soundtrack", "Crystal", "Atmosphere",
+	"Brightness", "Goblins", "Echoes", "Sci-fi", "Sitar", "Banjo",
+	"Shamisen", "Koto", "Kalimba", "Bagpipe", "Fiddle", "Shanai",
+	"Tinkle Bell", "Agogo", "Steel Drums", "Woodblock", "Taiko Drum",
+	"Melodic Tom", "Synth Drum", "Reverse Cymbal", "Guitar Fret Noise",
+	"Breath Noise", "Seashore", "Bird Tweet", "Telephone Ring", "Helicopter",
+	"Applause", "Gunshot"
+};
+
+
+static rgb_color
+ChannelColor(int32 channel)
+{
+	if (channel == 9) {
+		rgb_color drums = { 214, 150, 72, 255 };
+		return drums;
+	}
+	// hues around the circle, skipping the drums' orange
+	float hue = fmodf(channel * 360.0f / 15 + 200, 360) / 60;
+	float saturation = 0.50f;
+	float value = 0.86f;
+	int32 sector = (int32)hue;
+	float fraction = hue - sector;
+	float p = value * (1 - saturation);
+	float q = value * (1 - saturation * fraction);
+	float t = value * (1 - saturation * (1 - fraction));
+	float r, g, b;
+	switch (sector % 6) {
+		case 0: r = value; g = t; b = p; break;
+		case 1: r = q; g = value; b = p; break;
+		case 2: r = p; g = value; b = t; break;
+		case 3: r = p; g = q; b = value; break;
+		case 4: r = t; g = p; b = value; break;
+		default: r = value; g = p; b = q; break;
+	}
+	rgb_color color = { (uint8)(r * 255), (uint8)(g * 255), (uint8)(b * 255),
+		255 };
+	return color;
+}
+
+
+ChannelView::ChannelView(SongPlayer* player)
+	:
+	BView("channels", B_WILL_DRAW | B_PULSE_NEEDED | B_FRAME_EVENTS),
+	fPlayer(player),
+	fHasSong(false)
+{
+	for (int32 i = 0; i < 16; i++) {
+		fLevel[i] = 0;
+		fSeenNotes[i] = 0;
+		fShownProgram[i] = -2;
+		fShownUsed[i] = false;
+	}
+	SetViewColor(B_TRANSPARENT_COLOR);
+	SetLowColor(kBackground);
+
+	BFont font(be_plain_font);
+	font.SetSize(ceilf(font.Size() * 0.9f));
+	SetFont(&font);
+	_Measure();
+}
+
+
+void
+ChannelView::AttachedToWindow()
+{
+	BView::AttachedToWindow();
+	// the bars move 25 times a second
+	Window()->SetPulseRate(40000);
+}
+
+
+void
+ChannelView::Draw(BRect updateRect)
+{
+	SetHighColor(kBackground);
+	FillRect(updateRect);
+
+	if (!fHasSong) {
+		SetHighColor(kDimText);
+		SetLowColor(kBackground);
+		BRect bounds = Bounds();
+		float width = StringWidth(fEmptyText.String());
+		DrawString(fEmptyText.String(),
+			BPoint(floorf((bounds.Width() - width) / 2),
+				floorf(bounds.Height() / 2 + fTextBaseline / 2)));
+		return;
+	}
+
+	for (int32 channel = 0; channel < 16; channel++) {
+		if (_CellFrame(channel).Intersects(updateRect))
+			_DrawCell(channel);
+	}
+}
+
+
+void
+ChannelView::Pulse()
+{
+	if (!fHasSong || fPlayer == NULL)
+		return;
+
+	for (int32 channel = 0; channel < 16; channel++) {
+		float level = fLevel[channel];
+		int32 notes = fPlayer->NoteCount(channel);
+		float velocity = fPlayer->Velocity(channel);
+		if (notes != fSeenNotes[channel]) {
+			fSeenNotes[channel] = notes;
+			if (velocity > level)
+				level = velocity;
+		} else if (fPlayer->HeldNotes(channel) > 0) {
+			level *= kHeldDecay;
+			if (level < velocity * kHeldFloor)
+				level = velocity * kHeldFloor;
+		} else {
+			level *= kDecay;
+			if (level < 1)
+				level = 0;
+		}
+
+		int32 program = fPlayer->Program(channel);
+		bool used = fPlayer->UsesChannel(channel);
+		if ((int32)level != (int32)fLevel[channel]
+			|| program != fShownProgram[channel]
+			|| used != fShownUsed[channel]) {
+			fLevel[channel] = level;
+			Invalidate(_CellFrame(channel));
+		} else
+			fLevel[channel] = level;
+	}
+}
+
+
+BSize
+ChannelView::MinSize()
+{
+	return BSize(2 * fCellWidth + 3 * kSpacing,
+		kRows * fRowHeight + 2 * kSpacing);
+}
+
+
+BSize
+ChannelView::MaxSize()
+{
+	return BSize(B_SIZE_UNLIMITED, MinSize().height);
+}
+
+
+BSize
+ChannelView::PreferredSize()
+{
+	return MinSize();
+}
+
+
+void
+ChannelView::SetHasSong(bool hasSong)
+{
+	fHasSong = hasSong;
+	for (int32 i = 0; i < 16; i++) {
+		fLevel[i] = 0;
+		fSeenNotes[i] = fPlayer != NULL ? fPlayer->NoteCount(i) : 0;
+		fShownProgram[i] = -2;
+	}
+	Invalidate();
+}
+
+
+void
+ChannelView::SetEmptyText(const char* text)
+{
+	fEmptyText = text;
+	if (!fHasSong)
+		Invalidate();
+}
+
+
+// #pragma mark - private
+
+
+BRect
+ChannelView::_CellFrame(int32 channel) const
+{
+	float width = (Bounds().Width() - 3 * kSpacing) / 2;
+	float left = kSpacing + (channel / kRows) * (width + kSpacing);
+	float top = kSpacing + (channel % kRows) * fRowHeight;
+	return BRect(left, top, left + width, top + fRowHeight - 3);
+}
+
+
+void
+ChannelView::_DrawCell(int32 channel)
+{
+	BRect frame = _CellFrame(channel);
+	int32 program = fPlayer->Program(channel);
+	bool used = fPlayer->UsesChannel(channel);
+	fShownProgram[channel] = program;
+	fShownUsed[channel] = used;
+
+	SetHighColor(kBackground);
+	FillRect(frame);
+
+	// the channel number
+	char number[12];
+	snprintf(number, sizeof(number), "%" B_PRId32, channel + 1);
+	SetHighColor(used ? kText : kDimText);
+	SetLowColor(kBackground);
+	float numberWidth = StringWidth(number);
+	DrawString(number, BPoint(frame.left + fNumberWidth - numberWidth,
+		frame.top + fTextBaseline));
+
+	// the bar, and the instrument over it
+	BRect bar(frame.left + fNumberWidth + 6, frame.top, frame.right,
+		frame.bottom);
+	SetHighColor(kTrack);
+	FillRoundRect(bar, 3, 3);
+
+	float level = fLevel[channel] / 127;
+	if (level > 0) {
+		BRect fill = bar;
+		fill.right = bar.left + roundf(bar.Width() * level);
+		if (fill.right > fill.left + 1) {
+			rgb_color color = ChannelColor(channel);
+			SetHighColor(color);
+			FillRoundRect(fill, 3, 3);
+		}
+	}
+
+	BString label = used ? _Instrument(channel) : BString("–");
+	SetHighColor(used ? kText : kDimText);
+	SetDrawingMode(B_OP_OVER);
+	BFont font;
+	GetFont(&font);
+	font.TruncateString(&label, B_TRUNCATE_END, bar.Width() - 10);
+	DrawString(label.String(), BPoint(bar.left + 6,
+		frame.top + fTextBaseline));
+	SetDrawingMode(B_OP_COPY);
+}
+
+
+void
+ChannelView::_Measure()
+{
+	font_height height;
+	GetFontHeight(&height);
+	float textHeight = ceilf(height.ascent + height.descent);
+	fRowHeight = textHeight + 8;
+	fTextBaseline = floorf((fRowHeight - 3 - textHeight) / 2 + height.ascent);
+	fNumberWidth = StringWidth("16");
+	fCellWidth = ceilf(StringWidth("Acoustic Grand Piano") + fNumberWidth
+		+ 40);
+}
+
+
+BString
+ChannelView::_Instrument(int32 channel) const
+{
+	int32 program = fPlayer->Program(channel);
+	if (channel == 9) {
+		// on the percussion channel the program picks a drum kit
+		switch (program) {
+			case 8: return B_TRANSLATE("Drums (Room)");
+			case 16: return B_TRANSLATE("Drums (Power)");
+			case 24: return B_TRANSLATE("Drums (Electronic)");
+			case 25: return B_TRANSLATE("Drums (TR-808)");
+			case 32: return B_TRANSLATE("Drums (Jazz)");
+			case 40: return B_TRANSLATE("Drums (Brush)");
+			case 48: return B_TRANSLATE("Drums (Orchestra)");
+			case 56: return B_TRANSLATE("Drums (Sound effects)");
+			default: return B_TRANSLATE("Drums");
+		}
+	}
+	if (program < 0 || program > 127)
+		return kInstruments[0];
+			// what General MIDI plays without a program change
+	return kInstruments[program];
+}
