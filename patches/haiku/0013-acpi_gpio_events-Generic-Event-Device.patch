-			parse_aei, device);
 	if (status != B_OK) {
-		ERROR("reading _CRS/_AEI failed: %s\n", strerror(status));
+		ERROR("reading _CRS failed: %s\n", strerror(status));
 		goto error;
 	}
-	if (device->regs_base == 0 || device->irq == 0 || device->event_pins == 0) {
-		ERROR("nothing to do: registers %#" B_PRIxPHYSADDR ", irq %" B_PRIu32
-			", event pins %#x\n", device->regs_base, device->irq, device->event_pins);
+	if (device->irq == 0) {
+		ERROR("%s: no interrupt in _CRS\n", hid);
 		status = B_DEVICE_NOT_FOUND;
 		goto error;
 	}
