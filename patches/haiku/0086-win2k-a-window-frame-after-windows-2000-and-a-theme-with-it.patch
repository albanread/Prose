new file mode 100644
index 0000000000..e08dd8a344
--- /dev/null
+++ b/src/add-ons/decorators/Win2kDecorator/Win2kDecorator.h
@@ -0,0 +1,124 @@
+/*
+ * Copyright 2026, the Prose project.
+ * Distributed under the terms of the MIT License.
+ *
+ * Win2k: a window frame after the Windows 2000 classic appearance. A raised
+ * grey frame, and inside it a caption shaded from one colour to another with
+ * the title at its left in white and three raised buttons at its right --
+ * minimize, maximize (zoom) and, set apart, close -- that work on a window
+ * in the background too, as they did there. Document windows get a size
+ * grip in the corner the scroll bars leave.
+ *
+ * Pixel art in whole units, a unit being one pixel at the 12-point system
+ * font and two or more above it, as Platinum is. The colours come from the
+ * system: the frame and buttons are the panel colour (Windows' "3D objects"),
+ * the caption runs from the tab colour to the border colour -- the colour
+ * Windows called "gradient of the title bar" -- for the active and the
+ * inactive state, and the title is the tab text colour. A theme sets all of
+ * them; with a tab and border of one colour the caption is flat.
+ *
+ * The layout follows PlatinumDecorator: a bar over the frame on SATDecorator,
+ * stacked windows as slices, and the top border drawn as the bar's lower
+ * part, so every border stays as wide as BorderWidth() says.
+ */
+#ifndef WIN2K_DECORATOR_H
+#define WIN2K_DECORATOR_H
+
+
+#include "DecorManager.h"
+#include "SATDecorator.h"
+
+
+class Win2kDecorator : public SATDecorator {
+public:
+								Win2kDecorator(DesktopSettings& settings,
+									BRect frame, Desktop* desktop);
+	virtual						~Win2kDecorator();
+
+	virtual	Region				RegionAt(BPoint where, int32& tab) const;
+	virtual	void				ExtendDirtyRegion(Region region,
+									BRegion& dirty);
+	virtual	void				UpdateColors(DesktopSettings& settings);
+
+	virtual	void				Draw(BRect updateRect);
+	virtual	void				Draw();
+
+protected:
+	virtual	void				_DoLayout();
+
+	virtual	void				_DrawFrame(BRect invalid);
+	virtual	void				_DrawTab(Decorator::Tab* tab, BRect invalid);
+	virtual	void				_DrawTitle(Decorator::Tab* tab, BRect rect);
+	virtual	void				_DrawButtons(Decorator::Tab* tab,
+									const BRect& invalid);
+	virtual	void				_DrawClose(Decorator::Tab* tab, bool direct,
+									BRect rect);
+	virtual	void				_DrawZoom(Decorator::Tab* tab, bool direct,
+									BRect rect);
+	virtual	void				_DrawMinimize(Decorator::Tab* tab, bool direct,
+									BRect rect);
+
+	virtual	void				_SetTitle(Decorator::Tab* tab,
+									const char* string,
+									BRegion* updateRegion = NULL);
+	virtual	void				_SetFocus(Decorator::Tab* tab);
+	virtual	bool				_SetTabLocation(Decorator::Tab* tab,
+									float location, bool isShifting,
+									BRegion* updateRegion = NULL);
+	virtual	bool				_MoveTab(int32 from, int32 to, bool isMoving,
+									BRegion* updateRegion = NULL);
+
+	virtual	void				_MoveBy(BPoint offset);
+	virtual	void				_ResizeBy(BPoint offset, BRegion* dirty);
+
+	virtual	void				_GetFootprint(BRegion* region);
+
+private:
+			enum Button {
+				BUTTON_CLOSE,
+				BUTTON_ZOOM,
+				BUTTON_MINIMIZE
+			};
+
+			struct Palette {
+				rgb_color		face;
+				rgb_color		light;			// "3D light": the face
+				rgb_color		highlight;		// "3D highlight": white
+				rgb_color		shadow;
+				rgb_color		darkShadow;
+				rgb_color		glyph;
+				rgb_color		captionStart;
