+# Win2k
+# After Windows 2000's classic appearance: the Win2k frame, navy captions
+# shading to sky blue, 3D grey panels and menus, navy selections, and the
+# plain blue desktop with no picture.
+
+decorator = Win2kDecorator
+wallpaper = none
+
+# the window frame: the caption shades from the tab colour to the border
+# colour; the frame itself and its buttons are the panel colour
+window_tab = 10,36,106
+window_border = 166,202,240
+window_text = 255,255,255
+window_inactive_tab = 128,128,128
+window_inactive_border = 192,192,192
+window_inactive_text = 212,208,200
+
+# the desktop, shown with no picture, and under the icons' labels
+desktop = 58,110,165
+
+# panels, menus, documents, controls, lists
+panel_background = 212,208,200
+menu_background = 212,208,200
+navigation_base = 10,36,106
+menu_selected_background = 10,36,106
+menu_text = 0,0,0
+menu_selected_text = 255,255,255
+menu_selected_border = 10,36,106
+panel_text = 0,0,0
+document_background = 255,255,255
+document_text = 0,0,0
+control_background = 212,208,200
+control_text = 0,0,0
+control_border = 128,128,128
+control_highlight = 10,36,106
+navigation_pulse = 0,0,0
+shine = 255,255,255
+shadow = 0,0,0
+tooltip_background = 255,255,225
+tooltip_text = 0,0,0
+control_mark = 0,0,0
+list_background = 255,255,255
+list_selected_background = 10,36,106
+list_text = 0,0,0
+list_selected_text = 255,255,255
+scroll_bar_thumb = 212,208,200
+link_text = 0,0,255
+link_hover = 0,0,255
+link_visited = 128,0,128
+link_active = 255,0,0
+status_bar = 10,36,106
+success = 0,128,0
+failure = 255,0,0
