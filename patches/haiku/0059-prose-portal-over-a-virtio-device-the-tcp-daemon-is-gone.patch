diff --git a/headers/private/prose/prose_portal.h b/headers/private/prose/prose_portal.h
index aabb4ff31a..fd312f1f40 100644
--- a/headers/private/prose/prose_portal.h
+++ b/headers/private/prose/prose_portal.h
@@ -2,53 +2,65 @@
  * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
  * Distributed under the terms of the MIT License.
  *
- * The Prose Portal wire protocol: how the host asks the guest to do something
- * and hears what happened. docs/automation.md.
+ * The Prose Portal: how the host asks this machine to do something and hears
+ * what happened. docs/automation.md in HaikuArmQemu.
  *
- * Framed so it does not care what carries it. Today that is a TCP connection
- * on the host-only NAT bridge; a virtio device is the eventual home, and only
- * the read and write calls at either end change.
+ * The transport is a custom virtio device, ID 61, like the Prose MIDI port:
+ * queue 0 carries frames from the guest to the host, queue 1 brings requests
+ * from the host. The driver publishes it as /dev/misc/prose/portal/0, a
+ * datagram device: one read() returns one whole request, one write() sends one
+ * whole frame. Nothing is streamed and nothing has to be reassembled on the
+ * way in; the daemon never sees half a frame.
  *
- * Every frame is a 16-byte header and then its payload. A request carries an
- * id; its reply carries the same id, so a caller never has to assume replies
- * arrive in order.
+ * A request is one frame. A reply is one frame, except a RUN result, whose
+ * body -- stdout then stderr -- may be longer than a frame: it begins in the
+ * RESULT frame and continues in RESULT_MORE frames carrying the same id until
+ * out_length + error_length bytes have arrived.
  */
 #ifndef PROSE_PORTAL_H
 #define PROSE_PORTAL_H
 
 #include <SupportDefs.h>
 
-#define PROSE_PORTAL_MAGIC		'PRPT'
-#define PROSE_PORTAL_VERSION	1
-#define PROSE_PORTAL_PORT		7654
-#define PROSE_PORTAL_MAX		(8 * 1024 * 1024)
+#define PROSE_PORTAL_MAGIC			'PRPT'
+#define PROSE_PORTAL_VERSION		2		/* 1 was carried by TCP; gone */
+#define PROSE_PORTAL_VIRTIO_ID		61		/* 62 MIDI, 63 display; 64+ leaves the modern PCI ID range */
+#define PROSE_PORTAL_DEVICE			"/dev/misc/prose/portal/0"
+
+#define PROSE_PORTAL_REQUEST_SIZE	4096	/* host -> guest: one frame per buffer */
+#define PROSE_PORTAL_REPLY_SIZE		32768	/* guest -> host: one frame per buffer */
+#define PROSE_PORTAL_MAX_OUTPUT		(8 * 1024 * 1024)	/* a RUN body, across all its frames */
 
 enum {
-	// host -> guest
-	PROSE_PORTAL_PING		= 1,	// no payload
-	PROSE_PORTAL_RUN		= 2,	// the command line, UTF-8, no terminator
-	PROSE_PORTAL_INFO		= 3,	// no payload
-
-	// guest -> host
-	PROSE_PORTAL_HELLO		= 0x81,	// sent once, unasked, when the daemon starts
-	PROSE_PORTAL_PONG		= 0x82,
-	PROSE_PORTAL_RESULT		= 0x83,	// prose_portal_result, then stdout, then stderr
-	PROSE_PORTAL_INFO_REPLY	= 0x84,	// key=value lines, \n separated
-	PROSE_PORTAL_ERROR		= 0xFF	// a message, UTF-8
+	/* host -> guest */
+	PROSE_PORTAL_PING			= 1,	/* no payload */
+	PROSE_PORTAL_RUN			= 2,	/* a command line, UTF-8, no terminator */
+	PROSE_PORTAL_INFO			= 3,	/* no payload */
+
+	/* guest -> host */
+	PROSE_PORTAL_HELLO			= 0x81,	/* once, unasked, when the daemon has the device */
+	PROSE_PORTAL_PONG			= 0x82,
+	PROSE_PORTAL_RESULT			= 0x83,	/* prose_portal_result, then the start of the body */
+	PROSE_PORTAL_INFO_REPLY		= 0x84,	/* key=value lines, \n separated */
+	PROSE_PORTAL_RESULT_MORE	= 0x85,	/* the rest of a body, same id */
+	PROSE_PORTAL_ERROR			= 0xFF	/* a message, UTF-8 */
 };
 
 typedef struct {
 	uint32	magic;
 	uint16	version;
 	uint16	type;
-	uint32	id;
-	uint32	length;			// payload bytes following this header
+	uint32	id;				/* a reply carries the id of its request */
+	uint32	length;			/* payload bytes in this frame */
 } prose_portal_header;
 
+#define PROSE_PORTAL_RESULT_TRUNCATED	1	/* the body hit PROSE_PORTAL_MAX_OUTPUT */
+
 typedef struct {
-	int32	status;			// the command's exit status, or -1 if it could not run
-	uint32	out_length;
-	uint32	error_length;
+	int32	status;			/* the command's exit status, or -1 if it could not run */
+	uint32	out_length;		/* total, across frames */
+	uint32	error_length;	/* total, across frames */
+	uint32	flags;
 } prose_portal_result;
 
 #endif	/* PROSE_PORTAL_H */
