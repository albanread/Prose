diff --git a/src/add-ons/kernel/drivers/misc/prose_portal/prose_portal.cpp b/src/add-ons/kernel/drivers/misc/prose_portal/prose_portal.cpp
new file mode 100644
index 0000000000..5b758fe198
--- /dev/null
+++ b/src/add-ons/kernel/drivers/misc/prose_portal/prose_portal.cpp
@@ -0,0 +1,484 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * Prose Portal: the device through which the host asks this machine to do
+ * something (headers/private/prose/prose_portal.h). A custom virtio device,
+ * ID 61: queue 0 carries frames to the host, queue 1 brings requests from it.
+ *
+ * /dev/misc/prose/portal/0 is a datagram device. A read() returns one whole
+ * request frame -- never part of one, never two -- and a write() sends one
+ * whole frame of up to PROSE_PORTAL_REPLY_SIZE bytes. Buffers the daemon has
+ * not read yet stay with the driver, so the host can have at most BUFFER_COUNT
+ * requests outstanding: that is the flow control, and there is no other.
+ *
+ * Modelled on prose_midi, including where the module lives: under
+ * drivers/audio, because the device manager searches a virtio child's driver
+ * only when its node is registered, in the context of the /dev/<class> scan
+ * that triggered it, and for a multimedia-class device that is the /dev/audio
+ * (or, in this fork, /dev/midi or /dev/misc) scan. Where the device file is
+ * published does not depend on it.
+ */
+
+
+#include <KernelExport.h>
+#include <device_manager.h>
+#include <kernel.h>
+#include <lock.h>
+#include <util/AutoLock.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <virtio.h>
+#include <prose_portal.h>
+
+
+#define PRPT_DRIVER_MODULE_NAME		"drivers/audio/hmulti/prose_portal/driver_v1"
+#define PRPT_DEVICE_MODULE_NAME		"drivers/audio/hmulti/prose_portal/device_v1"
+#define PRPT_DEVICE_ID_GENERATOR	"prose_portal/device_id"
+
+#define INFO(x...)	dprintf("prose_portal: " x)
+#define ERROR(x...)	dprintf("prose_portal: " x)
+
+#define BUFFER_COUNT		8
+#define REPLY_SIZE			PROSE_PORTAL_REPLY_SIZE		// to the host
+#define REQUEST_SIZE		PROSE_PORTAL_REQUEST_SIZE	// from the host
+
+
+struct prpt_info {
+	device_node*				node;
+	int32						id;
+	char						name[64];
+	virtio_device				device;
+	virtio_device_interface*	virtio;
+	uint64						features;
+	virtio_queue				txQueue;		// to the host
+	virtio_queue				rxQueue;		// from the host
+
+	area_id						area;			// tx buffers then rx buffers, contiguous
+	uint8*						buffers;
+	phys_addr_t					phys;
+
+	// to the host: a free list of tx buffers
+	sem_id						txFree;
+	spinlock					lock;
+	uint32						txFreeList[BUFFER_COUNT];
+	uint32						txFreeHead;
+	uint32						txFreeTail;
+	mutex						txLock;
+
+	// from the host: completed rx buffers, each one whole request, in order
+	sem_id						rxAvailable;
+	uint32						rxIndex[BUFFER_COUNT];
+	uint32						rxLength[BUFFER_COUNT];
+	uint32						rxHead;
+	uint32						rxTail;
+	mutex						rxLock;
+
+	int32						openCount;
+	uint32						framesOut;
+	uint32						framesIn;
+};
+
+
+static device_manager_info* sDeviceManager;
+
+
+//	#pragma mark - queues
+
+
+static uint8*
+prpt_tx_buffer(prpt_info* info, uint32 index)
+{
+	return info->buffers + index * REPLY_SIZE;
+}
+
+
+static uint8*
+prpt_rx_buffer(prpt_info* info, uint32 index)
+{
+	return info->buffers + BUFFER_COUNT * REPLY_SIZE + index * REQUEST_SIZE;
+}
+
+
+static status_t
+prpt_post_rx(prpt_info* info, uint32 index)
+{
+	physical_entry entry = { info->phys + BUFFER_COUNT * REPLY_SIZE + index * REQUEST_SIZE,
+		REQUEST_SIZE };
+	return info->virtio->queue_request_v(info->rxQueue, &entry, 0, 1, (void*)(addr_t)(index + 1));
+}
+
+
+static void
+prpt_tx_callback(void* driverCookie, void* cookie)
+{
+	prpt_info* info = (prpt_info*)cookie;
+	void* tag;
+	while (info->virtio->queue_dequeue(info->txQueue, &tag, NULL)) {
+		uint32 index = (uint32)(addr_t)tag - 1;
+		if (index >= BUFFER_COUNT)
+			continue;
+		InterruptsSpinLocker locker(info->lock);
+		info->txFreeList[info->txFreeHead % BUFFER_COUNT] = index;
+		info->txFreeHead++;
+		locker.Unlock();
+		release_sem_etc(info->txFree, 1, B_DO_NOT_RESCHEDULE);
+	}
+}
+
+
+/*!	A request has arrived: keep the buffer until read() takes it. */
+static void
+prpt_rx_callback(void* driverCookie, void* cookie)
+{
+	prpt_info* info = (prpt_info*)cookie;
+	void* tag;
+	uint32 length;
+	while (info->virtio->queue_dequeue(info->rxQueue, &tag, &length)) {
+		uint32 index = (uint32)(addr_t)tag - 1;
+		if (index >= BUFFER_COUNT)
+			continue;
+		if (length > REQUEST_SIZE)
+			length = REQUEST_SIZE;
+		{
+			InterruptsSpinLocker locker(info->lock);
+			info->rxIndex[info->rxHead % BUFFER_COUNT] = index;
+			info->rxLength[info->rxHead % BUFFER_COUNT] = length;
+			info->rxHead++;
+		}
+		info->framesIn++;
+		release_sem_etc(info->rxAvailable, 1, B_DO_NOT_RESCHEDULE);
+	}
+}
+
+
+//	#pragma mark - driver
+
+
+static float
+prpt_supports_device(device_node* parent)
+{
+	const char* bus;
+	uint16 deviceType;
+	if (sDeviceManager->get_attr_string(parent, B_DEVICE_BUS, &bus, false) != B_OK
+		|| strcmp(bus, "virtio") != 0)
+		return 0.0f;
+	if (sDeviceManager->get_attr_uint16(parent, VIRTIO_DEVICE_TYPE_ITEM, &deviceType, true)
+			!= B_OK || deviceType != PROSE_PORTAL_VIRTIO_ID)
+		return 0.0f;
+	return 1.0f;
+}
+
+
+static status_t
+prpt_register_device(device_node* node)
+{
+	device_attr attrs[] = {
+		{ B_DEVICE_PRETTY_NAME, B_STRING_TYPE, { .string = "Prose Portal" }},
+		{ NULL }
+	};
+	return sDeviceManager->register_node(node, PRPT_DRIVER_MODULE_NAME, attrs, NULL, NULL);
+}
+
+
+static void
+prpt_teardown(prpt_info* info)
+{
+	if (info->virtio != NULL && info->txQueue != NULL)
+		info->virtio->free_interrupts(info->device);
+	if (info->txFree >= 0)
+		delete_sem(info->txFree);
+	if (info->rxAvailable >= 0)
+		delete_sem(info->rxAvailable);
+	if (info->area >= 0)
+		delete_area(info->area);
+	mutex_destroy(&info->txLock);
+	mutex_destroy(&info->rxLock);
+	free(info);
+}
+
+
+static status_t
+prpt_init_driver(device_node* node, void** _cookie)
+{
+	prpt_info* info = (prpt_info*)calloc(1, sizeof(prpt_info));
+	if (info == NULL)
+		return B_NO_MEMORY;
+	info->node = node;
+	info->area = -1;
+	info->txFree = -1;
+	info->rxAvailable = -1;
+	B_INITIALIZE_SPINLOCK(&info->lock);
+	mutex_init(&info->txLock, "prose_portal tx");
+	mutex_init(&info->rxLock, "prose_portal rx");
+
+	device_node* parent = sDeviceManager->get_parent_node(node);
+	sDeviceManager->get_driver(parent, (driver_module_info**)&info->virtio, (void**)&info->device);
+	sDeviceManager->put_node(parent);
+
+	status_t status = info->virtio->negotiate_features(info->device, 0, &info->features, NULL);
+	if (status != B_OK) {
+		ERROR("feature negotiation failed: %s\n", strerror(status));
+		goto error;
+	}
+
+	{
+		void* address;
+		size_t size = ROUNDUP(BUFFER_COUNT * (REPLY_SIZE + REQUEST_SIZE), B_PAGE_SIZE);
+		info->area = create_area("prose_portal buffers", &address, B_ANY_KERNEL_ADDRESS, size,
+			B_CONTIGUOUS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA);
+		if (info->area < 0) {
+			status = info->area;
+			goto error;
+		}
+		physical_entry entry;
+		status = get_memory_map(address, size, &entry, 1);
+		if (status != B_OK)
+			goto error;
+		info->buffers = (uint8*)address;
+		info->phys = entry.address;
+		memset(info->buffers, 0, size);
+	}
+	info->txFree = create_sem(BUFFER_COUNT, "prose_portal tx free");
+	info->rxAvailable = create_sem(0, "prose_portal rx");
+	if (info->txFree < 0 || info->rxAvailable < 0) {
+		status = B_NO_MEMORY;
+		goto error;
+	}
+	for (uint32 i = 0; i < BUFFER_COUNT; i++)
+		info->txFreeList[i] = i;
+	info->txFreeHead = BUFFER_COUNT;
+	info->txFreeTail = 0;
+
+	{
+		virtio_queue queues[2];
+		status = info->virtio->alloc_queues(info->device, 2, queues, NULL);
+		if (status != B_OK) {
+			ERROR("queue allocation failed: %s\n", strerror(status));
+			goto error;
+		}
+		info->txQueue = queues[0];
+		info->rxQueue = queues[1];
+	}
+	status = info->virtio->setup_interrupt(info->device, NULL, info);
+	if (status == B_OK)
+		status = info->virtio->queue_setup_interrupt(info->txQueue, prpt_tx_callback, info);
+	if (status == B_OK)
+		status = info->virtio->queue_setup_interrupt(info->rxQueue, prpt_rx_callback, info);
+	if (status != B_OK) {
+		ERROR("interrupt setup failed: %s\n", strerror(status));
+		goto error;
+	}
+	for (uint32 i = 0; i < BUFFER_COUNT; i++)
+		prpt_post_rx(info, i);
+
+	INFO("ready\n");
+	*_cookie = info;
+	return B_OK;
+
+error:
+	prpt_teardown(info);
+	return status;
+}
+
+
+static void
+prpt_uninit_driver(void* cookie)
+{
+	prpt_teardown((prpt_info*)cookie);
+}
+
+
+static status_t
+prpt_register_child_devices(void* cookie)
+{
+	prpt_info* info = (prpt_info*)cookie;
+	int32 id = sDeviceManager->create_id(PRPT_DEVICE_ID_GENERATOR);
+	if (id < 0)
+		return id;
+	info->id = id;
+	snprintf(info->name, sizeof(info->name), "misc/prose/portal/%" B_PRId32, id);
+	return sDeviceManager->publish_device(info->node, info->name, PRPT_DEVICE_MODULE_NAME);
+}
+
+
+//	#pragma mark - device
+
+
+static status_t
+prpt_init_device(void* driverCookie, void** _cookie)
+{
+	*_cookie = driverCookie;
+	return B_OK;
+}
+
+
+static void
+prpt_uninit_device(void* cookie)
+{
+}
+
+
+/*!	One opener: two daemons taking turns at the frames would each see half
+	of them. */
+static status_t
+prpt_open(void* deviceCookie, const char* path, int openMode, void** _cookie)
+{
+	prpt_info* info = (prpt_info*)deviceCookie;
+	if (atomic_add(&info->openCount, 1) != 0) {
+		atomic_add(&info->openCount, -1);
+		return B_BUSY;
+	}
+	*_cookie = info;
+	return B_OK;
+}
+
+
+static status_t
+prpt_close(void* cookie)
+{
+	return B_OK;
+}
+
+
+static status_t
+prpt_free(void* cookie)
+{
+	prpt_info* info = (prpt_info*)cookie;
+	atomic_add(&info->openCount, -1);
+	return B_OK;
+}
+
+
+/*!	One whole request from the host; blocks until there is one. A buffer
+	shorter than the request gets the request's start and the rest is lost,
+	so the daemon reads with PROSE_PORTAL_REQUEST_SIZE. */
+static status_t
+prpt_read(void* cookie, off_t position, void* buffer, size_t* _length)
+{
+	prpt_info* info = (prpt_info*)cookie;
+	status_t status = acquire_sem_etc(info->rxAvailable, 1, B_CAN_INTERRUPT, 0);
+	if (status != B_OK) {
+		*_length = 0;
+		return status;
+	}
+
+	MutexLocker locker(info->rxLock);
+	uint32 index, length;
+	{
+		InterruptsSpinLocker spin(info->lock);
+		index = info->rxIndex[info->rxTail % BUFFER_COUNT];
+		length = info->rxLength[info->rxTail % BUFFER_COUNT];
+		info->rxTail++;
+	}
+	size_t count = min_c((size_t)length, *_length);
+	status = user_memcpy(buffer, prpt_rx_buffer(info, index), count);
+	prpt_post_rx(info, index);		// the host may fill it again
+	if (status != B_OK) {
+		*_length = 0;
+		return B_BAD_ADDRESS;
+	}
+	*_length = count;
+	return B_OK;
+}
+
+
+/*!	One whole frame to the host, of up to REPLY_SIZE bytes. */
+static status_t
+prpt_write(void* cookie, off_t position, const void* buffer, size_t* _length)
+{
+	prpt_info* info = (prpt_info*)cookie;
+	if (*_length > REPLY_SIZE) {
+		*_length = 0;
+		return B_BAD_VALUE;
+	}
+	MutexLocker locker(info->txLock);
+	status_t status = acquire_sem_etc(info->txFree, 1, B_CAN_INTERRUPT, 0);
+	if (status != B_OK) {
+		*_length = 0;
+		return status;
+	}
+	uint32 index;
+	{
+		InterruptsSpinLocker spin(info->lock);
