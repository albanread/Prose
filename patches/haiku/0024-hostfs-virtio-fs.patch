+
+//	#pragma mark - directories
+
+
+static status_t
+hostfs_create_dir(fs_volume* _volume, fs_vnode* _parent, const char* name, int perms)
+{
+	Volume* volume = get_volume(_volume);
+	Node* parent = get_node(_parent);
+	if (volume->IsReadOnly())
+		return B_READ_ONLY_DEVICE;
+
+	fuse_mkdir_in in = {};
+	in.mode = perms & 07777;
+	fuse_entry_out entry;
+	status_t status = volume->Request(FUSE_MKDIR, parent->nodeid, &in, sizeof(in), name,
+		NULL, NULL, 0, &entry, sizeof(entry));
+	if (status != B_OK)
+		return status;
+
+	Node* node = volume->AcquireEntry(entry, parent->nodeid, name);
+	if (node != NULL) {
+		notify_entry_created(volume->ID(), parent->nodeid, name, node->nodeid);
+		volume->Unpend(node);
+	}
+	return B_OK;
+}
+
+
+static status_t
+hostfs_open_dir(fs_volume* _volume, fs_vnode* _node, void** _cookie)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	if (!node->IsDirectory())
+		return B_NOT_A_DIRECTORY;
+
+	DirCookie* cookie = new(std::nothrow) DirCookie;
+	if (cookie == NULL)
+		return B_NO_MEMORY;
+	memset(cookie, 0, sizeof(DirCookie));
+
+	status_t status = volume->Open(node->nodeid, true, LINUX_O_RDONLY, &cookie->fh);
+	if (status != B_OK) {
+		delete cookie;
+		return status;
+	}
+	*_cookie = cookie;
+	return B_OK;
+}
+
+
+static status_t
+hostfs_close_dir(fs_volume* _volume, fs_vnode* _node, void* _cookie)
+{
+	return B_OK;
+}
+
+
+static status_t
+hostfs_free_dir_cookie(fs_volume* _volume, fs_vnode* _node, void* _cookie)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	DirCookie* cookie = (DirCookie*)_cookie;
+
+	volume->Release(node->nodeid, true, cookie->fh);
+	free(cookie->buffer);
+	delete cookie;
+	return B_OK;
+}
+
+
+static status_t
+hostfs_read_dir(fs_volume* _volume, fs_vnode* _node, void* _cookie,
+	struct dirent* buffer, size_t bufferSize, uint32* _num)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	DirCookie* cookie = (DirCookie*)_cookie;
+
+	const uint32 maxCount = *_num;
+	uint32 count = 0;
+	uint8* out = (uint8*)buffer;
+	size_t space = bufferSize;
+
+	while (count < maxCount) {
+		if (cookie->position >= cookie->length) {
+			if (cookie->eof)
+				break;
+			if (cookie->buffer == NULL) {
+				cookie->buffer = (uint8*)malloc(DIR_BUFFER_SIZE);
+				if (cookie->buffer == NULL)
+					return B_NO_MEMORY;
+			}
+			fuse_read_in in = {};
+			in.fh = cookie->fh;
+			in.offset = cookie->offset;
+			in.size = DIR_BUFFER_SIZE;
+			size_t length = 0;
+			status_t status = volume->Request(FUSE_READDIR, node->nodeid, &in, sizeof(in),
+				NULL, NULL, NULL, 0, NULL, 0, cookie->buffer, DIR_BUFFER_SIZE, &length);
+			if (status != B_OK) {
+				if (count > 0)
+					break;
+				return status;
+			}
+			cookie->length = length;
+			cookie->position = 0;
+			if (length == 0) {
+				cookie->eof = true;
+				break;
+			}
+		}
+
+		const fuse_dirent* entry = (const fuse_dirent*)(cookie->buffer + cookie->position);
+		if (cookie->position + FUSE_NAME_OFFSET > cookie->length
+			|| cookie->position + FUSE_DIRENT_SIZE(entry) > cookie->length
+			|| entry->namelen == 0 || entry->namelen >= B_FILE_NAME_LENGTH) {
+			INFORM("malformed READDIR reply for node %" B_PRIu64 "\n", node->nodeid);
+			cookie->eof = true;
+			cookie->length = 0;
+			break;
+		}
+
+		const size_t recordLength = ROUNDUP(offsetof(struct dirent, d_name)
+			+ entry->namelen + 1, 8);
+		if (recordLength > space) {
+			if (count == 0)
+				return B_BUFFER_OVERFLOW;
+			break;
+		}
+
+		struct dirent* dirent = (struct dirent*)out;
+		dirent->d_dev = volume->ID();
+		dirent->d_pdev = volume->ID();
+		dirent->d_pino = node->nodeid;
+		memcpy(dirent->d_name, entry->name, entry->namelen);
+		dirent->d_name[entry->namelen] = '\0';
+		if (strcmp(dirent->d_name, ".") == 0)
+			dirent->d_ino = node->nodeid;
+		else if (strcmp(dirent->d_name, "..") == 0) {
+			uint64 parent = volume->ParentOf(node);
+			dirent->d_ino = parent != 0 ? parent : node->nodeid;
+		} else
+			dirent->d_ino = entry->ino;
+		dirent->d_reclen = recordLength;
+
+		out += recordLength;
+		space -= recordLength;
+		count++;
+		cookie->offset = entry->off;
+		cookie->position += FUSE_DIRENT_SIZE(entry);
+	}
+
+	*_num = count;
+	return B_OK;
+}
+
+
+static status_t
+hostfs_rewind_dir(fs_volume* _volume, fs_vnode* _node, void* _cookie)
+{
+	DirCookie* cookie = (DirCookie*)_cookie;
+	cookie->offset = 0;
+	cookie->length = 0;
+	cookie->position = 0;
+	cookie->eof = false;
+	return B_OK;
+}
