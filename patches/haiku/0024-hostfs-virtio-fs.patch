+
+//	#pragma mark - device: the pseudo-disk
+
+
+static status_t
+virtio_fs_init_device(void* driverCookie, void** _cookie)
+{
+	*_cookie = driverCookie;
+	return B_OK;
+}
+
+
+static void
+virtio_fs_uninit_device(void* cookie)
+{
+}
