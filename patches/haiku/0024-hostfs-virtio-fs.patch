+
+static status_t
+hostfs_read_fs_info(fs_volume* _volume, struct fs_info* info)
+{
+	Volume* volume = get_volume(_volume);
+
+	info->flags = B_FS_IS_PERSISTENT | B_FS_SUPPORTS_NODE_MONITORING;
+	if (volume->IsReadOnly())
+		info->flags |= B_FS_IS_READONLY;
+	info->block_size = 4096;
+	info->io_size = volume->MaxRead();
+	info->total_blocks = 0;
+	info->free_blocks = 0;
+	info->total_nodes = 0;
+	info->free_nodes = 0;
+	strlcpy(info->device_name, volume->DeviceName(), sizeof(info->device_name));
+	strlcpy(info->volume_name, volume->Name(), sizeof(info->volume_name));
+	strlcpy(info->fsh_name, HOSTFS_NAME, sizeof(info->fsh_name));
+
+	fuse_statfs_out out;
+	if (volume->Request(FUSE_STATFS, FUSE_ROOT_ID, NULL, 0, NULL, NULL, NULL, 0, &out,
+			sizeof(out)) == B_OK) {
+		uint32 blockSize = out.st.frsize != 0 ? out.st.frsize : out.st.bsize;
+		if (blockSize != 0) {
+			info->block_size = blockSize;
+			info->total_blocks = out.st.blocks;
+			info->free_blocks = out.st.bavail;
+		}
+		info->total_nodes = out.st.files;
+		info->free_nodes = out.st.ffree;
+	}
+	return B_OK;
+}
