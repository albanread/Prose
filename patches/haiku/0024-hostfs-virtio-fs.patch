+
+static status_t
+hostfs_get_vnode(fs_volume* _volume, ino_t id, fs_vnode* _node, int* _type,
+	uint32* _flags, bool reenter)
+{
+	Volume* volume = get_volume(_volume);
+
+	Node* node = volume->AcquireNode(id);
+	if (node == NULL) {
+		// Not in the table (asked for by ID, e.g. a node_ref): the host may
+		// still know it.
+		if ((volume->InitFlags() & FUSE_EXPORT_SUPPORT) == 0)
+			return B_ENTRY_NOT_FOUND;
+		fuse_entry_out entry;
+		if (volume->Lookup(id, ".", &entry) != B_OK)
+			return B_ENTRY_NOT_FOUND;
+		if (entry.nodeid != (uint64)id) {
+			volume->Forget(entry.nodeid, 1);
+			return B_ENTRY_NOT_FOUND;
+		}
+		node = volume->AcquireEntry(entry, 0, NULL);
+		if (node == NULL)
+			return B_NO_MEMORY;
+	}
+
+	if (node->IsFile() && node->fileCache == NULL) {
+		off_t size;
+		{
+			MutexLocker locker(node->lock);
+			size = node->size;
+		}
+		node->fileCache = file_cache_create(volume->ID(), id, size);
+	}
+
+	volume->Publish(node);
+	volume->Unpend(node);
+
+	_node->private_node = node;
+	_node->ops = &gHostFSVnodeOps;
+	*_type = node->type;
+	*_flags = 0;
+	return B_OK;
+}
+
+
+//	#pragma mark - vnodes
+
+
+static status_t
+hostfs_lookup(fs_volume* _volume, fs_vnode* _dir, const char* name, ino_t* _id)
+{
+	Volume* volume = get_volume(_volume);
+	Node* dir = get_node(_dir);
+	if (!dir->IsDirectory())
+		return B_NOT_A_DIRECTORY;
+
+	Node* node = NULL;
+	if (strcmp(name, ".") == 0) {
+		node = volume->AcquireNode(dir->nodeid);
+	} else if (strcmp(name, "..") == 0) {
+		node = volume->AcquireParent(dir);
+		if (node == NULL && (volume->InitFlags() & FUSE_EXPORT_SUPPORT) != 0) {
+			fuse_entry_out entry;
+			if (volume->Lookup(dir->nodeid, "..", &entry) == B_OK)
+				node = volume->AcquireEntry(entry, 0, NULL);
+		}
+	} else {
+		fuse_entry_out entry;
+		status_t status = volume->Lookup(dir->nodeid, name, &entry);
+		if (status != B_OK)
+			return status;
+		node = volume->AcquireEntry(entry, dir->nodeid, name);
+		if (node == NULL)
+			return B_NO_MEMORY;
+		node_update(volume, node, entry.attr);
+	}
+	if (node == NULL)
+		return B_ENTRY_NOT_FOUND;
+
+	void* privateNode;
+	status_t status = get_vnode(volume->FSVolume(), node->nodeid, &privateNode);
+	*_id = node->nodeid;
+	volume->Unpend(node);
+	return status;
+}
+
+
+static status_t
+hostfs_get_vnode_name(fs_volume* _volume, fs_vnode* _node, char* buffer,
+	size_t bufferSize)
+{
+	Node* node = get_node(_node);
+	if (node->name == NULL)
+		return B_ENTRY_NOT_FOUND;
+	// the name only changes under the volume lock, but a stale copy is fine
+	if (strlcpy(buffer, node->name, bufferSize) >= bufferSize)
+		return B_BUFFER_OVERFLOW;
+	return B_OK;
+}
+
+
+static status_t
+hostfs_put_vnode(fs_volume* _volume, fs_vnode* _node, bool reenter)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+
+	if (node->fileCache != NULL) {
+		file_cache_delete(node->fileCache);
+		node->fileCache = NULL;
+	}
+
+	uint64 fh = 0;
+	bool release = false;
+	{
+		MutexLocker locker(node->lock);
+		if (node->fhMode != -1) {
+			fh = node->fh;
+			node->fhMode = -1;
+			release = true;
+		}
+	}
+	if (release)
+		volume->Release(node->nodeid, false, fh);
+
+	volume->Unpublish(node);
+		// may forget and delete it
+	return B_OK;
+}
+
+
+static status_t
+hostfs_remove_vnode(fs_volume* _volume, fs_vnode* _node, bool reenter)
+{
+	return hostfs_put_vnode(_volume, _node, reenter);
+}
