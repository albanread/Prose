diff --git a/src/add-ons/kernel/file_systems/hostfs/hostfs.h b/src/add-ons/kernel/file_systems/hostfs/hostfs.h
new file mode 100644
index 0000000000..7927c50550
--- /dev/null
+++ b/src/add-ons/kernel/file_systems/hostfs/hostfs.h
@@ -0,0 +1,215 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * HostFS: a directory of the host (macOS) as a Haiku volume, through a
+ * virtio-fs device. hostfs is a FUSE client: every VFS operation becomes one or
+ * more FUSE requests, which the virtio_fs driver carries to the host.
+ *
+ * Nodes: the FUSE node ID is the vnode ID. The host counts how often it has
+ * handed a node ID out (lookups) and keeps the node until the client "forgets"
+ * those lookups again, so this file system keeps a table of every node ID it
+ * has been given and sends FUSE_FORGET when the VFS lets go of the vnode. A
+ * directory stays in the table while anything below it does, so ".." always
+ * resolves.
+ *
+ * Data: regular files go through the file cache (so mmap and executables
+ * work), with NFS-like close-to-open consistency: opening a file compares the
+ * host's size and modification time with what the cached pages were read
+ * with and drops them if the file changed on the host, and closing a file
+ * that was written writes the dirty pages back first.
+ */
+#ifndef HOSTFS_H
+#define HOSTFS_H
+
+
+#include <fs_cache.h>
+#include <fs_interface.h>
+#include <KernelExport.h>
+#include <lock.h>
+#include <util/OpenHashTable.h>
+
+#include <virtio_fs.h>
+
+#include "fuse_kernel.h"
+
+
+#define HOSTFS_MODULE_NAME		"file_systems/hostfs" B_CURRENT_FS_API_VERSION
+#define HOSTFS_NAME				"hostfs"
+#define HOSTFS_PRETTY_NAME		"HostFS"
+
+//#define TRACE_HOSTFS
+#ifdef TRACE_HOSTFS
+#	define TRACE(x...)			dprintf("hostfs: " x)
+#else
+#	define TRACE(x...)			do {} while (false)
+#endif
+#define INFORM(x...)			dprintf("hostfs: " x)
+
+// how long the host's attributes are trusted before they are asked for again
+#define HOSTFS_ATTR_TIMEOUT		1000000
+
+// the FUSE protocol minor this client speaks (the host may answer lower)
+#define HOSTFS_FUSE_MINOR		31
+
+
+class Volume;
+
+
+struct Node {
+								Node(Volume* volume, uint64 nodeid,
+									const fuse_attr& attr);
+								~Node();
+
+			bool				IsDirectory() const
+									{ return S_ISDIR(type); }
+			bool				IsFile() const
+									{ return S_ISREG(type); }
+			bool				IsSymlink() const
+									{ return S_ISLNK(type); }
+
+			Volume*				volume;
+			const uint64		nodeid;
+			const mode_t		type;		// S_IFMT bits; a node ID never
+											// changes type
+			Node*				hashLink;
+
+	// guarded by the volume lock
+			uint64				parent;		// directory last found in, 0: none
+			char*				name;		// the name it was found as
+			uint64				lookups;	// to be returned with FORGET
+			int32				pending;	// lookups on their way to
+											// get_vnode()
+			int32				children;	// table nodes with this parent
+			bool				published;	// the VFS has a vnode for it
+
+	// guarded by lock
+			mutex				lock;
+			fuse_attr			attr;
+			bigtime_t			attrTime;
+			off_t				size;		// the file cache's idea of the size
+			uint64				stampMtime;	// the host attributes the cached
+			uint32				stampMtimeNsec;	// pages belong to
+			uint64				stampSize;
+			void*				fileCache;
+			int32				opens;		// open file cookies
+			int32				writers;	// ... of them open for writing
+			uint64				fh;			// FUSE handle for page I/O
+			int					fhMode;		// -1: none, O_RDONLY or O_RDWR
+			int32				fhUsers;	// requests using fh right now
+			uint64				staleFh[4];	// replaced while in use
+			int32				staleFhCount;
+};
+
+
+struct NodeHashDefinition {
+	typedef uint64		KeyType;
+	typedef Node		ValueType;
+
+	size_t HashKey(uint64 key) const
+		{ return (size_t)(key ^ (key >> 32)); }
+	size_t Hash(Node* value) const
+		{ return HashKey(value->nodeid); }
+	bool Compare(uint64 key, Node* value) const
+		{ return value->nodeid == key; }
+	Node*& GetLink(Node* value) const
+		{ return value->hashLink; }
+};
+
+typedef BOpenHashTable<NodeHashDefinition> NodeTable;
+
+
+struct FileCookie {
+			int					openMode;
+};
+
+
+struct DirCookie {
+			uint64				fh;
+			uint64				offset;		// FUSE offset of the next entry
+			uint8*				buffer;		// the last READDIR reply
+			size_t				length;
+			size_t				position;
+			bool				eof;
+};
+
+
+class Volume {
+public:
+								Volume(fs_volume* fsVolume);
+								~Volume();
+
+			status_t			Mount(const char* device, uint32 flags,
+									const char* args);
+			void				Unmount();
+
+			dev_t				ID() const { return fFSVolume->id; }
+			fs_volume*			FSVolume() const { return fFSVolume; }
+			bool				IsReadOnly() const { return fReadOnly; }
+			const char*			Name() const { return fName; }
+			const char*			DeviceName() const { return fDeviceName; }
+			Node*				Root() const { return fRoot; }
+			size_t				MaxRead() const { return fMaxRead; }
+			size_t				MaxWrite() const { return fMaxWrite; }
+			uint32				Minor() const { return fMinor; }
+			uint32				InitFlags() const { return fInitFlags; }
+
+	// FUSE requests
+			status_t			Request(uint32 opcode, uint64 nodeid,
+									const void* args, size_t argsSize,
+									const char* name1, const char* name2,
+									const void* inData, size_t inDataSize,
+									void* reply, size_t replySize,
+									void* outData = NULL,
+									size_t outDataSize = 0,
+									size_t* _outDataLength = NULL);
+			status_t			GetAttr(uint64 nodeid, fuse_attr* attr);
+			status_t			Lookup(uint64 dir, const char* name,
+									fuse_entry_out* entry);
+			status_t			Open(uint64 nodeid, bool directory,
+									uint32 linuxFlags, uint64* _fh);
+			void				Release(uint64 nodeid, bool directory,
+									uint64 fh);
+			void				Forget(uint64 nodeid, uint64 lookups);
+
+	// the node table
+			Node*				AcquireEntry(const fuse_entry_out& entry,
+									uint64 parent, const char* name);
+			Node*				AcquireNode(uint64 nodeid);
+			Node*				AcquireParent(Node* node);
+			void				Unpend(Node* node);
+			void				Publish(Node* node);
+			void				Unpublish(Node* node);
+			void				Moved(Node* node, uint64 parent,
+									const char* name);
+			uint64				ParentOf(Node* node);
+			bool				IsPublished(Node* node);
+
+private:
+			Node*				_SetParent(Node* node, uint64 parent,
+									const char* name);
+			void				_Collect(Node* node, Node*& reclaimList);
+			void				_Reclaim(Node* reclaimList);
+
+private:
+			fs_volume*			fFSVolume;
+			int					fDevice;
+			virtio_fs_transport	fTransport;
+			mutex				fLock;
+			NodeTable			fNodes;
+			Node*				fRoot;
+			bool				fReadOnly;
+			uint32				fMinor;
+			uint32				fInitFlags;
+			size_t				fMaxRead;
+			size_t				fMaxWrite;
+			char				fName[B_FILE_NAME_LENGTH];
+			char				fDeviceName[B_PATH_NAME_LENGTH];
+};
+
+
+status_t	linux_to_haiku_error(int32 error, uint32 opcode);
+uint32		haiku_to_linux_open_flags(int openMode);
+
+
+#endif	// HOSTFS_H
diff --git a/src/add-ons/kernel/file_systems/hostfs/kernel_interface.cpp b/src/add-ons/kernel/file_systems/hostfs/kernel_interface.cpp
new file mode 100644
index 0000000000..ddcb283ce4
--- /dev/null
+++ b/src/add-ons/kernel/file_systems/hostfs/kernel_interface.cpp
@@ -0,0 +1,1598 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * HostFS: the VFS hooks. See hostfs.h for the model.
+ */
+
+
+#include "hostfs.h"
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <new>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <fs_info.h>
+#include <kernel.h>
+#include <NodeMonitor.h>
+#include <util/AutoLock.h>
+#include <AutoDeleter.h>
+
+
+#define DIR_BUFFER_SIZE		(16 * 1024)
+
+// Linux open(2) flags for the handles this file system opens itself
+#define LINUX_O_RDONLY		0
+#define LINUX_O_RDWR		00000002
+#define LINUX_O_CREAT		00000100
+#define LINUX_O_EXCL		00000200
+
+
+extern fs_volume_ops gHostFSVolumeOps;
+extern fs_vnode_ops gHostFSVnodeOps;
+
+
+static inline Volume*
+get_volume(fs_volume* volume)
+{
+	return (Volume*)volume->private_volume;
+}
+
+
+static inline Node*
+get_node(fs_vnode* vnode)
+{
+	return (Node*)vnode->private_node;
+}
+
+
+static inline bool
+is_writable(int openMode)
+{
+	return (openMode & O_RWMASK) != O_RDONLY;
+}
+
+
+//	#pragma mark - attributes and the cache
+
+
+/*!	Takes attributes the host just sent. Must be called with the node lock
+	held. Returns whether the file changed on the host since its pages were
+	cached; the caller then drops them with invalidate_cache(), without the
+	lock.
+*/
+static bool
+node_take_attr(Node* node, const fuse_attr& attr, off_t* _size)
+{
+	node->attr = attr;
+	node->attrTime = system_time();
+	if (!node->IsFile() || node->writers > 0) {
+		// open writers own the file's size until they close it
+		return false;
+	}
+	if (attr.mtime == node->stampMtime && attr.mtimensec == node->stampMtimeNsec
+		&& attr.size == node->stampSize) {
+		return false;
+	}
+	node->stampMtime = attr.mtime;
+	node->stampMtimeNsec = attr.mtimensec;
+	node->stampSize = attr.size;
+	node->size = attr.size;
+	*_size = attr.size;
+	return true;
+}
+
+
+/*!	The cached attributes describe the file as it is now (we just changed it
+	ourselves): the cached pages still belong to it.
+*/
+static void
+node_set_stamp(Node* node, const fuse_attr& attr)
+{
+	node->attr = attr;
+	node->attrTime = system_time();
+	node->stampMtime = attr.mtime;
+	node->stampMtimeNsec = attr.mtimensec;
+	node->stampSize = attr.size;
+}
+
+
+static void
+invalidate_cache(Volume* volume, Node* node, off_t size)
+{
+	TRACE("node %" B_PRIu64 " changed on the host, dropping its cache (size %" B_PRIdOFF
+		")\n", node->nodeid, size);
+	if (node->fileCache != NULL) {
+		file_cache_disable(node->fileCache);
+		file_cache_set_size(node->fileCache, size);
+		file_cache_enable(node->fileCache);
+	}
+	notify_stat_changed(volume->ID(), volume->ParentOf(node), node->nodeid,
+		B_STAT_SIZE | B_STAT_MODIFICATION_TIME);
+}
+
+
+/*!	Tells the VFS that the node is gone on the host (unlinked, or replaced by
+	a rename), if the VFS knows the node: it stops handing it out, and
+	remove_vnode() instead of put_vnode() ends it.
+*/
+static void
+node_removed(Volume* volume, Node* node)
+{
+	if (!volume->IsPublished(node))
+		return;
+	void* privateNode;
+	if (get_vnode(volume->FSVolume(), node->nodeid, &privateNode) != B_OK)
+		return;
+	remove_vnode(volume->FSVolume(), node->nodeid);
+	put_vnode(volume->FSVolume(), node->nodeid);
+}
+
+
+static void
+node_update(Volume* volume, Node* node, const fuse_attr& attr)
+{
+	off_t size;
+	bool invalidate;
+	{
+		MutexLocker locker(node->lock);
+		invalidate = node_take_attr(node, attr, &size);
+	}
+	if (invalidate)
+		invalidate_cache(volume, node, size);
+}
+
+
+/*!	Asks the host for the node's attributes when the cached ones are older
+	than HOSTFS_ATTR_TIMEOUT, or always if \a force.
+*/
+static status_t
+node_revalidate(Volume* volume, Node* node, bool force)
+{
+	if (!force) {
+		MutexLocker locker(node->lock);
+		if (system_time() - node->attrTime < HOSTFS_ATTR_TIMEOUT)
+			return B_OK;
+	}
+
+	fuse_attr attr;
+	status_t status = volume->GetAttr(node->nodeid, &attr);
+	if (status != B_OK)
+		return status;
+	node_update(volume, node, attr);
+	return B_OK;
+}
+
+
+//	#pragma mark - file handles
+
+
+/*!	Returns the FUSE handle page I/O goes through, opening the file on the
+	host if needed: read-write if the host lets us, so one handle serves both
+	directions. Balanced by node_put_fh().
+*/
+static status_t
+node_get_fh(Volume* volume, Node* node, bool write, uint64* _fh)
+{
+	MutexLocker locker(node->lock);
+	if (node->fhMode == O_RDWR || (node->fhMode == O_RDONLY && !write)) {
+		node->fhUsers++;
+		*_fh = node->fh;
+		return B_OK;
+	}
+	if (write && volume->IsReadOnly())
+		return B_READ_ONLY_DEVICE;
+
+	int mode = volume->IsReadOnly() ? O_RDONLY : O_RDWR;
+	uint64 fh;
+	status_t status = volume->Open(node->nodeid, false,
+		mode == O_RDWR ? LINUX_O_RDWR : LINUX_O_RDONLY, &fh);
+	if (status != B_OK && mode == O_RDWR && !write
+		&& (status == B_PERMISSION_DENIED || status == B_NOT_ALLOWED
+			|| status == B_READ_ONLY_DEVICE)) {
+		mode = O_RDONLY;
+		status = volume->Open(node->nodeid, false, LINUX_O_RDONLY, &fh);
+	}
+	if (status != B_OK)
+		return status;
+
+	bool releaseOld = false;
+	uint64 oldFh = node->fh;
+	if (node->fhMode != -1) {
+		// a read-only handle, replaced by a read-write one
+		if (node->fhUsers == 0 || node->staleFhCount == B_COUNT_OF(node->staleFh))
+			releaseOld = true;
+		else
+			node->staleFh[node->staleFhCount++] = oldFh;
+	}
+	node->fh = fh;
+	node->fhMode = mode;
+	node->fhUsers++;
+	*_fh = fh;
+	locker.Unlock();
+
+	if (releaseOld)
+		volume->Release(node->nodeid, false, oldFh);
+	return B_OK;
+}
+
+
+static void
+node_put_fh(Volume* volume, Node* node)
+{
+	uint64 release[B_COUNT_OF(node->staleFh) + 1];
+	int32 count = 0;
+	{
+		MutexLocker locker(node->lock);
+		node->fhUsers--;
+		if (node->fhUsers == 0) {
+			while (node->staleFhCount > 0)
+				release[count++] = node->staleFh[--node->staleFhCount];
+			if (node->opens == 0 && node->fhMode != -1) {
+				// nobody has the file open: don't keep the host file open
+				release[count++] = node->fh;
+				node->fhMode = -1;
+			}
+		}
+	}
+	for (int32 i = 0; i < count; i++)
+		volume->Release(node->nodeid, false, release[i]);
+}
+
+
+static status_t
+node_set_size(Volume* volume, Node* node, off_t size)
+{
+	off_t oldSize;
+	{
+		MutexLocker locker(node->lock);
+		oldSize = node->size;
+	}
+	// shrink the cache first, so that no page beyond the new end is written
+	// back afterwards
+	if (size < oldSize && node->fileCache != NULL)
+		file_cache_set_size(node->fileCache, size);
+
+	fuse_setattr_in in = {};
+	in.valid = FATTR_SIZE;
+	in.size = size;
+	fuse_attr_out out;
+	status_t status = volume->Request(FUSE_SETATTR, node->nodeid, &in, sizeof(in), NULL,
+		NULL, NULL, 0, &out, sizeof(out));
+	if (status != B_OK) {
+		if (size < oldSize && node->fileCache != NULL)
+			file_cache_set_size(node->fileCache, oldSize);
+		return status;
+	}
+
+	{
+		MutexLocker locker(node->lock);
+		node->size = size;
+		node_set_stamp(node, out.attr);
+	}
+	if (size > oldSize && node->fileCache != NULL)
+		file_cache_set_size(node->fileCache, size);
+
+	notify_stat_changed(volume->ID(), volume->ParentOf(node), node->nodeid,
+		B_STAT_SIZE | B_STAT_MODIFICATION_TIME);
+	return B_OK;
+}
+
+
+static void
+fill_stat(Volume* volume, Node* node, struct stat* st)
+{
+	// node lock held
+	const fuse_attr& attr = node->attr;
+	st->st_dev = volume->ID();
+	st->st_ino = node->nodeid;
+	st->st_mode = node->type | (attr.mode & ~S_IFMT);
+	st->st_nlink = attr.nlink;
+	st->st_uid = attr.uid;
+	st->st_gid = attr.gid;
+	st->st_size = node->IsFile() ? node->size : (off_t)attr.size;
+	st->st_rdev = attr.rdev;
+	st->st_blksize = attr.blksize != 0 ? attr.blksize : 4096;
+	st->st_blocks = attr.blocks;
+	st->st_atim.tv_sec = attr.atime;
+	st->st_atim.tv_nsec = attr.atimensec;
+	st->st_mtim.tv_sec = attr.mtime;
+	st->st_mtim.tv_nsec = attr.mtimensec;
+	st->st_ctim.tv_sec = attr.ctime;
+	st->st_ctim.tv_nsec = attr.ctimensec;
+	// FUSE has no birth time before statx; the change time is the best guess
+	st->st_crtim = st->st_ctim;
+	st->st_type = 0;
+}
