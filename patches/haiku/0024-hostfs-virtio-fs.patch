diff --git a/src/add-ons/kernel/drivers/disk/virtual/virtio_fs/virtio_fs.cpp b/src/add-ons/kernel/drivers/disk/virtual/virtio_fs/virtio_fs.cpp
new file mode 100644
index 0000000000..b8f4b3b6e7
--- /dev/null
+++ b/src/add-ons/kernel/drivers/disk/virtual/virtio_fs/virtio_fs.cpp
@@ -0,0 +1,692 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * virtio_fs: the transport half of HostFS (virtio 1.2 §5.11, device ID 26).
+ *
+ * A virtio-fs device speaks FUSE over two kinds of virtqueue: queue 0 carries
+ * the high-priority requests that get no reply (FORGET), queues 1..n carry
+ * everything else, each request being a device-readable fuse_in_header plus
+ * arguments followed by a device-writable fuse_out_header plus reply. On the
+ * Mac the device is Virtualization.framework's own, with Apple's FUSE server
+ * behind it.
+ *
+ * This driver only moves requests. It publishes the device as a small
+ * read-only pseudo-disk, /dev/disk/virtual/virtio_fs/<n>/raw, whose first
+ * block names the device (virtio_fs_disk_header), so that the disk device
+ * manager hands it to the hostfs file system like any other disk and it is
+ * mounted, unmounted and listed the way disks are. hostfs then asks for the
+ * transport (VIRTIO_FS_GET_TRANSPORT) and does the FUSE work.
+ *
+ * It is a boot module: the device manager probes mass-storage PCI devices
+ * once, in the /dev/disk scan at boot, when only boot modules can be loaded.
+ */
+
+
+#include <ByteOrder.h>
+#include <KernelExport.h>
+#include <Drivers.h>
+#include <device_manager.h>
+#include <kernel.h>
+#include <condition_variable.h>
+#include <lock.h>
+#include <util/AutoLock.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <virtio.h>
+#include <virtio_fs.h>
+
+
+#define VIRTIO_FS_DRIVER_MODULE_NAME	"drivers/disk/virtual/virtio_fs/driver_v1"
+#define VIRTIO_FS_DEVICE_MODULE_NAME	"drivers/disk/virtual/virtio_fs/device_v1"
+#define VIRTIO_FS_DEVICE_ID_GENERATOR	"virtio_fs/device_id"
+
+#define INFO(x...)	dprintf("virtio_fs: " x)
+#define ERROR(x...)	dprintf("virtio_fs: " x)
+
+// Requests in flight. Each owns a slot: a page for the device-readable header
+// and arguments, a page for the device-writable header and reply, and one data
+// buffer, used in whichever direction the request moves its payload.
+#define SLOT_COUNT			8
+#define SLOT_IN_SIZE		B_PAGE_SIZE
+#define SLOT_OUT_SIZE		B_PAGE_SIZE
+#define SLOT_DATA_SIZE		(128 * 1024)
+#define SLOT_SIZE			(SLOT_IN_SIZE + SLOT_OUT_SIZE + SLOT_DATA_SIZE)
+
+// the prefixes of FUSE's in and out headers this driver fills in and checks
+struct fuse_in_prefix {
+	uint32	len;
+	uint32	opcode;
+	uint64	unique;
+};
+
+struct fuse_out_prefix {
+	uint32	len;
+	int32	error;
+	uint64	unique;
+};
+
+
+struct virtio_fs_slot {
+	uint8*				in;
+	uint8*				out;
+	uint8*				data;
+	phys_addr_t			inPhys;
+	phys_addr_t			outPhys;
+	phys_addr_t			dataPhys;
+	ConditionVariable	completion;
+	uint32				usedLength;
+	int32				completed;
+};
+
+
+struct virtio_fs_info {
+	device_node*				node;
+	int32						id;
+	char						name[64];
+	virtio_device				device;
+	virtio_device_interface*	virtio;
+	uint64						features;
+	char						tag[VIRTIO_FS_TAG_LENGTH + 1];
+	uint32						requestQueues;
+	virtio_queue				hiprioQueue;
+	virtio_queue				requestQueue;
+
+	area_id						area;
+	virtio_fs_slot				slots[SLOT_COUNT];
+	sem_id						slotsFree;
+	spinlock					slotLock;
+	uint32						slotBusy;		// bitmap
+
+	int64						nextUnique;
+	virtio_fs_disk_header		header;
+	virtio_fs_transport			transport;
+
+	int32						requests;
+	int32						errors;
+};
+
+
+static device_manager_info* sDeviceManager;
+
+
+//	#pragma mark - requests
+
+
+static void
+virtio_fs_queue_callback(virtio_fs_info* info, virtio_queue queue)
+{
+	void* cookie;
+	uint32 usedLength;
+	while (info->virtio->queue_dequeue(queue, &cookie, &usedLength)) {
+		virtio_fs_slot* slot = (virtio_fs_slot*)cookie;
+		if (slot == NULL)
+			continue;
+		slot->usedLength = usedLength;
+		atomic_set(&slot->completed, 1);
+		slot->completion.NotifyAll();
+	}
+}
+
+
+static void
+virtio_fs_hiprio_callback(void* driverCookie, void* cookie)
+{
+	virtio_fs_info* info = (virtio_fs_info*)cookie;
+	virtio_fs_queue_callback(info, info->hiprioQueue);
+}
+
+
+static void
+virtio_fs_request_callback(void* driverCookie, void* cookie)
+{
+	virtio_fs_info* info = (virtio_fs_info*)cookie;
+	virtio_fs_queue_callback(info, info->requestQueue);
+}
+
+
+static status_t
+copy_between(void* to, const void* from, size_t size)
+{
+	if (size == 0)
+		return B_OK;
+	if (IS_USER_ADDRESS(to) || IS_USER_ADDRESS(from))
+		return user_memcpy(to, from, size);
+	memcpy(to, from, size);
+	return B_OK;
+}
+
+
+static virtio_fs_slot*
+virtio_fs_get_slot(virtio_fs_info* info)
+{
+	status_t status;
+	do {
+		status = acquire_sem(info->slotsFree);
+	} while (status == B_INTERRUPTED);
+	if (status != B_OK)
+		return NULL;
+
+	InterruptsSpinLocker locker(info->slotLock);
+	for (uint32 i = 0; i < SLOT_COUNT; i++) {
+		if ((info->slotBusy & (1u << i)) == 0) {
+			info->slotBusy |= 1u << i;
+			return &info->slots[i];
+		}
+	}
+	panic("virtio_fs: slot semaphore and bitmap disagree");
+	return NULL;
+}
+
+
+static void
+virtio_fs_put_slot(virtio_fs_info* info, virtio_fs_slot* slot)
+{
+	uint32 index = slot - info->slots;
+	{
+		InterruptsSpinLocker locker(info->slotLock);
+		info->slotBusy &= ~(1u << index);
+	}
+	release_sem(info->slotsFree);
+}
+
+
+/*!	Sends one FUSE request and waits for the device to complete it. */
+static status_t
+virtio_fs_do_request(void* cookie, virtio_fs_request* request)
+{
+	virtio_fs_info* info = (virtio_fs_info*)cookie;
+	const bool hiprio = request->out == NULL;
+
+	// headers live in the kernel; only the payloads may be in the calling team
+	if (IS_USER_ADDRESS(request->in) || (!hiprio && IS_USER_ADDRESS(request->out)))
+		return B_BAD_ADDRESS;
+	if (request->in_size < sizeof(fuse_in_prefix) || request->in_size > SLOT_IN_SIZE
+		|| request->in_data_size > SLOT_DATA_SIZE
+		|| request->out_data_size > SLOT_DATA_SIZE
+		|| (request->in_data_size > 0 && request->out_data_size > 0)
+		|| (!hiprio && (request->out_size < sizeof(fuse_out_prefix)
+			|| request->out_size > SLOT_OUT_SIZE))) {
+		return B_BAD_VALUE;
+	}
+	request->out_data_length = 0;
+
+	virtio_fs_slot* slot = virtio_fs_get_slot(info);
+	if (slot == NULL)
+		return B_ERROR;
+
+	status_t status = copy_between(slot->in, request->in, request->in_size);
+	if (status == B_OK)
+		status = copy_between(slot->data, request->in_data, request->in_data_size);
+	if (status != B_OK) {
+		virtio_fs_put_slot(info, slot);
+		return status;
+	}
+
+	fuse_in_prefix* inHeader = (fuse_in_prefix*)slot->in;
+	inHeader->len = request->in_size + request->in_data_size;
+	inHeader->unique = atomic_add64(&info->nextUnique, 2);
+		// even: FUSE marks interrupt requests with the low bit
+
+	physical_entry entries[4];
+	size_t readable = 0;
+	size_t writable = 0;
+	entries[readable++] = { slot->inPhys, request->in_size };
+	if (request->in_data_size > 0)
+		entries[readable++] = { slot->dataPhys, request->in_data_size };
+	if (!hiprio) {
+		memset(slot->out, 0, sizeof(fuse_out_prefix));
+		entries[readable + writable++] = { slot->outPhys, request->out_size };
+		if (request->out_data_size > 0)
+			entries[readable + writable++] = { slot->dataPhys, request->out_data_size };
+	}
+
+	const uint32 opcode = inHeader->opcode;
+	const uint64 unique = inHeader->unique;
+
+	ConditionVariableEntry entry;
+	atomic_set(&slot->completed, 0);
+	slot->completion.Add(&entry);
+
+	status = info->virtio->queue_request_v(hiprio ? info->hiprioQueue : info->requestQueue,
+		entries, readable, writable, slot);
+	if (status != B_OK) {
+		ERROR("queueing opcode %" B_PRIu32 " failed: %s\n", opcode, strerror(status));
+		virtio_fs_put_slot(info, slot);
+		return status;
+			// the entry leaves the variable in its destructor
+	}
+
+	// The device owns the slot's buffers until it completes the request, so
+	// the wait is not interruptible. A slow host is reported, not abandoned.
+	bigtime_t start = system_time();
+	while (entry.Wait(B_RELATIVE_TIMEOUT, 10000000) == B_TIMED_OUT
+		&& atomic_get(&slot->completed) == 0) {
+		ERROR("opcode %" B_PRIu32 " unique %" B_PRIu64 " still waiting after %" B_PRId64
+			" s\n", opcode, unique, (system_time() - start) / 1000000);
+		slot->completion.Add(&entry);
+		if (atomic_get(&slot->completed) != 0)
+			break;
+	}
+	atomic_add(&info->requests, 1);
+
+	if (hiprio) {
+		virtio_fs_put_slot(info, slot);
+		return B_OK;
+	}
+
+	// The device wrote usedLength bytes: the out buffer first, then the data
+	// buffer.
+	const fuse_out_prefix* outHeader = (const fuse_out_prefix*)slot->out;
+	uint32 used = slot->usedLength;
+	if (used < sizeof(fuse_out_prefix) || outHeader->unique != unique) {
+		ERROR("opcode %" B_PRIu32 ": bad reply (used %" B_PRIu32 ", unique %" B_PRIu64
+			" for %" B_PRIu64 ")\n", opcode, used, outHeader->unique, unique);
+		atomic_add(&info->errors, 1);
+		virtio_fs_put_slot(info, slot);
+		return B_IO_ERROR;
+	}
+	if (outHeader->len < used)
+		used = outHeader->len;
+
+	// a shorter reply (an error, or an older protocol minor) leaves the rest
+	// of the reply zeroed
+	size_t outLength = min_c((size_t)used, request->out_size);
+	memcpy(request->out, slot->out, outLength);
+	memset((uint8*)request->out + outLength, 0, request->out_size - outLength);
+	if (used > request->out_size && request->out_data_size > 0) {
+		size_t dataLength = min_c((size_t)used - request->out_size, request->out_data_size);
+		status = copy_between(request->out_data, slot->data, dataLength);
+		if (status == B_OK)
+			request->out_data_length = dataLength;
+	}
+
+	virtio_fs_put_slot(info, slot);
+	return status;
+}
+
+
+//	#pragma mark - driver
+
+
+static float
+virtio_fs_supports_device(device_node* parent)
+{
+	const char* bus;
+	uint16 deviceType;
+	if (sDeviceManager->get_attr_string(parent, B_DEVICE_BUS, &bus, false) != B_OK
+		|| strcmp(bus, "virtio") != 0)
+		return 0.0f;
+	if (sDeviceManager->get_attr_uint16(parent, VIRTIO_DEVICE_TYPE_ITEM, &deviceType, true)
+			!= B_OK || deviceType != VIRTIO_DEVICE_ID_FS)
+		return 0.0f;
+	return 1.0f;
+}
+
+
+static status_t
+virtio_fs_register_device(device_node* node)
+{
+	device_attr attrs[] = {
+		{ B_DEVICE_PRETTY_NAME, B_STRING_TYPE, { .string = "Virtio file system (HostFS)" }},
+		{ NULL }
+	};
+	return sDeviceManager->register_node(node, VIRTIO_FS_DRIVER_MODULE_NAME, attrs, NULL,
+		NULL);
+}
+
+
+static void
+virtio_fs_teardown(virtio_fs_info* info)
+{
+	if (info->virtio != NULL && info->requestQueue != NULL)
+		info->virtio->free_interrupts(info->device);
+	if (info->virtio != NULL && info->hiprioQueue != NULL)
+		info->virtio->free_queues(info->device);
+	if (info->slotsFree >= 0)
+		delete_sem(info->slotsFree);
+	if (info->area >= 0)
+		delete_area(info->area);
+	free(info);
+}
+
+
+static status_t
+virtio_fs_init_driver(device_node* node, void** _cookie)
+{
+	virtio_fs_info* info = (virtio_fs_info*)calloc(1, sizeof(virtio_fs_info));
+	if (info == NULL)
+		return B_NO_MEMORY;
+	info->node = node;
+	info->area = -1;
+	info->slotsFree = -1;
+	info->nextUnique = 2;
+	B_INITIALIZE_SPINLOCK(&info->slotLock);
+
+	device_node* parent = sDeviceManager->get_parent_node(node);
+	sDeviceManager->get_driver(parent, (driver_module_info**)&info->virtio,
+		(void**)&info->device);
+	sDeviceManager->put_node(parent);
+
+	// No optional features: the notification queue (VIRTIO_FS_F_NOTIFICATION)
+	// would carry host-side invalidations, which hostfs does not use yet.
+	status_t status = info->virtio->negotiate_features(info->device, 0, &info->features,
+		NULL);
+	if (status != B_OK) {
+		ERROR("feature negotiation failed: %s\n", strerror(status));
+		virtio_fs_teardown(info);
+		return status;
+	}
+
+	// virtio_fs_config: char tag[36], le32 num_request_queues
+	char tag[VIRTIO_FS_TAG_LENGTH];
+	uint32 requestQueues = 0;
+	info->virtio->read_device_config(info->device, 0, tag, sizeof(tag));
+	info->virtio->read_device_config(info->device, VIRTIO_FS_TAG_LENGTH, &requestQueues,
+		sizeof(requestQueues));
+	memcpy(info->tag, tag, sizeof(tag));
+	info->tag[VIRTIO_FS_TAG_LENGTH] = '\0';
+	info->requestQueues = B_LENDIAN_TO_HOST_INT32(requestQueues);
+	if (info->tag[0] == '\0')
+		strlcpy(info->tag, "HostFS", sizeof(info->tag));
+
+	// the slots: one contiguous area, SLOT_COUNT * (in page, out page, data)
+	void* address;
+	size_t size = SLOT_COUNT * SLOT_SIZE;
+	info->area = create_area("virtio_fs slots", &address, B_ANY_KERNEL_ADDRESS, size,
+		B_CONTIGUOUS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA);
+	if (info->area < 0) {
+		status = info->area;
+		ERROR("no memory for the request slots: %s\n", strerror(status));
+		virtio_fs_teardown(info);
+		return status;
+	}
+	physical_entry physical;
+	status = get_memory_map(address, B_PAGE_SIZE, &physical, 1);
+	if (status != B_OK) {
+		virtio_fs_teardown(info);
+		return status;
+	}
+	for (uint32 i = 0; i < SLOT_COUNT; i++) {
+		virtio_fs_slot* slot = &info->slots[i];
+		uint8* base = (uint8*)address + i * SLOT_SIZE;
+		phys_addr_t basePhys = physical.address + i * SLOT_SIZE;
+		slot->in = base;
+		slot->out = base + SLOT_IN_SIZE;
+		slot->data = base + SLOT_IN_SIZE + SLOT_OUT_SIZE;
+		slot->inPhys = basePhys;
+		slot->outPhys = basePhys + SLOT_IN_SIZE;
+		slot->dataPhys = basePhys + SLOT_IN_SIZE + SLOT_OUT_SIZE;
+		slot->completion.Init(slot, "virtio_fs request");
+	}
+	info->slotsFree = create_sem(SLOT_COUNT, "virtio_fs slots");
+	if (info->slotsFree < 0) {
+		status = info->slotsFree;
+		virtio_fs_teardown(info);
+		return status;
+	}
+
+	// queue 0: high priority (FORGET); queue 1: the first request queue. More
+	// request queues would only spread the same slots.
+	virtio_queue queues[2];
+	status = info->virtio->alloc_queues(info->device, 2, queues, NULL);
+	if (status != B_OK) {
+		ERROR("queue allocation failed: %s\n", strerror(status));
+		virtio_fs_teardown(info);
+		return status;
+	}
+	info->hiprioQueue = queues[0];
+	info->requestQueue = queues[1];
+
+	status = info->virtio->setup_interrupt(info->device, NULL, info);
+	if (status == B_OK) {
+		status = info->virtio->queue_setup_interrupt(info->hiprioQueue,
+			virtio_fs_hiprio_callback, info);
+	}
+	if (status == B_OK) {
+		status = info->virtio->queue_setup_interrupt(info->requestQueue,
+			virtio_fs_request_callback, info);
+	}
+	if (status != B_OK) {
+		ERROR("interrupt setup failed: %s\n", strerror(status));
+		virtio_fs_teardown(info);
+		return status;
+	}
+
+	virtio_fs_disk_header& header = info->header;
+	strlcpy(header.magic, VIRTIO_FS_DISK_MAGIC, sizeof(header.magic));
+	header.version = VIRTIO_FS_DISK_VERSION;
+	header.request_queues = info->requestQueues;
+	strlcpy(header.tag, info->tag, sizeof(header.tag));
+
+	virtio_fs_transport& transport = info->transport;
+	transport.version = VIRTIO_FS_TRANSPORT_VERSION;
+	transport.cookie = info;
+	transport.request = virtio_fs_do_request;
+	transport.max_in_size = SLOT_IN_SIZE;
+	transport.max_data = SLOT_DATA_SIZE;
+	strlcpy(transport.tag, info->tag, sizeof(transport.tag));
+
+	INFO("tag \"%s\", %" B_PRIu32 " request queue(s), features %#" B_PRIx64 "\n",
+		info->tag, info->requestQueues, info->features);
+	*_cookie = info;
+	return B_OK;
+}
+
+
+static void
+virtio_fs_uninit_driver(void* cookie)
+{
+	virtio_fs_teardown((virtio_fs_info*)cookie);
+}
+
+
+static status_t
+virtio_fs_register_child_devices(void* cookie)
+{
+	virtio_fs_info* info = (virtio_fs_info*)cookie;
+	int32 id = sDeviceManager->create_id(VIRTIO_FS_DEVICE_ID_GENERATOR);
+	if (id < 0)
+		return id;
+	info->id = id;
+	snprintf(info->name, sizeof(info->name), "disk/virtual/virtio_fs/%" B_PRId32 "/raw", id);
+	INFO("publishing /dev/%s\n", info->name);
+	return sDeviceManager->publish_device(info->node, info->name,
+		VIRTIO_FS_DEVICE_MODULE_NAME);
+}
