+
+static float
+hostfs_identify_partition(int fd, partition_data* partition, void** _cookie)
+{
+	virtio_fs_disk_header header;
+	if (read_pos(fd, 0, &header, sizeof(header)) != (ssize_t)sizeof(header))
+		return -1;
+	if (strncmp(header.magic, VIRTIO_FS_DISK_MAGIC, sizeof(header.magic)) != 0
+		|| header.version != VIRTIO_FS_DISK_VERSION)
+		return -1;
+
+	header.tag[sizeof(header.tag) - 1] = '\0';
+	char* name = strdup(header.tag[0] != '\0' ? header.tag : HOSTFS_PRETTY_NAME);
+	if (name == NULL)
+		return -1;
+	*_cookie = name;
+	return 0.9f;
+}
+
+
+static status_t
+hostfs_scan_partition(int fd, partition_data* partition, void* cookie)
+{
+	partition->status = B_PARTITION_VALID;
+	partition->flags |= B_PARTITION_FILE_SYSTEM;
+	partition->content_size = partition->size;
+	partition->block_size = VIRTIO_FS_DISK_BLOCK_SIZE;
+	partition->content_name = strdup((const char*)cookie);
+	if (partition->content_name == NULL)
+		return B_NO_MEMORY;
+	return B_OK;
+}
+
+
+static void
+hostfs_free_identify_partition_cookie(partition_data* partition, void* cookie)
+{
+	free(cookie);
+}
