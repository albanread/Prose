+
+static bool
+hostfs_can_page(fs_volume* _volume, fs_vnode* _node, void* cookie)
+{
+	return get_node(_node)->IsFile();
+}
+
+
+static status_t
+hostfs_read_pages(fs_volume* _volume, fs_vnode* _node, void* _cookie, off_t pos,
+	const iovec* vecs, size_t count, size_t* _numBytes)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	if (!node->IsFile())
+		return B_BAD_VALUE;
+
+	uint64 fh;
+	status_t status = node_get_fh(volume, node, false, &fh);
+	if (status != B_OK)
+		return status;
+
+	// Read what the host has; past its end (a hole we are about to fill, or
+	// the tail of the last page) the pages are zeros.
+	const size_t requested = *_numBytes;
+	size_t done = 0;
+	bool eof = false;
+	for (size_t i = 0; i < count && done < requested && status == B_OK; i++) {
+		uint8* base = (uint8*)vecs[i].iov_base;
+		const size_t length = min_c(vecs[i].iov_len, requested - done);
+		size_t vecDone = 0;
+		while (vecDone < length) {
+			const size_t chunk = min_c(length - vecDone, volume->MaxRead());
+			size_t got = 0;
+			if (!eof) {
+				fuse_read_in in = {};
+				in.fh = fh;
+				in.offset = pos + done + vecDone;
+				in.size = chunk;
+				status = volume->Request(FUSE_READ, node->nodeid, &in, sizeof(in), NULL,
+					NULL, NULL, 0, NULL, 0, base + vecDone, chunk, &got);
+				if (status != B_OK)
+					break;
+				if (got < chunk)
+					eof = true;
+			}
+			if (got < chunk)
+				memset(base + vecDone + got, 0, chunk - got);
+			vecDone += chunk;
+		}
+		done += vecDone;
+	}
+
+	node_put_fh(volume, node);
+	*_numBytes = done;
+	return status;
+}
+
+
+static status_t
+hostfs_write_pages(fs_volume* _volume, fs_vnode* _node, void* _cookie, off_t pos,
+	const iovec* vecs, size_t count, size_t* _numBytes)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	if (!node->IsFile())
+		return B_BAD_VALUE;
+	if (volume->IsReadOnly())
+		return B_READ_ONLY_DEVICE;
+
+	// whole pages come in; only what is inside the file goes out
+	off_t size;
+	{
+		MutexLocker locker(node->lock);
+		size = node->size;
+	}
+	const size_t requested = *_numBytes;
+	const size_t toWrite = pos >= size ? 0 : (size_t)min_c((off_t)requested, size - pos);
+	if (toWrite == 0)
+		return B_OK;
+
+	uint64 fh;
+	status_t status = node_get_fh(volume, node, true, &fh);
+	if (status != B_OK)
+		return status;
+
+	size_t done = 0;
+	for (size_t i = 0; i < count && done < toWrite && status == B_OK; i++) {
+		const uint8* base = (const uint8*)vecs[i].iov_base;
+		const size_t length = min_c(vecs[i].iov_len, toWrite - done);
+		size_t vecDone = 0;
+		while (vecDone < length) {
+			const size_t chunk = min_c(length - vecDone, volume->MaxWrite());
+			fuse_write_in in = {};
+			in.fh = fh;
+			in.offset = pos + done + vecDone;
+			in.size = chunk;
+			fuse_write_out out;
+			status = volume->Request(FUSE_WRITE, node->nodeid, &in, sizeof(in), NULL, NULL,
+				base + vecDone, chunk, &out, sizeof(out));
+			if (status != B_OK)
+				break;
+			if (out.size == 0 || out.size > chunk) {
+				status = B_IO_ERROR;
+				break;
+			}
+			vecDone += out.size;
+		}
+		done += vecDone;
+	}
+
+	node_put_fh(volume, node);
+	*_numBytes = status == B_OK ? requested : done;
+	return status;
+}
+
+
+static status_t
+hostfs_fsync(fs_volume* _volume, fs_vnode* _node, bool dataOnly)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	if (!node->IsFile() || node->fileCache == NULL)
+		return B_OK;
+
+	status_t status = file_cache_sync(node->fileCache);
+
+	// ask the host to sync, if we wrote through a handle it still has
+	bool haveFh;
+	{
+		MutexLocker locker(node->lock);
+		haveFh = node->fhMode == O_RDWR;
+	}
+	uint64 fh;
+	if (haveFh && node_get_fh(volume, node, false, &fh) == B_OK) {
+		fuse_fsync_in in = {};
+		in.fh = fh;
+		in.fsync_flags = dataOnly ? FUSE_FSYNC_FDATASYNC : 0;
+		volume->Request(FUSE_FSYNC, node->nodeid, &in, sizeof(in), NULL, NULL, NULL, 0,
+			NULL, 0);
+		node_put_fh(volume, node);
+	}
+	return status;
+}
+
+
+static status_t
+hostfs_read_symlink(fs_volume* _volume, fs_vnode* _node, char* buffer,
+	size_t* _bufferSize)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	if (!node->IsSymlink())
+		return B_BAD_VALUE;
+
+	char* target = (char*)malloc(B_PATH_NAME_LENGTH);
+	if (target == NULL)
+		return B_NO_MEMORY;
+	MemoryDeleter targetDeleter(target);
+
+	size_t length = 0;
+	status_t status = volume->Request(FUSE_READLINK, node->nodeid, NULL, 0, NULL, NULL,
+		NULL, 0, NULL, 0, target, B_PATH_NAME_LENGTH, &length);
+	if (status != B_OK)
+		return status;
+
+	size_t toCopy = min_c(length, *_bufferSize);
+	if (IS_USER_ADDRESS(buffer)) {
+		if (user_memcpy(buffer, target, toCopy) != B_OK)
+			return B_BAD_ADDRESS;
+	} else
+		memcpy(buffer, target, toCopy);
+	*_bufferSize = length;
+	return B_OK;
+}
+
+
+static status_t
+hostfs_create_symlink(fs_volume* _volume, fs_vnode* _dir, const char* name,
+	const char* path, int mode)
+{
+	Volume* volume = get_volume(_volume);
+	Node* dir = get_node(_dir);
+	if (volume->IsReadOnly())
+		return B_READ_ONLY_DEVICE;
+
+	fuse_entry_out entry;
+	status_t status = volume->Request(FUSE_SYMLINK, dir->nodeid, NULL, 0, name, path,
+		NULL, 0, &entry, sizeof(entry));
+	if (status != B_OK)
+		return status;
+
+	Node* node = volume->AcquireEntry(entry, dir->nodeid, name);
+	if (node != NULL) {
+		notify_entry_created(volume->ID(), dir->nodeid, name, node->nodeid);
+		volume->Unpend(node);
+	}
+	return B_OK;
+}
+
+
+static status_t
+hostfs_link(fs_volume* _volume, fs_vnode* _dir, const char* name, fs_vnode* _node)
+{
+	Volume* volume = get_volume(_volume);
+	Node* dir = get_node(_dir);
+	Node* node = get_node(_node);
+	if (volume->IsReadOnly())
+		return B_READ_ONLY_DEVICE;
+
+	fuse_link_in in = {};
+	in.oldnodeid = node->nodeid;
+	fuse_entry_out entry;
+	status_t status = volume->Request(FUSE_LINK, dir->nodeid, &in, sizeof(in), name, NULL,
+		NULL, 0, &entry, sizeof(entry));
+	if (status != B_OK)
+		return status;
+
+	Node* linked = volume->AcquireEntry(entry, dir->nodeid, name);
+	if (linked != NULL) {
+		node_update(volume, linked, entry.attr);
+		notify_entry_created(volume->ID(), dir->nodeid, name, linked->nodeid);
+		volume->Unpend(linked);
+	}
+	return B_OK;
+}
+
+
+/*!	Removes the entry \a name from \a dir, which is a directory or not as
+	\a directory says. The node is looked up first, so that watchers learn
+	its ID and the VFS learns it is gone.
+*/
+static status_t
+remove_entry(Volume* volume, Node* dir, const char* name, bool directory)
+{
+	if (volume->IsReadOnly())
+		return B_READ_ONLY_DEVICE;
+	if (strcmp(name, ".") == 0 || strcmp(name, "..") == 0)
+		return B_NOT_ALLOWED;
+
+	fuse_entry_out entry;
+	status_t status = volume->Lookup(dir->nodeid, name, &entry);
+	if (status != B_OK)
+		return status;
+	Node* node = volume->AcquireEntry(entry, dir->nodeid, name);
+	if (node == NULL)
+		return B_NO_MEMORY;
+
+	if (directory != S_ISDIR(entry.attr.mode)) {
+		volume->Unpend(node);
+		return directory ? B_NOT_A_DIRECTORY : B_IS_A_DIRECTORY;
+	}
+
+	status = volume->Request(directory ? FUSE_RMDIR : FUSE_UNLINK, dir->nodeid, NULL, 0,
+		name, NULL, NULL, 0, NULL, 0);
+	if (status == B_OK) {
+		notify_entry_removed(volume->ID(), dir->nodeid, name, node->nodeid);
+		if (directory || entry.attr.nlink <= 1)
+			node_removed(volume, node);
+	}
+	volume->Unpend(node);
+	return status;
+}
+
+
+static status_t
+hostfs_unlink(fs_volume* _volume, fs_vnode* _dir, const char* name)
+{
+	return remove_entry(get_volume(_volume), get_node(_dir), name, false);
+}
+
+
+static status_t
+hostfs_remove_dir(fs_volume* _volume, fs_vnode* _dir, const char* name)
+{
+	return remove_entry(get_volume(_volume), get_node(_dir), name, true);
+}
+
+
+static status_t
+hostfs_rename(fs_volume* _volume, fs_vnode* _fromDir, const char* fromName,
+	fs_vnode* _toDir, const char* toName)
+{
+	Volume* volume = get_volume(_volume);
+	Node* fromDir = get_node(_fromDir);
+	Node* toDir = get_node(_toDir);
+	if (volume->IsReadOnly())
+		return B_READ_ONLY_DEVICE;
+	if (strcmp(fromName, ".") == 0 || strcmp(fromName, "..") == 0
+		|| strcmp(toName, ".") == 0 || strcmp(toName, "..") == 0)
+		return B_BAD_VALUE;
+
+	// what moves, and what (if anything) it replaces
+	fuse_entry_out entry;
+	status_t status = volume->Lookup(fromDir->nodeid, fromName, &entry);
+	if (status != B_OK)
+		return status;
+	Node* node = volume->AcquireEntry(entry, fromDir->nodeid, fromName);
+	if (node == NULL)
+		return B_NO_MEMORY;
+
+	Node* replaced = NULL;
+	fuse_entry_out replacedEntry;
+	if (volume->Lookup(toDir->nodeid, toName, &replacedEntry) == B_OK) {
+		replaced = volume->AcquireEntry(replacedEntry, toDir->nodeid, toName);
+		if (replaced == node) {
+			// both names are the same node: nothing to do
+			volume->Unpend(replaced);
+			volume->Unpend(node);
+			return B_OK;
+		}
+	}
+
+	fuse_rename_in in = {};
+	in.newdir = toDir->nodeid;
+	status = volume->Request(FUSE_RENAME, fromDir->nodeid, &in, sizeof(in), fromName,
+		toName, NULL, 0, NULL, 0);
+	if (status == B_OK) {
+		if (replaced != NULL) {
+			notify_entry_removed(volume->ID(), toDir->nodeid, toName, replaced->nodeid);
+			if (S_ISDIR(replacedEntry.attr.mode) || replacedEntry.attr.nlink <= 1)
+				node_removed(volume, replaced);
+		}
+		volume->Moved(node, toDir->nodeid, toName);
+		notify_entry_moved(volume->ID(), fromDir->nodeid, fromName, toDir->nodeid, toName,
+			node->nodeid);
+	}
+
+	if (replaced != NULL)
+		volume->Unpend(replaced);
+	volume->Unpend(node);
+	return status;
+}
+
+
+static status_t
+hostfs_access(fs_volume* _volume, fs_vnode* _node, int accessMode)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	if ((accessMode & W_OK) != 0 && volume->IsReadOnly())
+		return B_READ_ONLY_DEVICE;
+
+	// the host enforces its own permissions on every request; this is the
+	// local view of them
+	MutexLocker locker(node->lock);
+	return check_access_permissions(accessMode, node->attr.mode, node->attr.gid,
+		node->attr.uid);
+}
+
+
+static status_t
+hostfs_read_stat(fs_volume* _volume, fs_vnode* _node, struct stat* st)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+
+	status_t status = node_revalidate(volume, node, false);
+	if (status == B_ENTRY_NOT_FOUND)
+		return status;
+
+	MutexLocker locker(node->lock);
+	fill_stat(volume, node, st);
+	return B_OK;
+}
+
+
+static status_t
+hostfs_write_stat(fs_volume* _volume, fs_vnode* _node, const struct stat* st,
+	uint32 mask)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	if (volume->IsReadOnly())
+		return B_READ_ONLY_DEVICE;
+
+	if ((mask & B_STAT_SIZE) != 0) {
+		if (node->IsDirectory())
+			return B_IS_A_DIRECTORY;
+		if (!node->IsFile())
+			return B_BAD_VALUE;
+		status_t status = node_set_size(volume, node, st->st_size);
+		if (status != B_OK)
+			return status;
+	}
+
+	fuse_setattr_in in = {};
+	if ((mask & B_STAT_MODE) != 0) {
+		in.valid |= FATTR_MODE;
+		in.mode = node->type | (st->st_mode & 07777);
+	}
+	if ((mask & B_STAT_UID) != 0) {
+		in.valid |= FATTR_UID;
+		in.uid = st->st_uid;
+	}
+	if ((mask & B_STAT_GID) != 0) {
+		in.valid |= FATTR_GID;
+		in.gid = st->st_gid;
+	}
+	if ((mask & B_STAT_ACCESS_TIME) != 0) {
+		in.valid |= FATTR_ATIME;
+		in.atime = st->st_atim.tv_sec;
+		in.atimensec = st->st_atim.tv_nsec;
+	}
+	if ((mask & B_STAT_MODIFICATION_TIME) != 0) {
+		in.valid |= FATTR_MTIME;
+		in.mtime = st->st_mtim.tv_sec;
+		in.mtimensec = st->st_mtim.tv_nsec;
+	}
+	if ((mask & B_STAT_CHANGE_TIME) != 0 && volume->Minor() >= 23) {
+		in.valid |= FATTR_CTIME;
+		in.ctime = st->st_ctim.tv_sec;
+		in.ctimensec = st->st_ctim.tv_nsec;
+	}
+	// B_STAT_CREATION_TIME: FUSE cannot set a birth time; ignored
+
+	if (in.valid != 0) {
+		// Set times after the data: dirty pages written back later would
+		// move the modification time again.
+		if ((in.valid & (FATTR_ATIME | FATTR_MTIME)) != 0 && node->IsFile()
+			&& node->fileCache != NULL) {
+			file_cache_sync(node->fileCache);
+		}
+
+		fuse_attr_out out;
+		status_t status = volume->Request(FUSE_SETATTR, node->nodeid, &in, sizeof(in),
+			NULL, NULL, NULL, 0, &out, sizeof(out));
+		if (status != B_OK)
+			return status;
+		MutexLocker locker(node->lock);
+		node_set_stamp(node, out.attr);
+	}
+
+	notify_stat_changed(volume->ID(), volume->ParentOf(node), node->nodeid, mask);
+	return B_OK;
+}
+
+
+//	#pragma mark - files
+
+
+static status_t
+hostfs_create(fs_volume* _volume, fs_vnode* _dir, const char* name, int openMode,
+	int perms, void** _cookie, ino_t* _newVnodeID)
+{
+	Volume* volume = get_volume(_volume);
+	Node* dir = get_node(_dir);
+	if (volume->IsReadOnly())
+		return B_READ_ONLY_DEVICE;
+	if (!dir->IsDirectory())
+		return B_NOT_A_DIRECTORY;
+
+	FileCookie* cookie = new(std::nothrow) FileCookie;
+	if (cookie == NULL)
+		return B_NO_MEMORY;
+	ObjectDeleter<FileCookie> cookieDeleter(cookie);
+	cookie->openMode = openMode;
+
+	// Created read-write whatever the caller asked for: the handle becomes
+	// the node's handle for page I/O.
+	struct {
+		fuse_entry_out	entry;
+		fuse_open_out	open;
+	} reply;
+	fuse_create_in in = {};
+	in.flags = LINUX_O_RDWR | LINUX_O_CREAT | LINUX_O_EXCL;
+	in.mode = S_IFREG | (perms & 07777);
+	status_t status = volume->Request(FUSE_CREATE, dir->nodeid, &in, sizeof(in), name,
+		NULL, NULL, 0, &reply, sizeof(reply));
+	bool haveFh = status == B_OK;
+	if (status == B_UNSUPPORTED) {
+		// no FUSE_CREATE: make the node, and open it when it is used
+		fuse_mknod_in mknod = {};
+		mknod.mode = S_IFREG | (perms & 07777);
+		status = volume->Request(FUSE_MKNOD, dir->nodeid, &mknod, sizeof(mknod), name,
+			NULL, NULL, 0, &reply.entry, sizeof(reply.entry));
+	}
+	if (status != B_OK)
+		return status;
+
+	Node* node = volume->AcquireEntry(reply.entry, dir->nodeid, name);
+	if (node == NULL) {
+		if (haveFh)
+			volume->Release(reply.entry.nodeid, false, reply.open.fh);
+		return B_NO_MEMORY;
+	}
+
+	bool releaseFh = haveFh;
+	{
+		MutexLocker locker(node->lock);
+		node->size = reply.entry.attr.size;
+		node_set_stamp(node, reply.entry.attr);
+		node->opens++;
+		if (is_writable(openMode))
+			node->writers++;
+		if (haveFh && node->fhMode == -1) {
+			node->fh = reply.open.fh;
+			node->fhMode = O_RDWR;
+			releaseFh = false;
+		}
+	}
+	if (releaseFh)
+		volume->Release(node->nodeid, false, reply.open.fh);
+
+	void* privateNode;
+	status = get_vnode(volume->FSVolume(), node->nodeid, &privateNode);
+	if (status != B_OK) {
+		{
+			MutexLocker locker(node->lock);
+			node->opens--;
+			if (is_writable(openMode))
+				node->writers--;
+		}
+		volume->Unpend(node);
+		return status;
+	}
+	volume->Unpend(node);
+
+	notify_entry_created(volume->ID(), dir->nodeid, name, node->nodeid);
+	*_newVnodeID = node->nodeid;
+	*_cookie = cookieDeleter.Detach();
+	return B_OK;
+}
+
+
+static status_t
+hostfs_open(fs_volume* _volume, fs_vnode* _node, int openMode, void** _cookie)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	const bool writable = is_writable(openMode);
+
+	if (node->IsDirectory()) {
+		if (writable)
+			return B_IS_A_DIRECTORY;
+	} else if (node->IsFile()) {
+		if (writable && volume->IsReadOnly())
+			return B_READ_ONLY_DEVICE;
+	} else if (writable) {
+		// symlinks and special files: open for their attributes only
+		return B_NOT_ALLOWED;
+	}
+
+	FileCookie* cookie = new(std::nothrow) FileCookie;
+	if (cookie == NULL)
+		return B_NO_MEMORY;
+	ObjectDeleter<FileCookie> cookieDeleter(cookie);
+	cookie->openMode = openMode;
+
+	if (node->IsFile()) {
+		// close-to-open: see what the host has now
+		status_t status = node_revalidate(volume, node, true);
+		if (status != B_OK)
+			return status;
+
+		{
+			MutexLocker locker(node->lock);
+			node->opens++;
+			if (writable)
+				node->writers++;
+		}
+		if (writable) {
+			// open the host file now, so that a permission problem shows here
+			// and not when the pages are written back
+			uint64 fh;
+			status = node_get_fh(volume, node, true, &fh);
+			if (status == B_OK)
+				node_put_fh(volume, node);
+			if (status == B_OK && (openMode & O_TRUNC) != 0)
+				status = node_set_size(volume, node, 0);
+			if (status != B_OK) {
+				uint64 releaseFh = 0;
+				bool release = false;
+				{
+					MutexLocker locker(node->lock);
+					node->opens--;
+					node->writers--;
+					if (node->opens == 0 && node->fhUsers == 0 && node->fhMode != -1) {
+						releaseFh = node->fh;
+						node->fhMode = -1;
+						release = true;
+					}
+				}
+				if (release)
+					volume->Release(node->nodeid, false, releaseFh);
+				return status;
+			}
+		}
+	}
+
+	*_cookie = cookieDeleter.Detach();
+	return B_OK;
+}
+
+
+static status_t
+hostfs_close(fs_volume* _volume, fs_vnode* _node, void* _cookie)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	FileCookie* cookie = (FileCookie*)_cookie;
+	if (!node->IsFile() || !is_writable(cookie->openMode))
+		return B_OK;
+
+	// write back what is in the cache, so the host has it now
+	status_t status = B_OK;
+	if (node->fileCache != NULL)
+		status = file_cache_sync(node->fileCache);
+
+	uint64 fh;
+	if (node_get_fh(volume, node, false, &fh) == B_OK) {
+		fuse_flush_in in = {};
+		in.fh = fh;
+		volume->Request(FUSE_FLUSH, node->nodeid, &in, sizeof(in), NULL, NULL, NULL, 0,
+			NULL, 0);
+		node_put_fh(volume, node);
+	}
+
+	// the write-back moved the host's modification time: the cached pages
+	// still belong to the file
+	fuse_attr attr;
+	if (volume->GetAttr(node->nodeid, &attr) == B_OK) {
+		MutexLocker locker(node->lock);
+		node_set_stamp(node, attr);
+	}
+
+	notify_stat_changed(volume->ID(), volume->ParentOf(node), node->nodeid,
+		B_STAT_SIZE | B_STAT_MODIFICATION_TIME);
+	return status;
+}
+
+
+static status_t
+hostfs_free_cookie(fs_volume* _volume, fs_vnode* _node, void* _cookie)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	FileCookie* cookie = (FileCookie*)_cookie;
+
+	if (node->IsFile()) {
+		uint64 fh = 0;
+		bool release = false;
+		{
+			MutexLocker locker(node->lock);
+			node->opens--;
+			if (is_writable(cookie->openMode))
+				node->writers--;
+			if (node->opens == 0 && node->fhUsers == 0 && node->fhMode != -1) {
+				fh = node->fh;
+				node->fhMode = -1;
+				release = true;
+			}
+		}
+		if (release)
+			volume->Release(node->nodeid, false, fh);
+	}
+
+	delete cookie;
+	return B_OK;
+}
+
+
+static status_t
+hostfs_read(fs_volume* _volume, fs_vnode* _node, void* _cookie, off_t pos,
+	void* buffer, size_t* _length)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	if (node->IsDirectory())
+		return B_IS_A_DIRECTORY;
+	if (!node->IsFile() || node->fileCache == NULL)
+		return B_BAD_VALUE;
+	if (pos < 0)
+		return B_BAD_VALUE;
+
+	// a file kept open (think tail -f) still sees the host's changes
+	node_revalidate(volume, node, false);
+
+	return file_cache_read(node->fileCache, _cookie, pos, buffer, _length);
+}
+
+
+static status_t
+hostfs_write(fs_volume* _volume, fs_vnode* _node, void* _cookie, off_t pos,
+	const void* buffer, size_t* _length)
+{
+	Volume* volume = get_volume(_volume);
+	Node* node = get_node(_node);
+	FileCookie* cookie = (FileCookie*)_cookie;
+	if (node->IsDirectory())
+		return B_IS_A_DIRECTORY;
+	if (!node->IsFile() || node->fileCache == NULL)
+		return B_BAD_VALUE;
+	if (volume->IsReadOnly())
+		return B_READ_ONLY_DEVICE;
+	if (!is_writable(cookie->openMode))
+		return B_FILE_ERROR;
+	if (pos < 0)
+		return B_BAD_VALUE;
+	if (*_length == 0)
+		return B_OK;
+
+	off_t end;
+	bool grow = false;
+	{
+		MutexLocker locker(node->lock);
+		if ((cookie->openMode & O_APPEND) != 0)
+			pos = node->size;
+		end = pos + *_length;
+		if (end > node->size) {
+			node->size = end;
+			grow = true;
+		}
+	}
+	if (grow)
+		file_cache_set_size(node->fileCache, end);
+
+	status_t status = file_cache_write(node->fileCache, cookie, pos, buffer, _length);
+
+	if (grow) {
+		notify_stat_changed(volume->ID(), volume->ParentOf(node), node->nodeid,
+			B_STAT_SIZE);
+	}
+	return status;
+}
+
+
+static status_t
+hostfs_set_flags(fs_volume* _volume, fs_vnode* _node, void* _cookie, int flags)
+{
+	FileCookie* cookie = (FileCookie*)_cookie;
+	// only O_APPEND and O_NONBLOCK can change; the access mode cannot
+	cookie->openMode = (cookie->openMode & ~(O_APPEND | O_NONBLOCK))
+		| (flags & (O_APPEND | O_NONBLOCK));
+	return B_OK;
+}
