diff --git a/headers/private/virtio/virtio_fs.h b/headers/private/virtio/virtio_fs.h
new file mode 100644
index 0000000000..12aadf17dd
--- /dev/null
+++ b/headers/private/virtio/virtio_fs.h
@@ -0,0 +1,79 @@
+/*
+ * Copyright 2026, HaikuArmQemu (PROSE fork). All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * HostFS: the kernel-private interface between the virtio_fs driver and the
+ * hostfs file system.
+ *
+ * The driver publishes every virtio-fs device as a small read-only
+ * pseudo-disk, /dev/disk/virtual/virtio_fs/<n>/raw. Its first block holds a
+ * virtio_fs_disk_header; everything else reads as zeros. The disk device
+ * manager scans it like any disk, hostfs recognises the header, and the
+ * volume is mounted from that device like any other (mount_server, Tracker's
+ * Mount menu, DriveSetup). Once mounted, hostfs gets the driver's transport
+ * through an ioctl and sends FUSE requests with it.
+ */
+#ifndef _VIRTIO_FS_H_
+#define _VIRTIO_FS_H_
+
+
+#include <Drivers.h>
+
+
+#define VIRTIO_DEVICE_ID_FS				26
+
+#define VIRTIO_FS_DISK_MAGIC			"PROSE virtio-fs"	// 15 chars + NUL
+#define VIRTIO_FS_DISK_VERSION			1
+#define VIRTIO_FS_DISK_BLOCK_SIZE		512
+#define VIRTIO_FS_DISK_BLOCK_COUNT		128
+#define VIRTIO_FS_TAG_LENGTH			36		// virtio_fs_config.tag
+
+typedef struct {
+	char		magic[16];
+	uint32		version;
+	uint32		request_queues;		// as the device reports them
+	char		tag[VIRTIO_FS_TAG_LENGTH + 4];	// NUL-terminated
+} virtio_fs_disk_header;
+
+
+/*!	One FUSE request. The driver fills in the unique ID and the length in the
+	fuse_in_header at the start of \c in, and copies everything through its own
+	DMA buffers, so the data pointers may be kernel addresses or addresses in
+	the calling team.
+	\c out == NULL sends the request on the high-priority queue and expects no
+	reply (FUSE_FORGET, FUSE_BATCH_FORGET).
+	Payloads go either in or out, never both (the driver has one data buffer
+	per request).
+*/
+typedef struct {
+	const void*	in;				// fuse_in_header + arguments (+ names)
+	size_t		in_size;
+	const void*	in_data;		// payload: FUSE_WRITE data, xattr values
+	size_t		in_data_size;
+	void*		out;			// fuse_out_header + fixed-size reply
+	size_t		out_size;
+	void*		out_data;		// variable-size reply: READ, READDIR,
+								// READLINK, GETXATTR, LISTXATTR
+	size_t		out_data_size;	// capacity
+	size_t		out_data_length;	// returned: bytes of out_data filled
+} virtio_fs_request;
+
+
+typedef struct {
+	uint32		version;
+	void*		cookie;
+	status_t	(*request)(void* cookie, virtio_fs_request* request);
+	size_t		max_in_size;	// largest in_size
+	size_t		max_data;		// largest in_data_size / out_data_size
+	char		tag[VIRTIO_FS_TAG_LENGTH + 1];
+} virtio_fs_transport;
+
+#define VIRTIO_FS_TRANSPORT_VERSION		1
+
+
+// ioctl on the pseudo-disk: fills in a virtio_fs_transport. For kernel
+// callers only; the pointers it hands out are kernel pointers.
+#define VIRTIO_FS_GET_TRANSPORT			(B_DEVICE_OP_CODES_END + 0x5646)
+
+
+#endif	// _VIRTIO_FS_H_
