+}
+
+
+static status_t
+virtio_fs_read(void* cookie, off_t position, void* buffer, size_t* _length)
+{
+	virtio_fs_info* info = (virtio_fs_info*)cookie;
+	const off_t size = (off_t)VIRTIO_FS_DISK_BLOCK_SIZE * VIRTIO_FS_DISK_BLOCK_COUNT;
+	if (position < 0)
+		return B_BAD_VALUE;
+	if (position >= size) {
+		*_length = 0;
+		return B_OK;
+	}
+	size_t length = min_c(*_length, (size_t)(size - position));
+
+	uint8 block[VIRTIO_FS_DISK_BLOCK_SIZE];
+	size_t done = 0;
+	while (done < length) {
+		off_t offset = position + done;
+		size_t inBlock = offset % VIRTIO_FS_DISK_BLOCK_SIZE;
+		size_t chunk = min_c(length - done, VIRTIO_FS_DISK_BLOCK_SIZE - inBlock);
+		memset(block, 0, sizeof(block));
+		if (offset < VIRTIO_FS_DISK_BLOCK_SIZE)
+			memcpy(block, &info->header, sizeof(info->header));
+		status_t status = copy_between((uint8*)buffer + done, block + inBlock, chunk);
+		if (status != B_OK) {
+			*_length = done;
+			return status;
+		}
+		done += chunk;
+	}
+	*_length = done;
+	return B_OK;
+}
+
+
+static status_t
+virtio_fs_write(void* cookie, off_t position, const void* buffer, size_t* _length)
+{
+	*_length = 0;
+	return B_READ_ONLY_DEVICE;
+}
+
+
+static status_t
+virtio_fs_control(void* cookie, uint32 op, void* buffer, size_t length)
+{
+	virtio_fs_info* info = (virtio_fs_info*)cookie;
+
+	switch (op) {
+		case B_GET_MEDIA_STATUS:
+		{
+			status_t mediaStatus = B_OK;
+			return copy_between(buffer, &mediaStatus, sizeof(mediaStatus));
+		}
+
+		case B_GET_DEVICE_SIZE:
+		{
+			size_t size = (size_t)VIRTIO_FS_DISK_BLOCK_SIZE * VIRTIO_FS_DISK_BLOCK_COUNT;
+			return copy_between(buffer, &size, sizeof(size));
+		}
+
+		case B_GET_GEOMETRY:
+		case B_GET_BIOS_GEOMETRY:
+		{
+			if (buffer == NULL || length > sizeof(device_geometry))
+				return B_BAD_VALUE;
+			device_geometry geometry = {};
+			geometry.bytes_per_sector = VIRTIO_FS_DISK_BLOCK_SIZE;
+			geometry.bytes_per_physical_sector = VIRTIO_FS_DISK_BLOCK_SIZE;
+			geometry.sectors_per_track = VIRTIO_FS_DISK_BLOCK_COUNT;
+			geometry.cylinder_count = 1;
+			geometry.head_count = 1;
+			geometry.device_type = B_DISK;
+			geometry.removable = false;
+			geometry.read_only = true;
+				// the pseudo-disk, not the volume: DriveSetup must not
+				// initialize it
+			geometry.write_once = false;
+			return copy_between(buffer, &geometry, length);
+		}
+
+		case B_FLUSH_DRIVE_CACHE:
+			return B_OK;
+
+		case B_GET_ICON_NAME:
+			if (IS_USER_ADDRESS(buffer))
+				return user_strlcpy((char*)buffer, "devices/drive-harddisk", B_FILE_NAME_LENGTH);
+			strlcpy((char*)buffer, "devices/drive-harddisk", B_FILE_NAME_LENGTH);
+			return B_OK;
+
+		case VIRTIO_FS_GET_TRANSPORT:
+			// kernel callers only: user ioctls with kernel buffers never get here
+			if (!IS_KERNEL_ADDRESS(buffer) || length < sizeof(virtio_fs_transport))
+				return B_NOT_ALLOWED;
+			memcpy(buffer, &info->transport, sizeof(virtio_fs_transport));
+			return B_OK;
+	}
+
+	return B_DEV_INVALID_IOCTL;
+}
+
