+
+
+//	#pragma mark - Linux conventions
+
+
+status_t
+linux_to_haiku_error(int32 error, uint32 opcode)
+{
+	// FUSE replies carry negative Linux errno values
+	switch (-error) {
+		case 0:		return B_OK;
+		case 1:		return B_NOT_ALLOWED;			// EPERM
+		case 2:		return B_ENTRY_NOT_FOUND;		// ENOENT
+		case 4:		return B_INTERRUPTED;			// EINTR
+		case 5:		return B_IO_ERROR;				// EIO
+		case 6:		return ENXIO;
+		case 7:		return E2BIG;
+		case 9:		return B_FILE_ERROR;			// EBADF
+		case 11:	return B_WOULD_BLOCK;			// EAGAIN
+		case 12:	return B_NO_MEMORY;				// ENOMEM
+		case 13:	return B_PERMISSION_DENIED;		// EACCES
+		case 14:	return B_BAD_ADDRESS;			// EFAULT
+		case 16:	return B_BUSY;					// EBUSY
+		case 17:	return B_FILE_EXISTS;			// EEXIST
+		case 18:	return B_CROSS_DEVICE_LINK;		// EXDEV
+		case 19:	return B_DEVICE_NOT_FOUND;		// ENODEV
+		case 20:	return B_NOT_A_DIRECTORY;		// ENOTDIR
+		case 21:	return B_IS_A_DIRECTORY;		// EISDIR
+		case 22:	return B_BAD_VALUE;				// EINVAL
+		case 23:	return ENFILE;
+		case 24:	return EMFILE;
+		case 25:	return ENOTTY;
+		case 26:	return ETXTBSY;
+		case 27:	return EFBIG;
+		case 28:	return B_DEVICE_FULL;			// ENOSPC
+		case 29:	return ESPIPE;
+		case 30:	return B_READ_ONLY_DEVICE;		// EROFS
+		case 31:	return EMLINK;
+		case 32:	return EPIPE;
+		case 34:	return ERANGE;
+		case 35:	return EDEADLK;
+		case 36:	return B_NAME_TOO_LONG;			// ENAMETOOLONG
+		case 38:	return B_UNSUPPORTED;			// ENOSYS
+		case 39:	return B_DIRECTORY_NOT_EMPTY;	// ENOTEMPTY
+		case 40:	return B_LINK_LIMIT;			// ELOOP
+		case 61:	return B_ENTRY_NOT_FOUND;		// ENODATA: no such xattr
+		case 75:	return EOVERFLOW;
+		case 95:	return B_UNSUPPORTED;			// EOPNOTSUPP
+		case 110:	return B_TIMED_OUT;				// ETIMEDOUT
+		case 116:	return B_ENTRY_NOT_FOUND;		// ESTALE
+		case 125:	return B_CANCELED;				// ECANCELED
+	}
+	INFORM("opcode %" B_PRIu32 ": unexpected error %" B_PRId32 " from the host\n",
+		opcode, -error);
+	return B_ERROR;
+}
+
+
+// open(2) flags as Linux (and so FUSE) numbers them on arm64 and x86
+#define LINUX_O_WRONLY		00000001
+#define LINUX_O_RDWR		00000002
+#define LINUX_O_CREAT		00000100
+#define LINUX_O_EXCL		00000200
+#define LINUX_O_TRUNC		00001000
+#define LINUX_O_APPEND		00002000
+
+
+uint32
+haiku_to_linux_open_flags(int openMode)
+{
+	uint32 flags = 0;
+	switch (openMode & O_RWMASK) {
+		case O_WRONLY:
+			flags = LINUX_O_WRONLY;
+			break;
+		case O_RDWR:
+			flags = LINUX_O_RDWR;
+			break;
+	}
+	if ((openMode & O_CREAT) != 0)
+		flags |= LINUX_O_CREAT;
+	if ((openMode & O_EXCL) != 0)
+		flags |= LINUX_O_EXCL;
+	if ((openMode & O_TRUNC) != 0)
+		flags |= LINUX_O_TRUNC;
+	if ((openMode & O_APPEND) != 0)
+		flags |= LINUX_O_APPEND;
+	return flags;
+}
+
+
+//	#pragma mark - Node
+
+
+Node::Node(Volume* volume, uint64 nodeid, const fuse_attr& attr)
+	:
+	volume(volume),
+	nodeid(nodeid),
+	type(attr.mode & S_IFMT),
+	hashLink(NULL),
+	parent(0),
+	name(NULL),
+	lookups(0),
+	pending(0),
+	children(0),
+	published(false),
+	attr(attr),
+	attrTime(system_time()),
+	size(attr.size),
+	stampMtime(attr.mtime),
+	stampMtimeNsec(attr.mtimensec),
+	stampSize(attr.size),
+	fileCache(NULL),
+	opens(0),
+	writers(0),
+	fh(0),
+	fhMode(-1),
+	fhUsers(0),
+	staleFhCount(0)
+{
+	mutex_init(&lock, "hostfs node");
+}
+
+
+Node::~Node()
+{
+	mutex_destroy(&lock);
+	free(name);
+}
+
+
+//	#pragma mark - Volume
+
+
+Volume::Volume(fs_volume* fsVolume)
+	:
+	fFSVolume(fsVolume),
+	fDevice(-1),
+	fRoot(NULL),
+	fReadOnly(false),
+	fMinor(0),
+	fInitFlags(0),
+	fMaxRead(B_PAGE_SIZE),
+	fMaxWrite(B_PAGE_SIZE)
+{
+	memset(&fTransport, 0, sizeof(fTransport));
+	mutex_init(&fLock, "hostfs volume");
+	fName[0] = '\0';
+	fDeviceName[0] = '\0';
+}
+
+
+Volume::~Volume()
+{
+	// whatever is left was never handed to the VFS (a failed mount)
+	Node* node = fNodes.Clear(true);
+	while (node != NULL) {
+		Node* next = node->hashLink;
+		delete node;
+		node = next;
+	}
+	if (fDevice >= 0)
+		close(fDevice);
+	mutex_destroy(&fLock);
+}
+
+
+status_t
+Volume::Mount(const char* device, uint32 flags, const char* args)
+{
+	status_t status = fNodes.Init();
+	if (status != B_OK)
+		return status;
+
+	fReadOnly = (flags & B_MOUNT_READ_ONLY) != 0;
+	strlcpy(fDeviceName, device != NULL ? device : "/dev/disk/virtual/virtio_fs/0/raw",
+		sizeof(fDeviceName));
+
+	fDevice = open(fDeviceName, O_RDONLY);
+	if (fDevice < 0) {
+		INFORM("cannot open %s: %s\n", fDeviceName, strerror(errno));
+		return errno;
+	}
+	if (ioctl(fDevice, VIRTIO_FS_GET_TRANSPORT, &fTransport, sizeof(fTransport)) != 0) {
+		INFORM("%s is not a virtio-fs device\n", fDeviceName);
+		return B_BAD_VALUE;
+	}
+	if (fTransport.version != VIRTIO_FS_TRANSPORT_VERSION)
+		return B_BAD_VALUE;
+	strlcpy(fName, fTransport.tag, sizeof(fName));
+
+	// FUSE_INIT: agree on a protocol version and on what the host does
+	fuse_init_in init = {};
+	init.major = FUSE_KERNEL_VERSION;
+	init.minor = HOSTFS_FUSE_MINOR;
+	init.max_readahead = fTransport.max_data;
+	init.flags = FUSE_ASYNC_READ | FUSE_ATOMIC_O_TRUNC | FUSE_EXPORT_SUPPORT
+		| FUSE_BIG_WRITES | FUSE_DONT_MASK | FUSE_PARALLEL_DIROPS | FUSE_MAX_PAGES;
+	fuse_init_out reply = {};
+	status = Request(FUSE_INIT, 0, &init, sizeof(init), NULL, NULL, NULL, 0, &reply,
+		sizeof(reply));
+	if (status != B_OK) {
+		// a session left over from an earlier mount: end it and start again
+		INFORM("FUSE_INIT failed (%s), retrying after FUSE_DESTROY\n", strerror(status));
+		Request(FUSE_DESTROY, 0, NULL, 0, NULL, NULL, NULL, 0, NULL, 0);
+		status = Request(FUSE_INIT, 0, &init, sizeof(init), NULL, NULL, NULL, 0, &reply,
+			sizeof(reply));
+	}
+	if (status != B_OK) {
+		INFORM("FUSE_INIT failed: %s\n", strerror(status));
+		return status;
+	}
+	if (reply.major != FUSE_KERNEL_VERSION) {
+		INFORM("the host speaks FUSE %" B_PRIu32 ".%" B_PRIu32 ", not 7.x\n", reply.major,
+			reply.minor);
+		return B_NOT_SUPPORTED;
+	}
+	fMinor = min_c(reply.minor, (uint32)HOSTFS_FUSE_MINOR);
+	fInitFlags = reply.flags & init.flags;
+	fMaxWrite = min_c(max_c(reply.max_write, (uint32)B_PAGE_SIZE), fTransport.max_data);
+	uint32 maxPages = (fInitFlags & FUSE_MAX_PAGES) != 0 && reply.max_pages != 0
+		? reply.max_pages : 32;
+	fMaxRead = min_c((size_t)maxPages * B_PAGE_SIZE, fTransport.max_data);
+
+	INFORM("\"%s\" on %s: FUSE 7.%" B_PRIu32 " (host 7.%" B_PRIu32 "), flags %#" B_PRIx32
+		" of %#" B_PRIx32 ", max_write %" B_PRIu32 ", max_pages %u, max_readahead %"
+		B_PRIu32 ", time_gran %" B_PRIu32 "; reads %" B_PRIuSIZE ", writes %" B_PRIuSIZE
+		"%s\n", fName, fDeviceName, fMinor, reply.minor, reply.flags, init.flags,
+		reply.max_write, reply.max_pages, reply.max_readahead, reply.time_gran, fMaxRead,
+		fMaxWrite, fReadOnly ? ", read-only" : "");
+
+	// the root directory is node 1, and is never looked up or forgotten
+	fuse_attr attr;
+	status = GetAttr(FUSE_ROOT_ID, &attr);
+	if (status != B_OK) {
+		INFORM("cannot stat the root: %s\n", strerror(status));
+		return status;
+	}
+	if (!S_ISDIR(attr.mode))
+		return B_NOT_A_DIRECTORY;
+
+	fRoot = new(std::nothrow) Node(this, FUSE_ROOT_ID, attr);
+	if (fRoot == NULL)
+		return B_NO_MEMORY;
+	fRoot->published = true;
+	fNodes.Insert(fRoot);
+
+	status = publish_vnode(fFSVolume, FUSE_ROOT_ID, fRoot, &gHostFSVnodeOps, S_IFDIR, 0);
+	if (status != B_OK) {
+		fNodes.Remove(fRoot);
+		delete fRoot;
+		fRoot = NULL;
+		return status;
+	}
+	return B_OK;
+}
+
+
+void
+Volume::Unmount()
+{
+	// the VFS has put every vnode but the one publish_vnode() gave us
+	put_vnode(fFSVolume, FUSE_ROOT_ID);
+
+	int32 left = 0;
+	{
+		MutexLocker locker(fLock);
+		left = fNodes.CountElements();
+	}
+	if (left > 1)
+		INFORM("unmounting with %" B_PRId32 " nodes still in the table\n", left);
+
+	Request(FUSE_DESTROY, 0, NULL, 0, NULL, NULL, NULL, 0, NULL, 0);
+	close(fDevice);
+	fDevice = -1;
+}
+
+
+//	#pragma mark - requests
+
+
+status_t
+Volume::Request(uint32 opcode, uint64 nodeid, const void* args, size_t argsSize,
+	const char* name1, const char* name2, const void* inData, size_t inDataSize,
+	void* reply, size_t replySize, void* outData, size_t outDataSize,
+	size_t* _outDataLength)
+{
+	const size_t name1Size = name1 != NULL ? strlen(name1) + 1 : 0;
+	const size_t name2Size = name2 != NULL ? strlen(name2) + 1 : 0;
+	const size_t inSize = sizeof(fuse_in_header) + argsSize + name1Size + name2Size;
+	if (inSize > fTransport.max_in_size)
+		return B_NAME_TOO_LONG;
+
+	uint8 stackIn[384];
+	uint8* in = stackIn;
+	if (inSize > sizeof(stackIn)) {
+		in = (uint8*)malloc(inSize);
+		if (in == NULL)
+			return B_NO_MEMORY;
+	}
+	MemoryDeleter inDeleter(in != stackIn ? in : NULL);
+
+	fuse_in_header* header = (fuse_in_header*)in;
+	memset(header, 0, sizeof(fuse_in_header));
+	header->opcode = opcode;
+	header->nodeid = nodeid;
+	header->uid = geteuid();
+	header->gid = getegid();
+	header->pid = getpid();
+	uint8* next = in + sizeof(fuse_in_header);
+	if (argsSize > 0) {
+		memcpy(next, args, argsSize);
+		next += argsSize;
+	}
+	if (name1Size > 0) {
+		memcpy(next, name1, name1Size);
+		next += name1Size;
+	}
+	if (name2Size > 0)
+		memcpy(next, name2, name2Size);
+
+	struct {
+		fuse_out_header	header;
+		uint8			reply[256];
+	} out;
+	if (replySize > sizeof(out.reply))
+		return B_BAD_VALUE;
+
+	const bool noReply = opcode == FUSE_FORGET || opcode == FUSE_BATCH_FORGET;
+	virtio_fs_request request = {};
+	request.in = in;
+	request.in_size = inSize;
+	request.in_data = inData;
+	request.in_data_size = inDataSize;
+	if (!noReply) {
+		request.out = &out;
+		request.out_size = sizeof(fuse_out_header) + replySize;
+		request.out_data = outData;
+		request.out_data_size = outDataSize;
+	}
+
+	status_t status = fTransport.request(fTransport.cookie, &request);
+	if (status != B_OK) {
+		INFORM("opcode %" B_PRIu32 ": transport error %s\n", opcode, strerror(status));
+		return status;
+	}
+	if (noReply)
+		return B_OK;
+
+	if (out.header.error != 0) {
+		status = linux_to_haiku_error(out.header.error, opcode);
+		TRACE("opcode %" B_PRIu32 " node %" B_PRIu64 ": %s\n", opcode, nodeid,
+			strerror(status));
+		return status;
+	}
+	if (reply != NULL && replySize > 0)
+		memcpy(reply, out.reply, replySize);
+	if (_outDataLength != NULL)
+		*_outDataLength = request.out_data_length;
+	return B_OK;
+}
+
+
+status_t
+Volume::GetAttr(uint64 nodeid, fuse_attr* attr)
+{
+	fuse_getattr_in in = {};
+	fuse_attr_out out;
+	status_t status = Request(FUSE_GETATTR, nodeid, &in, sizeof(in), NULL, NULL, NULL, 0,
+		&out, sizeof(out));
+	if (status == B_OK)
+		*attr = out.attr;
+	return status;
+}
+
+
+status_t
+Volume::Lookup(uint64 dir, const char* name, fuse_entry_out* entry)
+{
+	status_t status = Request(FUSE_LOOKUP, dir, NULL, 0, name, NULL, NULL, 0, entry,
+		sizeof(fuse_entry_out));
+	if (status == B_OK && entry->nodeid == 0) {
+		// a negative entry: the host says it does not exist
+		return B_ENTRY_NOT_FOUND;
+	}
+	return status;
+}
+
+
+status_t
+Volume::Open(uint64 nodeid, bool directory, uint32 linuxFlags, uint64* _fh)
+{
+	fuse_open_in in = {};
+	in.flags = linuxFlags;
+	fuse_open_out out;
+	status_t status = Request(directory ? FUSE_OPENDIR : FUSE_OPEN, nodeid, &in,
+		sizeof(in), NULL, NULL, NULL, 0, &out, sizeof(out));
+	if (status == B_OK)
+		*_fh = out.fh;
+	return status;
+}
+
+
+void
+Volume::Release(uint64 nodeid, bool directory, uint64 fh)
+{
+	fuse_release_in in = {};
+	in.fh = fh;
+	Request(directory ? FUSE_RELEASEDIR : FUSE_RELEASE, nodeid, &in, sizeof(in), NULL,
+		NULL, NULL, 0, NULL, 0);
+}
+
+
+void
+Volume::Forget(uint64 nodeid, uint64 lookups)
+{
+	fuse_forget_in in = {};
+	in.nlookup = lookups;
+	Request(FUSE_FORGET, nodeid, &in, sizeof(in), NULL, NULL, NULL, 0, NULL, 0);
+}
+
+
+//	#pragma mark - the node table
+
+
+/*!	Records a node the host just handed out (a lookup, create, mkdir, ...):
+	one more lookup to forget later. The node stays in the table at least until
+	Unpend() is called for it.
+*/
+Node*
+Volume::AcquireEntry(const fuse_entry_out& entry, uint64 parent, const char* name)
+{
+	if (entry.nodeid == 0)
+		return NULL;
+
+	Node* reclaim = NULL;
+	Node* node;
+	{
+		MutexLocker locker(fLock);
+		node = fNodes.Lookup(entry.nodeid);
+		if (node == NULL) {
+			node = new(std::nothrow) Node(this, entry.nodeid, entry.attr);
+			if (node == NULL) {
+				locker.Unlock();
+				Forget(entry.nodeid, 1);
+				return NULL;
+			}
+			fNodes.Insert(node);
+		}
+		node->lookups++;
+		node->pending++;
+		if (entry.nodeid != FUSE_ROOT_ID && parent != 0 && name != NULL) {
+			Node* oldParent = _SetParent(node, parent, name);
+			if (oldParent != NULL)
+				_Collect(oldParent, reclaim);
+		}
+	}
+	_Reclaim(reclaim);
+	return node;
+}
+
+
+/*!	Pins a node that is already in the table, if it is. */
+Node*
+Volume::AcquireNode(uint64 nodeid)
+{
+	MutexLocker locker(fLock);
+	Node* node = fNodes.Lookup(nodeid);
+	if (node != NULL)
+		node->pending++;
+	return node;
+}
+
+
+/*!	Pins the directory \a node was found in. */
+Node*
+Volume::AcquireParent(Node* node)
+{
+	MutexLocker locker(fLock);
+	uint64 parent = node->nodeid == FUSE_ROOT_ID ? FUSE_ROOT_ID : node->parent;
+	Node* parentNode = parent != 0 ? fNodes.Lookup(parent) : NULL;
+	if (parentNode != NULL)
+		parentNode->pending++;
+	return parentNode;
+}
+
+
+void
+Volume::Unpend(Node* node)
+{
+	Node* reclaim = NULL;
+	{
+		MutexLocker locker(fLock);
+		node->pending--;
+		_Collect(node, reclaim);
+	}
+	_Reclaim(reclaim);
+}
+
+
+void
+Volume::Publish(Node* node)
+{
+	MutexLocker locker(fLock);
+	node->published = true;
+}
+
+
+void
+Volume::Unpublish(Node* node)
+{
+	Node* reclaim = NULL;
+	{
+		MutexLocker locker(fLock);
+		node->published = false;
+		_Collect(node, reclaim);
+	}
+	_Reclaim(reclaim);
+}
+
+
+/*!	A rename moved \a node: it now lives in \a parent as \a name. */
+void
+Volume::Moved(Node* node, uint64 parent, const char* name)
+{
+	Node* reclaim = NULL;
+	{
+		MutexLocker locker(fLock);
+		Node* oldParent = _SetParent(node, parent, name);
+		if (oldParent != NULL)
+			_Collect(oldParent, reclaim);
+	}
+	_Reclaim(reclaim);
+}
+
+
+uint64
+Volume::ParentOf(Node* node)
+{
+	MutexLocker locker(fLock);
+	return node->nodeid == FUSE_ROOT_ID ? FUSE_ROOT_ID : node->parent;
+}
+
+
+bool
+Volume::IsPublished(Node* node)
+{
+	MutexLocker locker(fLock);
+	return node->published;
+}
+
+
+/*!	Must be called with the lock held. Returns the node's former parent if it
+	changed, so that the caller can see whether it is still needed.
+*/
+Node*
+Volume::_SetParent(Node* node, uint64 parent, const char* name)
+{
+	Node* oldParent = NULL;
+	if (node->parent != parent) {
+		if (node->parent != 0) {
+			oldParent = fNodes.Lookup(node->parent);
+			if (oldParent != NULL)
+				oldParent->children--;
+		}
+		Node* newParent = fNodes.Lookup(parent);
+		if (newParent != NULL) {
+			newParent->children++;
+			node->parent = parent;
+		} else
+			node->parent = 0;
+	}
+	if (name != NULL && (node->name == NULL || strcmp(node->name, name) != 0)) {
+		char* copy = strdup(name);
+		if (copy != NULL) {
+			free(node->name);
+			node->name = copy;
+		}
+	}
+	return oldParent;
+}
+
+
+/*!	Must be called with the lock held. Takes \a node out of the table if
+	nothing needs it any more -- and then its parent, if that was all that kept
+	the parent -- and prepends them to \a reclaimList for _Reclaim().
+*/
+void
+Volume::_Collect(Node* node, Node*& reclaimList)
+{
+	while (node != NULL && node->nodeid != FUSE_ROOT_ID && !node->published
+		&& node->pending == 0 && node->children == 0) {
+		fNodes.Remove(node);
+		Node* parent = node->parent != 0 ? fNodes.Lookup(node->parent) : NULL;
+		if (parent != NULL)
+			parent->children--;
+		node->hashLink = reclaimList;
+		reclaimList = node;
+		node = parent;
+	}
+}
+
+
+/*!	Gives the host back the lookups of nodes _Collect() took out of the
+	table, and deletes them. Must be called without the lock.
+*/
+void
+Volume::_Reclaim(Node* reclaimList)
+{
+	while (reclaimList != NULL) {
+		Node* node = reclaimList;
+		reclaimList = node->hashLink;
+		if (node->lookups > 0)
+			Forget(node->nodeid, node->lookups);
+		delete node;
+	}
+}
