+++ b/build/jam/DefaultBuildProfiles
@@ -312,6 +312,7 @@ rule DefineDefaultBuildProfiles
 				romannumbers
 				samedi
 				shredder
+				sisong
 				slayer
 				superprefs
 				systeminfo
