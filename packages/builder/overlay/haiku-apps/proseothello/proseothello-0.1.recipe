SUMMARY="Reversi for Prose"
DESCRIPTION="ProseOthello is the suite's game: Reversi against the machine, \
with every legal square circled so the board says what is possible. Four \
levels, from a random opponent to one that counts the ending out exactly. \
It is developed in the Prose repository (proseothello/) and packaged from \
there; SOURCE_STATE in the source says which state of the tree this is."
HOMEPAGE="https://github.com/albanread/Prose"
COPYRIGHT="2026 The Prose project"
LICENSE="MIT"
REVISION="1"
# The source is not fetched: make-source.sh beside this recipe packs the
# committed state of proseothello/app, and prosepkg reads a file:// source
# from the recipe's own directory. Run it before building.
SOURCE_URI="file://proseothello-$portVersion.tar.gz"
SOURCE_DIR="proseothello-$portVersion"

ARCHITECTURES="arm64 ?x86_64"

PROVIDES="
	proseothello = $portVersion
	app:ProseOthello = $portVersion
	"
REQUIRES="
	haiku
	"

BUILD_REQUIRES="
	haiku_devel
	"
BUILD_PREREQUIRES="
	cmd:g++
	cmd:make
	cmd:rc
	cmd:xres
	"

BUILD()
{
	# The Makefile is the developers': it names the tree's cross compiler and
	# a sysroot of its own. Here the compiler is the g++ on the PATH, prosepkg's
	# wrapper, which knows where the headers and libraries are, so those
	# settings are replaced. The binary is checked for: an empty package
	# looked like success once.
	make $jobArgs XGXX=g++ INCS="-I. -Isrc" LIBS="" \
		CXXFLAGS="-O2 -Wall -Wno-multichar -Wno-unused-parameter -std=c++17" \
		ProseOthello
	test -x ProseOthello || { echo "ProseOthello did not build" >&2; exit 1; }
	rc -o ProseOthello.rsrc ProseOthello.rdef
	xres -o ProseOthello ProseOthello.rsrc
}

INSTALL()
{
	mkdir -p $appsDir
	cp -a ProseOthello $appsDir/ProseOthello
	settype -t application/x-vnd.Be-elfexecutable $appsDir/ProseOthello
	mimeset -f $appsDir/ProseOthello
	addAppDeskbarSymlink $appsDir/ProseOthello
}
