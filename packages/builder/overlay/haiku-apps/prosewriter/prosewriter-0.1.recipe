SUMMARY="A word processor for Prose"
DESCRIPTION="ProseWriter is a native word processor for Prose: pages laid out \
as they will print, paragraph and character styles, tables, a spelling \
checker, and documents of its own format that it opens and saves. It is \
developed in the Prose repository (prosewriter/) and packaged from there; \
SOURCE_STATE in the source says which state of the tree this is."
HOMEPAGE="https://github.com/albanread/Prose"
COPYRIGHT="2026 The Prose project"
LICENSE="MIT"
REVISION="1"
# The source is not fetched: make-source.sh beside this recipe packs it from
# the repository's working tree, and prosepkg reads a file:// source from the
# recipe's own directory. Run it before building.
SOURCE_URI="file://prosewriter-$portVersion.tar.gz"
SOURCE_DIR="prosewriter-$portVersion"

ARCHITECTURES="arm64 ?x86_64"

PROVIDES="
	prosewriter = $portVersion
	app:ProseWriter = $portVersion
	"
REQUIRES="
	haiku
	lib:libz
	"

BUILD_REQUIRES="
	haiku_devel
	devel:libz
	"
BUILD_PREREQUIRES="
	cmd:g++
	cmd:make
	cmd:rc
	cmd:xres
	"

BUILD()
{
	# The Makefile is the developers': it names the tree's cross compiler and
	# a sysroot of its own. Here the compiler is the g++ on the PATH, prosepkg's
	# wrapper, which knows where the headers and libraries are, so those
	# settings are replaced. make's errors do not stop the build by themselves,
	# so the binary is checked for: an empty package looked like success once.
	make $jobArgs XGXX=g++ INCS="-I. -Isrc" LIBS="" \
		CXXFLAGS="-O2 -Wall -Wno-multichar -Wno-unused-parameter -std=c++17" \
		ProseWriter
	test -x ProseWriter || { echo "ProseWriter did not build" >&2; exit 1; }
	rc -o ProseWriter.rsrc ProseWriter.rdef
	xres -o ProseWriter ProseWriter.rsrc
}

INSTALL()
{
	mkdir -p $appsDir
	cp -a ProseWriter $appsDir/ProseWriter
	settype -t application/x-vnd.Be-elfexecutable $appsDir/ProseWriter
	mimeset -f $appsDir/ProseWriter
	addAppDeskbarSymlink $appsDir/ProseWriter
}
