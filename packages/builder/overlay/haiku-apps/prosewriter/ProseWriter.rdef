/* The application's identity, added to the executable by the recipe: the
 * Makefile builds it without resources. */
resource app_signature "application/x-vnd.prose.ProseWriter";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_ALPHA,
	internal = 0,
	short_info = "ProseWriter",
	long_info  = "ProseWriter 0.1 - a word processor for Prose"
};
