+#ifndef __ASSEMBLER__
+/* haiku-common force-includes this; AArch64's .S files are preprocessed */
 #include <sys/select.h>
 #include <sys/time.h>
+#endif
--- /dev/null
+++ b/Configurations/51-prose-haiku-aarch64.conf
@@ -0,0 +1,10 @@
+## Prose: Haiku on AArch64. OpenSSL defines haiku-x86 and haiku-x86_64
+## only; this is linux-aarch64's asm setup on top of haiku-common.
+my %targets = (
+    "haiku-aarch64" => {
+        inherit_from     => [ "haiku-common" ],
+        bn_ops           => "SIXTY_FOUR_BIT_LONG",
+        asm_arch         => 'aarch64',
+        perlasm_scheme   => "linux64",
+    },
+);
